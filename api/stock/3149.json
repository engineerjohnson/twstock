:{"topics":["營收","AI/半導體","匯率"],"bull":["新高","成長","年增"],"bear":["暴跌"],"score":0,"highlights":["成長 110%"],"keywords":["輝達","資料中心","目標價","空頭","技術面","流動性","平倉潮","循環融資"]},"time":"11/20 15:20"}],"fund":{"code":"3149","rev_month":"11510","rev":149585.0,"rev_mom":-33.55351122285349,"rev_yoy":-31.762714802498028,"rev_cum_yoy":4.336166902090553,"eps_q":1.72,"eps_year":"115","eps_season":"3","net_income":410580.0,"pe":55.64,"pb":2.2,"yield":null,"updated":"2026-11-27 02:23"},"tdcc":{"latest":{"date":"2026-11-20","big1000":19.12,"big400":24.29,"retail":33.79,"holders":67742},"prev":{"date":"2026-11-13","big1000":18.69,"big400":24.62,"retail":33.81,"holders":68125},"d_big1000":0.43,"d_big400":-0.33,"d_retail":-0.02,"d_holders":-383},"weekly":{"bars":[{"time":"2026-07-27","open":68.3,"high":71.0,"low":61.5,"close":65.9,"volume":37890.305},{"time":"2026-08-03","open":65.4,"high":68.9,"low":62.2,"close":62.8,"volume":53790.773},{"time":"2026-08-10","open":63.5,"high":72.0,"low":63.5,"close":67.1,"volume":72505.283},{"time":"2026-08-17","open":67.5,"high":68.7,"low":64.3,"close":65.0,"volume":27307.233},{"time":"2026-08-24","open":65.0,"high":68.9,"low":62.4,"close":66.4,"volume":27242.484000000004},{"time":"2026-08-31","open":65.6,"high":66.3,"low":58.4,"close":60.6,"volume":32133.708000000002},{"time":"2026-09-07","open":60.7,"high":64.0,"low":59.8,"close":62.3,"volume":18809.987999999998},{"time":"2026-09-14","open":61.7,"high":64.4,"low":59.4,"close":63.8,"volume":24587.36},{"time":"2026-09-21","open":64.7,"high":67.9,"low":62.5,"close":63.3,"volume":19739.773},{"time":"2026-09-29","open":63.2,"high":79.7,"low":63.0,"close":77.3,"volume":90163.016},{"time":"2026-10-05","open":78.8,"high":80.0,"low":75.0,"close":76.6,"volume":40190.306000000004},{"time":"2026-10-12","open":75.5,"high":81.4,"low":71.2,"close":72.4,"volume":43203.655999999995},{"time":"2026-10-19","open":69.8,"high":75.3,"low":68.6,"close":68.6,"volume":20458.912},{"time":"2026-10-27","open":70.1,"high":73.1,"low"