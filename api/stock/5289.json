TS-P系列SSD最高讀取速度達14GB/s、寫入速度達10GB/s，並提供U.2及EDSFF E1.S兩種規格，兼顧高速傳輸、散熱與維護需求。","sentiment":0,"tags":{"topics":["AI/半導體"],"bull":["布局"],"bear":[],"score":1,"highlights":[],"keywords":["宜鼎","記憶體","SSD","AI","伺服器","資料中心"]},"time":"11/04 13:29"}],"fund":{"code":"5289","rev_month":"11510","rev":7750083.0,"rev_mom":-11.049435554456789,"rev_yoy":454.5787679466923,"rev_cum_yoy":538.2561017998084,"eps_q":256.23,"eps_year":"115","eps_season":"3","net_income":24948186.0,"pe":3.64,"pb":2.81,"yield":1.79,"updated":"2026-11-13 17:58"},"tdcc":{"latest":{"date":"2026-11-06","big1000":18.43,"big400":29.02,"retail":34.65,"holders":84842},"prev":{"date":"2026-10-30","big1000":18.45,"big400":29.34,"retail":34.61,"holders":85102},"d_big1000":-0.02,"d_big400":-0.32,"d_retail":0.04,"d_holders":-260},"weekly":{"bars":[{"time":"2026-07-27","open":1355.0,"high":1355.0,"low":1090.0,"close":1295.0,"volume":11647.858},{"time":"2026-08-03","open":1295.0,"high":1680.0,"low":1295.0,"close":1500.0,"volume":19970.989},{"time":"2026-08-10","open":1525.0,"high":1595.0,"low":1425.0,"close":1475.0,"volume":14140.622},{"time":"2026-08-17","open":1485.0,"high":1580.0,"low":1390.0,"close":1560.0,"volume":11250.437},{"time":"2026-08-24","open":1580.0,"high":1660.0,"low":1465.0,"close":1470.0,"volume":10681.143},{"time":"2026-08-31","open":1460.0,"high":1480.0,"low":1320.0,"close":1360.0,"volume":7765.579},{"time":"2026-09-07","open":1415.0,"high":1445.0,"low":1240.0,"close":1295.0,"volume":8366.075},{"time":"2026-09-14","open":1265.0,"high":1315.0,"low":1245.0,"close":1315.0,"volume":5075.309},{"time":"2026-09-21","open":1330.0,"high":1375.0,"low":1270.0,"close":1305.0,"volume":5207.857000000001},{"time":"2026-09-29","open":1305.0,"high":1330.0,"low":1280.0,"close":1295.0,"volume":3130.31},{"time":"2026-10-05","open":1305.0,"high":1320.0,"low":1250.0,"close":1250.0,"volume":4782.646},{"time":"2026-10-12","open":1235.0,"high":1295.0,"low":1095.0,"close":1175.0,"volume":7601.395999999999},{"time":"2026-10-19","ope