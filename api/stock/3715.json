占地約3.5萬平方公尺，主要生產銅箔基板及黏合片，目前已開始小量出貨，預計2026年底正式量產，後續上膠產能將於2027年陸續開出，屆時泰國廠總設計產能預計再提升15%。新廠將落實China+1策略，除服務既有車用電子客戶外，也為未來資料中心及高階電子材料需求預作布局。 騰輝電子-KY指出，因應AI、高階運算與資料中心市場發展，騰輝-KY已於9月17日經董事會通過15億元昆山擴產預算，預計2027年第二季開始量產。結合泰國與昆山雙基地布局，集團將進一步提升全球產能調度彈性，強化國際客戶供應能力。","sentiment":1,"tags":{"topics":["擴產/資本支出","AI/半導體","美股/國際"],"bull":["擴產","供應鏈","布局"],"bear":[],"score":4,"highlights":[],"keywords":["騰輝-KY","CCL","泰國","PCB","尖點","華通","台光電","欣興"]},"time":"10/26 16:50"}],"fund":{"code":"3715","rev_month":"11509","rev":3226476.0,"rev_mom":10.04123038367892,"rev_yoy":84.69522628124143,"rev_cum_yoy":51.25937713911443,"eps_q":-1.55,"eps_year":"115","eps_season":"2","net_income":-542248.0,"pe":null,"pb":3.58,"yield":0.82,"updated":"2026-10-30 16:33"},"tdcc":{"latest":{"date":"2026-10-22","big1000":20.88,"big400":28.98,"retail":41.72,"holders":97162},"prev":{"date":"2026-10-08","big1000":20.86,"big400":29.71,"retail":41.58,"holders":97275},"d_big1000":0.02,"d_big400":-0.73,"d_retail":0.14,"d_holders":-113},"weekly":{"bars":[{"time":"2026-07-27","open":116.5,"high":116.5,"low":89.5,"close":99.9,"volume":33053.276},{"time":"2026-08-03","open":99.9,"high":120.0,"low":99.7,"close":114.5,"volume":32851.433},{"time":"2026-08-10","open":119.0,"high":129.0,"low":115.0,"close":116.0,"volume":35194.748},{"time":"2026-08-17","open":114.5,"high":116.0,"low":106.0,"close":107.0,"volume":17775.068000000003},{"time":"2026-08-24","open":107.0,"high":126.5,"low":104.0,"close":125.0,"volume":21420.786},{"time":"2026-08-31","open":122.0,"high":132.5,"low":115.5,"close":118.0,"volume":42752.378000000004},{"time":"2026-09-07","open":119.0,"high":138.0,"low":117.0,"close":123.0,"volume":45607.74},{"time":"2026-09-14","open":119.5,"high":125.5,"low":118.5,"close":118.5,"volume":16362.868999999999},{"time":"2026-09-21","open":119.5,"high":130.0,"low":118.5,"close":123.0,"volume":30532.839},{"time":"2026-09-29","open":121.5,"high":131.5,"low":120.5,"close":129.5,"volume":17474.96},{"time":"2026-10-05","open":134.0,"