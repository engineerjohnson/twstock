st":10.0,"dealer":-1304.643},{"date":"2026-10-15","foreign":-4678.726,"trust":0.0,"dealer":-1063.796}],"news":[{"id":"cnyes6659882","source":"鉅亨網","category":"台股","title":"友通(2397) 邊緣 AI 潛在商機九成集中三大應用，訂單轉化看驗證複製速度","link":"https://news.cnyes.com/news/id/6659882","published":1794432615,"summary":"2026年11月12日（優分析／產業數據中心報導）⸺ 友通(2397-TW) 在法說會上將邊緣 AI 機會分為三大應用：工業自動化占 42.4%，半導體與工業設備 29.7%，關鍵任務型應用 19.4%。這三個比重為公司追蹤的工業級邊緣 AI 潛在商機占比，三項合計 91.5%。 這三大應用對應設備端算力需求。公司指出，各國持續投資在地製造與半導體，新建工廠與產線導入自動化，算力需求要在設備現場建置完成；移動機器人的視覺辨識、導航與避障，產線上的即時瑕疵檢測，都須在現場完成處理後再做出下一個反應。 SEMI（國際半導體產業協會）預估 2026 年全球半導體製造設備銷售額 1,659 億美元、年增 23.2%，公司關注的是這些投資帶來的設備端運算需求。 公司也註明，潛在商機不代表訂單或營收，三大應用以外的其他應用占 8.5%。 先算需求再挑平台 公司選擇平台時先計算需求，以半導體製程設備為例，先確認設備要處理多少影像、須在多久內做出判斷，再評估現場介面、可用功耗與散熱條件，最後才建議運算平台。公司稱此做法為「最適算力」。 每台設備完成驗證後，公司會保留運算架構、介面設計與測試方法，同一個客戶的其他產品線、或同產業的新客戶可以縮短開發與驗證週期；需要更完整的整合時，公司從板卡延伸到工業級系統，結合晶片、軟體與母公司佳世達的集團資源。","sentiment":1,"tags":{"topics":["訂單/接單","營收","法說/展望","AI/半導體","匯率"],"bull":["訂單"],"bear":[],"score":2,"highlights":["年增 23.2%"],"keywords":["邊緣AI","工業自動化","半導體設備","機器人","優分析"]},"time":"11/12 05:30"},{"id":"ed9382d333d36439","source":"經濟日報-證券","category":"台股","title":"外資逆勢掃貨股 抗壓力強","link":"https://money.udn.com/money/story/5607/9865401","published":1794156936,"summary":"外資近期連續七個交易日賣超台股，波段累計賣超金額高達7,056.5億元，外資大幅出脫台股之際，仍有華航（2610）、寶雅*、神基、勤誠、合晶、光頡等多檔個股受到國際資金青睞。","sentiment":-1,"tags":{"topics":["法人動向"],"bull":[],"bear":["賣超","出脫"],"score":-4,"highlights":[],"keywords":[]},"time":"11/09 00:55"}],"fund":{"code":"6182","rev_month":"11510","rev":1035924.0,"rev_mom":2.5059395467440595,"rev_yoy":20.217242459760243,"rev_cum_yoy":12.829592256549386,"eps_q":null,"eps_year":null,"eps_season":null,"net_income":null,"pe":354.78,"pb":3.0,"yield":0.0,"updated":"2026-11-13 17:58"},"tdcc":{"latest":{"date":"2026-11-06","big1000":15.92,"big400":19.3,"retail":51.84,"holders":257105},"prev":{"date":"2026-10-30","big1000":17.22,"big400":20.64,"retail":50.97,"holders":257470},"d_big1000":-1.3,"d_big400":-1.34,"d_retail":0.87,"d_holders":-3