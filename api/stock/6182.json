洽談為Anthropic安排600億美元晶片融資，SpaceX( SPCX-US ) 據報也尋求為輝達( NVDA-US ) 晶片取得400億美元融資；輝達本身則宣布與六大貸款機構建立總額5,000億美元的合作框架。 摩根大通分析師預估，2030年前晶片支出總額可能超過3兆美元，其中大部分將仰賴舉債支應。 晶片抵押融資興起 CoreWeave 開創先例 晶片抵押融資的核心，是透過設立特殊目的公司（SPV）持有晶片，再以客戶合約所產生的現金流償還債務，並讓貸款期限配合晶片約5至6年的折舊週期，將相關資產的折舊風險納入融資安排。","sentiment":-1,"tags":{"topics":["AI/半導體","匯率"],"bull":["擴大","布局"],"bear":["違約","不如預期"],"score":-3,"highlights":[],"keywords":["GPU","融資","AI","人工智慧","算力","晶片","抵押","基礎設施"]},"time":"10/24 14:10"}],"fund":{"code":"6182","rev_month":"11509","rev":1010599.0,"rev_mom":0.6105731801773281,"rev_yoy":13.521877639785043,"rev_cum_yoy":11.961617195635972,"eps_q":0.06,"eps_year":"115","eps_season":"2","net_income":82722.0,"pe":454.35,"pb":3.84,"yield":0.0,"updated":"2026-10-25 00:33"},"tdcc":{"latest":{"date":"2026-10-22","big1000":16.98,"big400":21.35,"retail":50.25,"holders":256243},"prev":{"date":"2026-10-08","big1000":22.47,"big400":27.18,"retail":45.29,"holders":243399},"d_big1000":-5.49,"d_big400":-5.83,"d_retail":4.96,"d_holders":12844},"weekly":{"bars":[{"time":"2026-07-27","open":110.0,"high":116.0,"low":84.0,"close":89.0,"volume":92488.42899999999},{"time":"2026-08-03","open":82.1,"high":108.0,"low":82.1,"close":101.0,"volume":31483.543},{"time":"2026-08-10","open":101.5,"high":119.5,"low":89.8,"close":111.5,"volume":313016.019},{"time":"2026-08-17","open":111.0,"high":131.0,"low":103.5,"close":106.0,"volume":466402.034},{"time":"2026-08-24","open":108.5,"high":117.5,"low":104.5,"close":110.0,"volume":317176.72900000005},{"time":"2026-08-31","open":108.0,"high":116.0,"low":104.0,"close":111.0,"volume":255034.42700000003},{"time":"2026-09-07","open":112.0,"high":119.0,"low":103.5,"close":104.5,"volume":156497.789},{"time":"2026-09-14","open":102.5,"high":117.5,"low":100.0,"close":116.0,"volume":228421.06799999997},{"time":"2026-09-21","open":117.0,"high":125.0,"low":113.5,"close":120.5,"volume":358617.126},{"time":"2026-09-29","open":119.5,"high":140.0,"low":117.0,"close":135.0,"volume":547628.401},{"time":