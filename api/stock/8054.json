再次突破1兆美元。去年中國貿易順差寫下1.2兆美元歷史新高。 今年前 10 個月，中國的貿易順差比去年同期成長近 9%。 今年出口大幅成長，主要歸功於全球對人工智慧（AI）硬體的需求暴增，這類產品在全亞洲的貿易往來也十分熱絡。雖然中國的進口也有所成長，但仍落後於出口，且增幅主要侷限於黃金等少數特定商品，顯示內需依然缺乏明顯復甦跡象。 不過，中國出口強勁勢頭並不限於AI 硬體。高盛集團的分析顯示，若從出口數量來看，成長動能來自廣泛高科技產品，從中共高層推廣的「新三樣」產業——太陽能、電動車與鋰電池——到工業機器人皆包含在內。","sentiment":1,"tags":{"topics":["AI/半導體","匯率"],"bull":["突破","成長","超預期"],"bear":[],"score":5,"highlights":["成長 35.2%"],"keywords":["中國","出口","進口"]},"time":"11/10 11:36"}],"fund":{"code":"8054","rev_month":"11510","rev":267747.0,"rev_mom":17.974126915586417,"rev_yoy":29.323261059617362,"rev_cum_yoy":123.72949206338629,"eps_q":-0.14,"eps_year":"115","eps_season":"3","net_income":-107104.0,"pe":null,"pb":2.43,"yield":0.0,"updated":"2026-11-13 17:58"},"tdcc":{"latest":{"date":"2026-11-06","big1000":28.5,"big400":32.77,"retail":34.21,"holders":52152},"prev":{"date":"2026-10-30","big1000":27.43,"big400":33.51,"retail":34.37,"holders":52255},"d_big1000":1.07,"d_big400":-0.74,"d_retail":-0.16,"d_holders":-103},"weekly":{"bars":[{"time":"2026-07-27","open":95.6,"high":96.2,"low":75.3,"close":80.0,"volume":5751.295},{"time":"2026-08-03","open":79.5,"high":87.0,"low":78.5,"close":82.8,"volume":5335.373},{"time":"2026-08-10","open":84.0,"high":87.5,"low":82.4,"close":82.6,"volume":4211.24},{"time":"2026-08-17","open":82.7,"high":83.7,"low":78.4,"close":79.7,"volume":3052.4559999999997},{"time":"2026-08-24","open":79.9,"high":87.0,"low":78.6,"close":84.6,"volume":3406.431},{"time":"2026-08-31","open":83.5,"high":85.5,"low":80.1,"close":82.5,"volume":3070.1189999999997},{"time":"2026-09-07","open":83.5,"high":86.4,"low":79.5,"close":80.0,"volume":3499.8379999999997},{"time":"2026-09-14","open":80.5,"high":85.1,"low":79.6,"close":84.4,"volume":2903.18},{"time":"2026-09-21","open":84.6,"high":92.0,"low":83.5,"close":84.6,"volume":6367.099999999999},{"time":"2026-09-29","open":85.0,"high":92.5,"low":84.3,"close":89.5,"volume":5194.6089999999995},{"time":"2026-10-05","open":90.9,"high":91.8,"low":80.8,"close":81.0,"volume":