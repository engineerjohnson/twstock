","優分析"]},"time":"11/19 20:30"},{"id":"4182eee7dc206754","source":"富果直送","category":"台股","title":"【矽瑪法說會重點內容備忘錄】未來展望趨勢 20261119","link":"https://news.google.com/rss/articles/CBMiZ0FVX3lxTE1YQms4UVYzNEE4bnZCMlE5ZnhKckZHbVlJNjl3X0NkZE53SHhWRmpYR0UwaG1mVmtscVFBSGtvVTNqQVJwanBrVUdIWGhXUHBUdENURFgwLUE0NW1VZU9aYzBZa0l2WHc?oc=5","published":1795046400,"summary":"【矽瑪法說會重點內容備忘錄】未來展望趨勢 20261119 富果直送","sentiment":0,"tags":{"topics":["法說/展望"],"bull":[],"bear":[],"score":0,"highlights":[],"keywords":[]},"time":"11/19 08:00"}],"fund":{"code":"3511","rev_month":"11510","rev":167201.0,"rev_mom":-2.796897890844825,"rev_yoy":9.830132163220263,"rev_cum_yoy":12.378651368629003,"eps_q":-0.69,"eps_year":"115","eps_season":"3","net_income":-69135.0,"pe":null,"pb":0.9,"yield":0.0,"updated":"2026-11-27 02:23"},"tdcc":{"latest":{"date":"2026-11-20","big1000":51.13,"big400":53.4,"retail":21.66,"holders":9150},"prev":{"date":"2026-11-13","big1000":51.13,"big400":53.47,"retail":21.75,"holders":9169},"d_big1000":0.0,"d_big400":-0.07,"d_retail":-0.09,"d_holders":-19},"weekly":{"bars":[{"time":"2026-07-27","open":20.25,"high":20.4,"low":17.55,"close":19.1,"volume":1964.259},{"time":"2026-08-03","open":19.1,"high":20.65,"low":18.7,"close":20.15,"volume":1171.1799999999998},{"time":"2026-08-10","open":20.25,"high":21.25,"low":20.0,"close":20.3,"volume":1211.8449999999998},{"time":"2026-08-17","open":20.3,"high":20.4,"low":19.3,"close":19.5,"volume":628.062},{"time":"2026-08-24","open":19.5,"high":20.15,"low":19.05,"close":20.0,"volume":566.2080000000001},{"time":"2026-08-31","open":20.15,"high":20.15,"low":19.05,"close":19.7,"volume":585.5409999999999},{"time":"2026-09-07","open":19.5,"high":19.7,"low":18.6,"close":18.7,"volume":731.9540000000001},{"time":"2026-09-14","open":18.55,"high":19.15,"low":17.8,"close":19.0,"volume":626.402},{"time":"2026-09-21","open":19.55,"high":19.9,"low":19.0,"close":19.4,"volume":400.37600000000003},{"time":"2026-09-29","open":19.55,"high":19.85,"low":19.35,"close":1