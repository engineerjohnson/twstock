:22.264},{"date":"2026-10-05","foreign":10.536,"trust":31.98,"dealer":-8.076},{"date":"2026-10-02","foreign":0.055,"trust":24.5,"dealer":14.219},{"date":"2026-10-01","foreign":23.223,"trust":-29.0,"dealer":0.039},{"date":"2026-09-30","foreign":-23.401,"trust":6.0,"dealer":24.063},{"date":"2026-09-29","foreign":68.97,"trust":-19.2,"dealer":10.886},{"date":"2026-09-24","foreign":109.319,"trust":-42.0,"dealer":24.003},{"date":"2026-09-23","foreign":60.3,"trust":-42.0,"dealer":16.614},{"date":"2026-09-22","foreign":-68.958,"trust":23.96,"dealer":3.905}],"news":[{"id":"cnyes6637224","source":"鉅亨網","category":"台股","title":"連老先覺也變心？過去堅持只存個股的杜金龍，這次竟然「首度買進這檔 ETF」！？","link":"https://news.cnyes.com/news/id/6637224","published":1792846820,"summary":"在台灣投資圈，只要提到「技術分析大師」與「基本面活字典」，資歷超過 30 年的股市老先覺——杜金龍絕對是首屈一指的代表。熟悉杜老師的股民都知道，他是標準的「個股基本面派」，滿手都是台積電、聯發科、欣興等龍頭權值股，過去極少將資金停泊在被動型 ETF 上。 然而，在這波台股從逼近 5 萬點高檔急殺 3,800 點、跌破季線 46,000 點的恐慌殺盤中，杜金龍卻在優分析《股民想知道》節目中罕見自曝：「這次跌下來我逢低開始慢慢買，而且最近我也去買了 ETF——我平常很少去買 ETF 的！」 究竟是什麼樣的市場巨變與新型產品，竟然能讓堅持只買績優個股的老先覺「打破原則、動心進場」？背後的選股邏輯與操盤玄機，值得所有投資人深入探究。 一、大師罕見打破原則！為什麼這次逢低「買 ETF」？ 杜金龍透露，在加權指數逼近 5 萬點大關前，他早已居安思危，將持股比重從 7 月中旬抄底時的 95% 高檔，一路逢高調節降至 6 成。 而這波外資瘋狂提款 2 兆元、新台幣貶破 32 元大關，加權指數回測季線 46,000 點之際，他判定盤面已浮現短底，開始啟動逢低分批加碼，持股水位悄悄回升至 65%。除了加碼老朋友台積電與聯發科之外，最引人注目的，就是他首度將資金敲進了新一代的「主動式概念 ETF」！ 「很多投資人看著高價股跌下來想撿，但口袋不夠深；或是看到大盤重挫心慌慌，不知道該挑哪一檔。","sentiment":-1,"tags":{"topics":["法人動向","AI/半導體","匯率"],"bull":[],"bear":["恐慌","跌破","殺盤"],"score":-6,"highlights":[],"keywords":["川湖","ETF","杜金龍","優分析"]},"time":"10/24 21:00"},{"id":"cnyes6637214","source":"鉅亨網","category":"台股","title":"聯發科暴跌千元該抄底？杜金龍：分3筆「這價位」閉眼撿！私房操作曝光，太太叫我別買台積電改買它？","link":"https://news.cnyes.com/news/id/6637214","published":1792843208,"summary":"近期台股震盪劇烈，大盤在逼近 5 萬點大關前「近關情怯」，加上外資瘋狂提款、新台幣重貶，指數一口氣自高點回落近 3,800 點，殺回季線 46,000 點附近防守。不少投資人看著手中持股跌跌不休，連 App 都不敢打開。 然而，在這波恐慌殺盤中，高價權值股的拉回，究竟是多頭結束的警訊，還是天上掉下來的禮物？台股老先覺杜金龍在優分析的《股民想知道》節目中給出明確指引，更首度公開自家的「私房操作」——當台積電頻創天價之際，他的太太卻下達指令：「不要再買台積電了，趕快給我多買聯發科！」 究竟跌掉近千元的聯發科(2454-TW)能不能撿？杜金龍詳細拆解背後的基本面、籌碼面，並給出精準的進場策略。 一、外資「萬金魔咒」發威？聯發科為何暴跌千元 聯發科先前一路強勢攻上 5,400 元之上，但隨後卻遭遇沉重賣壓，短線大跌逾千元。杜金龍直言，市場上似乎有個「萬金魔咒」：只要外資或法人報告開始把目標價喊到 1 萬元，高價電子股往往就開始見頂修正。 從過去的大立光、台光電、川湖皆是如此，聯發科先前也有外資喊到 1 萬元，隨即引發獲利了結賣壓。 加上市場在 10 月 30 日法說會前，傳出第 3 季營收略低於預期、以及 ASIC（客製化晶片）業務明後年放緩的雜音，法人微調獲利預估，目標價下修至 5,500 元左右，導致股價出現一波急跌。","sentiment":-1,"tags":{"topics":["EPS/獲利","營收","法說/展望","法人動向","AI/半導體","匯率"],"bull":[],"bear":["恐慌","警訊","殺盤","暴跌","提款"],"score":-10,"highlights":[],"keywords":["聯發科","杜金龍","台股","台積電","優分析"]},"time":"10/24 20:00"},{"id":"cnyes6633217","source":"鉅亨網","category":"盤前盤後","title":"〈台股開盤〉開低一度挫逾800點 台積電失守2400元、川湖跌破萬元","link":"https://news.cnyes.com/news/id/6633217","published":1792374520,"summary":"美股上周五下跌，國際油價接近每桶110美元，加深通膨與利率疑慮，台股今(19)日開低，台積電跌破2400元，加權指數一度下跌逾800點，最低來到46243.55點，預估成交金額量縮至約7800至7900億元。 台積電今日開盤2395元，下跌25元或1%，聯發科跌逾2%，台達電開盤跌逾2%後走高，一度翻紅，早盤走勢震盪。鴻海、日月光投控等均跌逾2%，台光電及欣興早盤一度跌約4%，但盤中跌幅收斂，聯電則跌逾4%。 記憶體族群走弱，南亞科、旺宏、華邦電等均跌5%至6%，力積電跌半根停板，旗下愛普*更重挫逾7%。被動元件雙雄同樣弱勢，華新科跌逾7%、國巨*跌6%；封測廠京元電子、力成也分別下跌逾4%至5%。 高價股方面，川湖續挫，跌破萬元大關，健策及大立光跌約半根停板，不過，嘉澤逆勢抗跌，力守紅盤。另外，玻纖布相關的台玻、南亞也逆勢上漲，電信三雄則持續成為大盤走弱下的資金避風港。","sentiment":-1,"tags":{"topics":["AI/半導體","總經/聯準會","匯率","美股/國際","盤前"],"bull":[],"bear":["失守","跌破","通膨"],"score":-5,"highlights":[],"keywords":["台股","台積電","川湖","被動元件","記憶體"]},"time":"10/19 09:48"}],"fund":{"code":"2059","rev_month":"11509","rev":4464393.0,"rev_mom":-30.957681433937157,"rev_yoy":196.22466238072266,"rev_cum_yoy":167.83532632168345,"eps_q":110.96,"eps_year":"115","eps_season":"2","net_income":10573871.0,"pe":53.78,"pb":27.54,"yield":0.52,"updated":"2026-10-25 00:33"},"tdcc":{"latest":{"date":"2026-10-22","big1000":54.6,"big400":65.32,"retail":6.88,"holders":86332},"prev":{"date":"2026-10-08","big1000":54.48,"big400":64.58,"retail":5.96,"holders":62351},"d_big1000":0.12,"d_big400":0.74,"d_retail":0.92,"d_holders":23981},"weekly":{"bars":[{"time":"2026-07-27","open":7780.0,"high":8275.0,"low":6840.0,"close":7850.0,"volume":2980.286},{"time":"2026-08-03","open":8380.0,"high":11110.0,"low":8165.0,"close":11110.0