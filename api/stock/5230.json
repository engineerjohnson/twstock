車用領域在今年第四季與明年仍將維持穩健成長態勢。","sentiment":1,"tags":{"topics":["EPS/獲利","營收","AI/半導體","總經/聯準會","匯率"],"bull":["新高","出貨","放量","受惠"],"bear":[],"score":5,"highlights":[],"keywords":["艾笛森","富采","LED","雷笛克","光鋐"]},"time":"11/22 08:40"},{"id":"65936555e6453953","source":"經濟日報-證券","category":"台股","title":"雷笛克10月 EPS 0.14元 審慎樂觀Q4","link":"https://money.udn.com/money/story/11074/9892110","published":1795189060,"summary":"雷笛克光學（5230）昨（20）日公布10月自結，單月歸屬母公司業主淨利761萬元，年增426%，每股純益0.14元，較去年同期轉虧為盈，單月獲利已接近前三季總和。雷笛克10月合併營收1.43億元，年增23%。第3季在車用照明新專案放量與AI伺服器結構件出貨增溫帶動下，單季每股純益0.34元。雷笛克對本季持審慎樂觀看法。","sentiment":1,"tags":{"topics":["EPS/獲利","營收","AI/半導體"],"bull":["獲利","出貨","放量","年增"],"bear":[],"score":4,"highlights":["EPS 0.14元","年增426%","年增23%"],"keywords":[]},"time":"11/20 23:37"},{"id":"dd2f2382419c9f22","source":"經濟日報-證券","category":"台股","title":"雷笛克獲利／10月自結 EPS 0.14元 同期轉虧為盈 單月賺近前三季總和","link":"https://money.udn.com/money/story/11074/9891718","published":1795164047,"summary":"光學透鏡廠雷笛克光學（5230）近期股價波動劇烈，20日應主管機關要求公布10月自結損益，單月由虧轉盈，稅前淨利1,055萬元，年增619%，歸屬母公司業主淨利761萬元，年增426%，每股純益0.14元，優於去年同期的每股虧損0.04元。","sentiment":0,"tags":{"topics":["EPS/獲利"],"bull":["獲利","年增"],"bear":["虧損"],"score":0,"highlights":["EPS 0.14元","年增619%","年增426%"],"keywords":[]},"time":"11/20 16:40"}],"fund":{"code":"5230","rev_month":"11510","rev":143002.0,"rev_mom":1.3997220410131321,"rev_yoy":22.712684710041703,"rev_cum_yoy":11.497169970063258,"eps_q":0.16,"eps_year":"115","eps_season":"3","net_income":8798.0,"pe":349.44,"pb":1.3,"yield":1.59,"updated":"2026-11-27 02:23"},"tdcc":{"latest":{"date":"2026-11-20","big1000":18.22,"big400":34.38,"retail":28.18,"holders":29750},"prev":{"date":"2026-11-13","big1000":19.02,"big400":35.06,"retail":27.27,"holders":29356},"d_big1000":-0.8,"d_big400":-0.68,"d_retail":0.91,"d_holders":394},"weekly":{"bars":[{"time":"2026-07-27","open":18.2,"high":18.55,"low":16.25,"close":17.35,"volume":1633.6170000000002},{"time":"2026-08-03","open":17.25,"high":18.1,"low":17.25,"close":17.25,"volume":630.025},{"ti