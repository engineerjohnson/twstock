eign":-430.03,"trust":0.0,"dealer":71.14},{"date":"2026-11-02","foreign":350.062,"trust":0.0,"dealer":-13.008},{"date":"2026-10-30","foreign":-335.176,"trust":0.0,"dealer":6.959},{"date":"2026-10-29","foreign":-348.773,"trust":0.0,"dealer":-66.615},{"date":"2026-10-28","foreign":-125.416,"trust":0.0,"dealer":14.488},{"date":"2026-10-22","foreign":347.809,"trust":0.0,"dealer":28.643},{"date":"2026-10-21","foreign":-260.273,"trust":0.0,"dealer":52.653}],"news":[{"id":"cnyes6664066","source":"鉅亨網","category":"台股","title":"〈華紙法說〉前三季每股虧損1.04元 聚焦特殊用紙拚轉型","link":"https://news.cnyes.com/news/id/6664066","published":1794823916,"summary":"華紙(1905-TW)今(16)日召開法說會，總經理林谷豐指出，受到市場需求不振影響，加上木片價格上揚但國際漿價仍在低檔，花蓮廠因此計劃性調節產能因應，又因夏季能源成本墊高，拖累前三季稅後虧損11.5億元，每股虧損1.04元。林國豐表示，華紙將持續在本業進行轉型，並聚焦發展高毛利的特殊紙。 林谷豐表示，中國2025及2026兩年合計新增1600萬噸的紙漿產能，全中國產能近3000萬噸，且持續擴充中，產能擴張使得中國紙漿及紙品市場競爭更為激烈，整體中國紙業相當「內卷」，對於僅有30萬噸產能的華紙而言，壓力沈重。 林谷豐進一步表示，華紙規模相對較小，希望營運可以做到「小而美、小而精」，並持續調整營運方向、積極轉型，並聚焦特殊用紙開發。 林谷豐指出，目前特殊用紙占華紙營收比重約43至45%，文化用紙約占10%，希望未來提升高毛利的特殊用紙，以帶動本業營運。他補充特殊用紙涵蓋格拉新紙、膠帶、食品包裝袋(無氟防油紙)。 展望第四季與明年，林谷豐表示，先前減產的產能，已於11月恢復，且第四季將有出售觀音廠土地及建物給元太(8069-TW)的業外收益入帳，處分利益約13.3億元。至於明年，則將聚焦本業營運。","sentiment":-1,"tags":{"topics":["EPS/獲利","營收","擴產/資本支出","法說/展望"],"bull":[],"bear":["虧損"],"score":-2,"highlights":[],"keywords":["華紙","紙漿","造紙","特殊用紙","法說會"]},"time":"11/16 18:11"},{"id":"0976e7df4ca02346","source":"經濟日報-證券","category":"台股","title":"華紙觀音廠27億賣元太","link":"https://money.udn.com/money/story/5710/9877620","published":1794586026,"summary":"華紙（1905）昨（13）日公告，董事會通過以27.8億元出售桃園觀音廠全部土地及建物予元太科技，預計處分利益約13.3億元，將於今年第4季認列，可望挹注全年獲利。由於華紙前三季稅後淨損達11.50億元，這筆處分利益可望改善全年損益，為全年轉盈增添助力。","sentiment":0,"tags":{"topics":["EPS/獲利"],"bull":["獲利"],"bear":[],"score":1,"highlights":[],"keywords":[]},"time":"11/14 00:07"},{"id":"cnyes6661742","source":"鉅亨網","category":"台股","title":"華紙出售桃園觀音廠房與土地予元太 處分利益約13.3億元Q4認列","link":"https://news.cnyes.com/news/id/6661742","published":1794565638,"summary":"華紙(1905-TW)今(13)日召開重訊記者會宣布，董事會通過位於桃園觀音工業區的土地及廠房，出售給元太(8069-TW)。華紙指出，交易總金額約27.8億元，扣除相關成本與稅額後，實際處分利益約13.3億元，預計第四季認列。 華紙表示，此次出售的觀音廠區，此前已有部分區域由元太承租作為其生產據點。為活化公司資產、強化財務結構及營運綜效，董事會決議出售觀音廠全部土地及建物給元太，並於出售後回租部分廠房及土地使用。元太為華紙的關係人，本案採議價方式，價格參考專業不動產估價師事務所出具的估價報告。 總經理林谷豐補充，由於華紙仍有部分訂單需要完成生產，因此出售後將短期回租廠房，預計將持續生產至明年1月31日，之後廠房將完整出售。 林谷豐進一步表示，該廠房主要生產膠帶相關產品，出售後預估將影響約3%的產能，將評估未來是否將少部分產能移至高雄廠，整體而言對公司產能影響不大。 華紙提到，此次交易土地坐落於桃園市觀音區工業區段五小段 18-3 地號，面積約 7,973.63 坪，建物及附屬設備為同段 734-1 至 734-7 建號，面積約 9,938.30 坪。土地單價為每坪25.7萬元，建物交易金額 7.31億元，交易總金額為新台幣 27.8 億元(未稅)。","sentiment":0,"tags":{"topics":["訂單/接單","擴產/資本支出","匯率"],"bull":[],"bear":[],"score":0,"highlights":[],"keywords":["華紙","元太","出售廠房","造紙"]},"time":"11/13 18:27"}],"fund":{"code":"1905","rev_month":"11510","rev":1478847.0,"rev_mom":-2.7378926073150778,"rev_yoy":-2.900674644211356,"rev_cum_yoy":-3.1913766217067603,"eps_q":-1.04,"eps_year":"115","eps_season":"3","net_income":-1205239.0,"pe":null,"pb":0.67,"yield":null,"updated":"2026-11-20 19:27"},"tdcc":{"latest":{"date":"2026-11-13","big1000":68.71,"big400":71.14,"retail":12.79,"holders":69415},"prev":{"date":"2026-11-06","big1000":68.82,"big400":71.13,"retail":12.83,"holders":69624},"d_big1000":-0.11,"d_big400":0.01,"d_retail":-0.04,"d_holders":-209},"weekly":{"bars":[{"time":"2026-07-27","open":14.0,"high":14.0,"low":12.4,"close":12.65,"volume":14729.416000000001},{"time":"2026-08-03","open":12.55,"high":13.5,"low":12.45,"close":13.25,"volume":9965.534},{"time":"2026-08-10","open":13.3,"high":14.0,"low":13.15,"close":13.7,"volume":9963.638},{"time":"2026-08-17","open":13.55,"high":13.7,"low":13.0,"close":13.65,"volume":8328.005000000001},{"time":"2026-08-24","open":13.6,"high":13.8,"low":13.2,"close":13.7,"volume":6677.051},{"time":"2026-08-31","open":13.65,"high":14.1,"low":13.35,"close":13.5,"volume":9384.878},{"time":"2026-09-07","open":13.6,"high":13.6,"low":13.1,"close":13.2,"volume":6709.296},{"time":"2026-09-14","open":13.15,"high":13.5,"low":12.95,"close":13.25,"volume":9619.965},{"time":"2026-09-21","open":13.3,"high":13.3,"low":13.0,"close":13.1,"vol