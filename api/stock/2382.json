ics":["AI/半導體"],"bull":[],"bear":[],"score":0,"highlights":[],"keywords":[]},"time":"10/29 18:12"},{"id":"38a3305e1c8eeb01","source":"Yahoo股市-台股","category":"台股","title":"友達賣廠大轉折！台中廠賣台積電爆賺 廣達華亞廠案「這原因」破局","link":"https://tw.stock.yahoo.com/news/%E5%8F%8B%E9%81%94%E8%B3%A3%E5%BB%A0%E5%A4%A7%E8%BD%89%E6%8A%98-%E5%8F%B0%E4%B8%AD%E5%BB%A0%E8%B3%A3%E5%8F%B0%E7%A9%8D%E9%9B%BB%E7%88%86%E8%B3%BA-%E5%BB%A3%E9%81%94%E8%8F%AF%E4%BA%9E%E5%BB%A0%E6%A1%88-%E9%80%99%E5%8E%9F%E5%9B%A0-%E7%A0%B4%E5%B1%80-101224746.html","published":1793268744,"summary":"面板大廠友達（2409）賣廠兩樣情！友達今（29）日召開董事會，通過以388 億元處分台中二期廠房及附屬設施予台積電，預計可認列約185 億元處分利益；然而，原定以197億元將桃園華亞廠售予廣達（23","sentiment":0,"tags":{"topics":["AI/半導體"],"bull":[],"bear":[],"score":0,"highlights":[],"keywords":[]},"time":"10/29 18:12"},{"id":"02da2cb2d55f24d1","source":"Yahoo股市-台股","category":"台股","title":"友達台中二期廠388億元賣給台積電 處分利益估185億元","link":"https://tw.stock.yahoo.com/news/%E5%8F%8B%E9%81%94%E5%8F%B0%E4%B8%AD%E4%BA%8C%E6%9C%9F%E5%BB%A0388%E5%84%84%E5%85%83%E8%B3%A3%E7%B5%A6%E5%8F%B0%E7%A9%8D%E9%9B%BB-%E8%99%95%E5%88%86%E5%88%A9%E7%9B%8A%E4%BC%B0185%E5%84%84%E5%85%83-101128721.html","published":1793268688,"summary":"友達董事會通過出售台中廠二期廠房及附屬設施予台積電，交易金額388億元，估處分利益185億元。 另7月底通過的華亞廠出售案，因與廣達對使用規格、交付時程未達成協議，董事會決議終止。 彭双浪稱將聚焦輕資","sentiment":0,"tags":{"topics":["AI/半導體"],"bull":[],"bear":[],"score":0,"highlights":[],"keywords":[]},"time":"10/29 18:11"},{"id":"cnyes6640692","source":"鉅亨網","category":"台股","title":"友達台中二期廠388億元賣給台積電 處分利益估185億元","link":"https://news.cnyes.com/news/id/6640692","published":1793268688,"summary":"面板廠友達(2409-TW)今(29)日公告，董事會通過處分台中廠二期廠房及相關廠務附屬設施予台積電(2330-TW)，交易金額388億元，扣除相關交易費用及預估稅費後，處分利益估185億元。 另一方面，友達也公告，7月底董事會通過出售華亞廠予廣達電腦(2382-TW)的案件，因雙方對廠房使用規格及交付時程未能達成協議，董事會決議終止處分案，後續將持續尋找合適買家。 友達此次出售的台中二期廠區，包含一座五代廠及一座7.5代廠，交易標的為坐落於台中市西屯區的二期廠房及相關廠務附屬設施，權狀面積約12.98萬坪，使用面積約16.6萬坪。 友達董事長彭双浪表示，近年公司聚焦輕資產營運模式、活化資產及優化財務結構，陸續處分高雄廠、華亞廠、新加坡廠及台中廠區，透過資產活化調整資產配置，台中二期廠區此次出售予台積電，也是相關資產處分計畫的一環。 彭双浪指出，目前整體評估後，其餘廠房空間已達合適狀態，資產活化將告一段落，未來廠房處分回收資金將作為策略性及未來性投資用途，配合既有三大營運支柱及創新研究院的技術布局，兼顧短中期營運成長與長期技術競爭力。 友達今年持續推動組織調整，除既有三大營運支柱外，也成立創新研究院，布局AR眼鏡導光波導、低軌衛星天線、光通訊及半導體先進封裝等新技術領域，預期未來2至3年可望開始對整體營收產生較大貢獻。","sentiment":0,"tags":{"topics":["營收","AI/半導體"],"bull":[],"bear":[],"score":0,"highlights":[],"keywords":["友達","台積電","廣達","面板"]},"time":"10/29 18:11"},{"id":"63f1aa0a00588763","source":"鉅亨網","category":"台股","title":"研調估全球AI伺服器將突破250萬台 廣達、鴻海、緯穎擠進供應商前五名","link":"https://news.google.com/rss/articles/CBMiT0FVX3lxTE13SWtWOWtPY1ZacVByZEdwajZQMGNvb1Q1SHgwSTFyMXA5RlYzY25UejVqcDFDME1GTmhvWUljWl9NY2NacC1oUzAzTVUtR1k?oc=5","published":1793266810,"summary":"研調估全球AI伺服器將突破250萬台 廣達、鴻海、緯穎擠進供應商前五名 鉅亨網","sentiment":0,"tags":{"topics":["AI/半導體"],"bull":["突破"],"bear":[],"score":1,"highlights":[],"keywords":[]},"time":"10/29 17:40"}],"fund":{"code":"2382","rev_month":"11509","rev":325299509.0,"rev_mom":-23.27315755694308,"rev_yoy":76.68901002964485,"rev_cum_yoy":99.41108069855139,"eps_q":12.93,"eps_year":"115","eps_season":"2","net_income":50093575.0,"pe":13.86,"pb":5.03,"yield":4.91,"updated":"2026-10-30 16:33"},"tdcc":{"latest":{"date":"2026-10-22","big1000":81.28,"big400":84.81,"retail":8.04,"holders":281629},"prev":{"date":"2026-10-16","big1000":81.05,"big400":84.62,"retail":8.13,"holders":283947},"d_big1000":0.23,"d_big400":0.19,"d_retail":-0.09,"d_holders":-2318},"weekly":{"bars":[{"time":"2026-07-27","open":324.5,"high":326.5,"low":279.0,"close":291.5,"volume":177985.581},{"time":"2026-08-03","open":287.5,"high":310.5,"low":284.0,"close":298.0,"volume":104565.805},{"time":"2026-08-10","open":301.0,"high":336.5,"low":300.0,"close":327.5,"volume":131352.902},{"time":"2026-08-17","open":332.0,"high":339.0,"low":317.5,"close":321.5,"volume":83993.273},{"time":"2026-08-24","open":321.5,"high":339.0,"low":319.5,"close":332.5,"volume":56253.153000000006},{"time":"2026-08-31","open":329.5,"high":347.0,"low":326.0,"close":345.0,"volume":74330.86},{"time":"2026-09-07","open":350.0,"high":351.5,"low":328.0,"close":336.5,"volume":99807.564},{"time":"2026-09-14","open