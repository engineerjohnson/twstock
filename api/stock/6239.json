ust":116.0,"dealer":1574.382},{"date":"2026-10-05","foreign":-10753.842,"trust":150.0,"dealer":-434.537},{"date":"2026-10-02","foreign":746.632,"trust":18.591,"dealer":2033.488},{"date":"2026-10-01","foreign":-439.418,"trust":72.0,"dealer":259.448},{"date":"2026-09-30","foreign":1847.863,"trust":5.0,"dealer":377.81},{"date":"2026-09-29","foreign":-3711.572,"trust":27.0,"dealer":-52.176}],"news":[{"id":"454fb0b01a43599c","source":"經濟日報-證券","category":"台股","title":"AI封測景氣有多旺？ 它Q3毛利率衝45% AI ASIC、矽光子成新引擎","link":"https://money.udn.com/money/story/5607/9845358","published":1793369259,"summary":"受惠AI GPU、伺服器CPU、客製化ASIC等加持，先進封裝持續夯，台積電2026年資本支出提高至600億至640億美元，就是聚焦 2奈米先進製程、先進封裝CoWoS與SoIC，近期甚至傳出台積電CoWoS報價有新一波漲價，漲幅上看2成。日前輝達與京元電簽訂客戶預付款協議，AMD與後段封測大廠日月光投控、力成緊密合作，均可看出封測需求龐大，今年封裝大舉擴產，2027年業績增長可期。此外，日月光投控（3711）預期今年85億美元資本支出有望再上調，今年共有15座廠同時動工，但仍然趕不上需求，凸顯封測景氣不容小覷。包括日月光投控（3711）、京元電（2449）、矽格（6257）、欣銓（3264）、力成（6239）等績優股值得留意。","sentiment":1,"tags":{"topics":["EPS/獲利","擴產/資本支出","AI/半導體","總經/聯準會","匯率"],"bull":["擴產","漲價","合作","受惠"],"bear":[],"score":7,"highlights":[],"keywords":[]},"time":"10/30 22:07"},{"id":"cnyes6642111","source":"鉅亨網","category":"台股","title":"〈鴻海科技日〉劉揚偉：德州仍有擴建需求 TEEMA園區從供應鏈切入打造第三代科學園區","link":"https://news.cnyes.com/news/id/6642111","published":1793357220,"summary":"鴻海(2317-TW)今(30)日舉行科技日，董事長劉揚偉會後受訪時表示，鴻海目前在美國德州休士頓已有6棟廠房，且未來仍有持續擴建需求，將持續擴大當地布局。至於德州TEEMA(電電公會)園區，則希望從供應鏈開始切入，逐步打造涵蓋完整供應鏈的第三代科學園區。 劉揚偉指出，目前德州當地與AI相關的建置，多集中在Level 11及Level 12，相關供應鏈尚未真正進駐，因此TEEMA布局很可能從供應鏈開始。他希望將TEEMA打造成第三代科學園區，新竹為第一代、台南為第二代，德州則希望發展成具備完整生態系及供應鏈的園區，初期將以冷卻模組、線材連接器及印刷電路板(PCB)等基礎零組件切入，再進一步建構其他模組及系統。 除了美國市場，鴻海也持續擴大歐洲布局。劉揚偉表示，製造服務業未來將朝區域化發展，鴻海約5年前便認為區域化生產將成為趨勢，因此選擇波蘭作為歐洲樞紐，看好當地具備與台灣相似的靈活性及快速反應能力，加上人力成本及工作特質，成為布局考量。 劉揚偉進一步指出，鴻海在波蘭不打算採取傳統外商直接投資(FDI)模式，而是推動BOL（Build、Operate、Localize，建立、營運、在地化）模式，與當地夥伴EMP合作，共同建立、營運並在地化電動車業務，希望藉此協助波蘭逐步建立自己的電動車產業。","sentiment":1,"tags":{"topics":["AI/半導體"],"bull":["供應鏈","擴大","布局","進駐"],"bear":[],"score":4,"highlights":[],"keywords":["鴻海","劉揚偉","美國","德州","TEEMA","科學園區"]},"time":"10/30 18:47"},{"id":"cnyes6641174","source":"鉅亨網","category":"國際","title":"IT服務｜AI降價壓力告一段落 Cognizant財報透露產業下一步：從賣人力轉向包AI算力","link":"https://news.cnyes.com/news/id/6641174","published":1793286017,"summary":"2026年10月29日（優分析／產業數據中心報導）⸺ AI衝擊IT服務業的方式正在改變。美國IT服務大廠高知特Cognizant(CTSH-US)29日公布第3季財報，執行長Ravi Kumar表示，客戶因AI提高開發效率而要求重新議價的這一輪壓力，已大致消化完畢。新簽合約中，新業務與擴大既有業務的比重從約48%升到60%。不過，金融業以外的客戶仍在壓縮非必要支出，高知特同步下修全年財測，第4季有機成長只剩約2%。這顯示產業雖然走過最難熬的降價期，新需求還沒有擴散到多數產業。 高知特Cognizant(CTSH-US)為全球資訊科技與專業服務業者，總部位於美國紐澤西州，主要協助企業導入數位技術、改善營運流程及降低成本。服務涵蓋顧問諮詢、軟體開發、系統整合、雲端基礎設施、資安及業務流程委外，並積極布局AI與自動化，協助客戶提升作業效率與顧客體驗。客戶遍及金融、醫療與生命科學、製造、零售、能源及科技等產業，業務涵蓋北美、歐洲及其他國際市場。 生產力重新議價告一段落 新業務比重升到6成 過去兩年，生成式AI讓寫程式、測試、維運的效率大幅提高，客戶在續約時紛紛要求把省下的人力成本反映在價格上，IT服務業的營收被壓縮。Kumar先前表示，高知特約一半的合約已依生產力提升重新訂價。","sentiment":-1,"tags":{"topics":["營收","法說/展望","AI/半導體"],"bull":["擴大"],"bear":["下修"],"score":-2,"highlights":[],"keywords":["SaaS","AI推論","優分析"]},"time":"10/29 23:00"},{"id":"cnyes6640544","source":"鉅亨網","category":"國際","title":"AI投資風險藏在哪？私募信貸估值慢半拍，贖回壓力成考驗","link":"https://news.cnyes.com/news/id/6640544","published":1793259005,"summary":"2026年10月29日（優分析／產業數據中心報導）⸺ AI基礎建設大量仰賴私募信貸融資，但這些貸款缺乏公開交易價格，風險可能累積了，帳面價值卻尚未反映。投資顧問Altaf Kassam在評論中指出，投資人除了關心AI能否回本，也要留意資產估值更新落後，以及資金撤出時可能浮現的損失。 這類融資規模已不容忽視。經濟合作暨發展組織(OECD)估計，2025年AI相關交易占全球私募信貸交易的34%，為過去五年平均的兩倍；英格蘭銀行則預估，2026至2028年間，約7,000億美元的資料中心支出將由私募信貸支應。 問題在於，私募貸款通常由基金經理人按季估值，依據預期現金流與類似交易推算，調整速度往往慢於市場。帳面波動較小，未必代表風險較低。尤其資料中心約七成成本來自晶片與設備，一旦租金下降或設備加速淘汰，以晶片作為擔保的貸款，保障程度也可能減弱。 贖回機制可能進一步放大壓力。假設基金帳面仍將貸款估為100元，市場買家卻只願出90元，先贖回的投資人可能按較高淨值離場，差額則留給其他持有人承擔。大型資料中心融資業者Blue Owl Capital(OWL-US)今年已兩度因贖回需求旺盛，將旗下私募信貸基金的贖回比例限制在5%。 Kassam認為，長期封閉型資金可以等待貸款到期，但提供定期贖回的基金，更需要讓估值及時反映風險。","sentiment":0,"tags":{"topics":["AI/半導體","匯率","金融"],"bull":["合作"],"bear":[],"score":1,"highlights":[],"keywords":["私募信貸","優分析"]},"time":"10/29 15:30"},{"id":"16926532ebfebefa","source":"Yahoo股市-國際","category":"國際","title":"美股該等期中選舉後再買？ 凱基證券：投資紀律比找買點更重要","link":"https://tw.stock.yahoo.com/news/%E7%BE%8E%E8%82%A1%E8%A9%B2%E7%AD%89%E6%9C%9F%E4%B8%AD%E9%81%B8%E8%88%89%E5%BE%8C%E5%86%8D%E8%B2%B7-%E5%87%B1%E5%9F%BA%E8%AD%89%E5%88%B8-%E6%8A%95%E8%B3%87%E7%B4%80%E5%BE%8B%E6%AF%94%E6%89%BE%E8%B2%B7%E9%BB%9E%E6%9B%B4%E9%87%8D%E8%A6%81-063617882.html","published":1793255777,"summary":"財經中心/綜合報導美國期中選舉將於11月3日登場，選前利率動向與科技企業財報接力成為市場焦點，政策、利率及AI產業前景持續牽動台美股行情。面對市場波動，不少投資人猶豫「美股該等選後再買嗎？資金有限也能","sentiment":0,"tags":{"topics":["法說/展望","AI/半導體","總經/聯準會","美股/國際","金融"],"bull":[],"bear":[],"score":0,"highlights":[],"keywords":[]},"time":"10/29 14:36"},{"id":"cnyes6640477","source":"鉅亨網","category":"台股","title":"兩大陰影壟罩華爾街！？加權指數上沖下洗！現在是該恐懼還是貪婪？","link":"https://news.cnyes.com/news/id/6640477","published":1793253268,"summary":"高盛近期的報告顯示，按照標普500指數的長期歷史趨勢，2026年標普500指數的EPS為261美元，但實際預估可達326美元。1995年時，美股企業的淨利潤率僅約6%，至2026年時高達13%，並且本波美股企業淨利潤率的高成長，來自於AI產業的爆發。 標普500指數與那斯達克指數分別在10月初創下歷史新高，也基本反應美國企業的獲利成長，標普500指數今年至昨日(10/28)漲幅約13%，本益比與遠期本益比卻從去年底分別28倍及21.3倍，降至25.9倍及19倍。 根據市場機構統計，AI供應鏈佔標普500指數成分股的權重約50%，佔那斯達克指數成分股的權重則超過70%，那斯達克指數今年至昨日(10/28)漲幅約14%，本益比與遠期本益比卻從去年底分別約35倍及25.4倍，降至約28倍及20倍。那斯達克指數漲幅略高於標普500指數，本益比與遠期本益比降幅卻高於標普500指數，主因是高速成長的AI產業鏈於那斯達克指數權重較高。 更多的投資策略與選股資訊都在－ LINE@ https://user225916.pse.is/money668 頻道連結 https://www.youtube.com/@money66868 如果依照2025年底的本益比計算，標普500指數應該在8300點上下(10/28收7738點)；那斯達克指數應該在31400點上下(10/28收26549點)。","sentiment":1,"tags":{"topics":["EPS/獲利","AI/半導體","匯率","美股/國際"],"bull":["新高","獲利","成長"],"bear":[],"score":3,"highlights":[],"keywords":["葉俊敏","台積電","鴻海","欣興","日月光","臻鼎-KY","國巨","京元電"]},"time":"10/29 13:54"},{"id":"cnyes6640478","source":"鉅亨網","category":"台股","title":"《價值型投資 最新產業研究報告》穩懋 (3105-TW) 衛星需求帶動獲利改善，光通訊接收元件開始放量","link":"https://news.cnyes.com/news/id/6640478","published":1793253173,"summary":"今天大盤又向下震盪，一度重挫，但 穩懋 (3105-TW) 連兩天亮燈漲停，還有續航力嗎？一起來研究。昨天法說帶出的變化，是衛星、航太與光通訊業務逐漸擴大，基礎建設與光學產品合計營收占比已超過一半，公司的獲利結構也跟著改變。 過去提到 穩懋 (3105-TW) ，大家比較熟悉手機功率放大器，也就是幫手機把無線訊號放大、傳出去的晶片。公司替客戶代工的砷化鎵、氮化鎵等化合物半導體，適合用在高頻通訊，現在應用已延伸到衛星和資料中心。客戶對頻率、功率的要求提高，需要配合的製程也更複雜，長期累積的代工經驗就能用在新產品上。 第三季每股盈餘4.55元，較前季明顯增加；合併毛利率回升到37.4%。背後有產能利用率提高，以及高毛利基礎建設產品比重增加的幫助。這季獲利也包含轉投資收益，本業改善則可從毛利率看出來。工廠原本就要負擔設備與人力成本，產出增加、產品組合變好，留下來的利潤就跟著提高。 衛星是這季成長最明顯的一塊。低軌衛星持續發射，新一代規格導入後，衛星與地面之間收發訊號所需的元件也跟著升級。 穩懋 (3105-TW) 能承接發射端的功率放大器，以及接收微弱訊號時使用的低雜訊放大器等產品。這些需求涵蓋太空端與地面設備，並有不同客戶投入量產，公司已把長期的高頻製程布局轉成實際出貨。 光通訊則先看接收端。光偵測器會把光纖傳來的光訊號轉成電訊號，讓後面的晶片能讀取資料。","sentiment":1,"tags":{"topics":["EPS/獲利","營收","擴產/資本支出","法說/展望","AI/半導體","總經/聯準會"],"bull":["漲停","獲利","放量","擴大"],"bear":["重挫"],"score":3,"highlights":[],"keywords":["蔡慶龍","價值型投資","穩懋 (3105-TW)","低軌衛星","航太","光通訊","光偵測器","趨勢分析"]},"time":"10/29 13:52"},{"id":"cnyes6639516","source":"鉅亨網","category":"美股","title":"Fed 10月、9月聲明比一比：將「等待更多資訊」判斷下次行動、2人主張升息1碼","link":"https://news.cnyes.com/news/id/6639516","published":1793212609,"summary":"美國聯準會(Fed)結束為期兩天的政策會議後，於台灣時間周四(29日)凌晨2時公布利率決策，聯邦基金利率目標區間維持在3.75-4.00%，符合市場預期。以下是Fed 10月會議聲明，與上一次9月會議聲明相比的措詞差異： 10月決策聲明全文 聯邦公開市場委員會(FOMC) 以10票對2票 批准發布以下聲明： 「9月啟動三年來首度升息時，是12票全數通過。」 委員會決定將聯邦資金利率目標區間 維持在3.75%-4.00% ，以支持聯準會的雙重使命。委員會延續維持銀行體系充裕準備金的政策。 「9月聲明寫道：委員會決定將聯邦資金利率目標區間調升0.25個百分點至3.75%-4.00%。」 經濟活動正以強勁步調擴張。 雖然部分受到地緣政治局勢發展影響，不確定性仍居高不下，但國內支出一直展現韌性。生產力成長強勁，資本投資也相當穩健。就業成長與勞動力保持同步，失業率變化不大。 「9月聲明寫道：經濟活動正以穩健(solid)步調擴張，兩相比較，10月聲明中的強勁(strong)，措辭更正面。」 通膨依然居高不下。 隨著掌握更多資訊，聯邦公開市場委員會(FOMC)將能進一步判斷適當的政策立場， 以確保通膨及時回落至委員會判定的2%目標。委員會將實現物價穩定。 「9月聲明寫道：....今日的政策行動將有助於委員會更及時回落至委員會判定的2%目標。","sentiment":0,"tags":{"topics":["總經/聯準會","關稅/地緣","金融"],"bull":[],"bear":["升息"],"score":-1,"highlights":[],"keywords":["Fed","聯準會","聲明比一比","華許","利率","通膨","就業","升息"]},"time":"10/29 02:36"},{"id":"cnyes6639515","source":"鉅亨網","category":"美股","title":"Fed 10月會議聲明全文","link":"https://news.cnyes.com/news/id/6639515","published":1793211513,"summary":"美國聯準會(Fed)結束為期兩天的政策會議後，於台灣時間周四(29日)凌晨2時公布利率決策，聯邦基金利率目標區間維持在3.75-4.00%，符合市場預期。以下是10月會議聲明全文。 聯邦公開市場委員會(FOMC)以 10票對2票 批准發布以下聲明： 委員會決定將聯邦資金利率目標區間維持在3.75%-4.00%，以支持聯準會的雙重使命。委員會延續維持銀行體系充裕準備金的政策。 經濟活動正以強勁步調擴張。雖然部分受到地緣政治局勢發展影響，不確定性仍居高不下，但國內支出一直展現韌性。生產力成長強勁，資本投資也相當穩健。就業成長與勞動力保持同步，失業率變化不大。 通膨依然居高不下。 隨著掌握更多資訊，聯邦公開市場委員會(FOMC)將能進一步判斷適當的政策立場 ，以確保通膨及時回落至委員會判定的2%目標。委員會將實現物價穩定。 反對貨幣政策行動的是庫克(Lisa D. Coo