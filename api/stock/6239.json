aler":204.262},{"date":"2026-11-05","foreign":-2383.278,"trust":189.392,"dealer":-160.299},{"date":"2026-11-04","foreign":-1075.568,"trust":360.392,"dealer":142.415},{"date":"2026-11-03","foreign":-1842.312,"trust":427.196,"dealer":-462.255},{"date":"2026-11-02","foreign":-187.008,"trust":258.071,"dealer":179.663}],"news":[{"id":"cnyes6673829","source":"鉅亨網","category":"台股","title":"〈智邦法說〉AI重點筆記2026/11/27","link":"https://news.cnyes.com/news/id/6673829","published":1795767920,"summary":"一、 2026 年第三季財務與營運詳情 財務表現： 營收與獲利： 第三季營收達新台幣 1,207.4 億元，季增 26%；累計前三季營收達 2,864 億元，年增 62%（以美元計，2026 年 1 至 10 月營收已達約 104 億美元，超越 2025 全年之 80.3 億美元）。 第三季毛利率為 17.6%，季減 2.1 個百分點；前三季毛利率則年增 0.6 個百分點，主要受產品組合影響。第三季營業費用為 51 億元，季增 15%，前三季營業費用年增 49%，主因為人力成本與研發費用增加。第三季營業利益率為 13.3%，季減 1.7 個百分點。 第三季稅後淨利為 130 億元，每股盈餘（EPS）為 23.39 元；累計前三季稅後淨利約 10.2 億美元，EPS 達 58.09 元。 產負債與營運指標： 截至第三季末，現金餘額為 356 億元；存貨金額達 896 億元，季增 39%，主要因應未來訂單增加成品及原料備貨（包含成品 428 億元、原料 382 億元）。負債比率為 64.11%；現金週轉天數較第二季增加 6.95 天至 33.03 天，主因為應付帳款（AP）週轉天數減少。","sentiment":1,"tags":{"topics":["訂單/接單","EPS/獲利","營收","法說/展望","AI/半導體","總經/聯準會","匯率"],"bull":["獲利","年增"],"bear":[],"score":2,"highlights":["年增 62%","年增 49%","EPS）為 23.39 元"],"keywords":["智邦","AI","網通"]},"time":"11/27 16:25"},{"id":"cnyes6672045","source":"鉅亨網","category":"美股","title":"〈SemiAnalysis報告解析〉AI加速器需求與出貨預測大降！輝達受衝擊最大 博通相對抗跌","link":"https://news.cnyes.com/news/id/6672045","published":1795663208,"summary":"SemiAnalysis大幅下修全球AI加速器需求、出貨量及資本支出預測，認為市場此前對AI基礎設施擴張速度過於樂觀。這次調整不僅涉及晶片出貨量，也包括平均售價 (ASP)、高頻寬記憶體 (HBM) 需求及資料中心電力消耗。 報告指出，前沿AI實驗室營收成長放緩、資本市場融資條件收緊，以及美國資料中心建設延遲，是此次下修的主要原因。其中，輝達受到的衝擊最大，博通相對抗跌，聯發科部分TPU專案則面臨融資壓力。 一、AI基礎設施投資降溫，三大因素迫使預測下修 SemiAnalysis認為，前沿AI實驗室的新增營收成長正在放緩。研究團隊重新評估整個AI生態系的Token收入預期，尤其注意到多家前沿AI實驗室第三季淨新增年化經常性收入 (ARR) 成長減速，因此下修新增算力供給的估計，讓新增營收更能持續負擔整體算力成本。 不過，SemiAnalysis對這些AI實驗室的營收前景仍比市場共識樂觀，並認為前沿AI技術仍有許多可以落地、創造高投資報酬率的應用場景。真正的問題在於，AI基礎設施建設能否取得足夠融資，並不只取決於長期需求，也取決於資本市場投資人的信心。 第二個因素是資本市場融資條件收緊。債權與股權投資人都更加謹慎，不願再像先前一樣積極投入AI基礎設施資本支出，尤其是沒有大型雲端服務商承諾採購的資料中心專案。","sentiment":0,"tags":{"topics":["營收","擴產/資本支出","AI/半導體"],"bull":["成長","出貨"],"bear":["下修"],"score":-1,"highlights":[],"keywords":["加速器","資本支出","semianalysis","輝達","AI"]},"time":"11/26 11:20"},{"id":"cnyes6671646","source":"鉅亨網","category":"美股","title":"破發之後 Anthropic仍面臨多項營運挑戰","link":"https://news.cnyes.com/news/id/6671646","published":1795594205,"summary":"人工智慧(AI)模型開發商 Anthropic (ANT-US) 上周IPO，發行價為每股 83 美元，掛牌首日開盤價大漲 34%，公開募資規模達 935 億美元，加計同步進行的 260 億美元私募配售，創下全球科技業歷史性融資紀錄。然而，市場熱情迅速冷卻，在上市第四個交易日(24日)，Anthropic 收盤價跌至 81.91 美元，跌破發行價。 截至 2026 年 9 月，Anthropic 帳面上持有 956 億美元現金與現金等價物，以及 363 億美元短期投資；截至 2026 年 10 月，其年化營收跑率已達 810 億美元，2026 年前九個月營收同比暴增 1,206% 至 332 億美元。 然而，股價破發警訊凸顯出公開市場對其資本支出與獲利可持續性展開嚴苛審視， 分析師指出，Anthropic 財務長Krishna Rao與執行長Dario Amodei正面臨幾大核心營運與財務挑戰。 挑戰一：營業利潤穩定性與高昂算力成本 Anthropic 於 2026 年第二季曾實現 9.74 億美元營業利潤，但到了第三季，儘管單季營收衝高至接近 170 億美元(季增 47%)，公司卻錄得 5.67 億美元營業虧損。虧損主因在於算力與基礎設施支出單季暴增 43 億美元，加上員工股權配捐計劃記入約 20 億美元非現金費用。","sentiment":0,"tags":{"topics":["EPS/獲利","營收","擴產/資本支出","AI/半導體","匯率"],"bull":["大漲"],"bear":["跌破"],"score":0,"highlights":[],"keywords":["Anthropic","營運挑戰","破發","營業利潤","算力承諾","監管風險","AI"]},"time":"11/25 16:10"},{"id":"cnyes6671263","source":"鉅亨網","category":"美股","title":"Anthropic創史上最大IPO紀錄！募資1073億美元 AI估值邏輯轉向獲利與現金流","link":"https://news.cnyes.com/news/id/6671263","published":1795572607,"summary":"人工智慧新創Anthropic於11月19日正式登陸納斯達克，股票代碼為「ANT」，每股發行價定為83美元，高於原定70至78美元發行區間上限約6.4%。由於市場認購需求強勁，公司將發行規模由8.25億股擴大至9.8億股，公開發售募資約813.4億美元。 此外，Anthropic(ANT-US)同步透過私募方式，向Alphabet (GOOGL-US)、輝達 (NVDA-US)、超微 (AMD-US)、博通 (AVGO-US)、美光 (MU-US)、微軟 (MSFT-US)及台積電 (TSM-US)等7家科技巨頭發行N類無投票權股票，合計募資260億美元。兩項交易總募資約1,073億美元，超越SpaceX(SPCX-US)於當年6月創下的紀錄，成為有史以來規模最大的IPO。 Anthropic上市首日股價大幅上漲，引發市場對AI企業估值的高度關注。不過，這場IPO更重要的意義，在於AI基礎模型公司正式進入二級市場定價體系，投資人不再只為模型參數、產業排名與融資故事買單，而是開始檢視企業能否持續獲利、公益型治理能否兼顧資本回報與AI安全，以及算力成本、同質化競爭和監管合規將如何影響商業模式。 Anthropic的故事始於2021年。","sentiment":1,"tags":{"topics":["EPS/獲利","AI/半導體","匯率"],"bull":["需求強勁","獲利","認購","擴大"],"bear":[],"score":5,"highlights":[],"keywords":["api","openai","ipo","現金流","科技","上市","AI","美股"]},"time":"11/25 10:10"},{"id":"cnyes6670812","source":"鉅亨網","category":"台股","title":"台股史詩級噴漲3300點 國泰證期提醒風險是降低並非消除","link":"https://news.cnyes.com/news/id/6670812","published":1795491066,"summary":"輝達執行長黃仁勳事件一波三折，大轉折回歸輝達激勵美股和台股狂噴，國泰證期研究部今(24)日指出，此有利降低AI長期戰略改變的不確定性，並降低重要客戶與供應鏈的疑慮，不過，仍要提醒投資人「降低風險，不是消除風險」，出口管制和公司治理調查並未因其回任而自動解除。 國泰證期研究部分析，輝達過去透過CUDA、GPU、CPU、NVLink和網通系統的整合建立競爭優勢，在黃仁勳回歸下，有助維持既有的一體化戰略，並降低產品更新迭代放緩疑慮。 其次，黃仁勳與雲端巨頭、供應商的長期合作關係，是輝達重要競爭資產，回歸有助於穩定合作預期，尤其針對Neocloud的支持。 不過，國泰證期提醒，出口管制和公司治理調查並未自動解除，且監管以及金融環境造成融資成本過高問題仍存在。 因此，在市場信心初步恢復下，未來觀察重點將放在政策以及金融面對AI產業的影響，以目前來看，資料中心須自己負擔電力成本並改善能源效率是最可能情境。 另外，在GPU可能放緩下，預估ASIC將是潛在受惠者，但以結論來看，ASIC的成長趨勢原本就在，不必非得建立在看壞輝達的前提上，當推論需求持續成長時，ASIC可針對特定運算與記憶體存取模式進行最佳化，提供更低的TCO本身就為其優勢。","sentiment":0,"tags":{"topics":["AI/半導體","關稅/地緣","美股/國際"],"bull":["供應鏈"],"bear":["調查"],"score":0,"highlights":[],"keywords":["國泰證","台股","黃仁勳","輝達"]},"time":"11/24 11:31"},{"id":"cnyes6669682","source":"鉅亨網","category":"美股","title":"月之暗面傳取消輝達B300印尼租約 阿里騰訊表態轉用國產晶片","link":"https://news.cnyes.com/news/id/6669682","published":1795227604,"summary":"《The Information》19日引述知情人士報導，中國AI新創月之暗面已終止價值1.5億美元的印尼雲端合約，並停止新協議洽談。 月之暗面(Moonshot AI)是中國AI明星新創，開發Kimi智慧助手，被視為中國AI產業代表企業之一；外電報導其正拆除VIE架構、衝刺港股IPO，估值已升至500億美元。 報導指出，月之暗面原訂明年起在印尼租用基於輝達(NVDA-US)Blackwell Ultra B300的算力服務；B300被禁止出口中國，租用海外算力成為繞道取得先進晶片能力的管道。 為確保供應，月之暗面據報同意預付50%款項，超過市場慣例15%的三倍，顯示中國AI公司取得海外算力的急迫性；取消與金額細節尚未獲公司公開證實。 美國商務部16日宣布運算服務同樣納入出口許可要求，規則19日生效；背景是美方懷疑中國透過新加坡等地的資料中心，繞道取得受管制的美國晶片。 美國國會對中施壓同步升溫。眾院外交委員會主席Mast公布輝達與AMD去年12月至今年5月的出口許可申請紀錄：申請約344萬顆，核准879,868顆。 核准名單包括騰訊關係企業15萬顆、阿里巴巴(BABA-US)7.5萬顆、百度(BIDU-US)4.3萬顆；報導指出，部分買家被美國國防部認定為中國軍工企業。","sentiment":0,"tags":{"topics":["AI/半導體","匯率"],"bull":[],"bear":[],"score":0,"highlights":[],"keywords":["輝達","騰訊","阿里巴巴","百度","月之暗面","晶片","AI","印尼"]},"time":"11/21 10:20"},{"id":"cnyes6667802","source":"鉅亨網","category":"台股","title":"Anthropic今拚1.4兆美元估值IPO！AI步入「變現」期 投信點名資金流向這關鍵","link":"https://news.cnyes.com/news/id/6667802","published":1795086697,"summary":"全球 AI 產業迎來資本市場重要里程碑，Claude 開發商 Anthropic 預計於美國時間 11 月 19 日在那斯達克掛牌，股票代號 ANT，目標估值最高達 1.4 兆美元，IPO 與同步私募合計募資規模上看 904 億美元。隨著 AI 正式邁入算力變現時代，市場焦點轉向商業化獲利能力，FT核心AI電力算力 (009831-TW) 經理人江明鴻指出，投資不應單押晶片股，更須全方位布局電力、算力與軟體商機。 這場備受矚目的上市案，不僅考驗華爾街對 AI 產業的長期信心，也象徵市場評估標準正從單純的晶片效能與算力建設，逐漸轉向企業實際付費意願、營收成長動能及商業化獲利能力。 根據 Anthropic 最新公布的招股文件顯示，該公司第 3 季營收達 169.56 億美元，較前一季大幅成長約 47%，展現強勁的營收擴張速度。不過，受制於龐大的算力採購承諾與持續擴張的資本支出，公司目前仍處於虧損階段，也讓投資人開始審慎思考 AI 企業將高速成長轉化為穩定現金流的時間表。 009831 經理人江明鴻表示，Anthropic 上市的重要意義，不只是資本市場再添一家 AI 巨頭，更代表大型語言模型的商業模式正式開始接受公開市場嚴格檢驗。過去 AI 投資高度集中於晶片、伺服器及資料中心硬體建設，未來則須密切觀察企業是否願意持續付費、AI 服務使用量能否擴大，以及算力成本下降能否帶動獲利改善。","sentiment":1,"tags":{"topics":["EPS/獲利","營收","擴產/資本支出","法人動向","AI/半導體","匯率","美股/國際"],"bull":["獲利","布局"],"bear":[],"score":2,"highlights":[],"keywords":["Anthropic","IPO","AI算力","009831","電力基建","Claude","華爾街","AI變現"]},"time":"11/19 19:11"},{"id":"eeaacc8c87f16153","source":"富聯網","category":"台股","title":"《投信買超7-3》力成(767)、華航(754)、可成(742)","link":"https://news.google.com/rss/articles/CBMiiAFBVV95cUxNZVlXV013Uzg0XzdKaXRXYk5kM18zby1IR0s0MzRPOE5XaU5SQ0IyOVBfY0ZlYVRRT0xLcy1uVDVoT3BOZDhrUmdrbjhDMTJaaVY3eTRDdWRWTVFIVWo2VzZwUWQ3T2pwUFE3R09zQk1Zdkc5SERMMjFra2NPcjlvSjRJeDlCWENu?oc=5","published":1795075440,"summary":"《投信買超7-3》力成(767)、華航(754)、可成(742) 富聯網","sentiment":1,"tags":{"topics":["法人動向"],"bull":["買超"],"bear":[],"score":2,"highlights":[],"keywords":[]},"time":"11/19 16:04"},{"id":"cnyes6665659","source":"鉅亨網","category":"國際","title":"《紐時》：黃仁勳閃辭後家族勢力成隱憂 長女黃敏珊被指逼走多名資深主管","link":"https://news.cnyes.com/news/id/6665659","published":1794970208,"summary":"輝達 (Nvidia) 創辦人黃仁勳上週因婚外情風波請辭執行長。事件牽涉輝達客戶的一名高層，此人據報與中國情報單位有關，引發科技界震盪。隨著財務長克雷斯 (Colette Kress) 接任代理執行長，黃仁勳長女黃敏珊 (Madison Huang) 及其他家族成員的去留與權責，成為輝達新領導層面臨的難題。 《紐約時報》引述十多名現任及前任員工說法指出，長期扮演父親「實質幕僚長」的黃敏珊作風強勢，曾當眾對多名高層大吼，也被指與十多名主管離職有關。 越級斥責高層 被指逼走多名資深主管 現年 35 歲的黃敏珊，正式職稱為實體 AI 產品行銷資深總監。在黃仁勳辭職前，她能直接向董事會簡報、參與高階主管季度會議，也主導公司的行銷與公關策略。多名知情人士透露，黃敏珊的脾氣與父親相似。黃仁勳過去甚至曾半開玩笑地對員工說，若不聽話，就要「放生氣的敏珊去咬人」。一些高層因忌憚她與執行長的關係，不敢提出異議。 今年 2 月，黃仁勳原定出席印度新德里一場會議，臨時改派長期得力助手普里 (Jay Puri) 代為出席。會前的線上籌備會議中，黃敏珊因不滿團隊準備不足，對包括普里在內的員工大聲斥責。普里打斷她說：「只要妳停止對我大吼，我就能回答問題。」不到半年後，普里離開原職務。 去年底的一場行銷團隊會議中，一名副總裁據稱在遭黃敏珊當眾斥責後恐慌發作，被迫中途退出會議。","sentiment":0,"tags":{"topics":["AI/半導體"],"bull":["強勢"],"bear":[],"score":1,"highlights":[],"keywords":["婚外情","公關","黃仁勳","輝達","AI"]},"time":"11/18 10:50"},{"id":"cnyes6665393","source":"鉅亨網","category":"台股","title":"鉅亨速報 - Factset 最新調查：力成(6239-TW)目標價調降至320元，幅度約5.88%","link":"https://news.cnyes.com/news/id/6665393","published":1794917422,"summary":"根據FactSet最新調查，共7位分析師，對力成(6239-TW)提出目標價估值：中位數由340元下修至320元，調降幅度5.88%。其中最高估值500元，最低估值280元。 綜合評級 - 共有7位分析師給予力成(6239-TW)評價：積極樂觀6位、保持中立1位、保守悲觀0位。 力成(6239-TW)今(17日)收盤價為214.5元。近5日股價下跌6.74%，相關半導體業近5日下跌5.63%，集中市場加權指數下跌6.13%，股價波動與大盤表現同步。 資料來源：Factset，數據僅供參考，不作為投資建議。","sentiment":-1,"tags":{"topics":["AI/半導體"],"bull":["目標價"],"bear":["下修","調降","調查"],"score":-5,"highlights":["目標價調降至320元","目標價估值：中位數由340元"],"keywords":["台股","市場預估","目標價"]},"time":"11/17 20:10"},{"id":"cnyes6664826","source":"鉅亨網","category":"總經","title":"讓同事搶代班！3大育兒補助明年元旦上路 職代日領800元津貼、接送小孩免請假","link":"https://news.cnyes.com/news/id/6664826","published":1794909302,"summary":"化解育兒勞工請假造成的職場摩擦，勞動部今(17)日發布友善職場育兒彈性工作安排措施獎勵及補助要點，自2027年1月1日起正式實施。新制推出減工時薪資、職務代理津貼與新聘替代人力等3大補助，並加碼5項友善制度獎勵，讓育兒家長每日減工時1小時不扣薪，代班同事也能獲得實質津貼回饋。 勞動部表示，立法院於11月13日三讀通過性別平等工作法與就業保險法修正案，涵蓋產假陪產假延長、育兒照顧至8歲及育兒留停津貼6加3等重點。考量9至12歲國小學童仍有接送等彈性照顧需求，勞動部特別將育兒彈性減工時補助延伸至12歲，協助家長兼顧職場與家庭。 針對受僱者在婚孕產育階段請假或留職停薪，勞動部推動補助企業職代及替代人力成本，降低育兒勞工對同事的愧疚感。透過政府補貼企業增加的用人成本，讓育兒勞工能放心請假、職務代理勞工增加實質收入，同時減輕企業人力調度負擔，創造勞工、同事與雇主三贏的友善職場環境。 在3大補助措施方面，只要雇主實際給付工資或津貼即可申請。首先是育兒減少工作時間薪資補助，企業同意撫育未滿12歲子女的員工每日減少至少1小時工時且薪資照給，只要每月實施至少10日、累計3個月且總時數達30小時，政府便依實際照給薪資補助，每名員工每年最高4.5萬元，每家企業上限135萬元。","sentiment":1,"tags":{"topics":["金融"],"bull":["加碼"],"bear":[],"score":2,"highlights":[],"keywords":["勞動部","友善","獎勵","育兒","補助","津貼","育兒補助","代班津貼"]},"time":"11/17 17:55"},{"id":"cnyes6664674","source":"鉅亨網","category":"美股","title":"矽谷掀併購潮！最先進的AI公司盯上傳統生意 親自下場經營律師會計稅務等領域","link":"https://news.cnyes.com/news/id/6664674","published":1794890407,"summary":"過去20年，軟體行業最成功的商業模式，莫過於向傳統企業出售工具、透過提升客戶經營效率賺取訂閱費，但如今矽谷吹起一股新風向。最先進的AI創業公司不再滿足於單純售賣軟件，而是直接收購律所、會計師事務所、保險代理機構，甚至物業管理公司，親自下場經營傳統服務業務。 根據不完全統計，全球已有32家AI相關企業收購或直接經營傳服務業務，其中會計稅務領域最多，達到9家，法律服務5家，保險、客服和物業管理各3家。這些企業雖分佈於不同行業，商業邏輯卻高度一致：從出售AI工具，轉向直接經營傳統服務業務，爭奪更大的市場與利潤空間。 根據紅杉資本今年3月研究，企業每花1美元購買軟體，大約還會花6美元購買人力服務。換言之，AI軟體公司過去爭奪的僅是企業整體服務支出的一小部分。若能直接經營法律服務等業務，AI公司便可將原本屬於律所的服務收入囊中，同時把節省下來的人力成本轉化為自身利潤。 實例證明這條路確實能在短期內迅速擴張。美國AI法律公司Eudia去年初年度經常性收入(ARR)僅200萬美元，在陸續收購兩家法律服務企業後，去年12月ARR已突破2000萬美元，一年擴大十倍。 客服公司Crescendo收購外包商PartnerHero後，將AI引入原有業務，須轉交人工處理的諮詢減少七成以上，部分完成AI改造業務的毛利率更超過六成，遠高於傳統客服外包行業15%至25%的水平。","sentiment":0,"tags":{"topics":["EPS/獲利","AI/半導體","總經/聯準會","匯率","金融"],"bull":[],"bear":[],"score":0,"highlights":[],"keywords":["併購","矽谷","AI企業","法律","會計師","物業管理","AI軟體公司","銀行業"]},"time":"11/17 12:40"},{"id":"0d27aeb5271fb7f2","source":"Yahoo股市-國際","category":"國際","title":"四大因素恐加劇貨櫃船市場運力過剩 明年運價面臨下跌壓力","link":"https://tw.news.yahoo.com/%E5%9B%9B%E5%A4%A7%E5%9B%A0%E7%B4%A0%E6%81%90%E5%8A%A0%E5%8A%87%E8%B2%A8%E6%AB%83%E8%88%B9%E5%B8%82%E5%A0%B4%E9%81%8B%E5%8A%9B%E9%81%8E%E5%89%A9-%E6%98%8E%E5%B9%B4%E9%81%8B%E5%83%B9%E9%9D%A2%E8%87%A8%E4%B8%8B%E8%B7%8C%E5%A3%93%E5%8A%9B-104242425.html","published":1794739362,"summary":"根據中國大陸相關單位引述，Drewry、Xeneta等國際航運分析機構指出，受到全球貨櫃運輸需求與船隊運力成長速度差距擴大、紅海航線恢復通行、空班及拆船調節效果有限及大型航商持續競爭性訂造新船等四大因","sentiment":1,"tags":{"topics":["航運/傳產"],"bull":["成長","擴大"],"bear":[],"score":2,"highlights":[],"keywords":[]},"time":"11/15 18:42"},{"id":"cnyes6662527","source":"鉅亨網","category":"美股","title":"Anthropic IPO傳獲六倍申購2028年營收預估分歧、AI定價能力成焦點","link":"https://news.cnyes.com/news/id/6662527","published":1794632406,"summary":"2026年11月14日（優分析／產業數據中心報導）⸺ Anthropic上市申購熱度升高，但投資人對這家AI公司的成長潛力仍有明顯分歧。根據外媒報導，截至週四，IPO申購需求約為可售股份的六倍，較週二路演首日的兩倍增加；市場關注的重點，則從能否吸引資金，轉向Claude的技術優勢能維持多久。 估值分歧集中在2028年營收。銀行估計Anthropic屆時營收約2,700億至2,800億美元，並據此套用企業價值對營收倍數。但一名完成盡職調查、最後決定不參與IPO的投資人，對2028年的預估比賣方低約三成。這些數字是金融機構及投資人的估計，並非公司公布的財測。 投資人的疑問主要有兩項：Google等競爭對手追趕先進AI模型後，Anthropic能否維持較高售價；以及Claude能否將程式設計領域的優勢，延伸至更廣泛的知識工作市場。兩者都會影響未來營收成長，也讓同一家公司出現不同的估值判斷。 依公司向美國證管會提交的初步公開說明書，此次預計公開發售8.25億股，每股暫定70至78美元，以區間上緣計算，發行規模約643.5億美元，尚未計入承銷商超額配售選擇權。路透指出，路演預計持續至下週三，並於當天定價；申購需求及發行條件仍可能變動，Anthropic對路演消息不予評論。","sentiment":1,"tags":{"topics":["營收","法說/展望","AI/半導體","匯率","金融"],"bull":["成長","倍增"],"bear":[],"score":4,"highlights":[],"keywords":["Anthropic","優分析"]},"time":"11/14 13:00"}],"fund":{"code":"6239","rev_month":"11510","rev":8726838.0,"rev_mom":2.58961593247369,"rev_yoy":25.197285864121913,"rev_cum_yoy":29.75283948884192,"eps_q":9.05,"eps_year":"115","eps_season":"3","net_income":8801758.0,"pe":16.51,"pb":2.48,"yield":2.33,"updated":"2026-11-27 02:23"},"tdcc":{"latest":{"date":"2026-11-20","big1000":53.39,"big400":59.32,"retail":24.21,"holders":194797},"prev":{"date":"2026-11-13","big1000":53.93,"big400":59.56,"retail":24.13,"holders":195352},"d_big1000":-0.54,"d_big400":-0.24,"d_retail":0.08,"d_holders":-555},"weekly":{"bars":[{"time":"2026-07-27","open":278.0,"high":281.5,"low":210.0,"close":235.5,"volume":105661.331},{"time":"2026-08-03","open":235.5,"high":271.0,"low":235.5,"close":262.5,"volume":117599.642},{"time":"2026-08-10","open":283.0,"high":296.0,"low":271.0,"close":278.0,"volume":94853.13399999999},{"time":"2026-08-17","open":278.0,"high":282.0,"low":255.0,"close":267.5,"volume":41689.177},{"time":"2026-08-24","open":267.0,"high":298.0,"low":259.0,"close":287.0,"volume":88621.011},{"time":"2026-08-31","open":282.5,"high":289.0,"low":271.0,"close":276.5,"volume":58179.766},{"time":"2026-09-07","open":281.5,"high":290.5,"low":270.5,"close":273.0,"volume":61240.539000000004},{"time":"2026-09-14","open":265.0,"high":285.0,"low":262.0,"close":284.0,"volume":55623.588},{"time":"2026-09-21","open":286.0,"high":302.0,"low":283.5,"close":287.0,"volume":61937.488000000005},{"time":"2026-09-29","open":285.5,"high":316.0,"low":279.5,"close":308.0,"volume":59356.156},{"time":"2026-10-05","open":311.0,"high":313.0,"low":296.0,"close":308.0,"volume":82490.73599999999},{"time":"2026-10-12","open":308.0,"high":311