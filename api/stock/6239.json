eign":5109.319,"trust":62.0,"dealer":204.262},{"date":"2026-11-05","foreign":-2383.278,"trust":189.392,"dealer":-160.299},{"date":"2026-11-04","foreign":-1075.568,"trust":360.392,"dealer":142.415},{"date":"2026-11-03","foreign":-1842.312,"trust":427.196,"dealer":-462.255},{"date":"2026-11-02","foreign":-187.008,"trust":258.071,"dealer":179.663},{"date":"2026-10-30","foreign":-1573.694,"trust":382.0,"dealer":-175.875},{"date":"2026-10-29","foreign":-399.656,"trust":223.0,"dealer":-410.57},{"date":"2026-10-28","foreign":4376.893,"trust":531.664,"dealer":206.44},{"date":"2026-10-22","foreign":-6059.516,"trust":-181.0,"dealer":-99.582},{"date":"2026-10-21","foreign":741.163,"trust":30.566,"dealer":202.855},{"date":"2026-10-20","foreign":-1156.417,"trust":-384.454,"dealer":9.842},{"date":"2026-10-19","foreign":-139.947,"trust":-504.393,"dealer":399.155},{"date":"2026-10-16","foreign":839.825,"trust":454.569,"dealer":75.309},{"date":"2026-10-15","foreign":-9771.547,"trust":401.0,"dealer":-1840.78},{"date":"2026-10-14","foreign":2064.766,"trust":79.0,"dealer":-285.043},{"date":"2026-10-13","foreign":-553.653,"trust":588.196,"dealer":-416.898},{"date":"2026-10-12","foreign":-895.932,"trust":-134.608,"dealer":-229.461},{"date":"2026-10-08","foreign":685.66,"trust":145.0,"dealer":-544.798},{"date":"2026-10-07","foreign":-3877.64,"trust":102.0,"dealer":-554.622},{"date":"2026-10-06","foreign":6903.934,"trust":116.0,"dealer":1574.382}],"news":[{"id":"cnyes6651952","source":"鉅亨網","category":"美股","title":"AI支出疑慮升高之際 Google現金流連兩季轉負 仍砸170億美元建資料中心","link":"https://news.cnyes.com/news/id/6651952","published":1794025857,"summary":"Google加碼布局AI基礎設施,接手AI基礎設施開發商Crusoe位於美國懷俄明州東南部的一座未完工資料中心專案。Crusoe周五(6日)證實已將專案出售給Google;Google前一天(5日)宣布,將投入170億美元開發位於拉勒米縣(Laramie County)的資料中心園區,這也將成為Google在懷俄明州的首座資料中心。 根據Google官方資訊,這項計畫將建置702MW燃料電池發電設施,並搭配碳捕捉與封存(CCS)技術,燃料電池由Bloom Energy(BE-US)供應,Google並承諾負擔100%的電力成本。 不過,170億美元是Google對整體資料中心園區的開發投資規模,並非收購Crusoe專案的交易價格。Crusoe向《TechCrunch》證實出售消息,但未公布實際交易金額,目前尚無法確認Google為取得該專案支付多少費用。 《TechCrunch》報導,Crusoe去年與黑石(Blackstone)支持的基礎設施公司Tallgrass共同宣布這項開發計畫,原先規劃最終將園區電力容量擴大至10GW。Google據報在Crusoe負責管理期間,對專案成本及施工時程提出疑慮,之後決定接手開發。據《TechCrunch》轉述,這筆出售案最早由《彭博》於6月披露。","sentiment":1,"tags":{"topics":["AI/半導體","匯率"],"bull":["加碼","布局"],"bear":[],"score":3,"highlights":[],"keywords":["Crusoe","AI投資","谷歌","Google","AI運算","運算","電力"]},"time":"11/07 12:30"},{"id":"cnyes6651736","source":"鉅亨網","category":"美股","title":"微軟傳不再續約 逐步停用向甲骨文租用的AI算力","link":"https://news.cnyes.com/news/id/6651736","published":1793989805,"summary":"據《彭博》周五(6日)報導，微軟(MSFT-US)已決定不再續約，近幾個月逐步停用向甲骨文(ORCL-US)租用的AI算力。知情人士透露，甲骨文為這筆合約提供的伺服器採用較舊世代的輝達(NVDA-US)晶片，已不符微軟目前的規格需求。這筆合約原本用來支援Bing搜尋服務，如今微軟也在重新評估成本高昂的外部算力合作。 從Bing缺算力到不再續約 甲骨文稱舊款GPU仍有需求 微軟與甲骨文在2023年宣布合作，由甲骨文提供伺服器算力，支援導入AI功能的新版Bing搜尋引擎。當時連擁有自家雲端業務的微軟，都願意向主要競爭對手租用伺服器，被視為AI算力供不應求的早期訊號。這筆合約的完整金額尚不清楚，微軟對此次不續約消息不予置評。 甲骨文發言人表示，公司AI基礎設施需求依然強勁，較舊世代的繪圖處理器(GPU)也有客戶承租。甲骨文9月曾透露，已有四年歷史的GPU仍能以高於原合約20%的價格續約。 微軟重審逾800億美元算力承諾 甲骨文擴建支出受關注 除了向甲骨文租用伺服器，微軟也曾與CoreWeave(CRWV-US)、Nscale及Nebius(NBIS-US)等新興雲端業者簽下大單，帶動專門提供AI算力的雲端服務商快速崛起。為支援自身AI業務，微軟向外部雲端業者租用算力的承諾金額合計超過800億美元。 《彭博》先前報導，外部算力成本偏高，加上部分資料中心進度落後，已引起微軟高層不滿。","sentiment":0,"tags":{"topics":["訂單/接單","AI/半導體","匯率"],"bull":["合作"],"bear":[],"score":1,"highlights":[],"keywords":["微軟","Microsoft","甲骨文","Oracle","輝達","晶片","算力","GPU"]},"time":"11/07 02:30"},{"id":"7fe7ef10b66d93a6","source":"Yahoo股市-台股","category":"台股","title":"美股開盤／費半狂飆逾5% 台積電ADR強彈近8%","link":"https://tw.news.yahoo.com/%E7%BE%8E%E8%82%A1%E9%96%8B%E7%9B%A4-%E8%B2%BB%E5%8D%8A%E7%8B%82%E9%A3%86%E9%80%BE5-%E5%8F%B0%E7%A9%8D%E9%9B%BBadr%E5%BC%B7%E5%BD%88%E8%BF%918-144700839.html","published":1793976420,"summary":"美股受前日大跌與過熱的10月非農就業人數增加16.5萬人影響，引發升息預期升溫，FedWatch顯示下次升息率達76.8%。同時，市場傳出民主黨可能加強AI監管，智庫建議監控資料中心與電力成本並傳喚科","sentiment":-1,"tags":{"topics":["AI/半導體","總經/聯準會","美股/國際","盤前"],"bull":[],"bear":["大跌","升息"],"score":-3,"highlights":[],"keywords":[]},"time":"11/06 22:47"},{"id":"99671e579d1e7d85","source":"經濟日報-國際","category":"國際","title":"民主黨國會勝選 AI 基建遭遇逆風？中國信託證券投顧：約75%已動工","link":"https://money.udn.com/money/story/123398/9862047","published":1793948705,"summary":"中國信託證券投顧分析民主黨奪兩院對AI資料中心基礎建設影響，民主黨取得國會兩院控制權，且在多個資料中心建設重點州取得政治優勢，州政府可在既有法律授權範圍內透過行政及許可審查措施影響建設進度，因此州級監管對短期投資的影響更為直接，使市場擔憂未來AI基礎建設面臨更嚴格的電力成本分攤、環境規範與建設審批，進而拖累科技股估值。","sentiment":0,"tags":{"topics":["AI/半導體","金融"],"bull":[],"bear":[],"score":0,"highlights":[],"keywords":[]},"time":"11/06 15:05"},{"id":"cnyes6649271","source":"鉅亨網","category":"美股","title":"輝達暴跌逾9%跌入熊市！基金經理人：買點來了","link":"https://news.cnyes.com/news/id/6649271","published":1793934603,"summary":"輝達 (NVDA-US) 週四 (5 日) 暴跌 9.26%，收在 181.60 美元，較 10 月歷史收盤高點回落約 24.1%，正式跌入熊市。美國期中選舉後，市場擔憂資料中心建設將面臨更多政治阻力，引爆人工智慧 (AI) 晶片股賣壓。不過，部分基金經理人認為，AI 晶片需求與輝達競爭優勢仍具支撐，股價急跌可能帶來買進機會。 輝達週四創下 2025 年 1 月 DeepSeek 引發科技股拋售以來最大單日跌幅，單日市值蒸發約 4,470 億美元，為歷來第二大單日市值損失。自 10 月 6 日創下歷史收盤新高以來，累計市值縮水近 1.4 兆美元，目前約為 4.4 兆美元。 這波賣壓也使輝達跌破 200 日移動均線。截至週四，股價本週累計下跌約 11%，朝連續第五週收黑邁進，顯示投資人對 AI 產業前景的疑慮，已持續反映在股價上。 此次拋售的核心壓力來自華府。 民主黨在期中選舉奪回參眾兩院控制權，加上兩黨部分候選人選前均曾反對資料中心擴建，使市場擔心，供電成本與地方建設爭議將轉化為更嚴格的政策限制。 美國參議院今年秋季曾接近通過一項法案，要求資料中心承擔更多自身需求所衍生的電力成本。 對晶片業而言，市場關注的傳導風險在於，一旦資料中心建設延宕或成本提高，雲端業者部署 AI 運算設備的速度可能放慢，進而影響晶片採購時程。","sentiment":-1,"tags":{"topics":["訂單/接單","EPS/獲利","AI/半導體","匯率"],"bull":[],"bear":["賣壓","拋售","暴跌"],"score":-7,"highlights":[],"keywords":["輝達","AI","資料中心","雲端業者","晶片","財報","熊市","TOP"]},"time":"11/06 11:10"},{"id":"529e90f6e91f62b3","source":"Yahoo股市-國際","category":"國際","title":"馬斯克臉要綠了 德州新州長承諾暫停新建AI資料中心 還打算取消租稅優惠","link":"https://tw.news.yahoo.com/%E9%A6%AC%E6%96%AF%E5%85%8B%E8%87%89%E8%A6%81%E7%B6%A0%E4%BA%86-%E5%BE%B7%E5%B7%9E%E6%96%B0%E5%B7%9E%E9%95%B7%E6%89%BF%E8%AB%BE%E6%9A%AB%E5%81%9C%E6%96%B0%E5%BB%BAai%E8%B3%87%E6%96%99%E4%B8%AD%E5%BF%83-%E9%82%84%E6%89%93%E7%AE%97%E5%8F%96%E6%B6%88%E7%A7%9F%E7%A8%85%E5%84%AA%E6%83%A0-064525394.html","published":1793861125,"summary":"美國德州憑藉零州所得稅、長達7年的企業租稅優惠、低廉的營運與電力成本、充足的土地","sentiment":0,"tags":{"topics":["AI/半導體"],"bull":[],"bear":[],"score":0,"highlights":[],"keywords":[]},"time":"11/05 14:45"},{"id":"cnyes6647311","source":"鉅亨網","category":"美股","title":"選後行情怎麼走？投資人必看的四大關鍵議題","link":"https://news.cnyes.com/news/id/6647311","published":1793857122,"summary":"美國民主黨在期中選舉奪回參眾兩院控制權，美股週三 (4 日) 走強，選前不確定性消退，帶動投資人風險偏好回升。不過，這波漲勢能否延續，仍須觀察資料中心建設政策、聯準會 (Fed) 利率與人事布局、財政協商，以及企業獲利能否支撐市場預期。 《MarketWatch》報導，美股期貨在選舉結果陸續出爐時一度走低，但主要指數開盤後強勢反攻，有「恐慌指數」之稱的芝加哥選擇權交易所波動率指數 (VIX) 則大幅回落，顯示選舉落幕有助釋放市場壓力。 部分市場人士將漲勢歸因於民主黨可能推動撤銷部分川普關稅，尤其是針對加拿大商品的高額關稅；另一些人則認為，投資人首先慶祝的是選舉終於結束，政策方向的不確定性暫時降低。 然而，選舉結果並不代表政策已經改變。民主黨除了拿下國會，也贏得德州、俄亥俄州等傳統共和黨地盤的州長選舉，後續聯邦與地方政策如何調整，將牽動市場重新定價。 資料中心建設若放緩 AI產業贏家、輸家恐分化 反對新建資料中心，是這次選舉影響選民決策的重要議題之一。投資人接下來須評估，若地方政府收緊審批或提高建設門檻，將如何改變人工智慧 (AI) 產業的供需與獲利前景。 成功預測這波民主黨「藍色浪潮」的 3Fourteen Research 創辦人 Warren Pies 表示，在其他條件不變的情況下，新環境可能推高算力成本，有利於目前已持有資料中心產能的業者。","sentiment":1,"tags":{"topics":["EPS/獲利","擴產/資本支出","AI/半導體","總經/聯準會","關稅/地緣","美股/國際"],"bull":["獲利","回升","強勢","布局"],"bear":["恐慌"],"score":2,"highlights":[],"keywords":["期中選舉","美股","民主黨","VIX","美債","殖利率","AI","Fed"]},"time":"11/05 13:38"},{"id":"85b7371ea891bda4","source":"Yahoo股市-台股","category":"台股","title":"台股急殺千點！記憶體群遭血洗 「這2檔」狂跌逾7%摔最慘","link":"https://tw.news.yahoo.com/%E5%8F%B0%E8%82%A1%E6%80%A5%E6%AE%BA%E5%8D%83%E9%BB%9E-%E8%A8%98%E6%86%B6%E9%AB%94%E7%BE%A4%E9%81%AD%E8%A1%80%E6%B4%97-%E9%80%992%E6%AA%94-%E7%8B%82%E8%B7%8C%E9%80%BE7-%E6%91%94%E6%9C%80%E6%85%98-014700058.html","published":1793843220,"summary":"台股今（5）日早盤大跌逾千點，記憶體族群成重災區全面走弱。南亞科、華邦電與群聯跌幅皆超過6%，旺宏、力成等指標股也同步挫跌，族群氣氛偏空士氣低迷，投資人應密切關注後續國際股市動向與成交量變化以評估風險","sentiment":-1,"tags":{"topics":["AI/半導體"],"bull":[],"bear":["大跌","慘","血洗"],"score":-6,"highlights":[],"keywords":[]},"time":"11/05 09:47"},{"id":"cnyes6646044","source":"鉅亨網","category":"美股","title":"AI推論成新戰場！算力成本成獲利關鍵 Fal估值衝160億美元、輝達參投13億美元","link":"https://news.cnyes.com/news/id/6646044","published":1793760359,"summary":"AI推論需求爆發推升Fal估值翻倍至160億美元 輝達參投13億美元F輪、算力成本成獲利考驗 AI推論新創Fal於11月3日宣布完成F輪募資，募得13億美元，由Bessemer Venture Partners領投，公司估值達160億美元，較今年4月的80億美元翻倍。這筆交易凸顯生成式AI應用快速擴張，帶動模型推論服務需求激增，也讓提供算力與模型部署服務的基礎設施業者成為資本市場追逐的新焦點。 根據《彭博》報導，Fal這輪募資於10月完成，除Bessemer Venture Partners領投外，輝達 (NVIDIA) (NVDA-US) 以策略投資人身分參與，Sound Ventures、HOF Capital及T. Rowe Price (TROW-US) 也名列投資人。Bessemer合夥人Talia Goldberg將加入Fal董事會，顯示領投方不只提供資金，也將進一步參與公司治理。 Fal同日公布先前完成的E輪募資。該輪於今年4月募集3.5億美元，由紅杉資本 (Sequoia Capital) 領投，當時估值為80億美元。加上最新F輪，兩輪合計募資16.5億美元，估值在約半年內增加一倍，反映投資人對AI推論市場成長潛力的高度期待。 Fal成立於2021年，總部位於舊金山，主要為開發者與創作者託管、部署及運行AI影片、圖像與音訊模型。","sentiment":1,"tags":{"topics":["EPS/獲利","AI/半導體","匯率"],"bull":["獲利","翻倍"],"bear":[],"score":4,"highlights":[],"keywords":["推論","算力","fal","輝達","美股","科技","紅杉資本"]},"time":"11/04 10:45"},{"id":"f5683e192d44aaa1","source":"經濟日報-證券","category":"台股","title":"美期中選舉要押寶買股嗎？凱基證券：投資紀律比找買點更重要","link":"https://money.udn.com/money/story/5607/9853380","published":1793666978,"summary":"美國期中選舉11月3日登場，選前利率動向與科技企業財報接力成為市場焦點，政策、利率及AI產業前景持續牽動台美股行情。面對市場波動，不少投資人猶豫「美股該等選後再買嗎？資金有限也能參與嗎？」凱基證券指出，對有意長期布局美股的投資人而言，與其猜測選後漲跌，不如先做好正確投資觀念與資金規劃，透過定期定額分批投入，降低單次進場的擇時壓力，逐步建立投資紀律。","sentiment":0,"tags":{"topics":["法說/展望","AI/半導體","總經/聯準會","美股/國際","金融"],"bull":["布局"],"bear":[],"score":1,"highlights":[],"keywords":[]},"time":"11/03 08:49"},{"id":"726b24cee1f36e50","source":"富聯網","category":"台股","title":"《一週投信買超11-7》力成(959)、中華電(864)、大聯大(802)","link":"https://news.google.com/rss/articles/CBMiiAFBVV95cUxNWDhSVDBnX2FQSWFCelB5SE5IVkUzRERSd0RHYVJJTFMtbVBaeGhSMXJ4NWZBbWpmNjBfNVJSck9FcmNJQ2ViVmdkMHlOeFVyNkxjcDEwaWNiWmVPQzJjWkxITVg5ZnNwMjIybHhRWnRBWTBuN1VtS1hkaUlwcVBSa21xc2JYT3NH?oc=5","published":1793499660,"summary":"《一週投信買超11-7》力成(959)、中華電(864)、大聯大(802) 富聯網","sentiment":1,"tags":{"topics":["法人動向"],"bull":["買超"],"bear":[],"score":2,"highlights":[],"keywords":[]},"time":"11/01 10:21"},{"id":"e7f0da441000373a","source":"經濟日報-證券","category":"台股","title":"力成統一64購01 錢景亮","link":"https://money.udn.com/money/story/5739/9849228","published":1793468037,"summary":"力成第3季營收季增9.6%，年增26.9%，主因AI伺服器帶旺eSSD需求成長，且先進邏輯封裝、子公司超豐，以及Tera Probe／Tera Power均有雙位數季增成長表現；第3季歸屬母公司業主淨利26.12億元，單季每股純益（EPS）達3.55元，創歷史單季新高。","sentiment":1,"tags":{"topics":["EPS/獲利","營收","AI/半導體"],"bull":["新高","成長","年增"],"bear":[],"score":3,"highlights":["年增26.9%","EPS）達3.55元"],"keywords":[]},"time":"11/01 01:33"},{"id":"454fb0b01a43599c","source":"經濟日報-證券","category":"台股","title":"AI封測景氣有多旺？ 它Q3毛利率衝45% AI ASIC、矽光子成新引擎","link":"https://money.udn.com/money/story/5607/9845358","published":1793369259,"summary":"受惠AI GPU、伺服器CPU、客製化ASIC等加持，先進封裝持續夯，台積電2026年資本支出提高至600億至640億美元，就是聚焦 2奈米先進製程、先進封裝CoWoS與SoIC，近期甚至傳出台積電CoWoS報價有新一波漲價，漲幅上看2成。日前輝達與京元電簽訂客戶預付款協議，AMD與後段封測大廠日月光投控、力成緊密合作，均可看出封測需求龐大，今年封裝大舉擴產，2027年業績增長可期。此外，日月光投控（3711）預期今年85億美元資本支出有望再上調，今年共有15座廠同時動工，但仍然趕不上需求，凸顯封測景氣不容小覷。包括日月光投控（3711）、京元電（2449）、矽格（6257）、欣銓（3264）、力成（6239）等績優股值得留意。","sentiment":1,"tags":{"topics":["EPS/獲利","擴產/資本支出","AI/半導體","總經/聯準會","匯率"],"bull":["擴產","漲價","合作","受惠"],"bear":[],"score":7,"highlights":[],"keywords":[]},"time":"10/30 22:07"},{"id":"cnyes6642111","source":"鉅亨網","category":"台股","title":"〈鴻海科技日〉劉揚偉：德州仍有擴建需求 TEEMA園區從供應鏈切入打造第三代科學園區","link":"https://news.cnyes.com/news/id/6642111","published":1793357220,"summary":"鴻海(2317-TW)今(30)日舉行科技日，董事長劉揚偉會後受訪時表示，鴻海目前在美國德州休士頓已有6棟廠房，且未來仍有持續擴建需求，將持續擴大當地布局。至於德州TEEMA(電電公會)園區，則希望從供應鏈開始切入，逐步打造涵蓋完整供應鏈的第三代科學園區。 劉揚偉指出，目前德州當地與AI相關的建置，多集中在Level 11及Level 12，相關供應鏈尚未真正進駐，因此TEEMA布局很可能從供應鏈開始。他希望將TEEMA打造成第三代科學園區，新竹為第一代、台南為第二代，德州則希望發展成具備完整生態系及供應鏈的園區，初期將以冷卻模組、線材連接器及印刷電路板(PCB)等基礎零組件切入，再進一步建構其他模組及系統。 除了美國市場，鴻海也持續擴大歐洲布局。劉揚偉表示，製造服務業未來將朝區域化發展，鴻海約5年前便認為區域化生產將成為趨勢，因此選擇波蘭作為歐洲樞紐，看好當地具備與台灣相似的靈活性及快速反應能力，加上人力成本及工作特質，成為布局考量。 劉揚偉進一步指出，鴻海在波蘭不打算採取傳統外商直接投資(FDI)模式，而是推動BOL（Build、Operate、Localize，建立、營運、在地化）模式，與當地夥伴EMP合作，共同建立、營運並在地化電動車業務，希望藉此協助波蘭逐步建立自己的電動車產業。","sentiment":1,"tags":{"topics":["AI/半導體"],"bull":["供應鏈","擴大","布局","進駐"],"bear":[],"score":4,"highlights":[],"keywords":["鴻海","劉揚偉","美國","德州","TEEMA","科學園區"]},"time":"10/30 18:47"},{"id":"cnyes6641174","source":"鉅亨網","category":"國際","title":"IT服務｜AI降價壓力告一段落 Cognizant財報透露產業下一步：從賣人力轉向包AI算力","link":"https://news.cnyes.com/news/id/6641174","published":1793286017,"summary":"2026年10月29日（優分析／產業數據中心報導）⸺ AI衝擊IT服務業的方式正在改變。美國IT服務大廠高知特Cognizant(CTSH-US)29日公布第3季財報，執行長Ravi Kumar表示，客戶因AI提高開發效率而要求重新議價的這一輪壓力，已大致消化完畢。新簽合約中，新業務與擴大既有業務的比重從約48%升到60%。不過，金融業以外的客戶仍在壓縮非必要支出，高知特同步下修全年財測，第4季有機成長只剩約2%。這顯示產業雖然走過最難熬的降價期，新需求還沒有擴散到多數產業。 高知特Cognizant(CTSH-US)為全球資訊科技與專業服務業者，總部位於美國紐澤西州，主要協助企業導入數位技術、改善營運流程及降低成本。服務涵蓋顧問諮詢、軟體開發、系統整合、雲端基礎設施、資安及業務流程委外，並積極布局AI與自動化，協助客戶提升作業效率與顧客體驗。客戶遍及金融、醫療與生命科學、製造、零售、能源及科技等產業，業務涵蓋北美、歐洲及其他國際市場。 生產力重新議價告一段落 新業務比重升到6成 過去兩年，生成式AI讓寫程式、測試、維運的效率大幅提高，客戶在續約時紛紛要求把省下的人力成本反映在價格上，IT服務業的營收被壓縮。Kumar先前表示，高知特約一半的合約已依生產力提升重新訂價。","sentiment":-1,"tags":{"topics":["營收","法說/展望","AI/半導體"],"bull":["擴大"],"bear":["下修"],"score":-2,"highlights":[],"keywords":["SaaS","AI推論","優分析"]},"time":"10/29 23:00"}],"fund":{"code":"6239","rev_month":"11509","rev":8506551.0,"rev_mom":-0.5958952012522283,"rev_yoy":26.963788857940216,"rev_cum_yoy":30.346131522598483,"eps_q":null,"eps_year":null,"eps_season":null,"net_income":null,"pe":21.78,"pb":2.84,"yield":2.05,"updated":"2026-11-06 17:49"},"tdcc":{"latest":{"date":"2026-10-30","big1000":54.07,"big400":60.12,"retail":23.89,"holders":196102},"prev":{"date":"2026-10-22","big1000":54.16,"big400":60.18,"retail":23.8,"holders":196053},"d_big1000":-0.09,"d_big400":-0.06,"d_retail":0.09,"d_holders":49},"weekly":{"bars":[{"time":"2026-07-27","open":278.0,"high":281.5,"low":210.0,"close":235.5,"volume":105661.331},{"time":"2026-08-03","open":235.5,"high":271.0,"low":235.5,"close":262.5,"volume":117599.642},{"time":"2026-08-10","open":283.0,"high":296.0,"low":271.0,"close":278.0,"volume":94853.13399999999},{"time":"2026-08-17","open":278.0,"high":282.0,"low":255.0,"close":267.5,"volume":41689.177},{"time":"2026-08-24","open":267.0,"high":298.0,"low":259.0,"close":287.0,"volume":88621.011},{"time":"2026-08-31","open":282.5,"high":289.0,"low":271.0,"close":276.5,"volume":58179.766},{"time":"2026-09-07","open":281.5,"high":290.5,"low":270.5,"close":273.0,"volume":61240.539000000004},{"time":"2026-09-14","open":265.0,"high":285.0,"low":262.0,"close":284.0,"volume":55623.588},{"time":"2026-09-21","open":286.0,"hi