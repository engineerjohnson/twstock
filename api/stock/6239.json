22","foreign":-6059.516,"trust":-181.0,"dealer":-99.582},{"date":"2026-10-21","foreign":741.163,"trust":30.566,"dealer":202.855},{"date":"2026-10-20","foreign":-1156.417,"trust":-384.454,"dealer":9.842},{"date":"2026-10-19","foreign":-139.947,"trust":-504.393,"dealer":399.155},{"date":"2026-10-16","foreign":839.825,"trust":454.569,"dealer":75.309},{"date":"2026-10-15","foreign":-9771.547,"trust":401.0,"dealer":-1840.78},{"date":"2026-10-14","foreign":2064.766,"trust":79.0,"dealer":-285.043}],"news":[{"id":"cnyes6662527","source":"鉅亨網","category":"美股","title":"Anthropic IPO傳獲六倍申購2028年營收預估分歧、AI定價能力成焦點","link":"https://news.cnyes.com/news/id/6662527","published":1794632406,"summary":"2026年11月14日（優分析／產業數據中心報導）⸺ Anthropic上市申購熱度升高，但投資人對這家AI公司的成長潛力仍有明顯分歧。根據外媒報導，截至週四，IPO申購需求約為可售股份的六倍，較週二路演首日的兩倍增加；市場關注的重點，則從能否吸引資金，轉向Claude的技術優勢能維持多久。 估值分歧集中在2028年營收。銀行估計Anthropic屆時營收約2,700億至2,800億美元，並據此套用企業價值對營收倍數。但一名完成盡職調查、最後決定不參與IPO的投資人，對2028年的預估比賣方低約三成。這些數字是金融機構及投資人的估計，並非公司公布的財測。 投資人的疑問主要有兩項：Google等競爭對手追趕先進AI模型後，Anthropic能否維持較高售價；以及Claude能否將程式設計領域的優勢，延伸至更廣泛的知識工作市場。兩者都會影響未來營收成長，也讓同一家公司出現不同的估值判斷。 依公司向美國證管會提交的初步公開說明書，此次預計公開發售8.25億股，每股暫定70至78美元，以區間上緣計算，發行規模約643.5億美元，尚未計入承銷商超額配售選擇權。路透指出，路演預計持續至下週三，並於當天定價；申購需求及發行條件仍可能變動，Anthropic對路演消息不予評論。","sentiment":1,"tags":{"topics":["營收","法說/展望","AI/半導體","匯率","金融"],"bull":["成長","倍增"],"bear":[],"score":4,"highlights":[],"keywords":["Anthropic","優分析"]},"time":"11/14 13:00"},{"id":"cnyes6661794","source":"鉅亨網","category":"台股","title":"〈技嘉法說〉AI伺服器訂單能見度直達2027年底 明年資本支出增至40億元擴產","link":"https://news.cnyes.com/news/id/6661794","published":1794564803,"summary":"品牌大廠技嘉(2376-TW)於13日召開線上法說會，由集團共同總經理李宜泰與林英宇、副總經理蕭文達及發言人劉文忠共同釋出2027年最新營運展望與市況說明。李宜泰表示目前客戶對AI伺服器訂單需求非常強勁且能見度持續提高，成長動能可望一路延續至2027年底。劉文忠更指出隨著經濟規模擴大與費用率優化，預期2027年營業利益的成長幅度將優於營收成長幅度。 因應客戶強勁需求與全球產能擴充，技嘉持續調整全球生產佈局以提升交付彈性與供應鏈韌性。劉文忠透露今年2026年資本支出預計約為28至30億元新台幣，2027年資本支出規劃則預估提高至40億元新台幣。隨著海外生產基地逐步成熟，未來當地生產及在地化組裝的重要性將持續提高。 在全球產能配置上，台灣廠將持續強化產能擴充並支援高階產品製造、工程及系統整合需求。美國廠隨著在地化生產能力成熟，將作為提升北美市場在地供應彈性、加速客戶認證及發揮當地交付效率的重要核心。馬來西亞及其他東南亞海外基地也會依照客戶需求與供應鏈策略逐步擴充生產能力，配合供應鏈配套與實際訂單導入。 在客戶結構與市場動能方面，AI基礎建設市場正由過去少數大型雲端服務業者帶動，逐步擴展至二線雲端服務商、Neocloud新興雲端業者、主權AI、電信業者及企業端等多元客群。技嘉預期未來AI伺服器市場將呈現大型客戶維持高數量成長、中型客戶快速成長、企業與邊緣端逐步放量的多層次結構。","sentiment":1,"tags":{"topics":["訂單/接單","營收","擴產/資本支出","法說/展望","AI/半導體","匯率"],"bull":["訂單","擴產","成長","擴大"],"bear":[],"score":6,"highlights":[],"keywords":["技嘉","PC","板卡","AI伺服器"]},"time":"11/13 18:13"},{"id":"cnyes6661192","source":"鉅亨網","category":"頭條","title":"黃仁勳離開誰接班？《輝達之道》作者點名「安謀執行長」與「CUDA之父」兩大人選","link":"https://news.cnyes.com/news/id/6661192","published":1794529204,"summary":"黃仁勳周四(12日)辭去輝達(NVDA-US)的總裁、執行長及董事職務一職，由財務長Colette Kress暫代執行長一職，誰來接班延續過去驚人的成長動能成了當務之急。曾長期研究輝達內部管理方式的《輝達之道》作者金泰(Tae Kim)認為，最適任的兩位人選將是安謀(ARM-US)執行長哈斯(HassRene Haas)，以及在輝達負責資料中心客戶業務的巴克(Ian Buck)。 金泰是矽谷資深科技記者，為《巴隆周刊》(Barron’s)資深撰稿人，曾任《彭博》專欄作家和CNBC Digital投資記者，著有《輝達之道：黃仁勳打造晶片帝國，引領AI浪潮的秘密》(The Nvidia Way: Jensen Huang and the Making of a Tech Giant)一書。 金泰認為，即使黃仁勳因與兩名女性發生婚外情而離職震撼各界，輝達仍擁有足夠的領導人才與制度實力，能在新任執行長接掌下持續蓬勃發展。 目前輝達董事會已列出一份接班人名單並準備審查，而金泰建議董事會應把焦點集中在哈斯和巴克這兩名候選人身上。 哈斯：具豐富經營經驗的企業領導人 金泰的首選是目前擔任安謀執行長、曾任輝達高階主管的哈斯。 哈斯兼具技術理解能力、企業管理經驗與領導才能。在安謀任職期間，他已證明自己有能力成功管理輝達以外的大型科技公司。","sentiment":0,"tags":{"topics":["AI/半導體"],"bull":["成長"],"bear":[],"score":1,"highlights":[],"keywords":["TOP","輝達","黃仁勳","接班","CEO","執行長","安謀","CUDA"]},"time":"11/13 08:20"},{"id":"6ff0349c3ae0e4c4","source":"DIGITIMES","category":"台股","title":"張曉強：AI算力成最關鍵商品 台積電AI晶片供不應求","link":"https://news.google.com/rss/articles/CBMia0FVX3lxTFBXRHEwekVidkp3RDV2R0ZpWS1VdFBKUk1veXhMRml2dHhTTmFoWlkyM2lzdzNrX2VvQm1qZllGVFVtd1ZPSzVNLW8ydm90S0g1c3Vya00tWk55a2VnUHN1MWxLT2JIcWdqeFQw?oc=5","published":1794453720,"summary":"張曉強：AI算力成最關鍵商品 台積電AI晶片供不應求 DIGITIMES","sentiment":1,"tags":{"topics":["AI/半導體"],"bull":["供不應求"],"bear":[],"score":3,"highlights":[],"keywords":[]},"time":"11/12 11:22"},{"id":"cnyes6658387","source":"鉅亨網","category":"美股","title":"Anthropic營收狂飆背後藏風險！收入隨時可撤回、算力成本卻被鎖死長達20年","link":"https://news.cnyes.com/news/id/6658387","published":1794440402,"summary":"Anthropic營收正以驚人速度擴張，但高速成長背後，卻隱藏著收入與成本期限嚴重錯配的結構性風險。浙商證券最新研究報告指出，Anthropic的核心問題不在於持續虧損，而是客戶可以隨時縮減人工智慧（AI）服務支出，公司卻已對晶片及算力供應商承擔最高長達20年的不可撤銷付款義務，形成收入高度彈性、成本卻難以調整的經營困境。 浙商證券分析師週一（9日）發布報告指出，Anthropic今年前三季營收合計達332.42億美元，9個月年增約1,206%，已超過2025年全年營收的7.2倍。不過，公司第二季營業利益率雖首度轉正至8.4%，第三季又轉為虧損，降至-3.3%。 報告認為，這項波動凸顯Anthropic面臨的結構性問題：營收主要來自客戶當期實際使用量，剩餘履約義務（RPO）僅能覆蓋約5.1個月的年化營收，但公司已承擔高達8,954億美元的採購及租賃承諾，部分合約期限甚至延伸至2045年。 營收 9 個月暴增 12 倍 按量計費占逾 8 成 從營收表現來看，Anthropic近年成長速度相當驚人。根據公司S-1文件，2023年營收為4,100萬美元，2024年增至3.86億美元，2025年進一步攀升至45.85億美元，年增率分別達841%及1,088%。 進入2026年，成長動能進一步加速。","sentiment":-1,"tags":{"topics":["營收","AI/半導體","匯率","金融"],"bull":["成長"],"bear":["虧損","縮減"],"score":-2,"highlights":[],"keywords":["Anthropic","AI","人工智慧","營收","成本","算力","IPO","上市"]},"time":"11/12 07:40"},{"id":"cnyes6659762","source":"鉅亨網","category":"台股","title":"系微(6231) 毛利率降 3.29 個百分點，公司表示這項指標無意義","link":"https://news.cnyes.com/news/id/6659762","published":1794416434,"summary":"2026年11月12日（優分析／產業數據中心報導）⸺ 系微第 3 季毛利率 74.59%，比第 2 季的 77.88% 少 3.29 個百分點；同一個季度，營業利益率 24.77%，比第 2 季的 23.77% 高。兩個指標呈現不同走勢。 如下圖，根據優分析產業資料庫，2026 年第 3 季系微的毛利率比第 2 季低、營業利益率反而高，兩條線在右端分岔，圖上另外一條是稅後淨利率。 （資料來源：優分析產業資料庫） 公司在法人說明會上表示，毛利率對系微不太有意義，因為承接 NRE 之後，須將人事成本由費用轉列為銷貨成本，這是會計師對成本認列的要求。公司表示，可以把毛利率當成將近 100%，「只要看我們公司的淨利率就好」。 成本藏在費用裡 NRE 占營收約 30%，這類業務的規模變動，會帶動毛利率變化，因為 NRE 的人力成本列在銷貨成本，承接量增加，成本就會提高。第 3 季銷貨成本 1.24 億元，比第 2 季多 20.24%，同期營收只多 4.68%，營業費用則比第 2 季少 3.61%。 合併成本與費用來看，本業表現仍在成長：第 3 季營業利益 1.2 億元，比去年同期的 1.05 億元多 14.41%，營業利益率 24.77% 也高於去年同期的 24.70%。 淨利率那條線 公司提供給投資人的判準是淨利率，大約 20%。第 3 季稅後淨利 0.91 億元，淨利率 18.71%。","sentiment":0,"tags":{"topics":["EPS/獲利","營收","總經/聯準會"],"bull":[],"bear":[],"score":0,"highlights":[],"keywords":["毛利率","營業利益率","淨利率","NRE","優分析"]},"time":"11/12 01:00"},{"id":"cnyes6658618","source":"鉅亨網","category":"台股","title":"反彈遇月線反壓該跑？ 融資逆勢減少醞釀軋空，汰弱留強關鍵時刻","link":"https://news.cnyes.com/news/id/6658618","published":1794385626,"summary":"美國最新公布的10月CPI數據高於市場預期，引發美股短線劇烈震盪，然而市場對總經利空的反應已逐漸出現鈍化跡象。隨著升息疑慮與資金回流相互拉鋸，市場情緒正悄悄轉變，真正決定台股下一階段行情的關鍵訊號，也已逐步浮現。 〈美股CPI利空鈍化，國安基金助台股連三日強彈〉 昨日美國最新公布10月消費者物價指數（CPI）月增0.4%，核心CPI月增0.3%，雙雙高於市場預期，引發美股短線劇烈震盪，然而美股盤中一度由黑翻紅，透露市場短期內對通膨等總經利空消息已逐漸出現鈍化現象，行情遇利空不跌，本質上對盤面就是正向訊號。不過，長天期美債殖利率持續走高，後續對高估值科技股的估值壓力仍須密切警覺。加權指數今日在台積電(2330-TW)領軍下強勢大漲1,545.23點，終場收在44,257.15點，漲幅達3.62%，尤其國安基金啟動安定市場任務後，台股連續三個交易日強勁反彈，符合 智霖老師 先前節目分析過的國安基金進場後的歷史統計推升慣性。 〈台股下道關卡是下彎月線，融資餘額暗藏軋空契機〉 然而，隨著台股加權指數持續墊高，後續反彈動能預期將逐步趨緩，關鍵在於大盤反彈過程中，勢必反覆面臨各期均線的解套反壓測試。今日雖強勢突破10日均線反壓，但下一道關鍵考驗正是上方加速下彎的月線，攻堅難度勢必遠高於此次突破。尤其今日集中市場成交金額縮減至約8,500億元，浮現價漲量縮的量價背離隱憂，將直接牽制後續反彈力道。","sentiment":-1,"tags":{"topics":["AI/半導體","總經/聯準會","美股/國際"],"bull":["反彈"],"bear":["利空","減少","升息"],"score":-4,"highlights":[],"keywords":["國安基金","ASIC","PCB","先進封測","AI","台積電","創意","世芯KY"]},"time":"11/11 16:27"},{"id":"cnyes6658586","source":"鉅亨網","category":"台股","title":"新巨(2420) AI 伺服器占出貨 25 到 30 %，8,000 瓦機種預計今年底送樣","link":"https://news.cnyes.com/news/id/6658586","published":1794384012,"summary":"2026年11月11日（優分析／產業數據中心報導）⸺ 新巨(2420-TW) 的 AI 伺服器已占公司出貨的 25 到 30 %；下一階規格也排好時程，8,000 瓦機種預計今年底送樣。 北美客戶已在交貨 北美中小型資料中心這批案子，延續的是既有的客戶關係。公司表示，北美客戶一直維持合作，今年因 AI 應用落地，開始配合中小型資料中心開發產品，目前已經陸續交貨；瓦特數往上之後又有新案在開，年底送樣的就是 8,000 瓦機種。 資料中心用的這種電源稱為 CRPS，是英特爾制定的標準化冗餘電源規格。模組插進機箱後可以熱插拔，一顆故障還有另一顆接手，更換時系統不必停機。新巨的 CRPS 產品線涵蓋 300 瓦到 5,000 瓦。 月營收同期也在走高，2026 年 7 到 9 月都高於 2025 年同期。7 月的 2.38 億元是今年單月最高；8 月的 2.07 億元比去年同月多出約三成四，是今年最大的月增幅。 如下圖，根據優分析產業資料庫，2026 年 7 到 9 月的月營收線整段高於 2025 年同期。 （資料來源：優分析產業資料庫） 瓦特數還會持續往上，是因為 AI 算力成長，同一部伺服器需要的電力愈來愈多。機構空間不會跟著放大，公司表示將持續強化高功率密度與高轉換效率的技術，目標是在有限空間裡提供更高的輸出功率。","sentiment":1,"tags":{"topics":["營收","AI/半導體"],"bull":["合作","出貨"],"bear":[],"score":2,"highlights":[],"keywords":["伺服器電源","CRPS","資料中心","邊緣運算","優分析"]},"time":"11/11 16:00"},{"id":"cnyes6657970","source":"鉅亨網","category":"國際","title":"Anthropic拚長期營業利益率逾35%！算力效率提升4倍、企業客戶逾1.19萬家","link":"https://news.cnyes.com/news/id/6657970","published":1794369604,"summary":"人工智慧（AI）新創公司Anthropic在最新IPO路演中，首度明確揭露長期獲利目標，預計隨著算力效率提升、直接採購與租賃算力的比重增加，以及推論業務擴大，長期調整後營業利益率有望達到35%以上，較今年第三季的15%提高逾20個百分點。 Anthropic美東時間周二（10日）公布的路演影片及招股資料，也進一步揭露企業客戶規模、營運效率與成本結構等數據。截至第三季，公司營收達169.56億美元，年增逾12倍；過去12個月營收超過10萬美元的企業客戶已逾1.19萬家，同樣較去年同期增加逾12倍。 公司並表示，算力效率較2025年第一季提升逾4倍，截至今年10月底的營收年化運行率（ARR）約810億美元。 透過禮來( LLY-US ) 、樂天、Salesforce( CRM-US ) 及沃爾瑪( WMT-US ) 等企業客戶案例，Anthropic也試圖向投資人證明，Claude的商業應用已逐漸從程式開發擴展至科研、法律服務、企業營運及零售等領域。 不過，Anthropic並未提供達成35%以上調整後營業利益率的明確時間表。考慮到公司仍有約9000億美元的算力採購與租賃承諾，未來能否實現獲利目標，仍取決於企業客戶需求、算力成本控制及AI商業化進展。","sentiment":1,"tags":{"topics":["EPS/獲利","營收","AI/半導體","匯率"],"bull":["獲利","擴大"],"bear":[],"score":2,"highlights":[],"keywords":["人工智慧（AI）","AI","Anthropic","上市","IPO","ANT","營收","獲利"]},"time":"11/11 12:00"},{"id":"329b7e979dc2ef72","source":"科技島","category":"台股","title":"半導體產業鏈／力成Q3營收253億元創新高！前三季EPS達9.05元","link":"https://news.google.com/rss/articles/CBMiakFVX3lxTE1lT19aZVk3MEs3V2M2REdYanZiUGVUZWZjVEstWDNGMGk3UldMVDNxeUMtWTNpdGtqQjVCVUYzLVU2SzFSU2ZFZm9LWndQeHo0ZzlWbEN6c0hJUE1tQXgxaFhtUDJTQ295U1E?oc=5","published":1794368305,"summary":"半導體產業鏈／力成Q3營收253億元創新高！前三季EPS達9.05元 科技島","sentiment":1,"tags":{"topics":["EPS/獲利","營收","AI/半導體"],"bull":["創新高","新高"],"bear":[],"score":3,"highlights":["EPS達9.05元"],"keywords":[]},"time":"11/11 11:38"},{"id":"5214b8b4ed172d73","source":"Yahoo股市-國際","category":"國際","title":"中國使用輝達AI晶片 走私與租用東南亞資料中心算力成兩大途徑","link":"https://tw.stock.yahoo.com/news/%E4%B8%AD%E5%9C%8B%E4%BD%BF%E7%94%A8%E8%BC%9D%E9%81%94ai%E6%99%B6%E7%89%87-%E8%B5%B0%E7%A7%81%E8%88%87%E7%A7%9F%E7%94%A8%E6%9D%B1%E5%8D%97%E4%BA%9E%E8%B3%87%E6%96%99%E4%B8%AD%E5%BF%83%E7%AE%97%E5%8A%9B%E6%88%90%E5%85%A9%E5%A4%A7%E9%80%94%E5%BE%91-082028240.html","published":1794298828,"summary":"（中央社東京2026年11月10日綜合外電報導）輝達執行長黃仁勳近日承認有婚外情，據報對象是一家新加坡公司的中國籍高層。美方懷疑，該公司將輝達人工智慧晶片走私到中國。這起醜聞引發外界關注，中國如何在美","sentiment":0,"tags":{"topics":["AI/半導體"],"bull":[],"bear":[],"score":0,"highlights":[],"keywords":[]},"time":"11/10 16:20"},{"id":"c68f447f49db8681","source":"Yahoo股市-國際","category":"國際","title":"美民主黨掌控國會難撼川普關稅政策！電動車補貼、AI監管成新焦點","link":"https://tw.stock.yahoo.com/news/%E7%BE%8E%E6%B0%91%E4%B8%BB%E9%BB%A8%E6%8E%8C%E6%8E%A7%E5%9C%8B%E6%9C%83%E9%9B%A3%E6%92%BC%E5%B7%9D%E6%99%AE%E9%97%9C%E7%A8%85%E6%94%BF%E7%AD%96-%E9%9B%BB%E5%8B%95%E8%BB%8A%E8%A3%9C%E8%B2%BC-ai%E7%9B%A3%E7%AE%A1%E6%88%90%E6%96%B0%E7%84%A6%E9%BB%9E-131002077.html","published":1794057002,"summary":"民主黨拿下美國國會參眾兩院，川普關稅與對中管制料續行，修法限縮總統權限恐遭否決 AI、半導體、關鍵礦物等國安政策方向不變，但資料中心電力成本與設置地點監管可能趨嚴 電動車補貼可能重回辯論焦點，日本車廠","sentiment":-1,"tags":{"topics":["AI/半導體","關稅/地緣"],"bull":[],"bear":["關稅"],"score":-2,"highlights":[],"keywords":[]},"time":"11/07 21:10"},{"id":"cnyes6651952","source":"鉅亨網","category":"美股","title":"AI支出疑慮升高之際 Google現金流連兩季轉負 仍砸170億美元建資料中心","link":"https://news.cnyes.com/news/id/6651952","published":1794025857,"summary":"Google加碼布局AI基礎設施,接手AI基礎設施開發商Crusoe位於美國懷俄明州東南部的一座未完工資料中心專案。Crusoe周五(6日)證實已將專案出售給Google;Google前一天(5日)宣布,將投入170億美元開發位於拉勒米縣(Laramie County)的資料中心園區,這也將成為Google在懷俄明州的首座資料中心。 根據Google官方資訊,這項計畫將建置702MW燃料電池發電設施,並搭配碳捕捉與封存(CCS)技術,燃料電池由Bloom Energy(BE-US)供應,Google並承諾負擔100%的電力成本。 不過,170億美元是Google對整體資料中心園區的開發投資規模,並非收購Crusoe專案的交易價格。Crusoe向《TechCrunch》證實出售消息,但未公布實際交易金額,目前尚無法確認Google為取得該專案支付多少費用。 《TechCrunch》報導,Crusoe去年與黑石(Blackstone)支持的基礎設施公司Tallgrass共同宣布這項開發計畫,原先規劃最終將園區電力容量擴大至10GW。Google據報在Crusoe負責管理期間,對專案成本及施工時程提出疑慮,之後決定接手開發。據《TechCrunch》轉述,這筆出售案最早由《彭博》於6月披露。","sentiment":1,"tags":{"topics":["AI/半導體","匯率"],"bull":["加碼","布局"],"bear":[],"score":3,"highlights":[],"keywords":["Crusoe","AI投資","谷歌","Google","AI運算","運算","電力"]},"time":"11/07 12:30"},{"id":"cnyes6651736","source":"鉅亨網","category":"美股","title":"微軟傳不再續約 逐步停用向甲骨文租用的AI算力","link":"https://news.cnyes.com/news/id/6651736","published":1793989805,"summary":"據《彭博》周五(6日)報導，微軟(MSFT-US)已決定不再續約，近幾個月逐步停用向甲骨文(ORCL-US)租用的AI算力。知情人士透露，甲骨文為這筆合約提供的伺服器採用較舊世代的輝達(NVDA-US)晶片，已不符微軟目前的規格需求。這筆合約原本用來支援Bing搜尋服務，如今微軟也在重新評估成本高昂的外部算力合作。 從Bing缺算力到不再續約 甲骨文稱舊款GPU仍有需求 微軟與甲骨文在2023年宣布合作，由甲骨文提供伺服器算力，支援導入AI功能的新版Bing搜尋引擎。當時連擁有自家雲端業務的微軟，都願意向主要競爭對手租用伺服器，被視為AI算力供不應求的早期訊號。這筆合約的完整金額尚不清楚，微軟對此次不續約消息不予置評。 甲骨文發言人表示，公司AI基礎設施需求依然強勁，較舊世代的繪圖處理器(GPU)也有客戶承租。甲骨文9月曾透露，已有四年歷史的GPU仍能以高於原合約20%的價格續約。 微軟重審逾800億美元算力承諾 甲骨文擴建支出受關注 除了向甲骨文租用伺服器，微軟也曾與CoreWeave(CRWV-US)、Nscale及Nebius(NBIS-US)等新興雲端業者簽下大單，帶動專門提供AI算力的雲端服務商快速崛起。為支援自身AI業務，微軟向外部雲端業者租用算力的承諾金額合計超過800億美元。 《彭博》先前報導，外部算力成本偏高，加上部分資料中心進度落後，已引起微軟高層不滿。","sentiment":0,"tags":{"topics":["訂單/接單","AI/半導體","匯率"],"bull":["合作"],"bear":[],"score":1,"highlights":[],"keywords":["微軟","Microsoft","甲骨文","Oracle","輝達","晶片","算力","GPU"]},"time":"11/07 02:30"},{"id":"7fe7ef10b66d93a6","source":"Yahoo股市-台股","category":"台股","title":"美股開盤／費半狂飆逾5% 台積電ADR強彈近8%","link":"https://tw.news.yahoo.com/%E7%BE%8E%E8%82%A1%E9%96%8B%E7%9B%A4-%E8%B2%BB%E5%8D%8A%E7%8B%82%E9%A3%86%E9%80%BE5-%E5%8F%B0%E7%A9%8D%E9%9B%BBadr%E5%BC%B7%E5%BD%88%E8%BF%918-144700839.html","published":1793976420,"summary":"美股受前日大跌與過熱的10月非農就業人數增加16.5萬人影響，引發升息預期升溫，FedWatch顯示下次升息率達76.8%。同時，市場傳出民主黨可能加強AI監管，智庫建議監控資料中心與電力成本並傳喚科","sentiment":-1,"tags":{"topics":["AI/半導體","總經/聯準會","美股/國際","盤前"],"bull":[],"bear":["大跌","升息"],"score":-3,"highlights":[],"keywords":[]},"time":"11/06 22:47"}],"fund":{"code":"6239","rev_month":"11510","rev":8726838.0,"rev_mom":2.58961593247369,"rev_yoy":25.197285864121913,"rev_cum_yoy":29.75283948884192,"eps_q":9.05,"eps_year":"115","eps_season":"3","net_income":8801758.0,"pe":20.52,"pb":3.08,"yield":1.87,"updated":"2026-11-13 17:58"},"tdcc":{"latest":{"date":"2026-11-06","big1000":53.65,"big400":59.15,"retail":24.43,"holders":197206},"prev":{"date":"2026-10-30","big1000":54.07,"big400":60.12,"retail":23.89,"holders":196102},"d_big1000":-0.42,"d_big400":-0.97,"d_retail":0.54,"d_holders":1104},"weekly":{"bars":[{"time":"2026-07-27","open":278.0,"high":281.5,"low":210.0,"close":235.5,"volume":105661.331},{"time":"2026-08-03","open":235.5,"high":271.0,"low":235.5,"close":262.5,"volume":117599.642},{"time":"2026-08-10","open":283.0,"high":296.0,"low":271.0,"close":278.0,"volume":94853.13399999999},{"time":"2026-08-17","open":278.0,"high":282.0,"low":255.0,"close":267.5,"volume":41689.177},{"time":"2026-08-24","open":267.0,"high":298.0,"low":259.0,"close":287.0,"volume":88621.011},{"time":"2026-08-31","open":282.5,"high":289.0,"low"