2026-11-04","foreign":-789.461,"trust":-607.769,"dealer":42.524},{"date":"2026-11-03","foreign":-913.79,"trust":-84.885,"dealer":-396.162},{"date":"2026-11-02","foreign":599.033,"trust":-1025.885,"dealer":84.689}],"news":[{"id":"cnyes6673207","source":"鉅亨網","category":"台股","title":"從半導體研究到產業創新 陽明交大頒授鈺創董事長盧超群名譽博士","link":"https://news.cnyes.com/news/id/6673207","published":1795695010,"summary":"陽明交大今(26)日舉行名譽博士學位頒授典禮，頒授名譽博士學位予鈺創科技董事長暨陽明交大講座教授盧超群博士，表彰其長年深耕半導體研究與IC設計領域，推動臺灣半導體產業技術創新及國際發展的卓越貢獻。 盧超群博士為國際知名半導體專家，畢業於國立臺灣大學，並取得美國史丹佛大學電機工程碩、博士學位，曾於IBM總部投入半導體研究，研發多項創新記憶體元件。1981至1982年間，盧超群返臺於交通大學電子研究所擔任副教授，與學校結下深厚淵源。1990年代響應政府號召返臺，參與國家8吋晶片「次微米計畫」的規劃與推動，協助臺灣建立自主先進半導體製造能力，為後續產業發展奠定重要基礎。 除了學術研究，盧超群更積極將技術創新轉化為產業實力。1991年創立鈺創科技，並相繼共同創辦欣銓科技與創意電子，持續拓展臺灣半導體產業的技術與應用版圖。他早年率先推動裸晶（KGD）技術與異質整合（HI）理念，並促成IEEE於2017年制定異質整合藍圖。近年更提出「矽世代4.0」概念，倡議半導體產業從晶片技術持續邁向系統整合與價值創新。 盧超群在半導體領域的成就深獲國際肯定，不僅當選美國國家工程院院士、美國國家發明學院院士及IEEE Fellow，更獲頒IEEE固態電路獎章等重要殊榮，累積擁有389項全球專利，其中包括105項美國專利，展現其橫跨基礎研究、技術發明與產業應用的深厚實力。","sentiment":0,"tags":{"topics":["AI/半導體"],"bull":[],"bear":[],"score":0,"highlights":[],"keywords":["陽明交大","鈺創","記憶體"]},"time":"11/26 20:10"}],"fund":{"code":"3264","rev_month":"11510","rev":1857240.0,"rev_mom":4.587810027306449,"rev_yoy":47.867896271774256,"rev_cum_yoy":36.79259665507601,"eps_q":7.49,"eps_year":"115","eps_season":"3","net_income":3553593.0,"pe":17.37,"pb":3.14,"yield":2.69,"updated":"2026-11-27 02:23"},"tdcc":{"latest":{"date":"2026-11-20","big1000":50.69,"big400":57.76,"retail":23.2,"holders":106880},"prev":{"date":"2026-11-13","big1000":51.91,"big400":58.68,"retail":22.32,"holders":105631},"d_big1000":-1.22,"d_big400":-0.92,"d_retail":0.88,"d_holders":1249},"weekly":{"bars":[{"time":"2026-07-27","open":215.0,"high":216.5,"low":159.0,"close":177.0,"volume":33401.453},{"time":"2026-08-03","open":179.5,"high":219.0,"low":179.0,"close":207.5,"volume":33533.495},{"time":"2026-08-10","open":213.5,"high":238.0,"low":210.5,"close":225.5,"volume":56491.98700000001},{"time":"2026-08-17","open":22