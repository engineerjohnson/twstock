05","foreign":7879.903,"trust":412.0,"dealer":1106.537},{"date":"2026-10-02","foreign":1579.056,"trust":136.226,"dealer":354.859},{"date":"2026-10-01","foreign":-937.8,"trust":-115.0,"dealer":-44.788},{"date":"2026-09-30","foreign":429.974,"trust":595.0,"dealer":-151.837},{"date":"2026-09-29","foreign":1329.348,"trust":747.0,"dealer":27.449}],"news":[{"id":"cnyes6641724","source":"鉅亨網","category":"台股","title":"AI需求顯現 華通規劃連續3年每年資本支出皆維持200億元以上","link":"https://news.cnyes.com/news/id/6641724","published":1793340396,"summary":"HDI大廠華通(2313-TW)為因應全球客戶對AI資料中心基礎設施及新世代低軌衛星（LEO）產品的強勁需求，公司積極調整產品結構並擴大國內外產能布局，規劃2026-2028年，連續三年資本支出均維持在200億元以上的高檔水位。 華通今年9月營收86.17億元，創歷史新高，月增22.9%，年增15%，主要受惠於低軌衛星與美系智慧手機相關產品都有明顯成長，累計1-9月營收達621.25億元，較去年同期增加約13%，也創下歷史同期新高。 華通將於將於11月5日召開董事會，會後並將公告第三季財報。 相關PCB業者分析，低軌道衛星產業在今年年底前到明年上半年，將迎來Starship星艦V3火箭的加速發射與V3及D2C衛星的穩定部署，隨著上游材料業者新產能開出，太空PCB板與LEO地面設備PCB板的原物料供應，正在逐漸改善，全球低軌道衛星產業鏈將進入另一階段的加速成長。 華通很早就投入太空PCB板研發與生產，與主要客戶合作10年，目前太空PCB板也由華通囊括大部分的市場份額。隨著衛星升級，勢必帶動相關零組件價值提升，也將進一步推升整體營收及利潤。 展望2027-2028年，法人分析，隨著AI資料中心基礎設施架構的升級，算力提升的同時，必須更快速地進行伺服器集群的互聯升級，對於資料傳輸速度、頻寬的要求更高，推動資料中心使用的光模塊(光收發模組)大量地升級到800G或1.6T規格。","sentiment":1,"tags":{"topics":["營收","擴產/資本支出","法說/展望","AI/半導體"],"bull":["新高","成長","年增","擴大","受惠","布局"],"bear":[],"score":7,"highlights":["年增15%"],"keywords":["PCB","AI","華通"]},"time":"10/30 14:06"},{"id":"0f7c9f505a979ff1","source":"CMoney","category":"台股","title":"2313 華通 - 今日買賣超主力 買超主力：外資、內資 外資代表： 港商野村（... - 股市爆料同學會","link":"https://news.google.com/rss/articles/CBMiWEFVX3lxTE9fSVJ3aWVMdlVXUDJ2SVJJeTB1eVh6UFUzdTc1V01NUlF1NzVNLW5FalViR1VGWmljQ2x6Nm94bExhMWJpMVZDX0hFQ05LZHpoRHdaUmhUM00?oc=5","published":1793287608,"summary":"2313 華通 - 今日買賣超主力 買超主力：外資、內資 外資代表： 港商野村（... - 股市爆料同學會 CMoney","sentiment":0,"tags":{"topics":["法人動向"],"bull":["買超"],"bear":["賣超"],"score":0,"highlights":[],"keywords":[]},"time":"10/29 23:26"},{"id":"61b9aef0a94eedb9","source":"Yahoo股市-台股","category":"台股","title":"低軌衛星臉綠！「這檔」崩跌停拖金像電、群創、華通、聯發科挫4% 穩懋卻連衝2根漲停","link":"https://tw.stock.yahoo.com/news/%E4%BD%8E%E8%BB%8C%E8%A1%9B%E6%98%9F%E8%87%89%E7%B6%A0-%E9%80%99%E6%AA%94-%E5%B4%A9%E8%B7%8C%E5%81%9C%E6%8B%96%E9%87%91%E5%83%8F%E9%9B%BB-%E7%BE%A4%E5%89%B5-%E8%8F%AF%E9%80%9A-111500257.html","published":1793272500,"summary":"[FTNN新聞網]記者陳献朋／綜合報導經聯準會恐再升息、地緣政治風險升高導致油價上漲、美系科技巨頭財報不如預期等因素影響，台股大盤今（29）日收跌，加權指...","sentiment":-1,"tags":{"topics":["法說/展望","總經/聯準會","關稅/地緣"],"bull":["漲停"],"bear":["跌停","崩跌","不如預期","升息","崩"],"score":-9,"highlights":[],"keywords":[]},"time":"10/29 19:15"},{"id":"c76a6de9d2529525","source":"富聯網","category":"台股","title":"《投信買超8-6》鴻勁(287)、華通(271)、聯茂(269)","link":"https://news.google.com/rss/articles/CBMiiAFBVV95cUxNVkZBWldzWUlpV1B1MXBvYVQzXzU0RERoUzY5SkwwRE4wX2Y4ZW5nWVVwN01ENXphSDNad2JYYlZDUjVkanN4NV9yRFQ4T29qX1ZnN0JfQnhQekgzMmRaNVVNMEg5aXlHMFVCWVBTTENjQUU2N0dtNDQwYjRyaWUzRndTRDJEMlBu?oc=5","published":1793143980,"summary":"《投信買超8-6》鴻勁(287)、華通(271)、聯茂(269) 富聯網","sentiment":1,"tags":{"topics":["法人動向"],"bull":["買超"],"bear":[],"score":2,"highlights":[],"keywords":[]},"time":"10/28 07:33"},{"id":"5cc2e3a54c22d4d4","source":"Yahoo股市-國際","category":"國際","title":"馬斯克什麼都要搬上太空 受惠台鏈更多了","link":"https://tw.news.yahoo.com/%E9%A6%AC%E6%96%AF%E5%85%8B%E4%BB%80%E9%BA%BC%E9%83%BD%E8%A6%81%E6%90%AC%E4%B8%8A%E5%A4%AA%E7%A9%BA-%E5%8F%97%E6%83%A0%E5%8F%B0%E9%8F%88%E6%9B%B4%E5%A4%9A%E4%BA%86-224649580.html","published":1793141209,"summary":"特斯拉暨SpaceX執行長馬斯克近期關注超級智慧（SI）與太空議題，積極將通訊、AIDC（AI資料中心）、機器人、甚至SI都搬上太空。法人看好，除昇達科、華通、啓碁、鴻海等既有SpaceX供應鏈訂單可","sentiment":1,"tags":{"topics":["訂單/接單","AI/半導體"],"bull":["訂單","看好","供應鏈","受惠"],"bear":[],"score":6,"highlights":[],"keywords":[]},"time":"10/28 06:46"},{"id":"cnyes6637671","source":"鉅亨網","category":"台股","title":"CCL廠騰輝電子泰國新廠今開幕 昆山同步投資15億元擴產","link":"https://news.cnyes.com/news/id/6637671","published":1793004646,"summary":"CCL(銅箔基板)電子材料製造商騰輝電子-KY(6672-TW)今(26)日於泰國大城府Hi-Tech工業園區舉行新廠開幕典禮，正式啟用集團在東南亞首座生產基地。配合全球供應鏈重組及AI高算力、資料中心等新興應用發展，騰輝電子同步推進泰國廠後續產能建置及中國昆山15億元擴產計畫，進一步強化全球製造布局、供應鏈韌性與高階材料競爭力。 騰輝電子-KY泰國新廠開幕典禮由騰輝董事長王有慈、執行長鍾健人、董事邱奕誠及集團副總王琢共同主持。大城府最高行政長官—府尹查瓦寧（Chawanin Wongsattjirakan）並率領當地核心首長團隊隆重出席，共同見證集團全球策略布局的重要里程碑。 騰輝電子-KY泰國新廠占地約3.5萬平方公尺，主要生產銅箔基板及黏合片，目前已開始小量出貨，預計2026年底正式量產，後續上膠產能將於2027年陸續開出，屆時泰國廠總設計產能預計再提升15%。新廠將落實China+1策略，除服務既有車用電子客戶外，也為未來資料中心及高階電子材料需求預作布局。 騰輝電子-KY指出，因應AI、高階運算與資料中心市場發展，騰輝-KY已於9月17日經董事會通過15億元昆山擴產預算，預計2027年第二季開始量產。結合泰國與昆山雙基地布局，集團將進一步提升全球產能調度彈性，強化國際客戶供應能力。","sentiment":1,"tags":{"topics":["擴產/資本支出","AI/半導體","美股/國際"],"bull":["擴產","供應鏈","布局"],"bear":[],"score":4,"highlights":[],"keywords":["騰輝-KY","CCL","泰國","PCB","尖點","華通","台光電","欣興"]},"time":"10/26 16:50"},{"id":"52619274a4e47807","source":"富聯網","category":"台股","title":"《投信買超6-6》華通(131)、京元電(131)、偉詮電(130)","link":"https://news.google.com/rss/articles/CBMiiAFBVV95cUxOUXBQcERFTXd2WE4wOE1kQUxnZktlc0NjcHMxM1dub1c3NnFWVjVmeWJOdlNmVWMtZUk0MHgwdk1FdWtWbXBUOEYzLW5wMkRrRGl5UUx0WXVnY2hORFlSQVJsQWE0Z0R6TmVTa013bFV0V0l5LXktck9Pbi1QWDUzazd3MnlWcXRf?oc=5","published":1792655460,"summary":"《投信買超6-6》華通(131)、京元電(131)、偉詮電(130) 富聯網","sentiment":1,"tags":{"topics":["法人動向"],"bull":["買超"],"bear":[],"score":2,"highlights":[],"keywords":[]},"time":"10/22 15:51"},{"id":"d265fef6006e6bd2","source":"理財周刊","category":"台股","title":"華通單月與Q3營收雙創新高！投信連12買、大戶狂吃貨，強攻低軌衛星與光模組！","link":"https://news.google.com/rss/articles/CBMib0FVX3lxTFBWdjJvQmN1YWpJcjVQX1JZVVAwZTdzVGp0Q1FDWnlOQzl3RlNGN3d5VWhaMVQxTFhueHlWUU13NG1xckNyLWZ4R2J5MTFCSWxFMWlXMmNvVFlHdmVZYlNWN2xvMktadkZjZkFKLTE0SQ?oc=5","published":1792566000,"summary":"華通單月與Q3營收雙創新高！投信連12買、大戶狂吃貨，強攻低軌衛星與光模組！ 理財周刊","sentiment":1,"tags":{"topics":["營收","法人動向"],"bull":["創新高","新高"],"bear":[],"score":3,"highlights":[],"keywords":[]},"time":"10/21 15:00"},{"id":"f7bc26c1e03e35d1","source":"台灣好新聞","category":"台股","title":"華通單月與Q3營收雙創新高！投信連12買、大戶狂吃貨，強攻低軌衛星與光模組！","link":"https://news.google.?oc=5","published":1792548064,"summary":"華通單月與Q3營收雙創新高！投信連12買、大戶狂吃貨，強攻低軌衛星與光模組！ 台灣好新聞","sentiment":1,"tags":{"topics":["營收","法人動向"],"bull":["創新高","新高"],"bear":[],"score":3,"highlights":[],"keywords":[]},"time":"10/21 10:01"}],"fund":{"code":"231