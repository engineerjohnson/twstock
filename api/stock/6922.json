經/聯準會"],"bull":["創新高","新高","獲利","年增"],"bear":["年減"],"score":4,"highlights":["EPS10.63元","年增76.48%","年增84.44%"],"keywords":["宸曜","工業電腦","邊緣AI"]},"time":"11/11 15:30"}],"fund":{"code":"6922","rev_month":"11510","rev":262206.0,"rev_mom":6.312947015034301,"rev_yoy":62.33655274888559,"rev_cum_yoy":50.928272103264725,"eps_q":10.63,"eps_year":"115","eps_season":"3","net_income":288581.0,"pe":15.02,"pb":3.92,"yield":2.74,"updated":"2026-11-13 17:58"},"tdcc":{"latest":{"date":"2026-11-06","big1000":57.46,"big400":63.68,"retail":11.57,"holders":2858},"prev":{"date":"2026-10-30","big1000":57.46,"big400":63.68,"retail":11.17,"holders":2852},"d_big1000":0.0,"d_big400":0.0,"d_retail":0.4,"d_holders":6},"weekly":{"bars":[{"time":"2026-07-27","open":189.0,"high":189.5,"low":160.0,"close":170.0,"volume":827.47},{"time":"2026-08-03","open":167.5,"high":196.5,"low":167.5,"close":185.5,"volume":987.6730000000001},{"time":"2026-08-10","open":204.0,"high":217.0,"low":197.5,"close":201.0,"volume":2587.533},{"time":"2026-08-17","open":203.5,"high":210.5,"low":189.0,"close":202.5,"volume":1493.59},{"time":"2026-08-24","open":202.5,"high":216.5,"low":200.0,"close":208.5,"volume":1328.821},{"time":"2026-08-31","open":207.5,"high":212.5,"low":201.0,"close":208.5,"volume":697.6719999999999},{"time":"2026-09-07","open":213.5,"high":217.0,"low":185.0,"close":186.0,"volume":1170.5780000000002},{"time":"2026-09-14","open":183.5,"high":191.0,"low":181.5,"close":188.0,"volume":316.823},{"time":"2026-09-21","open":190.5,"high":213.5,"low":190.0,"close":212.0,"volume":890.703},{"time":"2026-09-29","open":212.0,"high":230.0,"low":210.0,"close":212.5,"volume":987.6019999999999},{"time":"2026-10-05","open":213.5,"high":218.0,"low":202.0,"close":203.0,"volume":443.291},{"time":"2026-10-12","open":201.5,"high":204.5,"low":193.5,"close":195.5,"volume":376.396},{"time":"2026-10-19","open":195.5,"high":196.0,"low":189.0,"close":189.0,"volume":264.7},{"time":"2026-10-27","open":189.0,"high":196.5,"low":186.0,"c