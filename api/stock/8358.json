下周二(10月27日)恢復正常開盤交易，處置日也順延至10月27日，除了科嶠(4542-TW)自10月27日處置到11月4日止，共7日，其餘包括金居(8358-TW)、中茂(5205-TW)、大地-KY(8437-TW)等3檔，皆自周二起處置到11月2日、共5日，4檔處置股交易時間皆為每 2分鐘撮合一次，主管機關呼籲投資人能留意。 金居處置原因為當日本益比為65.35、股價淨值比為11.9且為其所屬產業類別股價淨值比之3.09倍、當日周轉率達6.95%。 科嶠處置原因為當日本益比為158.26、股價淨值比為12.66且為其所屬產業類別股價淨值比之3.28倍、當日周轉率達6.66%。 另因科嶠因本益比異常，且周轉率過大，受處置時間長達7個交易日。 中茂處置原因最近6個營業日(含今日)累積之最後成交價跌幅達31.9%。 大地-KY處置原因最近6個營業日(含今日)累積之最後成交價漲幅達28.64%，當日之成交量較最近60個營業日日平均成交量放大14.01倍；元大證券公司當日受託買進該有價證券之成交量占當日該有價證券總成交量之比率為39.01%。","sentiment":0,"tags":{"topics":["EPS/獲利","金融"],"bull":[],"bear":["休市","颱風"],"score":0,"highlights":[],"keywords":["處置股","科嶠","金居","中茂","大地-KY"]},"time":"10/22 21:08"}],"fund":{"code":"8358","rev_month":"11509","rev":1104081.0,"rev_mom":4.529170398450355,"rev_yoy":64.63242245397639,"rev_cum_yoy":48.91451692786363,"eps_q":4.22,"eps_year":"115","eps_season":"2","net_income":1064656.0,"pe":65.35,"pb":11.9,"yield":0.46,"updated":"2026-10-25 00:33"},"tdcc":{"latest":{"date":"2026-10-22","big1000":26.7,"big400":34.57,"retail":44.97,"holders":171428},"prev":{"date":"2026-10-08","big1000":29.35,"big400":37.89,"retail":41.74,"holders":163741},"d_big1000":-2.65,"d_big400":-3.32,"d_retail":3.23,"d_holders":7687},"weekly":{"bars":[{"time":"2026-07-27","open":369.0,"high":375.0,"low":271.0,"close":298.0,"volume":53432.693},{"time":"2026-08-03","open":299.0,"high":397.0,"low":298.0,"close":352.0,"volume":110912.65},{"time":"2026-08-10","open":354.5,"high":462.0,"low":342.5,"close":428.5,"volume":170027.152},{"time":"2026-08-17","open":430.5,"high":444.0,"low":392.0,"close":436.0,"volume":118452.25499999999},{"time":"2026-08-24","open":430.0,"high":543.0,"low":399.0,"close":543.0,"volume":138090.182},{"time":"2026-08-31","open":538.0,"high":564.0,"low":469.5,"close":500.0,"volume":99788.666},{"time":"2026-09-07","open":510.0,"high":535.0,"low":480.5,"close":485.0,"volume":29509.705},{"time":"2026-09-14","open":477.0,"high":530.0,"low":477.0,"close":499.5,"volume":117409.515},{"time":"2026-09-21","open":500.0,"hig