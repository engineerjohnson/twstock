及新世代低軌衛星密集升空的契機下，有助公司結構性轉型。 總管理處總經理陳舜平表示，2025年下半年起，陸續啟動專案性資本支出，以打通瓶頸限制或提高單片產出，在技術進程上，穩懋針對AI Data Center推出涵蓋短中長距的全方位光通訊解決方案，包括VCSEL、CW Laser、EML及InP PIC，並朝200mW至400mW高功率雷射推進。 另穩懋亦突破目前市面主流0.25μm與0.15μm的限制，成功推進至0.1μm GaN HEMT先進製程，搶攻新世代衛星通訊商機。","sentiment":0,"tags":{"topics":["營收","擴產/資本支出","法說/展望","AI/半導體","關稅/地緣"],"bull":["看好"],"bear":[],"score":1,"highlights":[],"keywords":["穩懋","低軌衛星","航太通訊","光通訊","AI Data Center","法說會"]},"time":"10/28 21:20"}],"fund":{"code":"3025","rev_month":"11509","rev":39836.0,"rev_mom":31.26832965367252,"rev_yoy":-61.856430192364776,"rev_cum_yoy":3.255205725224697,"eps_q":1.26,"eps_year":"115","eps_season":"2","net_income":71308.0,"pe":11.49,"pb":3.95,"yield":5.93,"updated":"2026-10-30 16:33"},"tdcc":{"latest":{"date":"2026-10-22","big1000":12.38,"big400":23.32,"retail":32.21,"holders":41637},"prev":{"date":"2026-10-08","big1000":12.38,"big400":23.23,"retail":32.19,"holders":41606},"d_big1000":0.0,"d_big400":0.09,"d_retail":0.02,"d_holders":31},"weekly":{"bars":[{"time":"2026-07-27","open":57.0,"high":57.0,"low":49.6,"close":53.9,"volume":1515.3890000000001},{"time":"2026-08-03","open":54.0,"high":56.6,"low":52.5,"close":53.5,"volume":1060.09},{"time":"2026-08-10","open":53.7,"high":57.9,"low":53.7,"close":56.6,"volume":866.36},{"time":"2026-08-17","open":57.4,"high":58.1,"low":55.5,"close":56.1,"volume":874.874},{"time":"2026-08-24","open":56.1,"high":57.2,"low":53.4,"close":53.6,"volume":1008.124},{"time":"2026-08-31","open":53.1,"high":53.2,"low":51.8,"close":52.3,"volume":862.157},{"time":"2026-09-07","open":51.8,"high":51.9,"low":50.0,"close":50.7,"volume":1048.518},{"time":"2026-09-14","open":49.95,"high":51.7,"low":49.9,"close":51.6,"volume":357.259},{"time":"2026-09-21","open":51.5,"high":52.8,"low":50.8,"close":52.4,"volume":449.389},{"time":"2026-09-29","open":52.4,"high":59.9,"low":52.3,"close":55.4,"volume":2266.052},{"time":"2026-10-05","open":55.4,"high":60.7,"low":55.3,"close":56.2,"volume":4462.255},{"time":"2026-10-12","open"