":-581.327,"trust":348.0,"dealer":223.25},{"date":"2026-11-09","foreign":-873.58,"trust":1977.0,"dealer":543.432},{"date":"2026-11-06","foreign":-279.355,"trust":0.0,"dealer":281.665},{"date":"2026-11-05","foreign":280.267,"trust":-2.379,"dealer":262.23},{"date":"2026-11-04","foreign":1401.546,"trust":238.0,"dealer":113.654},{"date":"2026-11-03","foreign":417.028,"trust":-246.0,"dealer":14.625},{"date":"2026-11-02","foreign":-127.857,"trust":1251.0,"dealer":43.403},{"date":"2026-10-30","foreign":3171.633,"trust":1.0,"dealer":352.039},{"date":"2026-10-29","foreign":597.273,"trust":3.0,"dealer":-59.756},{"date":"2026-10-28","foreign":604.979,"trust":3.0,"dealer":-67.062},{"date":"2026-10-22","foreign":5441.972,"trust":91.0,"dealer":742.478},{"date":"2026-10-21","foreign":2384.121,"trust":-735.0,"dealer":-591.087}],"news":[{"id":"cnyes6669422","source":"鉅亨網","category":"台股","title":"〈晶呈法說〉晶呈展2項光纖專利新技術布局市場 不受AI需求疑放緩減少擴產","link":"https://news.cnyes.com/news/id/6669422","published":1795178294,"summary":"特殊氣體廠晶呈科技(4768-TW)今(20)日舉行法說會，針對全球AI市場波動，有法人指出，全球AI有減緩需求的發展疑慮。晶呈科技董事長陳亞理今在法說上表示，目前AI客戶需求未變，公司正積極擴大TGV(玻璃通孔)擴產計畫也如期推進，明(2027)年底前將累計完成建置12條產線。 晶呈也在法說上展現2項光纖自動化組裝相關專利技術，並透過技術整合加快CPO(共同封裝光學)相關產品的商業化進程。 晶呈表示，從目前接收到AI領域客戶訊息顯示，需求面上產品及出貨數量仍維持穩定，素前TGV Glass Core主要客戶集中於通訊ASIC下的IC設計公司及CPO FAU領域。 晶呈指出，這2個區塊為主要市場，目前TGV成長幅度正逐步擴大，且晶呈TGV Glass Core Board是以既有氣態分解熔蝕技術發展的工藝，因此亦可用於非玻璃材料，公司對於未來前景展望非常樂觀。 此外，晶呈也在法說上展示，近期釋出的2項光纖自動化組裝相關專利技術，包括光纖自動穿入系統及內嵌式磁性導引光纖技術，將透過磁力牽引取代傳統機械推入方式，以提升FAU光纖組裝效率與良率。 晶呈表示，目前已與光纖製造商及設備開發商接洽合作，希望透過技術整合加快 CPO 相關產品的商業化進程，目前這項2項專利，自本(11)月起正式對外界推廣，初期市場反應非常不錯，公司正與潛在客戶洽談相關授權。","sentiment":1,"tags":{"topics":["擴產/資本支出","法說/展望","AI/半導體"],"bull":["擴產","擴大","布局"],"bear":["減少"],"score":3,"highlights":[],"keywords":["光纖","晶呈科技","CPO","AI"]},"time":"11/20 20:38"},{"id":"cnyes6669357","source":"鉅亨網","category":"台股","title":"〈晶呈法說〉Q3特殊氣體占營收91%以上 TGV明年業績成長幅度有望翻倍","link":"https://news.cnyes.com/news/id/6669357","published":1795175519,"summary":"半導體特殊氣體廠晶呈科技(4768-TW)今(20)日舉行法說會，也公告自結今(2026)年第3季財報及未來展望，晶呈科技積極擴大TGV(玻璃通孔)相關業務布局，其中受惠於受惠通訊IC及共同封裝光學(CPO)應用需求持續增溫，第3季特殊氣體占營收已達91%以上，也持續擴展TGV產線， 明(2027)年底前預計建置完成12條產線。 晶呈第3季營收3.78億、季減約0.6%、年增約57%；稅後淨損1,173萬元、單季每股淨損0.24元，本業營業利益已轉虧為盈，累計今年前3季營收年增逾翻倍，但受到研發費用大幅攀升影響，前3季每股累計仍虧損1.22元。 晶呈科技表示，前3季虧損原因仍在研發費用增加影響，但公司目前持續加強轉型產品技術研發，目前在TGV合作客戶分為五大類，分別為是IC設計公司、載板廠、生物晶片IC設計、探針卡製造廠與CPO FAU製造廠，其中大型IC設計有3家與晶呈合作，且已陸續出貨，載板廠則有4家廠商合作，CPO FAU領域則有5家公司與晶呈合作，客戶遍及美、日及台灣等地區客戶。 晶呈指出。目前TGV已於第2、3季起有營收獲利，成長幅度也正逐步擴大，以第3季為例特殊氣體的營收占比已達91 %，前3季營收占比特殊氣體部分比去(2025)年同期更成長100%以上。","sentiment":1,"tags":{"topics":["EPS/獲利","營收","法說/展望","AI/半導體"],"bull":["成長","翻倍","年增","擴大","受惠","布局"],"bear":[],"score":9,"highlights":["成長100%"],"keywords":["晶呈科技","特殊氣體廠","AI","CPO","載板廠"]},"time":"11/20 19:51"},{"id":"cnyes6669255","source":"鉅亨網","category":"盤前盤後","title":"外資再提款94億元續砍0050本周大賣逾30萬張 聯電與面板雙虎反獲青睞","link":"https://news.cnyes.com/news/id/6669255","published":1795169469,"summary":"電子權值值、傳產全倒今(20)日全倒，金管會祭出「有條件禁空令」也擋不住沈重賣壓，台股終場跌2393.6點或6.23%，創史上第三大跌點，收36033.29點，成交量8773.5億元。外資今天持續提款，賣超94.13億元，連5賣，並再度大舉砍出0050，本周大賣0050超過30萬張，不過反手加碼聯電與面板雙虎。 觀察三大法人今天籌碼動向，三大法人同站賣方，外資賣超94.13億元，連5賣，投信終止連2買，轉賣超87.49億元，自營商賣超340.84億元，連5賣，三大法人合計賣超522.46億元。 外資今天再度瞄準0050減碼，賣超11萬張，連續5個交易日賣超，本周合計大砍36.2萬張。此外，也持續減碼主動式ETF，賣超00403A主動統一升級50 3.4萬張，00991A主動復華未來50 2.9萬張，00406A主動中信台灣收益1.6萬張，00981A主動統一台股增長1.2萬張。 外資賣超個股方面，今天減碼臺企銀2.5萬張，中鋼2.1萬張，兆豐金1.2萬張，台積電1.1萬張，仁寶1萬張，大成鋼8535張，遠東銀7825張，台玻7666張，台泥6789張，鴻海6673張。 外資今天青睞聯電與面板雙虎，買超聯電8萬張，群創4.6萬張，友達2.8張，並同步加碼力積電1.8萬張，台新新光金1.7萬張，華航1.1萬張，華邦電1萬張，第一金8599張，旺宏7823張，國泰金7130張。","sentiment":-1,"tags":{"topics":["法人動向","AI/半導體"],"bull":["加碼"],"bear":["大跌","賣超","賣壓","提款"],"score":-5,"highlights":[],"keywords":["外資","三大法人","台積電","0050","聯電","群創","友達"]},"time":"11/20 18:11"},{"id":"cnyes6668857","source":"鉅亨網","category":"台股","title":"環工業者裕山多元方向發展擬辦現增籌資 將發行1萬張現增股","link":"https://news.cnyes.com/news/id/6668857","published":1795150350,"summary":"具備自主研發能力及海外業務經驗的環工業者裕山 (7715-TW)，向金管會申報辦理發行1萬張現增股的市場籌資案，今(20)日申報生效，主辦券商爲永豐金證券 裕山在在業務方向上 ，包括拓展半導體、電子製造等高科技產業工程業務。整合環境整治、工程管理及機電統包服務。深化