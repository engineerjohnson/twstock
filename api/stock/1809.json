部；其中最受矚的是新材料事業，包括螢光玻璃片、低介電類晶玻璃陶瓷基板、固態電池用電解質隔離膜材料等三大產品線。","sentiment":1,"tags":{"topics":["訂單/接單","EPS/獲利","法說/展望","AI/半導體","關稅/地緣","金融"],"bull":["獲利","翻倍","供應鏈","出貨","年增","受惠"],"bear":[],"score":9,"highlights":["EPS為0.11元","EPS為0.12元","成長40%"],"keywords":["中釉","玻璃","新材料","AI"]},"time":"11/23 19:46"}],"fund":{"code":"1809","rev_month":"11510","rev":217195.0,"rev_mom":-4.867547348318937,"rev_yoy":-3.2883604951464958,"rev_cum_yoy":-1.1722039256004158,"eps_q":0.12,"eps_year":"115","eps_season":"3","net_income":-1839.0,"pe":151.0,"pb":1.71,"yield":0.83,"updated":"2026-11-27 02:23"},"tdcc":{"latest":{"date":"2026-11-20","big1000":42.49,"big400":47.68,"retail":31.03,"holders":54006},"prev":{"date":"2026-11-13","big1000":42.49,"big400":48.12,"retail":30.4,"holders":53800},"d_big1000":0.0,"d_big400":-0.44,"d_retail":0.63,"d_holders":206},"weekly":{"bars":[{"time":"2026-07-27","open":36.9,"high":37.4,"low":29.3,"close":32.2,"volume":9593.517},{"time":"2026-08-03","open":31.6,"high":40.65,"low":31.5,"close":37.3,"volume":12944.693000000001},{"time":"2026-08-10","open":37.55,"high":43.95,"low":37.55,"close":40.15,"volume":17569.129},{"time":"2026-08-17","open":40.15,"high":40.4,"low":37.0,"close":38.35,"volume":5220.729},{"time":"2026-08-24","open":38.35,"high":40.75,"low":36.65,"close":39.7,"volume":6932.669},{"time":"2026-08-31","open":39.25,"high":39.75,"low":36.7,"close":37.75,"volume":4600.773999999999},{"time":"2026-09-07","open":37.75,"high":39.85,"low":37.25,"close":37.45,"volume":5840.32},{"time":"2026-09-14","open":37.4,"high":39.1,"low":36.0,"close":38.6,"volume":5950.939},{"time":"2026-09-21","open":38.6,"high":45.35,"low":38.2,"close":45.35,"volume":19331.006},{"time":"2026-09-29","open":45.1,"high":48.8,"low":43.05,"close":47.55,"volume":66606.82699999999},{"time":"2026-10-05","open":47.9,"high":48.35,"low":44.7,"close":45.45,"volume":14070.741999999998},{"time":"2026-10-12","open":44.55,"high":46.05,"low":40.2,"close":41.8,"volume":11021.302},{"time":"2026-10-19"