生效，為獲利增添動能。 百容2026年第二季營收達5.66億元，創歷年同期新高，季增17.62%、年增20.42%，其中半導體應用營收占比達50.4%。受惠營收規模擴大、毛利率與營業利益率上揚，加上業外收益及匯率等有利因素，上半年稅後純益突破4362萬元，每股純益0.41元。 為擴大半導體業務，百容董事會決議斥資3.23億元，購置台中工業區工一路廠房及土地，土地面積約702坪，目前已完成過戶。百容後續將投入資金添購設備並興建新廠房，導入重型沖壓設備，投入大功率散熱片研發與生產。","sentiment":1,"tags":{"topics":["訂單/接單","EPS/獲利","營收","擴產/資本支出","AI/半導體","總經/聯準會","匯率"],"bull":["接單","訂單","需求強勁","獲利","漲價","出貨"],"bear":[],"score":12,"highlights":["年增20.42%"],"keywords":["半導體","百容","營收","毛利率","漲價"]},"time":"10/29 12:09"}],"fund":{"code":"2483","rev_month":"11509","rev":188796.0,"rev_mom":0.3796216543847896,"rev_yoy":27.300801715360706,"rev_cum_yoy":22.546408290336846,"eps_q":0.4,"eps_year":"115","eps_season":"2","net_income":44467.0,"pe":135.6,"pb":1.33,"yield":0.88,"updated":"2026-10-30 16:33"},"tdcc":{"latest":{"date":"2026-10-22","big1000":56.32,"big400":62.33,"retail":15.91,"holders":9621},"prev":{"date":"2026-10-16","big1000":56.3,"big400":62.18,"retail":16.35,"holders":9804},"d_big1000":0.02,"d_big400":0.15,"d_retail":-0.44,"d_holders":-183},"weekly":{"bars":[{"time":"2026-07-27","open":39.0,"high":39.65,"low":31.5,"close":35.25,"volume":2112.052},{"time":"2026-08-03","open":35.25,"high":43.55,"low":35.05,"close":35.45,"volume":10179.327},{"time":"2026-08-10","open":35.8,"high":41.7,"low":34.8,"close":38.1,"volume":12072.362000000001},{"time":"2026-08-17","open":38.0,"high":38.6,"low":35.3,"close":36.1,"volume":5183.25},{"time":"2026-08-24","open":35.8,"high":38.5,"low":34.3,"close":36.6,"volume":5052.889},{"time":"2026-08-31","open":36.0,"high":36.65,"low":32.85,"close":33.35,"volume":4579.996},{"time":"2026-09-07","open":34.1,"high":34.1,"low":29.95,"close":30.1,"volume":3499.1459999999997},{"time":"2026-09-14","open":30.15,"high":33.2,"low":29.6,"close":33.0,"volume":2490.575},{"time":"2026-09-21","open":33.55,"high":33.75,"low":32.3,"close":32.55,"volume":1610.133},{"time":"2026-09-29","open":32.2,"high":38.4,"low":32.2,"close":37.0,"volume":10832.819},{"time":"2026-10-05","open":38.0,"high":41.5,"lo