","foreign":-335.0,"trust":0.0,"dealer":-15.314},{"date":"2026-10-14","foreign":270.0,"trust":0.0,"dealer":6.957},{"date":"2026-10-13","foreign":-170.0,"trust":0.0,"dealer":15.684},{"date":"2026-10-12","foreign":-15.62,"trust":0.0,"dealer":-0.973},{"date":"2026-10-08","foreign":43.098,"trust":0.0,"dealer":0.151},{"date":"2026-10-07","foreign":-696.0,"trust":0.0,"dealer":-13.643},{"date":"2026-10-06","foreign":-7.978,"trust":0.0,"dealer":-10.125}],"news":[{"id":"cnyes6645209","source":"鉅亨網","category":"台股","title":"〈達方法說〉AI摘要2026/11/3","link":"https://news.cnyes.com/news/id/6645209","published":1793699735,"summary":"一、 2026 年第三季財務與營運詳情 財務表現： 第三季單季營運成果： 合併營收：新台幣 70 億元，季減（QoQ）6.7%、年增（YoY）7.8%。營收季減主因 NB 產業零組件（記憶體、CPU）漲價推升 PC 終端售價並壓抑買氣，致使 IT 周邊元件營收微幅下滑；加上德國通路子公司 Grofa 7~8 月暑假度假因素淡季調節所致。 毛利率與毛利額：營業毛利為 10.54 億元（季減 15.4%、年增 4.6%），毛利率降至 15.0%（季減 1.6 個百分點）。毛利率下滑主因產品組合變動（高毛利的 IT 周邊營收占比滑落）、NB 機構件與貴金屬原物料漲價，以及中國廠區受人民幣升值變相墊高製造成本。 費用管控與獲利：營業費用為 10.2 億元（季減 7.1%、年減 13.4%），持續精實各廠區費用與產能；營業利益為 3,400 萬元（季減 77%、年增 113%），營業利益率約 0.5%；稅後歸屬母公司淨利為 8,500 萬元（季減 1.2%、年增改善），第三季每股盈餘（EPS）為 0.31 元。 2026 前三季累計表現： 前三季累計營收達 205 億元（年增 8.8%），前三季累計毛利率為 16.5%（年增 1.24 個百分點）。 累計營業淨利為 2.61 億元（年增 363%）；歸屬母公司淨利為 2.28 億元（年增近 78%），前三季累計 EPS 為 0.82 元。","sentiment":1,"tags":{"topics":["EPS/獲利","營收","擴產/資本支出","法說/展望","AI/半導體","總經/聯準會","匯率"],"bull":["漲價","年增"],"bear":["下滑"],"score":2,"highlights":["年增 4.6%","年增 113%","EPS）為 0.31 元"],"keywords":["達方","MLCC","自行車","AI"]},"time":"11/03 17:55"},{"id":"cnyes6645201","source":"鉅亨網","category":"台股","title":"〈達方法說〉MLCC事業旺至明年 積極切入AI資料中心散熱與電源市場","link":"https://news.cnyes.com/news/id/6645201","published":1793699551,"summary":"達方(8163-TW)今(3)日召開線上法說會，總經理蔡耀坤表示，儘管下半年個人電腦市場復甦不如預期，但在整合元件與綠能事業雙引擎帶動下，維持全年營收正成長的目標不變。同時公司正積極透過策略投資與內部技術整合，跨足AI資料中心散熱、電源與備援電池領域，啟動新一波價值轉型。 針對近期表現最亮眼的整合元件事業，蔡耀坤指出，包含積層陶瓷電容與集團旗下詠業等元件業務今年表現相當出色，目前占整體營收比重已提升至13%。雖然平價一般品需求增幅放緩，但高容與中高壓等高階產品市場需求依然強勁，加上日系同業策略性淡出部分品項，帶動工廠產能稼動率維持高檔，訂單能見度將一路延續至明年，公司也將持續擴大在伺服器與工控等高附加價值應用的研發投入。 在綠能事業方面，全球自行車產業的成車與材料庫存去化速度明顯優於往年，預計今年底絕大多數庫存調整將告一段落。受惠於前端通路去化加速，旗下德國通路商Grofa今年在售後市場消耗品帶動下，營收成長相當顯著，目前明年新案開案與訂單狀況皆呈現正向，預期明年整體綠能與自行車業務將重返健康的成長軌道。 反觀占營收比重逾四成的IT周邊事業，則面臨較大的市場逆風。由於記憶體、中央處理器與印刷電路板等零組件價格走揚，推升終端筆電官方建議售價大漲30%至50%，加上AI與伺服器排擠訂單效應，導致品牌客戶自8月與9月起大幅下修需求。","sentiment":0,"tags":{"topics":["訂單/接單","營收","擴產/資本支出","法說/展望","AI/半導體"],"bull":["成長","亮眼"],"bear":["不如預期"],"score":0,"highlights":[],"keywords":["達方","PC","MLCC","自行車","AI"]},"time":"11/03 17:52"},{"id":"8c3d42bb2a27c180","source":"經濟日報-證券","category":"台股","title":"達方財報／第3季獲利0.9億元、年大增941.3% 每股賺0.31元","link":"https://money.udn.com/money/story/5710/9854902","published":1793698102,"summary":"達方（8163）董事會3日通過今年第3季財報，單季毛利率15%，季減1.6個百分點，年增0.9個百分點。稅後純益 0.9億元，季減1.2%，年大增941.3%，每股純益0.31 元。","sentiment":1,"tags":{"topics":["EPS/獲利","法說/展望","總經/聯準會"],"bull":["獲利","年增"],"bear":[],"score":2,"highlights":[],"keywords":[]},"time":"11/03 17:28"},{"id":"cnyes6645053","source":"鉅亨網","category":"台股","title":"〈達方法說〉Q3純益年增逾9倍EPS 0.31元 惟筆電需求降溫、原物料漲價壓抑毛利率","link":"https://news.cnyes.com/news/id/6645053","published":1793696736,"summary":"達方(8163-TW)今(3)日召開法說並同步公布第三季財報，第三季稅後純益 0.9 億元，季減 1.2%，年增 941.3%，每股純益 0.31 元。達方指出，由於筆電產業下滑、綠能通路出貨降溫、原物料上漲以及匯率變動，導致第三季營收與毛利率下滑。 達方第三季營收 70.1 億元，季減 6.7%，年增 7.8%；毛利率 15.0%，季減 1.6 個百分點，年增 0.9 個百分點；營業利益3400萬元，季減 77.4%，較去年同期由虧轉盈；營益率 0.5%，季減 1.5 個百分點，年增 4.5 個百分點。稅後純益 0.9 億元，季減 1.2%，年增 941.3%，每股純益 0.31 元。 達方前三季累計營收 205.5 億元，年增 8.8%；毛利率 16.5%，年增 0.6 個百分點；營業利益2.6 億元，較去年同期由虧轉盈；營益率 1.3%，年增 1.8 個百分點；稅後純益 2.3 億元，年增 77.8%，每股純益 0.82 元。 達方財務長林豐正表示，第3季營收與毛利率較上季下滑，主要有三大因素。首先是占營收逾四成的IT周邊事業，受到下半年筆電產業需求下修影響，單季營收呈現雙位數年減，加上歐洲7月與8月適逢暑假，旗下德國綠能通路Grofa出貨微幅降溫，使整體產品組合轉弱。","sentiment":1,"tags":{"topics":["EPS/獲利","營收","法說/展望","總經/聯準會","匯率"],"bull":["漲價","出貨","年增"],"bear":["下滑"],"score":3,"highlights":["EPS 0.31元","年增 941.3%","年增 7.8%"],"keywords":["達方","NB","MLCC","自行車"]},"time":"11/03 17:05"},{"id":"673e3483e203478d","source":"富果直送","category":"台股","title":"【達方法說會重點內容備忘錄】未來展望趨勢 20261103","link":"https://news.google.com/rss/articles/CBMiZ0FVX3lxTE5Ga2FHZmFIaU1EbjBjT3c0NXZ4R2pwb0ctbXdQUUxzR2YyODdrWFc2M0VWT0xCblRSS3BwdEpsajB5ZzlJbk1PRWlqYTdkTmtyVXVIYmJYamVMZGYwcHhxRGpTbzNxN0E?oc=5","published":1793664000,"summary":"【達方法說會重點內容備忘錄】未來展望趨勢 20261103 富果直送","sentiment":0,"tags":{"topics":["法說/展望"],"bull":[],"bear":[],"score":0,"highlights":[],"keywords":[]},"time":"11/03 08:00"},{"id":"cnyes6637492","source":"鉅亨網","category":"國際","title":"AI載板量產難度升高 特斯拉出資確保供應，輝達攜三星電機、欣興等拚三年產能增至2.5倍","link":"https://news.cnyes.com/news/id/6637492","published":1792938604,"summary":"2026年10月25日（優分析／產業數據中心報導）⸺ AI晶片需求持續增加，科技大廠開始出資確保高階載板產能。根據韓國《每日經濟》報導，特斯拉Tesla(TSLA-US)與輝達NVIDIA(NVDA-US)將合計投入3.7兆韓元，約28億美元（約新台幣910億元），協助三星電機Samsung Electro-Mechanics(009150-KR)擴建覆晶球柵陣列（FC-BGA）載板產線，支應自駕車、人形機器人及資料中心需求。 三星電機9月已公布，將投入4.27兆韓元擴充世宗廠FC-BGA產能，為公司歷來規模最大的單一產品投資案。據報導，其中1.1兆韓元將由特斯拉負擔，換取2029年至2033年、為期五年的供貨安排，產品將用於自駕電動車及人形機器人Optimus的AI晶片。 世宗新廠預計2027年底完工，2028年上半年完成設備建置與試運轉，下半年投入量產，2029年開始向特斯拉交貨。三星電機先前表示，透過客戶提供投資資金及中長期採購安排，可降低擴產資金負擔，並為新增產線提前取得穩定長期訂單。 輝達方面，其投資規模約2.6兆韓元。三星電機與輝達已於10月21日正式宣布合作，將共同投資世宗及釜山的專用產線，供應AI運算晶片及資料中心高速網路交換器使用的ABF載板。 輝達供貨時程較早，三星電機規劃自2026年起交貨，未來數年供貨量預計維持雙位數年增率。","sentiment":0,"tags":{"topics":["訂單/接單","擴產/資本支出","AI/半導體","匯率","美股/國際"],"bull":[],"bear":[],"score":0,"highlights":[],"keywords":["ABF","FC-BGA","優分析"]},"time":"10/25 22:30"}],"fund":{"code":"8163","rev_month":"11509","rev":2162368.0,"rev_mom":-6.77406949452725,"rev_yoy":-3.43536540055446,"rev_cum_yoy":8.810226165770192,"eps_q":0.82,"eps_year":"115","eps_season":"3","net_income":109082.0,"pe":29.66,"pb":0.67,"yield":1.92,"updated":"2026-11-06 17:49"},"tdcc":{"latest":{"date":"2026-10-30","big1000":39.61,"big400":44.96,"retail":24.87,"holders":74537},"prev":{"date":"2026-10-22","big1000":39.39,"big400":44.72,"retail":24.91,"holders":74608},"d_big1000":0.22,"d_big400":0.24,"d_retail":-0.04,"d_holders":-71},"weekly":{"bars":[{"time":"2026-07-27","open":32.3,"high":32.3,"low":27.9,"close":30.6,"volume":6958.544},{"time":"2026-08-03","open":30.05,"high":32.75,"low":29.6,"close":31.15,"volume":6856.406},{"time":"2026-0