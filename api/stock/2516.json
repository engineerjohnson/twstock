foreign":-23.0,"trust":0.0,"dealer":2.0},{"date":"2026-10-15","foreign":0.0,"trust":0.0,"dealer":5.0},{"date":"2026-10-14","foreign":-59.0,"trust":0.0,"dealer":0.0},{"date":"2026-10-13","foreign":70.0,"trust":0.0,"dealer":-2.0},{"date":"2026-10-12","foreign":22.95,"trust":0.0,"dealer":-2.0},{"date":"2026-10-08","foreign":16.0,"trust":0.0,"dealer":0.0},{"date":"2026-10-07","foreign":59.0,"trust":0.0,"dealer":-0.004},{"date":"2026-10-06","foreign":-230.0,"trust":0.0,"dealer":1.0}],"news":[{"id":"cnyes6651766","source":"鉅亨網","category":"美股","title":"Vistra：資料中心用電需求未轉離德州併網仍是主要瓶頸","link":"https://news.cnyes.com/news/id/6651766","published":1793989805,"summary":"2026年11月07日（優分析／產業數據中心報導）⸺ 美國發電業者Vistra(VST-US)11月6日表示，期中選舉過後，尚未看到大型用電客戶將需求由德州轉往美國東部PJM電力市場。雲端巨擘與資料中心業者仍積極洽談供電，真正牽動專案進度的，仍是何時能接上電網。 Vistra管理層在第三季法說會指出，德州仍是具吸引力的市場。資料中心面臨的用水、土地與稅負等審查，也不只發生在德州；客戶評估設址時，最在意的是取得電力的速度，以及地方社區與政府是否支持。公司在德州與PJM均持續洽談大型用電專案，涵蓋既有及新建燃氣電廠，也看好後續核電購電協議的機會，但未承諾簽約時程。 電網接入時間仍是供電合約的重要限制。管理層表示，部分雲端、AI模型及資料中心開發商為了盡快取得電力，願意先採成本較高的「表後供電」，也就是在用戶電表後方直接供電，待電網接入完成後再轉換供電方式。這類安排可作為過渡方案，但也凸顯資料中心擴建不只取決於發電容量，還得配合電網接入進度。 Vistra同日公布，旗下德州Odessa燃氣電廠已與New Era Energy and Digital簽訂20年、207MW的購電協議。公司表示，選舉結果讓政策方向更明朗，有助客戶評估專案；不過，許可與電網接入仍會影響落地速度。","sentiment":0,"tags":{"topics":["法說/展望","AI/半導體"],"bull":[],"bear":[],"score":0,"highlights":[],"keywords":["電力","電網","AI","優分析"]},"time":"11/07 02:30"},{"id":"cnyes6650395","source":"鉅亨網","category":"台股","title":"股災還沒結束？融資不殺乾淨，台股難見真正大底！","link":"https://news.cnyes.com/news/id/6650395","published":1793957896,"summary":"11月6日台股上演驚心動魄的多空攻防，早盤恐慌性賣壓傾巢而出，指數最低下探37,837點，盤中多檔大型權值股觸及跌停，最終卻拉出接近2,000點的長下影線，跌停家數收斂至24家。總統賴清德出面信心喊話，金管會、證交所與國安基金也陸續表態關注市場。值得注意的是，元大台灣50（0050）成交量高達86萬張，元大台灣50正2（00631L）更爆出130萬張大量。這種極端恐慌下的低檔爆量，搭配大型權值股開低走高，顯示市場可能已有承接資金進場。雖然無法據此斷言絕對底部已經出現，但至少可以確認，台股正進入多空力量重新平衡的關鍵階段。 真正決定台股能否止跌的關鍵，並非外資何時翻多，而是融資籌碼是否充分清洗。以11月5日數據觀察，上市大盤自高點回落約16.55%，融資餘額卻僅減少9.61%；櫃買指數跌幅達25.4%，融資減幅也只有18.62%，顯示散戶去槓桿速度仍落後股價修正。若以融資減幅至少達到指數跌幅八成作為初步檢驗標準，配合11月6日盤中跌勢估算，上市融資至少還需減少420億元、約7.3%，上櫃融資則需減少110億元、約6%，才能顯著改善籌碼結構。若上市櫃合計減幅進一步接近1,000億元，市場籌碼將更趨穩定。換言之，融資斷頭固然殘酷，卻也是市場重新建立健康籌碼結構的必要過程。 至於引發科技股重挫的AI疑慮，市場可能混淆了政策限制與需求消失兩件事。","sentiment":-1,"tags":{"topics":["法人動向","AI/半導體"],"bull":[],"bear":["跌停","恐慌","賣壓"],"score":-7,"highlights":[],"keywords":["趨勢分析","摩爾投顧","謝晨彥","台股"]},"time":"11/06 17:38"},{"id":"bdaa833accd1b5ca","source":"CMoney","category":"台股","title":"2330 台積電 - [00981A 操作日報] 淨值重挫，經理人新建倉中信金- 股市爆料同學會","link":"https://news.google.com/rss/articles/CBMiWEFVX3lxTE1zZmE0aGF4UTFIbUVRS3d6QVI0WkhlTWgzUkU5Z2s1NExBT3p6UXY5S0NFWkJGWEUzRS1KZWxTSk8yc2tkeG95c1ZYcnB6T05WUnBLN0ROeHI?oc=5","published":1793876456,"summary":"2330 台積電 - [00981A 操作日報] 淨值重挫，經理人新建倉中信金- 股市爆料同學會 CMoney","sentiment":-1,"tags":{"topics":["AI/半導體"],"bull":[],"bear":["重挫"],"score":-3,"highlights":[],"keywords":[]},"time":"11/05 19:00"},{"id":"cnyes6645971","source":"鉅亨網","category":"國際","title":"BMW再下修汽車獲利展望 加速裁員重整、全年交車估減5%至9.9%","link":"https://news.cnyes.com/news/id/6645971","published":1793755806,"summary":"2026年11月04日（優分析／產業數據中心報導）⸺ 德國豪華車廠BMW宣布下修2026年汽車業務獲利展望，預估息稅前利潤率（EBIT margin）由原先的1%至3%，降至負0.5%至正0.5%。這是公司五個月內第二度調降預測，主要受到加速裁員與重整的一次性成本影響。 BMW表示，將擴大並加強業務組合與結構調整，加快組織重整進度，管理職能的精簡速度也將快於先前公布的計畫。公司近期提出約8,000人的裁員方案，希望在接連發布獲利預警後，重新建立投資人信心。 銷售端同樣承壓。BMW目前預估2026年汽車業務交車量將年減5%至9.9%，並將於11月4日公布第三季財報。中國市場需求疲弱，是公司今年啟動重整的重要背景；當地消費者愈來愈傾向價格較低的本土品牌，使傳統豪華車廠過去穩定的獲利來源受到衝擊。 這股壓力也延伸至其他德國車廠。賓士上週因中國市場持續疲弱而調降獲利展望，福斯與BMW則陸續推動大規模重整。對BMW而言，銷量下滑之際加快人力與組織調整，短期先反映為額外費用，讓全年汽車業務獲利預估進一步降至接近損益兩平。 ※ 本文經「優分析」授權轉載，原文出處: 原文連結 ※ 免責聲明：文中所提的個股、基金、期貨商品內容僅供參考，並非投資建議，投資人應獨立判斷，審慎評估風險。","sentiment":-1,"tags":{"topics":["EPS/獲利","法說/展望"],"bull":["獲利","擴大"],"bear":["下修","調降","裁員"],"score":-5,"highlights":[],"keywords":["BMW","重整","汽車","優分析"]},"time":"11/04 09:30"},{"id":"48b044e382a97b6b","source":"CMoney投資網誌","category":"台股","title":"【00981A】11/03 操作日報｜趁大跌加碼台積電，新建倉台玻","link":"https://news.google.com/rss/articles/CBMifkFVX3lxTE9ZSEJlemR5bzJkWUdUM3NVTzJQRFEyYmNJSmc3TUNFV2V5Q1lYY3ZpSEdCS2prMUNJV1F2R2FXQkRxVHFKZVhHTGFxU2VPaktQeXZhdklzYjUxZnZzTE1TQkdrckVPaG5yNWxqQVoxYlBVZlFwNmJ0NnE5Sk9qQQ?oc=5","published":1793703654,"summary":"【00981A】11/03 操作日報｜趁大跌加碼台積電，新建倉台玻 CMoney投資網誌","sentiment":0,"tags":{"topics":["AI/半導體"],"bull":["加碼"],"bear":["大跌"],"score":0,"highlights":[],"keywords":[]},"time":"11/03 19:00"},{"id":"cnyes6640693","source":"鉅亨網","category":"台股","title":"波力-KY柬埔寨新廠2027年首季投產 初期主攻冰上曲棍球桿","link":"https://news.cnyes.com/news/id/6640693","published":1793269344,"summary":"複合材料廠波力-KY(8467-TW)總經理洪進山今(29)日在法說會中指出，波力-KY在柬埔寨投資興建的新廠房已完成建置，設備陸續運抵並進行驗收中，預估2027年首季進入營運，並將導入自動化設備。 波力-KY以ODM模式為主力客戶Bauer生產的冰上曲棍球桿，全球市占率已達60%。隨著公司在中南半島柬埔寨布局新廠及新增生產線，初期將以冰上曲棍球桿為主要生產項目，進一步擴充產能。 總經理洪進山指出，今年以來原物料價格攀升，如日本碳纖維紗價格上漲約15%，對毛利及獲利形成壓力。而新建的柬埔寨廠則導入自動化設備。 波力-KY與漢翔(2634-TW)合作推進布局航機複材次結構件、內裝及座椅零件，並打入空中巴士民航客機的供應鏈，簽下20年的供應合約。 波力-KY 2026年上半年營收11.26億元，稅後純益1.22億元，每股純益2.53元。第三季營收7.43億元，年增5.68%，1-9月累計營收18.69億元，年減6.74%。","sentiment":0,"tags":{"topics":["EPS/獲利","營收","擴產/資本支出","法說/展望","法人動向"],"bull":["布局"],"bear":[],"score":1,"highlights":["年增5.68%"],"keywords":["波力-KY","營收","柬埔寨"]},"time":"10/29 18:22"},{"id":"cnyes6638158","source":"鉅亨網","category":"台股","title":"國產集團推動「碳競爭優勢」 旗下國宇ALC、惠普搶攻低碳建築商機","link":"https://news.cnyes.com/news/id/6638158","published":1793067175,"summary":"國產(2504-TW)積極布局低碳建材，旗下國宇建材與惠普分別從ALC輕量化牆體系統及矽酸鈣板低碳製程切入，強化產品減碳與施工效率。國宇建材近期於2026國際永續智慧建築暨智慧建材展展示ALC輕質磚、ALC嵌板等產品，主打較紅磚減碳77.6%；惠普則透過產線改善與智慧化升級，將新建工程訂單占比提升至六成，2026年全年營收可望持平或優於去年。 國宇建材日前受邀參加「2026 Build for NextGen國際永續智慧建築暨智慧建材展」，於建築模組化展區展示ALC輕質磚、ALC嵌板及輕量化牆體系統整合方案，分享低碳建築應用趨勢。 國宇建材總經理楊志強表示，面對營建業缺工、缺料及低碳轉型等挑戰，ALC牆體系統具備隔音、防火及輕量化等特性，其中隔音性能最高達63分貝、防火時效超過3小時。透過工廠預製與模組化施工，可縮短工期、降低施工風險，施工速度較傳統工法提升約40%。 國宇建材李銘智博士指出，ALC輕量化牆體系統可應用於室內隔間、建築外牆及高隔音隔戶牆。其中，ALC輕質磚採乾式施工，可用於室內隔間；ALC嵌板則適用於外牆、屋頂及樓地板，尤其適合鋼構建築，可依需求客製尺寸，經工廠預製後運抵現場安裝，減少現場切割與施工廢料。高隔音複合牆的隔音效果最高達63分貝，優於50分貝的隔音標準；相較傳統RC牆體，整體成本約可節省25%至30%。","sentiment":1,"tags":{"topics":["訂單/接單","營收"],"bull":["訂單","布局"],"bear":[],"score":3,"highlights":[],"keywords":["國產","建材","趨勢分析"]},"time":"10/27 10:12"}],"fund":{"code":"2516","rev_month":"11509","rev":544759.0,"rev_mom":-23.538