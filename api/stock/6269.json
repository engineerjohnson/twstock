%8D%E5%BD%88-pcb%E5%85%A8%E7%B7%9A%E5%BC%B7%E5%99%B4-%E9%80%997%E6%AA%94-%E7%8E%87%E5%85%88%E4%BA%AE%E7%87%88%E6%BC%B2%E5%81%9C-023500456.html","published":1794278100,"summary":"台股今（10）日展現強勁的報復性反彈，盤中加權指數一度狂飆超過1400點。其中，PCB族群成為市場焦點全面噴發，大哥南電與二哥欣興率先亮燈漲停，帶動台郡、同欣電、楠梓電、金像電與台表科等多檔概念股同步","sentiment":1,"tags":{"topics":[],"bull":["漲停","反彈"],"bear":[],"score":4,"highlights":[],"keywords":[]},"time":"11/10 10:35"},{"id":"cnyes6648368","source":"鉅亨網","category":"台股","title":"生產需求走緩 台虹10月營收下滑至7.93億元呈月年雙減","link":"https://news.cnyes.com/news/id/6648368","published":1793877760,"summary":"由元太科技(8069-TW)入主經營權的FCCL(軟性銅箔基板廠)台虹(8039-TW)今(5)日公布最新營收資訊，2026年10月營收7.93億元，月減5.63%，年減17.42%，2026年1-10月營收爲83.98億元，年減4.83%。台虹已公布最新2026年前三季稅後純益6.15億元，年增79.93%，每股純益為2.33元。 台虹2026年新產品仍在持續開發及驗證中，營運以確保獲利爲主軸，推估全年營收可能不及2025年全年的106.09億元。 台虹2026年第三季營收24.93億元，毛利率22.77%，季減0.36個百分點，年增4.26個百分點，2026年第三季稅後純益2.03億元，季減15.75%，年減10.38%，每股純益0.77元。台虹科技2026年前三季營收76.05億元，毛利率22.66%，年增3.54個百分點，稅後純益6.15億元，年增79.93%，每股純益2.33元。 台虹董事會通過與E Ink元太科技簽訂合作意向書，台虹擬借重元太在電子材料領域深厚的基礎材料開發與製造技術能力，結合自身在電路板材料領域的研發實力與長期產業經驗，強強聯手、優勢互補，共同布局 AI 高速傳輸材料市場。 依據雙方合作意向書架構設定，雙方將共同推動AI高速傳輸材料的技術開發、製程驗證及委託製造等合作事宜。","sentiment":0,"tags":{"topics":["EPS/獲利","營收","AI/半導體","總經/聯準會"],"bull":["獲利","年增"],"bear":["下滑","年減"],"score":0,"highlights":["年增79.93%"],"keywords":["台虹","元太","長華","台郡"]},"time":"11/05 19:22"},{"id":"cnyes6646887","source":"鉅亨網","category":"台股","title":"台郡前3季每股虧損4.83元 產品組合優化看好明年首季轉盈","link":"https://news.cnyes.com/news/id/6646887","published":1793792192,"summary":"處於轉型階段的台郡(6269-TW)，2026年第三季營運仍未轉盈，但受惠產品組合優化，毛利率提升至10.8%，較第二季增加6.5個百分點，單季稅後淨損也收斂至1.79億元，每股虧損0.56元。累計2026年前三季稅後淨損15.44億元，較2025年同期收斂，每股淨損4.83元。展望後市，台郡預估第四季營收將與第三季持平，並看好明年第一季有機會轉虧為盈。 台郡預估，2027年AI高速傳輸相關新產品營收將快速成長，帶動產品組合進一步優化；至於今年仍占營收約7成的消費性電子應用，預計2027年營收占比將降至5成。此外，台郡在中國大陸既有產能也將逐步轉向高階產品應用，進一步調整產能配置與產品布局。 台郡科技董事長鄭明智於今天法說會開場致詞中明確指出，台郡近年來邁向高階製程與價值轉型過程已初見成效，2026年營運在穩健成長中能持續優化產品組合獲利能力。 台郡總經理 David Cheng 在法說會對公司營運策略方向指出，公司持續秉持與客戶建立長期穩健合作關係的經營理念，過去兩年面對市場環境變化及價格競爭壓力，仍積極支持全球性策略客戶需求，深化雙方技術合作基礎下開展新產品。展望未來，公司將更加重視與客戶合作的長期價值與營運效益，深耕核心客戶，並積極朝高技術門檻、高附加價值及高毛利產品領域發展。","sentiment":0,"tags":{"topics":["EPS/獲利","營收","擴產/資本支出","法說/展望","AI/半導體","總經/聯準會"],"bull":["看好","受惠"],"bear":["虧損"],"score":1,"highlights":[],"keywords":["台郡","軟板","AI"]},"time":"11/04 19:36"}],"fund":{"code":"6269","rev_month":"11510","rev":1929248.0,"rev_mom":-8.094285333180892,"rev_yoy":4.484285503843054,"rev_cum_yoy":1.6530770343892576,"eps_q":-4.83,"eps_year":"115","eps_season":"3","net_income":-1516461.0,"pe":null,"pb":1.2,"yield":null,"updated":"2026-11-13 17:58"},"tdcc":{"latest":{"date":"2026-11-06","big1000":24.08,"big400":30.81,"retail":35.52,"holders":91343},"prev":{"date":"2026-10-30","big1000":25.48,"big400":32.5,"retail":34.78,"holders":90494},"d_big1000":-1.4,"d_big400":-1.69,"d_retail":0.74,"d_holders":849},"weekly":{"bars":[{"time":"2026-07-27","open":54.3,"high":55.0,"low":46.0,"close":49.2,"volume":21581.525999999998},{"time":"2026-08-03","open":49.0,"high":70.8,"low":49.0,"close":66.6,"volume":39404.276},{"time":"2026-08-10","open":66.0,"high":69.7,"low":62.6,"close":65.7,"volume":32392.088},{"time":"2026-08-17","open":66.0,"high":67.6,"low":62.2,"close":62.4,"volume":11724.836000000001},{"time":"2026-08-24","open":62.3,"high":78.8,"low":59.0,"close":75.0,"volume":47568.532999999996},{"time":"2026-08-31","open":73.3,"high":82.3,"low":64.7,"close":67.7,"volume":89601.69499999999},{"time":"2026-09-07","open":68.2,"high":71.0,"low":64.7,"close":66.1,"volume":29802.374},{"time":"2026-09-14","open":65.8,"high":66.6,"low":63.0,"close":64.1,"volume":15801.256000000001},{"time":"2026-09-21","open":64.4,"high":66.3,"low":63.3,"close":64.8,"volume":12056.190999999999},{"time":"2026-09-29","open":64.8,"high":66.9,"low":64.3,"close":66.1,"volume":11395.211},{"time":"2026-10-05","open":66.7,"high":66.9,"low":63.4,"close":63.6,"volume":8717.101999999999},{"time":"2026-10-12","open":62.9,"high":82.0,"low":60.3,"close":82.0,"volume":64921.258},{"time":"2026-10-19","open":83.0,"high":93.0,"low":78.1,"