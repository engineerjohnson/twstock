動化競賽」決賽現場。(鉅亨網記者王莞甯攝) 「2026年JINPAO-PRAKSA自動化競賽」(中學及職業教育組工業自動化與機器人競賽)決賽，於10月30日至31日在帕克薩國際教育學校(Praksa Withedsuksa School)舉行。來自泰國26府、共43支隊伍參與，最終16支隊伍進入決賽，透過三輪實作競賽來角逐御賜獎盃和獎金。 本屆賽事已邁入第三屆，以工業自動化、機器人及智慧控制為核心。","sentiment":0,"tags":{"topics":["擴產/資本支出"],"bull":["合作"],"bear":[],"score":1,"highlights":[],"keywords":["經寶","jpp","泰國皇室","泰國台商","機器人"]},"time":"11/01 00:05"},{"id":"7b776994c660dc52","source":"富聯網","category":"台股","title":"《投信買超8-8》尖點(136)、瑞昱(134)、創意(134)","link":"https://news.google.com/rss/articles/CBMiiAFBVV95cUxNM2ZlSTB3cmo2ekRKVXNUQWI3TXNsWndiWk1QMnk0allORm5nWlotZUMweFd5a25JdWZHS2NQdUpyOUtFQTFEQkNpamJZSi1TbEhOTXdtM3o4SXVWMVNVMGNzeFVmZmxibUVOS0xEd0VBUlBRQmcwRkFUeHJDdWVmY2ExZy13aElE?oc=5","published":1793409000,"summary":"《投信買超8-8》尖點(136)、瑞昱(134)、創意(134) 富聯網","sentiment":1,"tags":{"topics":["法人動向"],"bull":["買超"],"bear":[],"score":2,"highlights":[],"keywords":[]},"time":"10/31 09:10"}],"fund":{"code":"3443","rev_month":"11509","rev":7145236.0,"rev_mom":22.34796220745762,"rev_yoy":97.77847715325761,"rev_cum_yoy":102.83428395752624,"eps_q":40.84,"eps_year":"115","eps_season":"3","net_income":5473445.0,"pe":129.39,"pb":54.57,"yield":0.31,"updated":"2026-11-06 17:49"},"tdcc":{"latest":{"date":"2026-10-30","big1000":51.88,"big400":65.12,"retail":8.35,"holders":58137},"prev":{"date":"2026-10-22","big1000":52.69,"big400":64.75,"retail":8.26,"holders":56494},"d_big1000":-0.81,"d_big400":0.37,"d_retail":0.09,"d_holders":1643},"weekly":{"bars":[{"time":"2026-07-27","open":4080.0,"high":4080.0,"low":3175.0,"close":3805.0,"volume":10416.375},{"time":"2026-08-03","open":4150.0,"high":4665.0,"low":4030.0,"close":4545.0,"volume":10257.028000000002},{"time":"2026-08-10","open":4640.0,"high":5830.0,"low":4510.0,"close":5465.0,"volume":13900.523000000001},{"time":"2026-08-17","open":5475.0,"high":5990.0,"low":5230.0,"close":5600.0,"volume":13990.329},{"time":"2026-08-24","open":5635.0,"high":6370.0,"low":5205.0,"close":6015.0,"volume":10532.244},{"time":"2026-08-31","open":5850.0,