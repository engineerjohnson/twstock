等跌停；信昌電、東台、尖點、景碩、環球晶等跌幅9%以上。 終場台灣加權指數下跌1873.08點，以39701.64點作收，","sentiment":-1,"tags":{"topics":["AI/半導體","盤前"],"bull":["進駐"],"bear":["重挫","恐慌","殺盤","狂瀉"],"score":-9,"highlights":[],"keywords":[]},"time":"11/09 08:33"}],"fund":{"code":"3685","rev_month":"11510","rev":79429.0,"rev_mom":-1.7125957457339784,"rev_yoy":-38.39752439156804,"rev_cum_yoy":14.356774831578544,"eps_q":0.21,"eps_year":"115","eps_season":"3","net_income":71973.0,"pe":null,"pb":2.79,"yield":0.0,"updated":"2026-11-13 17:58"},"tdcc":{"latest":{"date":"2026-11-06","big1000":43.8,"big400":61.22,"retail":8.36,"holders":14046},"prev":{"date":"2026-10-30","big1000":43.88,"big400":61.87,"retail":8.03,"holders":13803},"d_big1000":-0.08,"d_big400":-0.65,"d_retail":0.33,"d_holders":243},"weekly":{"bars":[{"time":"2026-07-27","open":40.1,"high":40.1,"low":32.3,"close":36.35,"volume":6348.139},{"time":"2026-08-03","open":36.2,"high":40.7,"low":34.5,"close":39.65,"volume":5700.445},{"time":"2026-08-10","open":39.7,"high":40.2,"low":36.75,"close":37.0,"volume":3286.725},{"time":"2026-08-17","open":36.9,"high":38.5,"low":34.9,"close":36.7,"volume":2158.808},{"time":"2026-08-24","open":36.7,"high":38.0,"low":35.6,"close":36.9,"volume":2297.133},{"time":"2026-08-31","open":36.9,"high":39.5,"low":36.0,"close":36.9,"volume":4775.634},{"time":"2026-09-07","open":36.95,"high":37.25,"low":36.0,"close":36.9,"volume":2264.652},{"time":"2026-09-14","open":36.55,"high":37.4,"low":33.5,"close":35.9,"volume":2666.8590000000004},{"time":"2026-09-21","open":36.35,"high":36.55,"low":34.0,"close":35.2,"volume":1020.277},{"time":"2026-09-29","open":35.2,"high":36.4,"low":33.9,"close":36.0,"volume":2351.2019999999998},{"time":"2026-10-05","open":36.0,"high":38.4,"low":35.05,"close":37.9,"volume":6119.021},{"time":"2026-10-12","open":37.9,"high":39.95,"low":35.9,"close":36.3,"volume":20166.561999999998},{"time":"2026-10-19","open":35.8,"high":36.65,"low":32.0,"close":33.1,"volume":11007.413},{"time":"2026-10-27","open":33.0,"high":33