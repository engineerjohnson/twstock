。 裕隆城今年獲選新北市十大熱門景點，因此，以「光影散策」主題邀請民眾先從裕隆城豐富的餐飲、購物、閱讀和娛樂體驗出發，再走訪新店渡船頭、碧潭吊橋、銀河洞和體驗碧潭天鵝船，展開從城市光影到自然山水的耶誕一日遊。","sentiment":0,"tags":{"topics":[],"bull":[],"bear":[],"score":0,"highlights":[],"keywords":["耶誕","裕隆","環球購物"]},"time":"11/27 15:39"},{"id":"8473895426908ad4","source":"經濟日報-證券","category":"台股","title":"冠德中捷聯開案動土 將爭取對街 G9-2 住宅開發案","link":"https://money.udn.com/money/story/5710/9894975","published":1795367297,"summary":"冠德（2520）加碼台中，與中鹿開發共同投資107億元的台中捷運市政府站G9-1聯開案，昨（22）日動土。冠德董事長馬志綱同步表態，將爭取對街開發規模上看百億元的G9-2住宅聯開案，未來包括商場、商辦與飯店，也要搶住宅開發案。","sentiment":1,"tags":{"topics":[],"bull":["加碼"],"bear":[],"score":2,"highlights":[],"keywords":[]},"time":"11/23 01:08"}],"fund":{"code":"2520","rev_month":"11510","rev":2867945.0,"rev_mom":32.94633834286721,"rev_yoy":28.815815004725135,"rev_cum_yoy":18.379264871744848,"eps_q":2.55,"eps_year":"115","eps_season":"3","net_income":2471476.0,"pe":9.25,"pb":0.77,"yield":5.08,"updated":"2026-11-27 02:23"},"tdcc":{"latest":{"date":"2026-11-20","big1000":71.93,"big400":75.91,"retail":8.14,"holders":75947},"prev":{"date":"2026-11-13","big1000":71.84,"big400":75.72,"retail":8.21,"holders":76004},"d_big1000":0.09,"d_big400":0.19,"d_retail":-0.07,"d_holders":-57},"weekly":{"bars":[{"time":"2026-07-27","open":34.9,"high":35.7,"low":34.0,"close":34.65,"volume":8005.566},{"time":"2026-08-03","open":34.65,"high":34.85,"low":33.9,"close":34.7,"volume":4952.737},{"time":"2026-08-10","open":33.3,"high":35.5,"low":33.3,"close":34.85,"volume":8336.125},{"time":"2026-08-17","open":34.65,"high":37.05,"low":34.3,"close":36.8,"volume":10121.996000000001},{"time":"2026-08-24","open":37.0,"high":37.15,"low":34.85,"close":35.3,"volume":6203.084999999999},{"time":"2026-08-31","open":35.3,"high":37.55,"low":34.95,"close":37.1,"volume":9871.192},{"time":"2026-09-07","open":37.45,"high":37.45,"low":36.05,"close":36.45,"volume":4848.874},{"time":"2026-09-14","open":36.05,"high":39.6,"low":36.05,"close":38.0,"volume":11613.916000000001},{"time":"2026-09-21","open":37.9