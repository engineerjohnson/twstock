PU樹脂配方、機能膜材研發、合成皮革貼合加工，到終端運動用品及多元應用市場，逐步擴大集團整體業務綜效，包括第3季毛利率達25％，季增4個百分點，營業利益率達4％，在高附加價值產品出貨成長及營運效率持續改善下，帶動本業獲利能力。 信立10月營收達1.37億元、年增96.66％，續創歷年同期新高，累計今年1至10月合併營收達10.54億元、年增23.97％，亦刷新歷年同期記錄。","sentiment":1,"tags":{"topics":["EPS/獲利","營收","總經/聯準會"],"bull":["獲利","成長","亮眼","受惠"],"bear":[],"score":6,"highlights":["EPS)達0.72元","EPS達0.53元"],"keywords":["信立","邁達康","永捷","鞋材","運動用品"]},"time":"11/13 20:48"},{"id":"4b5a13869e3d1ea1","source":"經濟日報-證券","category":"台股","title":"信立財報／第3季 EPS 0.72元 季增2.27倍","link":"https://money.udn.com/money/story/11074/9872291","published":1794388264,"summary":"信立（4303）11日公布第3季合併營收達4.02億元，季增39.8％、年增44.9％，稅後淨利9,487萬元，EPS 0.72元，較上季成長2.27倍，獲利創下今年單季新高。累計前三季合併營收達9.17億元，稅後淨利7,010萬元，EPS達0.53元。","sentiment":1,"tags":{"topics":["EPS/獲利","營收","法說/展望"],"bull":["新高","獲利","成長","年增"],"bear":[],"score":4,"highlights":["EPS 0.72元","成長2.27倍","EPS達0.53元"],"keywords":[]},"time":"11/11 17:11"}],"fund":{"code":"4303","rev_month":"11510","rev":137495.0,"rev_mom":-5.078977162897302,"rev_yoy":96.66304316731986,"rev_cum_yoy":23.96982861552542,"eps_q":null,"eps_year":null,"eps_season":null,"net_income":null,"pe":2.98,"pb":0.77,"yield":18.08,"updated":"2026-11-13 17:58"},"tdcc":{"latest":{"date":"2026-11-06","big1000":14.11,"big400":20.21,"retail":28.8,"holders":37015},"prev":{"date":"2026-10-30","big1000":14.11,"big400":19.16,"retail":28.93,"holders":37038},"d_big1000":0.0,"d_big400":1.05,"d_retail":-0.13,"d_holders":-23},"weekly":{"bars":[{"time":"2026-07-27","open":43.15,"high":43.95,"low":39.35,"close":41.35,"volume":2535.824},{"time":"2026-08-03","open":41.45,"high":45.6,"low":41.35,"close":45.05,"volume":1893.519},{"time":"2026-08-10","open":45.3,"high":48.8,"low":44.5,"close":47.15,"volume":3555.9929999999995},{"time":"2026-08-17","open":47.85,"high":51.4,"low":46.8,"close":51.2,"volume":4654.852},{"time":"2026-08-24","open":53.5,"high":55.0,"low":38.7,"close":39.0,"volume":18685.85},{"time":"2026-08-31","open":38.5,"high":38.5,"low":34.45,"close":34.7,"volume":6054.