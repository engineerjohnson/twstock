首富。甲骨文共同創辦人艾里森同日身家也減少101億美元。 報導指出，跌勢源於民主黨重掌國會後，因投資人重新評估AI基建與半導體資本支出前景。當全球AI鏈市值劇烈重估，長鑫科技等中國記憶體勢力的體量，正成為衡量這場波動的新標尺。","sentiment":-1,"tags":{"topics":["擴產/資本支出","AI/半導體","匯率"],"bull":[],"bear":["重挫","拋售","慘"],"score":-6,"highlights":[],"keywords":["輝達","市值","長鑫科技","CXMT","馬斯克","富豪榜"]},"time":"11/06 12:30"}],"fund":{"code":"3663","rev_month":"11510","rev":565475.0,"rev_mom":-3.122157139210449,"rev_yoy":4.029839763047997,"rev_cum_yoy":35.11935604215675,"eps_q":0.36,"eps_year":"115","eps_season":"3","net_income":42917.0,"pe":133.89,"pb":1.64,"yield":0.0,"updated":"2026-11-13 17:58"},"tdcc":{"latest":{"date":"2026-11-06","big1000":62.76,"big400":64.18,"retail":21.41,"holders":24014},"prev":{"date":"2026-10-30","big1000":61.98,"big400":64.69,"retail":21.03,"holders":23984},"d_big1000":0.78,"d_big400":-0.51,"d_retail":0.38,"d_holders":30},"weekly":{"bars":[{"time":"2026-07-27","open":65.5,"high":67.0,"low":53.3,"close":57.4,"volume":3752.892},{"time":"2026-08-03","open":57.8,"high":65.9,"low":57.3,"close":62.1,"volume":2461.423},{"time":"2026-08-10","open":63.8,"high":69.7,"low":62.5,"close":64.6,"volume":3253.6690000000003},{"time":"2026-08-17","open":64.7,"high":65.5,"low":60.7,"close":61.3,"volume":1219.181},{"time":"2026-08-24","open":61.9,"high":64.6,"low":58.9,"close":62.8,"volume":1696.3180000000002},{"time":"2026-08-31","open":62.8,"high":64.8,"low":60.2,"close":62.1,"volume":2284.534},{"time":"2026-09-07","open":62.2,"high":65.5,"low":58.9,"close":58.9,"volume":1737.738},{"time":"2026-09-14","open":59.0,"high":64.1,"low":56.7,"close":61.2,"volume":3218.426},{"time":"2026-09-21","open":61.3,"high":63.2,"low":60.2,"close":61.5,"volume":1513.0299999999997},{"time":"2026-09-29","open":61.4,"high":68.6,"low":61.0,"close":64.8,"volume":4894.423},{"time":"2026-10-05","open":65.7,"high":65.7,"low":61.4,"close":61.6,"volume":1881.8870000000002},{"time":"2026-10-12","open":62.6,"high":75.0,"low":59.8,"close":68.6,"volume":11187.951000000001},{"time":"2026-10-19","open":66.0,"