":0.0},{"date":"2026-10-15","foreign":1.0,"trust":0.0,"dealer":0.0},{"date":"2026-10-12","foreign":5.0,"trust":0.0,"dealer":0.0},{"date":"2026-10-08","foreign":2.0,"trust":0.0,"dealer":0.0},{"date":"2026-10-05","foreign":-7.0,"trust":0.0,"dealer":0.0},{"date":"2026-09-30","foreign":-1.0,"trust":0.0,"dealer":0.0},{"date":"2026-09-24","foreign":-1.0,"trust":0.0,"dealer":0.0},{"date":"2026-09-22","foreign":-1.0,"trust":0.0,"dealer":0.0},{"date":"2026-09-21","foreign":-1.0,"trust":0.0,"dealer":0.0}],"news":[{"id":"cnyes6642889","source":"鉅亨網","category":"國際","title":"商用PC換機需求仍在 漲價考驗明年採購量 華碩逆勢增加市占","link":"https://news.cnyes.com/news/id/6642889","published":1793419206,"summary":"2026年10月31日（優分析／產業數據中心報導）⸺ 戴爾Dell(DELL-US)、惠普HP(HPQ-US)及華碩ASUS(2357-TW)積極搶攻商用PC換機潮，但記憶體等零組件漲價，也讓企業採購面臨預算壓力。三家業者各有布局，戴爾鎖定高階商用機種爭取市占，惠普靠調價與產品組合支撐營收，華碩則維持出貨成長，在漲價壓力下逆勢擴大商用PC市占。 戴爾認為，既有設備老舊及Windows 11升級需求，仍是支撐商用換機的主要動能。公司截至2025年10月底的2026會計年度第三季，商用業務營收年增5%，商用需求連續七季成長。面對後續市場出貨壓力，戴爾將著重高階商用產品，並運用供應鏈優勢爭取市占。 惠普則出現營收增加、出貨減少的情況。2026會計年度第三季商用PC營收年增22%，出貨量卻減少14%，主要靠調整售價及提高高階產品比重支撐。即使如此，個人系統事業營益率仍較去年同期下降0.8個百分點至4.6%，零組件成本增加持續侵蝕獲利。 相比之下，華碩在這波漲價壓力下，商用PC市占反而持續擴大，出貨已連續六季年增逾50%。相較惠普透過漲價與產品組合維持營收成長，華碩有實際出貨量增加作為支撐，商用業務基期較低，也提供較大的擴張空間。 不過，華碩同樣面對客戶預算限制。華碩表示，今年下半年國內PC價格已上漲約10%，部分機構原先編列的預算已買不齊所需設備，必須重新安排採購。","sentiment":1,"tags":{"topics":["EPS/獲利","營收","AI/半導體"],"bull":["漲價","成長","出貨","擴大","布局"],"bear":[],"score":6,"highlights":["年增5%","年增22%"],"keywords":["PC","優分析"]},"time":"10/31 12:00"},{"id":"cnyes6640220","source":"鉅亨網","category":"台股","title":"東南亞不香了？惠普、華碩、宏碁想將產線搬回中國 專家：AI推高記憶體等成本","link":"https://news.cnyes.com/news/id/6640220","published":1793256603,"summary":"市場研究機構Omdia最新數據顯示，今年第三季聯想到貨量佔全球PC總量四分之一，其餘市佔率由惠普、戴爾、蘋果、華碩、三星和宏碁等非中國廠商分食，而在持續攀升的供應鏈成本壓力下，越來越多海外PC大廠正把核心零組件採購、整機生產訂單交給中國代工廠承接，更有產業主管預期成本環境若未改善，回流趨勢恐進一步擴大。 多位知情人士透露，惠普、華碩、宏碁等全球主要PC製造商正透過將部分生產從泰國、越南遷回中國，並啟用新一代代工製造商的方式，應對持續飆升的零組件成本。 主打遊戲PC品項的廠商高層坦言，過去一年DRAM價格漲幅至少達8倍，CPU、PCB及各類被動元件採購成本同步大幅攀升，加上美國先前暫停對PC類產品徵收額外關稅，權衡之下，廠商自然將更多生產訂單轉回中國製造體系。 中國憑藉著經驗豐富的產業技術工人、更低的綜合生產成本，以及全球最完整的電子全產業鏈集群，仍是PC製造的最優選擇之一，零組件就近供應的優勢幾乎無可取代。 隨著物料清單成本上升，AI需求激增導致記憶體等零件嚴重短缺，PC廠商利潤空間大幅壓縮。一家為所有主要PC製造商供貨的晶片企業高層表示，不僅記憶體晶片，其他零件價格也迅猛上漲，廠商已難以消化漲幅。 此外，PC廠商的訂單正轉向新興中國代工企業。由於廣達、仁寶等傳統代工巨頭將產能重心轉向利潤率更高的AI資料中心伺服器業務，為立訊精密等技術新勢力創造關鍵窗口期。","sentiment":1,"tags":{"topics":["訂單/接單","擴產/資本支出","AI/半導體","關稅/地緣"],"bull":["訂單","供應鏈","擴大"],"bear":[],"score":4,"highlights":[],"keywords":["Omdia","PC","生產線","惠普","華碩","宏碁","AI","記憶體"]},"time":"10/29 14:50"},{"id":"cnyes6638733","source":"鉅亨網","category":"台股","title":"研調：全球PC出貨量Q3年減21% 估Q4跌幅擴大至27% 華碩、蘋果市占提升","link":"https://news.cnyes.com/news/id/6638733","published":1793104068,"summary":"研調機構Counterpoint Research統計，2026年第三季全球PC出貨量年減21%至5,700萬台，季減13.8%。記憶體及其他零組件成本持續攀升，推高PC售價並影響消費者購買意願，其中聯想維持全球PC市場市佔第一，華碩與蘋果出貨跌幅低於整體市場，市占率均有所提升。 消費性市場需求仍顯疲弱，較高的產品售價使消費者傾向延後設備汰換。相較之下，企業市場受惠於設備更新及Windows系統遷移需求，表現相對穩定，但仍不足以抵銷整體市場下滑。此外，2025年第三季受到Windows 10終止支援前的換機需求，以及關稅相關庫存調整帶動，形成較高的比較基期，進一步擴大2026年第三季的年減幅度。 2026年第三季，全球前五大PC品牌合計占整體出貨量的76.7%，各品牌表現如下，聯想出貨1,500萬台，年減23%，市占率26.3%，維持全球第一；惠普(HPE-US)出貨1,030萬台，年減31%，市占率18.1%，排名第二，為前六大品牌中跌幅最大者。 戴爾(DELL-US)出貨760萬台，年減25%，市占率13.3%，排名第三，顯示企業需求仍不足以完全抵銷市場下滑；蘋果(AAPL-US)出貨560萬台，年減11%，市占率由去年同期的8.7%提升至9.8%。","sentiment":0,"tags":{"topics":["AI/半導體","關稅/地緣"],"bull":["出貨","擴大","受惠"],"bear":["年減","延後","疲弱"],"score":0,"highlights":[],"keywords":["研調","PC","蘋果","華碩","戴爾","惠普","聯想"]},"time":"10/27 20:27"},{"id":"cnyes6638158","source":"鉅亨網","category":"台股","title":"國產集團推動「碳競爭優勢」 旗下國宇ALC、惠普搶攻低碳建築商機","link":"https://news.cnyes.com/news/id/6638158","published":1793067175,"summary":"國產(2504-TW)積極布局低碳建材，旗下國宇建材與惠普分別從ALC輕量化牆體系統及矽酸鈣板低碳製程切入，強化產品減碳與施工效率。國宇建材近期於2026國際永續智慧建築暨智慧建材展展示ALC輕質磚、ALC嵌板等產品，主打較紅磚減碳77.6%；惠普則透過產線改善與智慧化升級，將新建工程訂單占比提升至六成，2026年全年營收可望持平或優於去年。 國宇建材日前受邀參加「2026 Build for NextGen國際永續智慧建築暨智慧建材展」，於建築模組化展區展示ALC輕質磚、ALC嵌板及輕量化牆體系統整合方案，分享低碳建築應用趨勢。 國宇建材總經理楊志強表示，面對營建業缺工、缺料及低碳轉型等挑戰，ALC牆體系統具備隔音、防火及輕量化等特性，其中隔音性能最高達63分貝、防火時效超過3小時。透過工廠預製與模組化施工，可縮短工期、降低施工風險，施工速度較傳統工法提升約40%。 國宇建材李銘智博士指出，ALC輕量化牆體系統可應用於室內隔間、建築外牆及高隔音隔戶牆。其中，ALC輕質磚採乾式施工，可用於室內隔間；ALC嵌板則適用於外牆、屋頂及樓地板，尤其適合鋼構建築，可依需求客製尺寸，經工廠預製後運抵現場安裝，減少現場切割與施工廢料。高隔音複合牆的隔音效果最高達63分貝，優於50分貝的隔音標準；相較傳統RC牆體，整體成本約可節省25%至30%。","sentiment":1,"tags":{"topics":["訂單/接單","營收"],"bull":["訂單","布局"],"bear":[],"score":3,"highlights":[],"keywords":["國產","建材","趨勢分析"]},"time":"10/27 10:12"}],"fund":{"code":"8424","rev_month":"11509","rev":80271.0,"rev_mom":-9.605747683021587,"rev_yoy":-5.5801917308710225,"rev_cum_yoy":-1.4381101021915406,"eps_q":3.24,"eps_year":"115","eps_season":"2","net_income":116938.0,"pe":11.08,"pb":2.24,"yield":7.27,"updated":"2026-10-30 16:33"},"tdcc":{"latest":{"date":"2026-10-22","big1000":50.7,"big400":60.44,"retail":15.37,"holders":2992},"prev":{"date":"2026-10-08","big1000":50.7,"big400":60.6,"retail":15.36,"holders":3001},"d_big1000":0.0,"d_big400":-0.16,"d_retail":0.01,"d_holders":-9},"weekly":{"bars":[{"time":"2026-07-27","open":68.7,"high":68.9,"low":67.9,"close":68.4,"volume":102.596},{"time":"2026-08-03","open":68.1,"high":69.2,"low":68.0,"close":69.2,"volume":85.923},{"time":"2026-08-10","open":69.0,"high":69.4,"low":68.5,"close":68.8,"volume":90.085},{"time":"2026-08-17","open":68.8,"high":69.3,"low":68.6,"close":69.2,"volume":31.258000000000003},{"time":"2026-08-24","open":69.2,"high":70.1,"low":68.6,"close":68.8,"volume":44.732},{"time":"2026-08-31","open":68.7,"high":69.0,"low":68.5,"close":68.8,"volume":23.918},{"time":"2026-09-07","open":68.7,"high":69.0,"low":68.5,"close":68.8,"volume":40.777},{"time":"2026-09-14","open":69.2,"high":69.4,"low":68.8,"close":69.3,"volume":29.069000000000003},{"time":"2026-09-21","open":69.3,"high":70.8,"low":68.8,"close":70.8,"volume":113.76},{"time":"2026-09-29","open":70.8,"high":71.2,"low":69.5,"close":69.6,"volume":25.96},{"time":"2026-10-05","open":69.6,"high":70.3,"low":69.0,"close":69.5,"volume":32.258},{"time":"2026-10-12","open":69.0,"high":69.0,"low":68.5,"close":68.8,"volume":70.94999999999999},{"time":"2026-10-19","open":68.7,"high":68.8,"low":68.6,"close":68.7,"volume":18.279},{"time":"2026-10-27","open":6