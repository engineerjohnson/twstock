到人工智慧監管疑慮及市場風險情緒升溫影響，科技股遭遇沉重賣壓，四大指數全面重挫，道瓊工業指數下跌 3.44% ，標普 500 指數下跌 4.36% ，那斯達克指數下跌 5.52% ，費城半導體指數更大跌 12.25% ，成為本波修正重災區，市場主要擔憂美國期中選舉後， AI 產業監管政策可能出現變化，加上資料中心龐大資本支出及未來投資報酬率受到重新檢視，促使資金短線撤出科技與半導體族群。","sentiment":-1,"tags":{"topics":["擴產/資本支出","法人動向","AI/半導體","美股/國際"],"bull":["創新高","新高","買超"],"bear":["賣超","暴跌","血洗"],"score":-3,"highlights":[],"keywords":["德州","AI集團股","資安","莊佳螢分析師","摩爾投顧","三大法人","趨勢分析"]},"time":"11/06 17:36"}],"fund":{"code":"1416","rev_month":"11510","rev":51757.0,"rev_mom":1.3690312977398253,"rev_yoy":45.45837783148783,"rev_cum_yoy":47.314679517801444,"eps_q":1.0,"eps_year":"115","eps_season":"3","net_income":206454.0,"pe":16.19,"pb":0.79,"yield":2.98,"updated":"2026-11-13 17:58"},"tdcc":{"latest":{"date":"2026-11-06","big1000":52.88,"big400":59.53,"retail":14.19,"holders":45052},"prev":{"date":"2026-10-30","big1000":51.4,"big400":58.26,"retail":14.18,"holders":44987},"d_big1000":1.48,"d_big400":1.27,"d_retail":0.01,"d_holders":65},"weekly":{"bars":[{"time":"2026-07-27","open":10.95,"high":10.95,"low":10.6,"close":10.75,"volume":1487.7759999999998},{"time":"2026-08-03","open":10.7,"high":11.1,"low":10.65,"close":11.0,"volume":1441.074},{"time":"2026-08-10","open":11.0,"high":11.95,"low":10.95,"close":11.9,"volume":7796.781999999999},{"time":"2026-08-17","open":11.9,"high":12.05,"low":11.5,"close":12.0,"volume":2592.546},{"time":"2026-08-24","open":12.05,"high":12.35,"low":11.65,"close":11.8,"volume":2104.623},{"time":"2026-08-31","open":11.75,"high":11.9,"low":11.5,"close":11.75,"volume":1142.882},{"time":"2026-09-07","open":11.75,"high":11.75,"low":11.2,"close":11.3,"volume":1336.165},{"time":"2026-09-14","open":11.2,"high":11.5,"low":11.1,"close":11.5,"volume":1161.6440000000002},{"time":"2026-09-21","open":11.45,"high":11.65,"low":11.3,"close":11.45,"volume":682.995},{"time":"2026-09-29","open":11.45,"high":11.85,"low":11.3,"close":11.85,"volume":1379.0990000000002},{"time":"2026-10-05","open":11.9,"high":12.5,"low":11.65,"close":12.0,"volume":1723.