.357,"trust":-886.6,"dealer":67.962}],"news":[{"id":"b9940f60361de4a4","source":"經濟日報-證券","category":"台股","title":"CPO真正卡關竟在「測試」！ 光電同測成量產瓶頸 鴻勁、旺矽、致茂搶商機","link":"https://money.udn.com/money/story/5607/9834024","published":1792836115,"summary":"今年初，輝達的Quantum-X Photonics Infiniband交換器開始出貨、並在今年中進入客製化部署，其Spectrum-X Ethernet Photonics也在八月進入完全生產，ＣＰＯ技術已經正式進入量產階段這件事情已毋庸置疑，差別在於何時能大規模部署？據摩根士丹利證券追蹤供應鏈確認指出，台積電PIC晶片生產仍是ＣＰＯ放量的重要瓶頸，今年台積電光引擎總產量預估可望達到六千萬顆，但考量PIC的產出率、EIC/PIC混合鍵合及下游組裝估三成的產出率計算，最終實際可出貨的光引擎數量約落在一七○○萬～一八○○萬顆間，這樣的光引擎出貨數量預估足以支應輝達今年五○○○台NVL576所需的Scale up交換器及二○萬～二五萬台的Spectrum Scale out出貨所需。然隨著ＣＰＯ技術將導入輝達NVLink的Scale up機櫃，預計明年下半年的Rubin Ultra NVL5","sentiment":1,"tags":{"topics":["AI/半導體","金融"],"bull":["供應鏈","出貨","放量"],"bear":[],"score":3,"highlights":[],"keywords":[]},"time":"10/24 18:01"},{"id":"5da28b5dbdbfe85c","source":"Yahoo股市-台股","category":"台股","title":"台積電產能供不應求 耗材6檔必收","link":"https://tw.news.yahoo.com/%E5%8F%B0%E7%A9%8D%E9%9B%BB%E7%94%A2%E8%83%BD%E4%BE%9B%E4%B8%8D%E6%87%89%E6%B1%82-%E8%80%97%E6%9D%906%E6%AA%94%E5%BF%85%E6%94%B6-150500113.html","published":1792681500,"summary":"台積電上修資本支出並擴大先進製程與封裝布局，帶動半導體耗材與測試介面需求迎來歷史性爆發期。中砂、昇陽半導體、旺矽、精測、穎崴及環球晶等供應鏈台廠受惠於訂單滲透率提升、產能倍增及產品價格調漲，營運成長動","sentiment":1,"tags":{"topics":["訂單/接單","擴產/資本支出","AI/半導體"],"bull":["訂單","上修","成長","倍增","供應鏈","擴大"],"bear":[],"score":17,"highlights":[],"keywords":[]},"time":"10/22 23:05"},{"id":"216f6a358acc13e4","source":"永豐金證券","category":"台股","title":"三大法人買賣超 – 外資買超(2408)南亞科、(2344)華邦電，投信買超(2330)台積電、(6223)旺矽，法人合計賣超99.87億元","link":"https://news.google.com/rss/articles/CBMi_?oc=5","published":1792543179,"summary":"三大法人買賣超 – 外資買超(2408)南亞科、(2344)華邦電，投信買超(2330)台積電、(6223)旺矽，法人合計賣超99.87億元 永豐金證券","sentiment":1,"tags":{"topics":["法人動向","AI/半導體","金融"],"bull":["買超","法人買"],"bear":["賣超"],"score":2,"highlights":[],"keywords":[]},"time":"10/21 08:39"},{"id":"cnyes6631120","source":"鉅亨網","category":"盤前盤後","title":"〈台股盤後〉狂瀉1655點創史上第六大跌點 收46969點摜破月線","link":"https://news.cnyes.com/news/id/6631120","published":1792046206,"summary":"美國CPI數據高於市場預期，市場擔憂升息，加上AI資料中心融資信用風險疑慮升溫，拖累台股今(15)日哀鴻遍野，一度跌至46795.38點，大跌1830.45點，雖然隨後跌幅稍收斂，但終場仍狂瀉1655.96點或3.41%，為台股史上第六大跌點，收46969.87點，除失守4萬7關卡，同步摜破月線，成交量1.32兆元。 電子權值股今天全倒，台積電(2330-TW)跌50元或2.01%，收2440元，聯發科(2454-TW)、台達電(2308-TW)及聯電(2303-TW)紛紛跌逾半根停板，廣達(2382-TW)跌逾2%，鴻海(2317-TW)跌逾1%，日月光(3711-TW)更跌停鎖死673元。 封測及測試介面族群今天成重災區，多檔亮綠燈，旺矽(6223-TW)、穎崴(6515-TW)、精測(6510-TW)、南茂(8150-TW)皆跌停鎖死，鴻勁(7769-TW)、京元電子(2449-TW)、頎邦(6147-TW)、力成(6239-TW)、矽格(6257-TW)、福懋科(8131-TW)都跌逾半根停板。 塑化族群今天轉弱承受賣壓，台塑四寶中，南亞(1303-TW)、台化(1326-TW)摔至跌停，台塑(1301-TW)、台塑化(6505-TW)也都跌逾半根停板。","sentiment":-1,"tags":{"topics":["AI/半導體","總經/聯準會","航運/傳產","盤後"],"bull":[],"bear":["大跌","失守","升息","狂瀉"],"score":-8,"highlights":[],"keywords":["台股盤後","台股","台積電","封測","電信三雄","千金股"]},"time":"10/15 14:36"}],"fund":{"code":"6223","rev_month":"11509","rev":2047814.0,"rev_mom":-0.0174301852726164,"rev_yoy":82.2297406727807,"rev_cum_yoy":58.02185445520963,"eps_q":28.08,"eps_year":"115","eps_season":"2","net_income":2751299.0,"pe":104.71,"pb":30.13,"yield":0.45,"updated":"2026-10-25 00:33"},"tdcc":{"latest":{"date":"2026-10-22","big1000":37.96,"big400":50.21,"retail":12.56,"holders":84148},"prev":{"date":"2026-10-08","big1000":38.39,"big400":51.11,"retail":12.3,"holders":79215},"d_big1000":-0.43,"d_big400":-0.9,"d_retail":0.26,"d_holders":4933},"weekly":{"bars":[{"time":"2026-07-27","open":5760.0,"high":5815.0,"low":4650.0,"close":5280.0,"volume":3819.837},{"time":"2026-08-03","open":5475.0,"high":6390.0,"low":5450.0,"close":6100.0,"volume":3438.5860000000002},{"time":"2026-08-10","open":6230.0,"high":6815.0,"low":6100.0,"close":6440.0,"volume":3048.8459999999995},{"time":"2026-08-17","open":5800.0,"high":5950.0,"low":5000.0,"close":5465.0,"volume":6685.224000000001},{"time":"2026-08-24","open":5580.0,"high":5675.0,"low":4730.0,"close":5030.0,"volume":7367.013000000001},{"time":"2026-08-31","open":4930.0,"high":5585.0,"low":4870.0,"close":5155.0,"volume":5952.148},{"time":"2026-09-07","open":5225.0,"high":6060.0,"low":5165.0,"close":56