":-0.668,"trust":0.0,"dealer":-2.683},{"date":"2026-11-20","foreign":28.0,"trust":0.0,"dealer":0.112},{"date":"2026-11-19","foreign":4.114,"trust":0.0,"dealer":-11.312},{"date":"2026-11-18","foreign":38.386,"trust":0.0,"dealer":-4.954},{"date":"2026-11-17","foreign":-2.223,"trust":0.0,"dealer":0.0},{"date":"2026-11-16","foreign":-9.0,"trust":0.0,"dealer":0.88},{"date":"2026-11-13","foreign":9.0,"trust":0.0,"dealer":0.0},{"date":"2026-11-12","foreign":-2.0,"trust":0.0,"dealer":0.0},{"date":"2026-11-11","foreign":2.0,"trust":0.0,"dealer":0.0},{"date":"2026-11-10","foreign":11.0,"trust":0.0,"dealer":0.0},{"date":"2026-11-09","foreign":2.0,"trust":0.0,"dealer":0.0},{"date":"2026-11-06","foreign":10.0,"trust":0.0,"dealer":0.0},{"date":"2026-11-05","foreign":-25.0,"trust":0.0,"dealer":3.0},{"date":"2026-11-04","foreign":8.0,"trust":0.0,"dealer":0.0},{"date":"2026-11-03","foreign":5.0,"trust":0.0,"dealer":0.0},{"date":"2026-11-02","foreign":3.0,"trust":0.0,"dealer":0.0}],"news":[{"id":"cnyes6672928","source":"鉅亨網","category":"台股","title":"〈消費趨勢〉餐飲漲價潮來襲 路易莎、麥味登恐跟進","link":"https://news.cnyes.com/news/id/6672928","published":1795680899,"summary":"近期不少大型餐飲業者漲價因應成本節節墊高，除了王品(2727-TW)、瓦城(2729-TW)、壽司郎等以正餐為主的品牌，全台總店數超過500店的咖啡業者路易莎(2758-TW)也表態，明年恐漲價3-5%，正在評估中，而揚秦(2755-TW)(主力品牌麥味登)也不排除漲價，每半年進行評估。 揚秦表示，旗下各品牌的訂價策略每半年會依營運成本定期評估與調整，當營運成本出現較大幅度的異動，如原物料漲價、水電雙漲、基本工資調漲等，一旦超出總部、廠商或加盟門市可吸收範圍，終端售價會適度調整以維持健康的營運狀態。 路易莎董事長黃銘賢則表示，由於基本工資、原物料都在漲，「成本整串往上疊，漲價是不得不的現實」，正評估明年調漲價格，幅度約在3-5%。 黃銘賢進一步指出，以路易莎集團規模估算，明年每月人事成本將在基本工資調漲後約增加500萬元。 路易莎今年約新增30-40家直營門市，整體直營比例超過50%，預計明年路易莎再開逾40家店，展店動能維持，使全集團總店數超過600家。 路易莎今日將旗下健身品牌Selfroom插旗台北大巨蛋，目標打造新浪潮健身指標，黃銘賢認為，台灣健身產值已突破200億元，長期有望突破千億元，希望未來將Selfroom拓展至全台各地，而明年初將於新莊幸福站亮相的自建綜合商場也將開出。","sentiment":1,"tags":{"topics":["法人動向"],"bull":["漲價"],"bear":[],"score":2,"highlights":[],"keywords":["漲價","餐飲","路易莎","麥味登","揚秦","咖啡"]},"time":"11/26 16:14"},{"id":"cnyes6672059","source":"鉅亨網","category":"台股","title":"揚秦明年再開百家麥味登 啟動數智轉型計畫深化供應鏈","link":"https://news.cnyes.com/news/id/6672059","published":1795664992,"summary":"連鎖餐飲集團揚秦(2755-TW)最新表示，啟動「數據中台＋AI Agent」數智轉型計畫，並持續推進多品牌海內外布局，為2027年供應鏈深化應用奠定基礎，同時，明年主品牌麥味登目標再成長100家門市，營運動能樂觀。 揚秦總經理林麗玲說明，數位轉型已成推升營運效率的關鍵引擎，目前集團跨品牌APP會員數達170萬人、LINE會員數達259萬人，帶動線上點餐率由去年第三季的57.65%逐季攀升至今年第三季的64.56%。 而12月將進行「AI智慧營運整合計畫」導入驗證，透過新ERP、WMS（倉儲管理系統）、智慧配送與行銷Agent，串聯總部、物流與門市端，提升物流效率並優化營運決策，為明年供應鏈深化應用奠定基礎。 揚秦前三季合併營收達26.32億元、年增18.68%，稅後純益2.02億元、年增18.81%，每股純益(EPS)4.33元，創同期新高，主要是受惠於旗下早午餐品牌「麥味登」穩健展店和直營火鍋品牌「涮金鍋」強勁成長。 而隨著10月營收再度創單月新高紀錄，揚秦持續樂觀看待第四季，截至目前麥味登全台總店數已達1059家、「涮金鍋」11家門市，年底前將於中壢、林口再展2家店，明年也將陸續開出三峽店、內壢店。 另一方面，旗下烘焙品牌「REAL 真‧Cafe‧Bread」現有8家門市，中壢店預計年底開幕。","sentiment":1,"tags":{"topics":["EPS/獲利","營收","AI/半導體"],"bull":["成長","供應鏈","布局"],"bear":[],"score":3,"highlights":["年增18.68%","年增18.81%","EPS)4.33元"],"keywords":["餐飲","早午餐","麥味登","加盟","早餐","揚秦"]},"time":"11/26 11:49"}],"fund":{"code":"2755","rev_month":"11510","rev":314138.0,"rev_mom":3.1160859360895468,"rev_yoy":15.73828112047336,"rev_cum_yoy":18.226882210048483,"eps_q":4.33,"eps_year":"115","eps_season":"3","net_income":201840.0,"pe":13.64,"pb":3.06,"yield":7.59,"updated":"2026-11-27 02:23"},"tdcc":{"latest":{"date":"2026-11-20","big1000":57.48,"big400":65.41,"retail":10.62,"holders":3855},"prev":{"date":"2026-11-13","big1000":57.48,"big400":65.4,"retail":10.47,"holders":3857},"d_big1000":0.0,"d_big400":0.01,"d_retail":0.15,"d_holders":-2},"weekly":{"bars":[{"time":"2026-07-27","open":105.0,"high":105.0,"low":100.5,"close":102.5,"volume":194.33299999999997},{"time":"2026-08-03","open":102.0,"high":105.0,"low":101.0,"close":102.5,"volume":136.725},{"time":"2026-08-10","open":102.0,"high":104.5,"low":101.5,"close":104.5,"volume":216.047},{"time":"2026-08-17","open":104.0,"high":104.0,"low":101.0,"close":102.5,"volume":177.691},{"time":"2026-08-24","open":102.5,"high":103.5,"low":101.5,"close":102.0,"volume":106.578},{"time":"2026-08-31","open":102.0,"high":102.5,"low":99.0,"close":100.5,"volume":170.171},{"time":"2026-09-07","open":100.0,"high":100.0,"low":98.0,"close":98.2,"volu