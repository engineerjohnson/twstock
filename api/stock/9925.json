動業務與公益計畫的過程中持續合作、串聯資源，共同回應高齡社會的多元需求，延續「取諸社會、用諸社會」的公益精神。 新光保全表示，隨著臺灣邁入超高齡社會，高齡者所需要的不僅是醫療照護，也包括日常生活安全、情感支持及社會參與。而新光保全長期關注獨居長者的生活需求，透過遍及全臺的社區關懷行動，將企業守護安全的專業理念延伸至社會公益，關心長者的生活安全與情感需求。","sentiment":0,"tags":{"topics":[],"bull":["擴大"],"bear":[],"score":1,"highlights":[],"keywords":["新光保全","桂蘭","關懷","獨居","CSR"]},"time":"11/03 18:10"}],"fund":{"code":"9925","rev_month":"11510","rev":689005.0,"rev_mom":-3.1785043787168505,"rev_yoy":2.707492971519374,"rev_cum_yoy":4.47068870830358,"eps_q":3.16,"eps_year":"115","eps_season":"3","net_income":1296551.0,"pe":11.3,"pb":0.94,"yield":5.06,"updated":"2026-11-13 17:58"},"tdcc":{"latest":{"date":"2026-11-06","big1000":60.38,"big400":67.11,"retail":9.59,"holders":19359},"prev":{"date":"2026-10-30","big1000":60.51,"big400":67.49,"retail":9.62,"holders":19384},"d_big1000":-0.13,"d_big400":-0.38,"d_retail":-0.03,"d_holders":-25},"weekly":{"bars":[{"time":"2026-07-27","open":40.4,"high":40.75,"low":40.15,"close":40.3,"volume":3733.8030000000003},{"time":"2026-08-03","open":40.55,"high":40.55,"low":40.0,"close":40.05,"volume":2284.8160000000003},{"time":"2026-08-10","open":40.25,"high":40.3,"low":39.85,"close":40.1,"volume":2593.6119999999996},{"time":"2026-08-17","open":40.1,"high":40.3,"low":39.7,"close":39.7,"volume":4137.353},{"time":"2026-08-24","open":39.9,"high":40.2,"low":39.7,"close":39.85,"volume":4201.245},{"time":"2026-08-31","open":39.85,"high":40.15,"low":39.3,"close":39.55,"volume":14656.999},{"time":"2026-09-07","open":39.6,"high":39.8,"low":39.4,"close":39.55,"volume":2070.76},{"time":"2026-09-14","open":39.5,"high":39.7,"low":39.35,"close":39.65,"volume":2175.755},{"time":"2026-09-21","open":39.6,"high":39.8,"low":39.5,"close":39.65,"volume":1176.296},{"time":"2026-09-29","open":39.65,"high":39.7,"low":39.4,"close":39.5,"volume":1453.344},{"time":"2026-10-05","open":39.55,"high":39.55,"low":39.35,"close":39.4,"volume":1430.242},{"time":"2026-10-12","open":39.4,"high":39.8,"low":39.35,"close":39.65,"volume":1737.464},{"time":