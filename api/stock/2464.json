te":"2026-10-28","foreign":-72.095,"trust":40.0,"dealer":15.097},{"date":"2026-10-22","foreign":92.032,"trust":2.0,"dealer":-194.147},{"date":"2026-10-21","foreign":264.593,"trust":0.0,"dealer":-3.993},{"date":"2026-10-20","foreign":-441.006,"trust":-0.017,"dealer":-205.663},{"date":"2026-10-19","foreign":303.118,"trust":0.0,"dealer":-56.476},{"date":"2026-10-16","foreign":321.758,"trust":0.0,"dealer":-116.711},{"date":"2026-10-15","foreign":-3078.965,"trust":17.0,"dealer":-227.249},{"date":"2026-10-14","foreign":766.173,"trust":0.0,"dealer":79.581}],"news":[{"id":"cnyes6658710","source":"鉅亨網","category":"頭條","title":"歐洲央行：若年底前未達協議 數位歐元推出時程恐延至2029年後","link":"https://news.cnyes.com/news/id/6658710","published":1794399006,"summary":"歐洲央行(ECB)發出警訊，指出歐盟若無法在今(2026)年底前就「單一貨幣法案包」達成協議，原定於 2029 年首次發行的數位歐元(Digital Euro)計畫恐面臨延後。 隨著 2026 年僅剩約七周時間，歐洲央行正全力敦促歐盟立法機構加快腳步，以確保整體籌備工作具備明確的法律確定性。 歐洲央行執行董事奇波洛內(Piero Cipollone)於 11 月 10 日出席歐洲議會經濟及貨幣事務委員會時明確指出，立法延宕將直接推遲數位歐元的上路時程。 奇波洛內特別提到了歐盟在基礎設施上的風險，表示目前歐元區高達三分之二的信用卡支付受控制於外國業者，並指出：「近年歐洲已深刻體會到在能源與國防上不能單純依賴第三方，支付領域也是如此。」他警告，延遲發行將加深歐洲對外國支付服務商的依賴，並打擊在地企業的創新發展空間。 同時，歐洲央行總裁拉加德(Christine Lagarde)也將數位歐元視為關鍵應對方案，並警告指出，錨定美元的私營穩定幣若大規模普及，將可能削弱央行對貨幣政策的掌控能力。 面對大眾對實體貨幣存廢的疑慮，歐洲議會官員Fernando Navarrete Rojas強調，數位歐元的定位十分清晰，「將作為現金的補充手段，絕不會取代現金。」 目前歐洲議會正與歐盟理事會及歐盟執委會展開三方協商。法案談判的核心爭議主要集中於三大面向：個人隱私保護、交易手續費架構以及個人持有限額。","sentiment":-1,"tags":{"topics":["總經/聯準會","匯率"],"bull":[],"bear":["延後","警訊"],"score":-3,"highlights":[],"keywords":["歐盟","歐洲議會","數位歐元","單一貨幣","支付領域"]},"time":"11/11 20:10"},{"id":"e257bc7e5aef926c","source":"經濟日報-證券","category":"台股","title":"盟立 Q3 EPS 2.81元 走出谷底","link":"https://money.udn.com/money/story/5710/9867568","published":1794244197,"summary":"盟立（2464）昨（9）日公布第3季毛利率22.54%，季增0.37個百分點，年增4.02個百分點；稅後純益6.11億元，季增609.2%，並較去年同期暴增472.8倍，每股純益2.81元，反映出貨暢旺，帶動營運走出谷底。","sentiment":1,"tags":{"topics":["EPS/獲利","總經/聯準會"],"bull":["出貨","年增"],"bear":[],"score":2,"highlights":["EPS 2.81元"],"keywords":[]},"time":"11/10 01:09"},{"id":"5e56d98b10798dd1","source":"Yahoo股市","category":"台股","title":"半導體瘋狂吸金！「這檔」訂單看旺至2028年翻紅漲逾3% 亞翔、盟立、聖暉等11檔攻頂","link":"https://news.google.com/rss/articles/CBMi-?oc=5","published":1794221100,"summary":"半導體瘋狂吸金！「這檔」訂單看旺至2028年翻紅漲逾3% 亞翔、盟立、聖暉等11檔攻頂 Yahoo股市","sentiment":1,"tags":{"topics":["訂單/接單","AI/半導體"],"bull":["訂單"],"bear":[],"score":2,"highlights":[],"keywords":[]},"time":"11/09 18:45"},{"id":"cnyes6647380","source":"鉅亨網","category":"國際","title":"歐洲議會擬放寬2035年汽車減排目標 燃油車禁售政策進一步鬆動","link":"https://news.cnyes.com/news/id/6647380","published":1793844324,"summary":"歐洲議會議員周三（4日）投票支持放寬歐盟2035年汽車減排目標，將新車減排要求從100%下調至87.5%。 歐洲汽車產業面臨的壓力越來越大，歐盟立法者逐步傾向於給予車廠更多靈活性，降低其向電動車轉型的難度。 歐洲議會環境委員會的議員投票支持放寬新車和廂式貨車的排放要求，為汽車製造商履行氣候義務提供更大操作空間。這項協議仍需獲歐洲議會全體會議批准，並在與歐盟成員國談判後，才能成為法律。 歐洲議會全體會議預定12月表決這項汽車產業政策方案。此次表決將確立歐洲議會在後續談判中的立場，之後歐洲議會將與代表歐盟各成員國政府的歐盟理事會展開磋商。 這一舉措甚至比歐盟委員會此前提出的方案更寬鬆。歐盟原本計劃從2035年起停止銷售新燃油車，但在汽車產業的壓力下，歐盟委員會去年年底提出放寬汽車減排目標，將二氧化碳排放量削減比例從100%下調至90%，即不再要求新車全部實現零排放，允許車廠通過低碳鋼材、可持續燃料等抵扣方式，保留一定燃油車和插混車型銷售空間。 根據歐洲議會達成的妥協方案，使用歐盟生產的低碳鋼材，車廠還可獲得額外7.5%排放抵扣額度；廂式貨車的減排目標則將從90%下調至80%。 此次投票象徵歐盟氣候政策及歐洲議會內部政治力量對比發生重大轉變。此前歐洲議會各黨派曾就逐步收緊二氧化碳排放標準形成廣泛共識。 如今能源成本飆漲威脅歐洲工業競爭力，立法者越來越重視保護汽車產業。","sentiment":0,"tags":{"topics":[],"bull":[],"bear":[],"score":0,"highlights":[],"keywords":["歐洲議會","燃油車","二氧化碳"]},"time":"11/05 10:05"}],"fund":{"code":"2464","rev_month":"11510","rev":1104861.0,"rev_mom":10.713949307675195,"rev_yoy":95.9988149893207,"rev_cum_yoy":42.68355260588374,"eps_q":3.57,"eps_year":"115","eps_season":"3","net_income":741934.0,"pe":50.66,"pb":4.44,"yield":0.3,"updated":"2026-11-13 17:58"},"tdcc":{"latest":{"date":"2026-11-06","big1000":33.43,"big400":41.18,"retail":31.9,"holders":96800},"prev":{"date":"2026-10-30","big1000":34.62,"big400":42.49,"retail":31.39,"holders":96540},"d_big1000":-1.19,"d_big400":-1.31,"d_retail":0.51,"d_holders":260},"weekly":{"bars":[{"time":"2026-07-27","open":144.0,"high":145.5,"low":118.0,"close":134.5,"volume":24613.22},{"time":"2026-08-03","open":134.5,"high":185.0,"low":134.0,"close":173.5,"volume":88573.54