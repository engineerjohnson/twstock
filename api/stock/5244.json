.0},{"date":"2026-11-20","foreign":20.0,"trust":0.0,"dealer":0.0},{"date":"2026-11-19","foreign":-46.0,"trust":0.0,"dealer":11.0},{"date":"2026-11-18","foreign":57.0,"trust":0.0,"dealer":0.0},{"date":"2026-11-17","foreign":10.475,"trust":0.0,"dealer":1.0},{"date":"2026-11-16","foreign":-22.0,"trust":0.0,"dealer":1.0},{"date":"2026-11-13","foreign":-31.0,"trust":0.0,"dealer":1.0},{"date":"2026-11-12","foreign":-43.0,"trust":0.0,"dealer":0.0},{"date":"2026-11-11","foreign":-29.54,"trust":0.0,"dealer":0.0},{"date":"2026-11-10","foreign":49.0,"trust":0.0,"dealer":-1.0},{"date":"2026-11-09","foreign":62.0,"trust":0.0,"dealer":0.0},{"date":"2026-11-06","foreign":87.0,"trust":0.0,"dealer":0.0},{"date":"2026-11-05","foreign":-47.0,"trust":0.0,"dealer":0.0},{"date":"2026-11-04","foreign":76.0,"trust":0.0,"dealer":0.0},{"date":"2026-11-03","foreign":16.0,"trust":0.0,"dealer":0.0},{"date":"2026-11-02","foreign":34.0,"trust":0.0,"dealer":0.0}],"news":[{"id":"cnyes6670976","source":"鉅亨網","category":"台股","title":"〈弘凱法說〉Q3轉虧為盈EPS 0.18元 備援晶圓廠明年4月交貨緩解車用IC缺料","link":"https://news.cnyes.com/news/id/6670976","published":1795513803,"summary":"LED IC廠弘凱(5244-TW)於2026年11月24日舉辦法人說明會，第三季稅後淨利1202萬元，每股純益0.18元，成功終結前兩季虧損並正式轉虧為盈。弘凱副總經理邱炎璋表示，面對近期AI與記憶體需求排擠晶圓代工產能導致車用控制IC交期延宕，公司已同步在台湾與中國大陸導入第二及第三家備援晶圓廠開光罩，預計2027年4月起新晶圓廠即可交貨，帶動第2季起供料瓶頸大幅緩解。 邱炎璋指出，由於上半年金價、銅價及鋁價等貴金屬成本飆漲逾5成、中國市場價格內捲以及深圳遷廠至南通產生人員移動與培訓費用，累計前3季稅後虧損3750萬元、每股虧損0.55元、累計毛利率26.8個百分點，但受惠於南通新廠通過客戶審廠並放量出貨，第3季單季毛利率強勁回升至29.8個百分點，邱炎璋預估第4季單季維持獲利應無問題，惟能否全數彌補前兩季虧損仍待觀察。 關於供應鏈瓶頸，邱炎璋表示，弘凱車用氛圍燈EVO與ECO及結構性ETR等自研IC雖已通過多家一線車廠認證導入，但原合作晶圓代工廠旺宏將產能轉向利潤較高的DRAM等記憶體產品，導致控制IC排上產線卻無交期，使下半年每月約5KK的車用訂單無法如期出貨，迫使部分客戶暫時改回傳統消費型IC方案，同時感測元件模組出貨也受客戶端部分IC供應不足而有所遞延。","sentiment":-1,"tags":{"topics":["訂單/接單","EPS/獲利","擴產/資本支出","法說/展望","AI/半導體","總經/聯準會"],"bull":[],"bear":["虧損"],"score":-2,"highlights":["EPS 0.18元"],"keywords":["弘凱","LED","IC","漲價"]},"time":"11/24 17:50"},{"id":"cnyes6670982","source":"鉅亨網","category":"台股","title":"〈弘凱法說〉機器人與車用雙引擎點火 接獲波士頓動力試投單 2027年重返成長軌道","link":"https://news.cnyes.com/news/id/6670982","published":1795513803,"summary":"LED IC廠弘凱(5244-TW)今(24)日舉辦法人說明會，副董事長吳志明表示，成功設計導入LG旗下前波士頓動力開發的人形機器人與雙頭機器狗供應鏈並已接獲試投訂單，隨著機器人新案推進、明年第2季起車用控制IC缺料大幅緩解以及日韓海外新訂單挹注，2027年公司營運將重返穩健成長軌道。 吳志明表示，公司已將自主研發的IC LED架構搭配通信IC導入Atlas人形機器人與雙頭機器狗，今年已接獲2萬至3萬顆小量試投訂單，預計2027年底至2028年正式放量，且該前沿市場具備成本轉嫁彈性。 吳志明提到，隨著中國大陸車廠陸續設立機器人部門，公司亦積極接洽未來陪伴型機器人的光學應用需求，並在中國大陸國產化趨勢帶動下推升感測元件出貨量，同步組建團隊規劃感測與光通訊MPO等測試業務以打造新成長曲線。 在核心車用市場明年動能上，吳志明指出2027年首要營收成長主力仍聚焦於車用領域，隨著新開光罩的台陸備援晶圓廠預計於明年4月起供貨，加上明年6月有新車型專案導入採用自研車用氛圍燈IC，供料瓶頸將大幅改善。 吳志明表示，弘凱也將趁明年第1季中國大陸車市傳統淡季進行南通新廠的產能調校與製程優化，為第2季起的新一波訂單放量做好準備，並持續研發車用內部網絡設計以拉高產品附加價值。","sentiment":1,"tags":{"topics":["訂單/接單","營收","擴產/資本支出","法說/展望","法人動向"],"bull":["訂單","成長","供應鏈","新訂單"],"bear":[],"score":6,"highlights":[],"keywords":["弘凱","LED","光通訊","車用"]},"time":"11/24 17:50"}],"fund":{"code":"5244","rev_month":"11510","rev":85758.0,"rev_mom":-13.379257403741263,"rev_yoy":11.608839376350243,"rev_cum_yoy":7.889263720931582,"eps_q":-0.55,"eps_year":"115","eps_season":"3","net_income":-37496.0,"pe":null,"pb":1.1,"yield":1.39,"updated":"2026-11-27 02:23"},"tdcc":{"latest":{"date":"2026-11-20","big1000":28.51,"big400":49.06,"retail":17.82,"holders":9402},"prev":{"date":"2026-11-13","big1000":28.51,"big400":48.7,"retail":17.95,"holders":9450},"d_big1000":0.0,"d_big400":0.36,"d_retail":-0.13,"d_holders":-48},"weekly":{"bars":[{"time":"2026-07-27","open":31.65,"high":32.15,"low":27.85,"close":30.65,"volume":1049.966},{"time":"2026-08-03","open":30.65,"high":33.95,"low":30.6,"close":33.15,"volume":922.3760000000001},{"time":"2026-08-10","open":33.2,"high":34.1,"low":32.6,"close":32.85,"volume":491.55400000000003},{"time":"2026-08-17","open":32.85,"high":34.2,"low":32.7,"close":34.05,"volume":589.24},{"time":"2026-08-24","open":34.0,"high":36.25,"low":33.5,"close":35.6,"volume":808.6129999999999},{"time":"2026-08-31","open":35.3,"high":35.9,"low":34.25,"close":35.0,"volume":723.5329999999999},{"time":"2026-09-07","open":34.7,"high":35.2,"low":33.8,"close":33