026-11-02","foreign":-154.65,"trust":0.0,"dealer":-10.0},{"date":"2026-10-30","foreign":-1651.41,"trust":0.0,"dealer":8.0},{"date":"2026-10-29","foreign":-521.52,"trust":0.0,"dealer":-18.891},{"date":"2026-10-28","foreign":-1765.745,"trust":0.0,"dealer":45.735},{"date":"2026-10-22","foreign":-3955.506,"trust":0.0,"dealer":0.0},{"date":"2026-10-21","foreign":-5344.63,"trust":0.0,"dealer":-10.0}],"news":[{"id":"4f059eba674d84e1","source":"經濟日報-證券","category":"台股","title":"中工攜手信紘科拿下台塑大樓都更案","link":"https://money.udn.com/money/story/5607/9892107","published":1795189493,"summary":"中工（2515）昨（20）日宣布攜手信紘科，取得「台塑大樓都更案」建築與機電案。信紘科承攬約49億元全案機電工程，從半導體擴大布局大型商辦、住宅及都市更新市場，中工累積大型複合式建築工程實績，預計2029年完工。","sentiment":1,"tags":{"topics":["AI/半導體"],"bull":["擴大","布局"],"bear":[],"score":2,"highlights":[],"keywords":[]},"time":"11/20 23:44"},{"id":"cnyes6669132","source":"鉅亨網","category":"台股","title":"信紘科攜手中工搶攻台塑大樓都更 統包訂單營收占比已達50%","link":"https://news.cnyes.com/news/id/6669132","published":1795164604,"summary":"信紘科(6667-TW)今20日在台北宣布，與營造廠中工(2515-TW)攜手合作，共同投入總工程造價約新台幣220億元的台塑大樓都市更新新建工程，其中信紘科承攬全案機電統包工程，合約金額約49億元，預計2029年完工。受惠於近年積極轉型總承包商並拓展跨產業應用，信紘科目前在手統包形態案件占整體營收比重已達50%。 信紘科共同執行長林欣德指出，公司自2021年至2022年間便開始布局機電領域，目前已建立近百人的專業團隊，涵蓋設計規劃、現場監造與建築資訊模型等職能。面對外界關注高科技廠務與商辦都更的毛利率及人力配置差異。 林欣德他表示機電團隊與原本的半導體團隊各自獨立運作且可跨區調度，公司看重的是透過擴大承攬規模帶來整體營收與每股純益的實質成長。 信紘科過去在晶圓代工龍頭廠區的氣體與化學等高門檻二次配項目擁有八至九成市占率，如今正將高科技廠房的高效率管理經驗延伸至民間建築及半導體上下游供應鏈。 林欣德說明，隨著半導體大廠持續擴產，周邊化學品與原物料供應商普遍採取統包模式發包建廠，信紘科憑藉熟悉精密製程與無塵室整合的優勢，已順利切入美系記憶體廠的二次配統包與辦公室機電工程，未來海外如新加坡等據點也將以統包模式接單。","sentiment":1,"tags":{"topics":["訂單/接單","EPS/獲利","營收","擴產/資本支出","AI/半導體","總經/聯準會","匯率"],"bull":["訂單","合作","受惠","布局"],"bear":[],"score":6,"highlights":[],"keywords":["中工","信紘科","廠務"]},"time":"11/20 16:50"},{"id":"cnyes6669013","source":"鉅亨網","category":"台股","title":"中工進軍科技廠辦 搶攻高科技建廠商機並結盟信紘科發揮綜效","link":"https://news.cnyes.com/news/id/6669013","published":1795159942,"summary":"中華工程(2515-TW)今(20)日與信紘科技(6667-TW)攜手合作，共同投入台北市重大都市更新指標工程「台塑大樓都市更新新建工程」，全案由台塑建設擔任實施者，整體工程造價約220億元，此次合作結合中工大型營造統籌能力與信紘科高科技廠務及機電工程整合經驗，集結專業工程團隊共同執行大型複合式建築工程，也為雙方跨領域合作開啟新的篇章。 信紘科此次承攬「台塑大樓都市更新新建工程」案約49億元的機電工程。 中工並指出，未來，中工與信紘科將以此次合作為重要基礎， 建立台塑建設、中工與信紘科三方合作基礎，持續拓展後續大型營建及相關工程合作機會，開創更廣泛的工程合作空間。 台北市都更重大工程的「台塑大樓都市更新新建工程」，基地位於台北市松山區敦化北路，面積約6,328坪，規劃興建兩棟地上22層辦公大樓及一棟地上22層住宅大樓，預計2029年完工。全案由中工承攬興建，主要負責主體營造工程，信紘科則負責全案機電工程。 台塑大樓於1976年落成，長年作為台塑企業總部及敦化北路重要企業地標，隨台塑集團總部於2023年遷往內湖，原址正式啟動都市更新計畫。 「台塑大樓都市更新新建工程」案基地涵蓋松山區民生段6筆土地，座落於敦北金融商圈與民生住宅生活圈交會地帶，也是敦化南北路都市綠廊的重要節點，屬台北市中心少見的大規模完整街廓都市更新案。","sentiment":0,"tags":{"topics":["擴產/資本支出"],"bull":["合作"],"bear":[],"score":1,"highlights":[],"keywords":["中工","信紘科","台塑大樓","都更"]},"time":"11/20 15:32"}],"fund":{"code":"2515","rev_month":"11510","rev":1566241.0,"rev_mom":-27.49985187434501,"rev_yoy":-4.00835231726548,"rev_cum_yoy":22.58101466963354,"eps_q":0.3,"eps_year":"115","eps_season":"3","net_income":509789.0,"pe":22.33,"pb":0.69,"yield":5.21,"updated":"2026-11-20 19:27"},"tdcc":{"latest":{"date":"2026-11-13","big1000":52.8,"big400":60.4,"retail":9.38,"holders":140416},"prev":{"date":"2026-11-06","big1000":52.8,"big400":60.43,"retail":9.36,"holders":140410},"d_big1000":0.0,"d_big400":-0.03,"d_retail":0.02,"d_holders":6},"weekly":{"bars":[{"time":"2026-07-27","open":12.05,"high":12.1,"low":11.3,"close":11.85,"volume":34755.545000000006},{"time":"2026-08-03","open":11.9,"high":12.4,"low":11.75,"close":11.95,"volume":29679.336000000003},{"time":"2026-08-10","open":12.0,"high":12.2,"low":11.85,"close":12.05,"volume":33434.352},{"time":"2026-08-17","open":12.05,"high":12.05,"low":11.7,"close":12.0,"volume":23502.298},{"time":"2026-08-24","open":12.0,"high":12.2,"low":11.9,"close":11.95,"volume":25135.423000000003},{"time":"2026-08-31","open":11.95,"high":12.4,"low":11.95,"close":12.15,"volume":27024.606},{"time":"2026-09-07","open":12.2,"high":12.2,"low":11.9,"close":12.0,"volume":16946.093},{"time":"2026-09-14","open":12.0,"high":12.5,"low":11.7,"close":11.95,"volume":38775.268},{"time":"2026-09-21","open":12.0,"high":12.15,"low":11.85,"close":11.95,"volume":176