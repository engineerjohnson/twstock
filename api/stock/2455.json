.411},{"date":"2026-10-05","foreign":99.35,"trust":-45.0,"dealer":315.884},{"date":"2026-10-02","foreign":1386.047,"trust":-1030.0,"dealer":551.235},{"date":"2026-10-01","foreign":292.444,"trust":-1016.0,"dealer":282.549},{"date":"2026-09-30","foreign":249.306,"trust":0.0,"dealer":34.574},{"date":"2026-09-29","foreign":-109.309,"trust":35.0,"dealer":119.416}],"news":[{"id":"cnyes6639382","source":"鉅亨網","category":"台股","title":"〈焦點股〉Lumentum、Coherent大漲 眾達-KY領軍光通訊族群紅光滿面","link":"https://news.cnyes.com/news/id/6639382","published":1793166946,"summary":"隨AI基礎建設需求強勁，持續支撐光通訊產業需求，美國光學元件廠Lumentum (LITE-US)、Coherent(COHR-US)及AXT(AXTI-US)周二(27日)收盤全面大漲，激勵今(28)日台廠供應鏈上揚，包括眾達-KY(4977-TW)、IET-KY(4971-TW)、全新(2455-TW)3檔開高走高，盤中在大單持敲進下攻上漲停板，推升光通訊族群多檔臉紅上漲。 盤面上，以眾達-KY等3檔磷化銦(InP)磊晶為主的供應商盤中衝上漲停板最為強勁，其他如環宇-KY(4991-TW)、上詮(3363-TW)、波若威(3163-TW)、華星光(4979-TW)、前鼎(4908-TW)、聯鈞(3450-TW)攜手上揚，飆漲超過半根停板。 由於矽光子技術利用光傳輸資料，推升先進AI硬體對傳輸速度的要求不斷提高，矽光子預料將逐步取代資料中心叢集內以銅為基礎的互連技術。同時，光學網路也有助於降低系統產生的熱量與耗電量。","sentiment":1,"tags":{"topics":["訂單/接單","AI/半導體"],"bull":["漲停","大漲","需求強勁","大單","供應鏈"],"bear":[],"score":10,"highlights":[],"keywords":["lumentum","矽光子","光通訊","眾達-KY","IET-KY","全新"]},"time":"10/28 13:55"},{"id":"0f5a03213d330da3","source":"經濟日報-證券","category":"台股","title":"上游料源掌握度高 法人喊買三檔光通訊供應鏈","link":"https://money.udn.com/money/story/5607/9839705","published":1793079808,"summary":"受惠人工智慧（AI）資料中心持續建置、輝達（NVIDIA）新世代GPU規格升級帶動網路頻寬翻倍成長，及上游材料持續供不應求，法人看好，聯亞（3081）、全新（2455）、華星光（4979）等相關供應鏈營運成長可期，維持買進投資建議。","sentiment":1,"tags":{"topics":["AI/半導體"],"bull":["看好","成長","翻倍","供應鏈","受惠","供不應求"],"bear":[],"score":13,"highlights":[],"keywords":[]},"time":"10/27 13:43"},{"id":"cnyes6638238","source":"鉅亨網","category":"台股","title":"〈焦點股〉AI需求旺盛磷化銦缺口短期難解 聯亞飆漲半根停板","link":"https://news.cnyes.com/news/id/6638238","published":1793075195,"summary":"隨著AI伺服器帶動800G、1.6T高速光模組需求持續旺盛，三五族磊晶製造廠聯亞(3081-TW)上周雖遭外資連4賣，今(27)日仍開高走高，盤中在大單敲進下，一度飆漲9.47%，股價觸及2,600元。法人表示，在光通訊與CPO(共同封裝)技術發展帶動下，上游關鍵原料磷化銦(InP)基板供不應求，預期隨供需缺口延續，成長動能可望持續增溫。 業界指出，包括全新(2455-TW)、聯亞等磷化銦為主的光通訊廠，因磷化銦缺料問題仍在，不僅產能遠遠跟不上訂單，磷化銦基板、磊晶價格也不斷上揚，粗估磷化銦基板與磊晶缺口目前仍高達三成以上。 聯亞今(2026)年前3季合併營收達36.87億元、年增136.33%。聯亞先前在法說上表示，公司仍受矽光產品持續增加出貨增加挹注業績增長，目前1.6T產品已開始量產，3.2T也持續與客戶協商開發中， 受惠於光通訊需求噴發，聯亞在產線上持續進行擴產準備，今年8月底經聯亞董事會決議，通過不超過新台幣22.7億元的設備投資案，加上聯亞與美、日供應商，簽訂長期的磷化銦(InP)基板採購合約，也建立穩定的料件需求，以滿足客戶的強勁需求。 全新則表示，受惠於AIDC(AI資料中心)需求仍爆發性成長，目前在出貨上遇到磷化銦基板、磊晶都供不應求，目前「訂單需求不大，主要在缺料可以生產出貨給客戶」問題較大。","sentiment":1,"tags":{"topics":["訂單/接單","營收","擴產/資本支出","法說/展望","法人動向","AI/半導體","匯率"],"bull":["成長","大單","供不應求"],"bear":[],"score":6,"highlights":["年增136.33%"],"keywords":["磷化銦","聯亞","全新","AI資料中心","光通訊","CPO"]},"time":"10/27 12:26"}],"fund":{"code":"2455","rev_month":"11509","rev":449063.0,"rev_mom":-4.638100334675433,"rev_yoy":29.486480797455616,"rev_cum_yoy":34.95902177765917,"eps_q":2.2,"eps_year":"115","eps_season":"2","net_income":408673.0,"pe":118.63,"pb":24.51,"yield":0.54,"updated":"2026-10-30 16:33"},"tdcc":{"latest":{"date":"2026-10-22","big1000":36.91,"big400":51.8,"retail":22.19,"holders":70736},"prev":{"date":"2026-10-16","big1000":36.45,"big400":51.89,"retail":22.03,"holders":70393},"d_big1000":0.46,"d_big400":-0.09,"d_retail":0.16,"d_holders":343},"weekly":{"bars":[{"time":"2026-07-27","open":322.5,"high":338.0,"low":255.0,"close":292.0,"volume":35416.006},{"time":"2026-08-03","open":301.5,"high":402.0,"low":300.0,"close":364.0,"volume":72203.08600000001},{"time":"2026-08-10","open":382.0,"high":398.0,"low":358.5,"close":379.5,"volume":19050.759},{"time":"2026-08-17","open":409.5,"high":437.5,"low":385.0,"close":406.0,"volume":95095.566},{"time":"2026-08-24","open":401.5,"high":450.0,"low":374.5,"close":434.0,"volume":17740.771},{"time":"2026-08-31","open":428.0,"high":555.0,"low":428.0,"close":528.0,"volume":139990.494},{"time":"2026-09-07","open":525.0,"high":552.0,"low":491.0,"close":515.0,"volume":14034.820000000002},{"time":"2026-09-14","open":497.0,"high":566.0,"low":493.0,"close":556.0,"volume":71754.81},{"time":"2026-09-21","open":571.0,"high":590.0,"low":535.0,"close":554.0,