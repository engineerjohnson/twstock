trust":63.0,"dealer":-468.46},{"date":"2026-11-03","foreign":-1122.794,"trust":133.0,"dealer":-20.366},{"date":"2026-11-02","foreign":4.851,"trust":31.0,"dealer":-59.063}],"news":[{"id":"cnyes6672121","source":"鉅亨網","category":"台股","title":"〈焦點股〉SpaceX獲准發射百萬顆衛星 激勵穩懋亮燈漲停領7檔題材股齊嗨","link":"https://news.cnyes.com/news/id/6672121","published":1795670682,"summary":"馬斯克旗下SpaceX(SPCX-US)於25日經美國聯邦通訊委員會(FCC)同意，最多可部署100萬顆衛星上太空，以打造宇宙資料中心網路，今(26)日聞訊後激勵穩懋(3105-TW)、萊德光電-KY(7717-TW)開高後雙雙亮燈衝上漲停板，相關PA、太空光通訊相關供應廠統新等6檔個股也狂飆逾半根漲停板。 據外電報導，FCC在25日強調，已附條件批准SpaceX組建名為「Starmind」的太空資料中心星座，以滿足快速增長的超級智慧算力需求，FCC主席也表示，美國將引領世界進入超級智慧時代，FCC此次授權將為美國所需的運算基礎設施開闢新疆域。 盤面上，穩懋、萊德光電-KY受惠太空元件光通訊題材股，開高後迅速跳空拉漲停，股價也雙雙站回5日線。 其他包括光薄膜濾光片廠統新(6426-TW)漲停板，三五族群的光通訊廠的聯亞(3081-TW)、IET-KY(4971-TW)、宏捷科(8086-TW)、環宇-KY(4991-TW)、全新(2455-TW)等5檔也飆漲超過半根停板。 FCC此次批准SpaceX部署100萬顆衛星上太空，供給AI運算使用，預估2033年11月前開始至2035月11月前，將預計部署10萬顆。","sentiment":1,"tags":{"topics":["AI/半導體","美股/國際"],"bull":["漲停","題材"],"bear":[],"score":4,"highlights":[],"keywords":["SpaceX","低軌衛星","光電","聯亞","穩懋","萊德光電-KY"]},"time":"11/26 13:24"},{"id":"fe46336adaf574b2","source":"CMoney","category":"台股","title":"全新（2455）融資未退主力買超－熱門話題｜股市爆料同學會","link":"https://news.google.com/rss/articles/CBMiaEFVX3lxTE93OE0tNE10X3NKZGpzS1NkSXM4YkVzdHpUTkhUdjdjYWVPRnl1NXlZYmVFNmlRcktMRVBrQkpjSU52NUJqSlZvRnJyTDZkNGVnMXBZRGhrZ0N4TkU5dE5OQXI3Ym1VSlZx?oc=5","published":1795479641,"summary":"全新（2455）融資未退主力買超－熱門話題｜股市爆料同學會 CMoney","sentiment":1,"tags":{"topics":["法人動向"],"bull":["買超"],"bear":[],"score":2,"highlights":[],"keywords":[]},"time":"11/24 08:20"},{"id":"cnyes6664819","source":"鉅亨網","category":"頭條","title":"兆豐00913換股「3進3出」 南亞科、全新、精材入列搶攻AI商機","link":"https://news.cnyes.com/news/id/6664819","published":1794884769,"summary":"台股ETF迎來新一波成分股調整！兆豐台灣晶圓製造(00913-TW)將於今(17)日進行下半年成分股調整，採取「3進3出」，新納入南亞科(2408-TW)、全新(2455-TW)及精材(3374-TW)，刪除光洋科(1785-TW)、志聖(2467-TW)及精測(6510-TW)，調整結果於今日收盤後生效。此次新納入標的橫跨記憶體、光通訊及先進封裝領域，瞄準AI資料中心與高效能運算帶動的半導體供應鏈商機。 觀察此次新增的3檔成分股，各自掌握不同AI關鍵應用。南亞科為台灣DRAM製造大廠，可望受惠AI伺服器推升記憶體需求；全新為砷化鎵磊晶片廠，布局資料中心高速光通訊及矽光子傳輸所需的關鍵材料；精材則為台積電轉投資的晶圓封裝廠，切入3D感測及先進封測領域，隨著AI晶片朝高效能、高整合度發展，相關技術需求也備受市場關注。 兆豐00913投資團隊指出，近期全球AI晶片龍頭輝達(NVIDIA)傳出高層人事變動及相關調查消息，引發市場對接班布局、技術路線及核心供應鏈變化的關注。不過，從整體產業鏈來看，無論未來AI晶片設計版圖如何變化，主流AI晶片與高效能運算處理器仍高度仰賴台灣在晶圓製造、先進製程及高階封裝的技術優勢。 法人分析，隨著市場評估AI產業未來發展，雲端服務供應商(CSP)可能進一步分散晶片供應來源，擴大與超微(AMD)、博通(Broadcom)及各大廠自研ASIC晶片的合作。","sentiment":0,"tags":{"topics":["AI/半導體"],"bull":[],"bear":[],"score":0,"highlights":[],"keywords":["兆豐","00913","半導體","晶圓代工","AI"]},"time":"11/17 11:06"},{"id":"edfdd8d48e628163","source":"Yahoo股市-台股","category":"台股","title":"台股4檔遭關禁閉！全新近5日飆逾2成、景碩同入列 致茂、台勝科今日出關","link":"https://tw.stock.yahoo.com/news/%E5%8F%B0%E8%82%A14%E6%AA%94%E9%81%AD%E9%97%9C%E7%A6%81%E9%96%89-%E5%85%A8%E6%96%B0%E8%BF%915%E6%97%A5%E9%A3%86%E9%80%BE2%E6%88%90-%E6%99%AF%E7%A2%A9%E5%90%8C%E5%85%A5%E5%88%97-%E8%87%B4%E8%8C%82-%E5%8F%B0%E5%8B%9D%E7%A7%91%E4%BB%8A%E6%97%A5%E5%87%BA%E9%97%9C-005000314.html","published":1794790200,"summary":"[FTNN新聞網]記者陳宣穎／綜合報導台股處置股名單出爐！根據證交所、櫃買中心最新公告，今（16）日共有4檔上市櫃及興櫃個股仍處於處置期間，包括全新（2455）...","sentiment":0,"tags":{"topics":[],"bull":[],"bear":[],"score":0,"highlights":[],"keywords":[]},"time":"11/16 08:50"}],"fund":{"code":"2455","rev_month":"11510","rev":471181.0,"rev_mom":4.925366819354968,"rev_yoy":32.66239269313827,"rev_cum_yoy":34.665152588853296,"eps_q":4.01,"eps_year":"115","eps_season":"3","net_income":746850.0,"pe":56.73,"pb":12.41,"yield":0.93,"updated":"2026-11-27 02:23"},"tdcc":{"latest":{"date":"2026-11-20","big1000":34.2,"big400":51.35,"retail":23.7,"holders":72499},"prev":{"date":"2026-11-13","big1000":34.33,"big400":50.97,"retail":23.42,"holders":72394},"d_big1000":-0.13,"d_big400":0.38,"d_retail":0.28,"d_holders":105},"weekly":{"bars":[{"time":"2026-07-27","open":322.5,"high":338.0,"low":255.0,"close":292.0,"volume":35416.006},{"time":"2026-08-03","open":301.5,"high":402.0,"low":300.0,"close":364.0,"volume":72203.08600000001},{"time":"2026-08-10","open":382.0,"high":398.0,"low":358.5,"close":379.5,"volume":19050.759},{"time":"202