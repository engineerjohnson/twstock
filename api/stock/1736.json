,122.71,122.3,122.17,122.28,122.33,122.28,122.19,122.39,122.11,122.53,121.54,121.04,120.76,120.26,119.63,119.08,118.94,118.89,118.59,118.58,118.35,118.41,118.3,118.01,118.18,118.52,119.03,119.28,118.1,117.83,114.96,112.88,111.72,109.87,108.43,107.38,106.19,105.08,104.65,104.03,101.7,100.55,100.45,98.95,98.89,99.04]},"insti":[{"date":"2026-11-27","foreign":4.588,"trust":0.0,"dealer":2.755},{"date":"2026-11-26","foreign":46.391,"trust":1.0,"dealer":-2.052},{"date":"2026-11-25","foreign":-36.059,"trust":-10.0,"dealer":-5.669},{"date":"2026-11-24","foreign":15.455,"trust":0.0,"dealer":3.195},{"date":"2026-11-23","foreign":67.18,"trust":0.0,"dealer":-7.82},{"date":"2026-11-20","foreign":91.642,"trust":0.0,"dealer":-11.515},{"date":"2026-11-19","foreign":129.964,"trust":-10.0,"dealer":3.163},{"date":"2026-11-18","foreign":41.365,"trust":0.0,"dealer":25.024},{"date":"2026-11-17","foreign":48.954,"trust":0.0,"dealer":7.882},{"date":"2026-11-16","foreign":102.509,"trust":0.0,"dealer":0.505},{"date":"2026-11-13","foreign":62.001,"trust":0.0,"dealer":2.0},{"date":"2026-11-12","foreign":184.518,"trust":0.0,"dealer":2.99},{"date":"2026-11-11","foreign":-64.859,"trust":0.0,"dealer":-5.05},{"date":"2026-11-10","foreign":56.843,"trust":-10.0,"dealer":-3.0},{"date":"2026-11-09","foreign":-39.629,"trust":0.0,"dealer":-2.0},{"date":"2026-11-06","foreign":-96.006,"trust":0.0,"dealer":-2.0},{"date":"2026-11-05","foreign":195.742,"trust":0.0,"dealer":0.0},{"date":"2026-11-04","foreign":31.362,"trust":1.0,"dealer":2.0},{"date":"2026-11-03","foreign":102.286,"trust":0.0,"dealer":0.0},{"date":"2026-11-02","foreign":-0.872,"trust":0.0,"dealer":1.0}],"news":[{"id":"cnyes6667496","source":"鉅亨網","category":"台股","title":"喬山(1736)第三季營收年增24%商用器材商機不只靠健身房展店","link":"https://news.cnyes.com/news/id/6667496","published":1795068094,"summary":"2026年11月19日（優分析／產業數據中心報導）⸺ 喬山(1736-TW)第三季合併營收149.6億元，年增24.2%。商用健身器材是喬山的主要業務，美國連鎖健身房Planet Fitness(PLNT-US)則是主要客戶之一。這家客戶近期下修新加盟店的器材安裝預估，但既有加盟店的換機採購增加。對喬山而言，這兩種需求要分開看。 Planet Fitness今年預計新增190至195個據點，高於原估的180至190個，主因是收購葡萄牙健身房業者Be-Fit，把25家已在營業的門店納入旗下。另一方面，Planet Fitness把全年新加盟店的器材安裝預估從150至160家下修至135至140家。管理層表示，美國合適店址不易取得，部分原定今年開幕的加盟店可能延到明年。 新店裝機放慢，舊店同時買了更多設備。第三季，Planet Fitness賣給既有加盟店的設備收入較去年同期增加960萬美元，抵銷新加盟店設備收入減少的80萬美元，帶動Planet Fitness設備部門營收年增11.1%至8,760萬美元。換機設備占該部門當季營收的比重，也從上年同期的82%升至85%。 展望全年，Planet Fitness把整體營收年增率預估由7%上修至約8%，同店銷售增幅也由約1%上調至1.5%至2%。不過，這是健身房業者的營運展望；對喬山來說，更直接的訊號是加盟店有沒有採購器材。","sentiment":-1,"tags":{"topics":["營收","法說/展望","匯率"],"bull":["年增"],"bear":["下修"],"score":-2,"highlights":["年增24%","年增24.2%","年增11.1%"],"keywords":["運動休閒","健身","優分析"]},"time":"11/19 14:01"},{"id":"cnyes6667226","source":"鉅亨網","category":"台股","title":"〈焦點股〉喬山進入銷售旺季全年營收可望再創高 逆風走揚","link":"https://news.cnyes.com/news/id/6667226","published":1795056851,"summary":"健身器材廠喬山(1736-TW)累計今年前三季營收站上400億元關卡，稅後純益18.05億元，年增逾7成，每股純益5.95元，隨著時序進到第四季，迎來銷售旺季，11、12月為全年營運高峰，預期在旺季需求帶動下，全年營收可望再創高，激勵喬山今(19)日逆風走揚，力拚站穩月線。 喬山今天早盤以114元開高，盤中最高漲至118.5元，大漲逾半根停板，不過隨後漲幅收斂，截至10點40分，股價暫報113元，漲幅約0.89%，力拚站穩月線，成交量約300張。三大法人持續敲進喬山，連續5個交易日買超，合計買超478張。 喬山積極拓展商用市場，今年推出大量產品布局與開發，目前喬山於全球商用市場市占率接近5成，新產品線有助提升市占率，預期相關布局效益將於明年逐步發酵，目標在2028年達到70%的市占率。同時，也預計於明年增設3家子公司，以擴大服務範圍。 家用市場部分，喬山指出，明年成長動能主要來自Bowflex，由於家用市場競爭激烈，重點將放在提升毛利率，因此目前與知名健身品牌合作，增加來店客數和銷售，有望帶動門市獲利。此外，也期望有突破性的產品線，鎖定高階家用健身市場。","sentiment":1,"tags":{"topics":["EPS/獲利","營收","法人動向","總經/聯準會"],"bull":["大漲","旺季","年增","站上","創高"],"bear":[],"score":7,"highlights":[],"keywords":["喬山","健身器材","商用"]},"time":"11/19 10:54"},{"id":"5e9a827f20e7831c","source":"UDN","category":"台股","title":"喬山法說會／商用健身需求熱 全年營收拚新高、越南廠支應至2028年","link":"https://news.google.com/rss/articles/CBMiUEFVX3lxTE9qdTRPRklTekticUZVM21rejBqQ3lrSlZHUWxpT3ZZU3RSelpmVGZtWkJpenRUZlBxRjhGTDZxVEtGY3FEMG5IclRvbmJGRWgy0gFWQVVfeXFMTjJWcUxPM1ZrbGdiTE1KUUFDNGRmRVJaV2taaF9HN3g2ZzBGMXd0aWpWWmR2MVBseGhaNWIwUzhjNkE4b2hNWFRYR2JKSmhBWlpXcXVhRVE?oc=5","published":1795009023,"summary":"喬山法說會／商用健身需求熱 全年營收拚新高、越南廠支應至2028年 UDN","sentiment":0,"tags":{"topics":["營收","法說/展望"],"bull":["新高"],"bear":[],"score":1,"