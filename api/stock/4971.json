634},{"date":"2026-09-30","foreign":-157.687,"trust":0.0,"dealer":0.022}],"news":[{"id":"cnyes6639382","source":"鉅亨網","category":"台股","title":"〈焦點股〉Lumentum、Coherent大漲 眾達-KY領軍光通訊族群紅光滿面","link":"https://news.cnyes.com/news/id/6639382","published":1793166946,"summary":"隨AI基礎建設需求強勁，持續支撐光通訊產業需求，美國光學元件廠Lumentum (LITE-US)、Coherent(COHR-US)及AXT(AXTI-US)周二(27日)收盤全面大漲，激勵今(28)日台廠供應鏈上揚，包括眾達-KY(4977-TW)、IET-KY(4971-TW)、全新(2455-TW)3檔開高走高，盤中在大單持敲進下攻上漲停板，推升光通訊族群多檔臉紅上漲。 盤面上，以眾達-KY等3檔磷化銦(InP)磊晶為主的供應商盤中衝上漲停板最為強勁，其他如環宇-KY(4991-TW)、上詮(3363-TW)、波若威(3163-TW)、華星光(4979-TW)、前鼎(4908-TW)、聯鈞(3450-TW)攜手上揚，飆漲超過半根停板。 由於矽光子技術利用光傳輸資料，推升先進AI硬體對傳輸速度的要求不斷提高，矽光子預料將逐步取代資料中心叢集內以銅為基礎的互連技術。同時，光學網路也有助於降低系統產生的熱量與耗電量。","sentiment":1,"tags":{"topics":["訂單/接單","AI/半導體"],"bull":["漲停","大漲","需求強勁","大單","供應鏈"],"bear":[],"score":10,"highlights":[],"keywords":["lumentum","矽光子","光通訊","眾達-KY","IET-KY","全新"]},"time":"10/28 13:55"}],"fund":{"code":"4971","rev_month":"11509","rev":108127.0,"rev_mom":1.9738951657015673,"rev_yoy":11.373538651696967,"rev_cum_yoy":19.2517206167805,"eps_q":2.31,"eps_year":"115","eps_season":"2","net_income":97569.0,"pe":117.83,"pb":5.05,"yield":0.18,"updated":"2026-10-30 16:33"},"tdcc":{"latest":{"date":"2026-10-22","big1000":22.08,"big400":40.75,"retail":32.76,"holders":39118},"prev":{"date":"2026-10-08","big1000":22.09,"big400":40.93,"retail":31.85,"holders":38924},"d_big1000":-0.01,"d_big400":-0.18,"d_retail":0.91,"d_holders":194},"weekly":{"bars":[{"time":"2026-07-27","open":402.5,"high":440.0,"low":316.0,"close":347.5,"volume":5492.885},{"time":"2026-08-03","open":374.0,"high":508.0,"low":374.0,"close":460.5,"volume":8266.184000000001},{"time":"2026-08-10","open":479.0,"high":535.0,"low":462.0,"close":480.0,"volume":5417.816},{"time":"2026-08-17","open":487.0,"high":612.0,"low":487.0,"close":588.0,"volume":22225.379999999997},{"time":"2026-08-24","open":575.0,"high":581.0,"low":502.0,"close":568.0,"volume":5738.915},{"time":"2026-08-31","open":555.0,"high":726.0,"low":555.0,"close":624.0,