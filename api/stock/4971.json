ealer":0.274},{"date":"2026-10-16","foreign":10.139,"trust":0.0,"dealer":-0.032},{"date":"2026-10-15","foreign":28.633,"trust":0.0,"dealer":-6.965}],"news":[{"id":"eef6d86a493ba12f","source":"優分析UAnalyze","category":"台股","title":"國防客戶加速提貨，IET-KY(4971) 10 月營收創年內新高！商用擴張仍受基板產能限制","link":"https://news.google.com/rss/articles/CBMiVkFVX3lxTFBjZjJBbGdzMk1qajVOLTV1M1JaX1p0cjF1SUFEWUN3V1NnWnZUTkY4UzRpbEZ4aGVyOXRUelBpVmdGMlVhc3dkaFFEaXBzTFV1SDVBaFNR?oc=5","published":1794544861,"summary":"國防客戶加速提貨，IET-KY(4971) 10 月營收創年內新高！商用擴張仍受基板產能限制 優分析UAnalyze","sentiment":1,"tags":{"topics":["營收","擴產/資本支出"],"bull":["新高","營收創"],"bear":[],"score":3,"highlights":[],"keywords":[]},"time":"11/13 12:41"},{"id":"cnyes6660813","source":"鉅亨網","category":"頭條","title":"〈IET法說〉高毛利助攻Q3季增賺逾2倍 受惠國防、光通訊雙引擎助攻","link":"https://news.cnyes.com/news/id/6660813","published":1794486686,"summary":"三五族磊晶廠IET-KY(4971-TW)英特磊於今(12)日舉辦法說會，並公告今(2026)年第3季財報，受惠於國防相關銻化鎵及砷化鎵訂單增加，挹注高毛利產品出貨比重提升，單季稅後純益5,900萬元、季增高214.31%、年增98.06%，EPS為1.26元。展望未來，英特磊董事長高永中表示，明(2027)年隨著磷化銦(InP)基板供應緩解加上新產品陸續量產、國防產品放量，公司對業績呈現樂觀看待。 英特磊第3季營收為3.19億元、年增26.84%；稅後純益為5,900萬元、季增214.31%、年增98.06%；營業毛利1.24億元、年增55.07%；毛利率38.72%、年增7個百分點； 營業利益率18.16%、年增4.7個百分點。 累計前3季營收9.08億元、年增19.3%，毛利率40.72%，營業利益1.76億元、年增76.14%；稅後純益1.57億元，EPS為3.58元，已超越去年全年度獲利。法人推估英特磊今年全年獲利有望挑戰歷史新高。 高永中表示，公司在第3季國防客戶需求明顯增溫，也帶動高附加價值的磊晶產品出貨增加，推升營收季增24.64%，毛利率也第2季提高，加上產品組合改善帶動本業獲利提升及客戶需求強勁，目前公司在半導體基板及關鍵原料價格亦明顯上漲，公司將持續與客戶協商調整售價，適度反映材料成本變化。","sentiment":1,"tags":{"topics":["訂單/接單","EPS/獲利","營收","法說/展望","AI/半導體","總經/聯準會"],"bull":["訂單","出貨","放量","年增","受惠"],"bear":[],"score":7,"highlights":["年增98.06%","EPS為1.26元","年增26.84%"],"keywords":["國防","光通訊","光聖","IET-KY法說會","AI伺服器"]},"time":"11/12 20:31"}],"fund":{"code":"4971","rev_month":"11510","rev":124023.0,"rev_mom":14.70123095988976,"rev_yoy":22.012238312608215,"rev_cum_yoy":19.49834221618057,"eps_q":3.58,"eps_year":"115","eps_season":"3","net_income":156899.0,"pe":86.39,"pb":4.43,"yield":0.21,"updated":"2026-11-13 17:58"},"tdcc":{"latest":{"date":"2026-11