損0.58元。","sentiment":1,"tags":{"topics":["EPS/獲利","營收","擴產/資本支出","法說/展望","總經/聯準會","匯率"],"bull":["擴產","倍增","受惠"],"bear":[],"score":7,"highlights":[],"keywords":["中傑-KY","營收","印尼","印度","越南"]},"time":"11/25 17:22"}],"fund":{"code":"6965","rev_month":"11510","rev":1722943.0,"rev_mom":3.562287894652691,"rev_yoy":9.398554722992806,"rev_cum_yoy":-3.8549436423893177,"eps_q":-0.58,"eps_year":"115","eps_season":"3","net_income":-91806.0,"pe":null,"pb":0.86,"yield":7.91,"updated":"2026-11-27 02:23"},"tdcc":{"latest":{"date":"2026-11-20","big1000":90.64,"big400":92.3,"retail":2.24,"holders":2204},"prev":{"date":"2026-11-13","big1000":90.48,"big400":92.46,"retail":2.36,"holders":2248},"d_big1000":0.16,"d_big400":-0.16,"d_retail":-0.12,"d_holders":-44},"weekly":{"bars":[{"time":"2026-07-27","open":77.8,"high":79.7,"low":76.9,"close":79.2,"volume":167.336},{"time":"2026-08-03","open":77.4,"high":79.2,"low":75.1,"close":77.3,"volume":148.36700000000002},{"time":"2026-08-10","open":77.7,"high":77.7,"low":74.6,"close":75.9,"volume":142.524},{"time":"2026-08-17","open":75.7,"high":75.7,"low":72.6,"close":75.1,"volume":111.83599999999998},{"time":"2026-08-24","open":75.0,"high":75.5,"low":73.3,"close":75.2,"volume":66.64099999999999},{"time":"2026-08-31","open":73.0,"high":74.4,"low":72.3,"close":73.8,"volume":121.262},{"time":"2026-09-07","open":75.1,"high":75.1,"low":69.4,"close":69.8,"volume":198.365},{"time":"2026-09-14","open":68.3,"high":71.0,"low":67.4,"close":71.0,"volume":176.486},{"time":"2026-09-21","open":70.9,"high":70.9,"low":67.1,"close":67.1,"volume":98.481},{"time":"2026-09-29","open":66.4,"high":67.0,"low":61.2,"close":61.6,"volume":506.22},{"time":"2026-10-05","open":61.6,"high":65.9,"low":59.3,"close":65.8,"volume":419.471},{"time":"2026-10-12","open":65.8,"high":68.2,"low":62.2,"close":66.6,"volume":250.96099999999998},{"time":"2026-10-19","open":65.1,"high":66.6,"low":64.2,"close":64.3,"volume":94.762},{"time":"2026-10-27","open":65.5,"high":66.1,"low":62.7,"close