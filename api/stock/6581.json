家剛轉盈 兩家關聯企業的獲利來源不同。公司表示，台灣鋼聯的獲利持續較好，豐堉今年則轉虧為盈。 台灣鋼聯從事煉鋼集塵灰回收與鋅提煉，獲利隨鋅價變動；豐堉資源從事一般及有害事業廢棄物處理，2026 年第 2 季取得售電執照後開始有售電收入，是今年由虧轉盈的轉折點。兩家都是關聯企業、不是合併子公司，收益按持股比例認列，因此金額會隨各自的獲利與鋅價起伏。 本業的獲利則小幅下滑。前 3 季營收 208.74 億元、年減 7%，毛利率 12.3% 高於去年同期的 11.5%，靠的是產品組合往條線與型鋼移動，鋼筋佔營收的比重降到 48%，比去年明顯下滑。 第 3 季業外縮水 第 3 季的表現更能凸顯業外對獲利的影響。","sentiment":0,"tags":{"topics":["EPS/獲利","營收","總經/聯準會"],"bull":["成長","年增"],"bear":["年減"],"score":1,"highlights":["年增 12%"],"keywords":["業外損益","權益法","轉投資","財務結構","優分析"]},"time":"11/12 18:30"}],"fund":{"code":"6581","rev_month":"11510","rev":92811.0,"rev_mom":-36.266249150202924,"rev_yoy":-60.58696381479767,"rev_cum_yoy":6.494954377745933,"eps_q":6.4,"eps_year":"115","eps_season":"3","net_income":712642.0,"pe":13.42,"pb":2.63,"yield":4.86,"updated":"2026-11-13 17:58"},"tdcc":{"latest":{"date":"2026-11-06","big1000":86.89,"big400":89.97,"retail":2.81,"holders":2253},"prev":{"date":"2026-10-30","big1000":86.89,"big400":89.97,"retail":2.83,"holders":2263},"d_big1000":0.0,"d_big400":0.0,"d_retail":-0.02,"d_holders":-10},"weekly":{"bars":[{"time":"2026-07-27","open":107.0,"high":109.0,"low":107.0,"close":109.0,"volume":167.265},{"time":"2026-08-03","open":108.0,"high":109.0,"low":107.0,"close":108.0,"volume":100.03399999999999},{"time":"2026-08-10","open":107.5,"high":108.5,"low":107.0,"close":107.0,"volume":94.895},{"time":"2026-08-17","open":108.0,"high":109.0,"low":107.0,"close":108.5,"volume":84.275},{"time":"2026-08-24","open":108.5,"high":110.0,"low":108.0,"close":109.5,"volume":112.781},{"time":"2026-08-31","open":108.5,"high":110.5,"low":108.0,"close":109.5,"volume":96.02000000000001},{"time":"2026-09-07","open":109.5,"high":112.0,"low":109.0,"close":111.5,"volume":118.85400000000001},{"time":"2026-09-14","open":109.5,"high":110.5,"low":108.5,"close":109.5,"volume":80.607},{"time":"2026-09-21","open":109.5,"high":109.5,"low":108.0,"close":108.5,"volume":21.769999999999996},{"time":"2026-09-29","open":108.0,"high":109.0,"low":108.0,"close":108.0,"volume":50.8940000