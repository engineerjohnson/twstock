族群有撐，健策、奇鋐、雙鴻、高力均收紅。另外，緯穎也隨母公司緯創走強，收漲逾2%。 傳產方面，國際油價回檔，台塑四寶重挫，台塑化跌逾8%，台塑跌4%，南亞及台化也跌2%；金融股也普遍走弱，國泰金跌近4%，台新新光金、富邦金等跌3%。","sentiment":-1,"tags":{"topics":["AI/半導體","航運/傳產","盤後"],"bull":[],"bear":["縮減","賣壓"],"score":-3,"highlights":[],"keywords":["台股","台積電","鴻海","緯創","散熱"]},"time":"10/20 14:30"},{"id":"50f632b332b51ff5","source":"永豐金證券","category":"台股","title":"三大法人買賣超 – 外資買超(6669)緯穎、(2317)鴻海，投信買超(2368)金像電、(2454)聯發科，法人合計賣超678.07億元","link":"https://news.google.?oc=5","published":1792134000,"summary":"三大法人買賣超 – 外資買超(6669)緯穎、(2317)鴻海，投信買超(2368)金像電、(2454)聯發科，法人合計賣超678.07億元 永豐金證券","sentiment":1,"tags":{"topics":["法人動向","金融"],"bull":["買超","法人買"],"bear":["賣超"],"score":2,"highlights":[],"keywords":[]},"time":"10/16 15:00"},{"id":"6fe9a22a48553dd8","source":"永豐金證券","category":"台股","title":"【1012台股盤前】連假前外資提款台股收黑失守5日線！OpenAI烏龍報導衝擊AI產業，被動元件與半導體測試逆勢走強，投本比排行鎖定世芯-KY、金像電、台塑化｜豐雲學堂2026 年 10 月","link":"https://news.google.com/rss/articles/CBMiggFBVV95cUxOWXRTS1FrTFp2bnBvWUh4c2FUdDZSYk51RnNFLXdGYWJYQ2h2Nk5BTjNrWmRIcWpYenB6V0Nyb1VEUWJ0dkw3T0I1bXk3cU8xclQ3VTAwak53UldRMzlIcll2Y0x6d1pGbnRLY2FuSzFIRUpodXQ0UWczeE5ZM0Z1Wmx3?oc=5","published":1791961200,"summary":"【1012台股盤前】連假前外資提款台股收黑失守5日線！OpenAI烏龍報導衝擊AI產業，被動元件與半導體測試逆勢走強，投本比排行鎖定世芯-KY、金像電、台塑化｜豐雲學堂2026 年 10 月 永豐金證券","sentiment":-1,"tags":{"topics":["法人動向","AI/半導體","航運/傳產","金融","盤前"],"bull":[],"bear":["失守","提款"],"score":-3,"highlights":[],"keywords":[]},"time":"10/14 15:00"}],"fund":{"code":"2368","rev_month":"11509","rev":9319805.0,"rev_mom":-10.248160361772968,"rev_yoy":55.462822673426,"rev_cum_yoy":69.0679079756067,"eps_q":16.17,"eps_year":"115","eps_season":"2","net_income":8267039.0,"pe":40.02,"pb":13.68,"yield":0.88,"updated":"2026-10-25 00:33"},"tdcc":{"latest":{"date":"2026-10-22","big1000":68.19,"big400":76.81,"retail":9.43,"holders":119673},"prev":{"date":"2026-10-08","big1000":68.02,"big400":76.65,"retail":9.25,"holders":115443},"d_big1000":0.17,"d_big400":0.16,"d_retail":0.18,"d_holders":4230},"weekly":{"bars":[{"time":"2026-07-27","open"