.1元，單周大漲24.46%，股價已站穩所有均線，並完成三重底型態，短線技術面轉強。目前5日線18.99元為短線支撐，10日線與月線則在17.8元附近糾結，形成另一道支撐區。","sentiment":0,"tags":{"topics":["EPS/獲利","營收","法說/展望","總經/聯準會"],"bull":["獲利","年增"],"bear":["虧損"],"score":0,"highlights":[],"keywords":["欣興","同泰","營收","盈餘","軟板"]},"time":"10/31 08:50"},{"id":"3312863b5341902e","source":"CMoney投資網誌","category":"台股","title":"【09:41 即時新聞】同泰(3321)盤中走強，主力買盤續進場","link":"https://news.google.com/rss/articles/CBMijgFBVV95cUxNbE9ja3pLZDFFNUxkWFdqM1VUYm9BUmFONHBPVzhPMjBUdWthMklPb0toMk5oRnZGZjhUZVJ0eDRWemEzN3N3MjNnOGVLLUZCWC1sRHFvYXN6WGcwdTdIcGEwWVFwRnVYWlByYnl3R1NoUWtfMnVhQzNPdFdSNE9oS2c2UVo4dnNpamZONWRn?oc=5","published":1793238100,"summary":"【09:41 即時新聞】同泰(3321)盤中走強，主力買盤續進場 CMoney投資網誌","sentiment":0,"tags":{"topics":["法人動向"],"bull":[],"bear":[],"score":0,"highlights":[],"keywords":[]},"time":"10/29 09:41"}],"fund":{"code":"3321","rev_month":"11509","rev":199182.0,"rev_mom":-14.893307924354165,"rev_yoy":-5.972601187722462,"rev_cum_yoy":12.71015450780995,"eps_q":-0.78,"eps_year":"115","eps_season":"2","net_income":-67534.0,"pe":null,"pb":2.55,"yield":null,"updated":"2026-10-30 16:33"},"tdcc":{"latest":{"date":"2026-10-22","big1000":37.72,"big400":48.15,"retail":14.34,"holders":28569},"prev":{"date":"2026-10-08","big1000":37.66,"big400":48.0,"retail":14.3,"holders":28424},"d_big1000":0.06,"d_big400":0.15,"d_retail":0.04,"d_holders":145},"weekly":{"bars":[{"time":"2026-07-27","open":18.75,"high":18.8,"low":16.5,"close":17.9,"volume":1376.209},{"time":"2026-08-03","open":17.9,"high":21.1,"low":17.6,"close":19.1,"volume":1837.808},{"time":"2026-08-10","open":19.25,"high":19.7,"low":18.1,"close":18.3,"volume":912.065},{"time":"2026-08-17","open":18.15,"high":19.0,"low":17.65,"close":18.15,"volume":615.665},{"time":"2026-08-24","open":18.0,"high":19.2,"low":17.65,"close":18.55,"volume":977.507},{"time":"2026-08-31","open":18.8,"high":18.8,"low":17.0,"close":18.1,"volume":1061.959},{"time":"2026-09-07","open":18.1,"high":18.4,"low":16.9,"close":17.35,"volume":1017