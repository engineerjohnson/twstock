oreign":-69.0,"trust":0.0,"dealer":-0.335}],"news":[{"id":"cnyes6667707","source":"鉅亨網","category":"台股","title":"永信建高雄龍華10期預計明年完工 後續有9大案1201戶住宅開發規劃","link":"https://news.cnyes.com/news/id/6667707","published":1795081150,"summary":"永信建設(5508-TW)今(19)日召開法說會，永信建設指出，2026年1-3季稅後純益6.97億元，已經超越2025年全年獲利，年增42.08%，每股純益3.21元；2026年有楠梓區「晴仰」及鳳山區「清朗」兩案陸續完工，合計280戶、總銷估約52億元，2027年有高雄鼓山的龍華10期65戶住宅大樓完工。 同時，永信建設提出包括高雄的在苓雅、鳳山、前鎮、仁武、楠梓等9大案開發規劃，預計將陸續完成興建1201戶住宅，其中在苓雅區的「師大案」將興建地上30層、地下4層的171戶住宅最高，而其中在楠梓區將推出4案，規劃戶數合計達550戶。 永信建設2026年第三季營收12.2億元，毛利率39.45%，季增2.33個百分點，年減4個百分點，2026年第三季稅後純益3.17億元，爲8季以來新高，季增64.5%，年增1.91倍，每股純益1.46元。 永信建設2026年1-3季營收29.51億元，毛利率39.39%，年減5.74個百分點，2026年1-3季稅後純益6.97億元，已經超越2025年全年獲利年，增42.08%，每股純益3.21元。永信建設指出，公司持續掌握既有建案銷售與交屋進度，並兼顧工程推進、成本控管及資金安排，穩健推動各項開發計畫。 2026年完工個案方面，永信建設指出，位於高雄市楠梓區的「晴仰」，為公司高大三期開發案，規劃152戶，總銷約31億元，已於近期取得使用執照。","sentiment":1,"tags":{"topics":["EPS/獲利","營收","法說/展望","總經/聯準會"],"bull":["獲利","年增"],"bear":[],"score":2,"highlights":["年增42.08%","年增1.91倍"],"keywords":["永信建","高雄","推案","楠梓","住宅"]},"time":"11/19 17:39"}],"fund":{"code":"5508","rev_month":"11510","rev":376728.0,"rev_mom":-39.82221157302025,"rev_yoy":118.23616646584485,"rev_cum_yoy":72.52762635746852,"eps_q":3.21,"eps_year":"115","eps_season":"3","net_income":697416.0,"pe":10.96,"pb":1.66,"yield":6.3,"updated":"2026-11-20 19:27"},"tdcc":{"latest":{"date":"2026-11-13","big1000":65.78,"big400":69.0,"retail":14.05,"holders":17848},"prev":{"date":"2026-11-06","big1000":66.28,"big400":69.01,"retail":14.06,"holders":17856},"d_big1000":-0.5,"d_big400":-0.01,"d_retail":-0.01,"d_holders":-8},"weekly":{"bars":[{"time":"2026-07-27","open":51.3,"high":52.2,"low":49.2,"close":50.2,"volume":2555.3849999999998},{"time":"2026-08-03","open":50.0,"high":53.9,"low":49.6,"close":53.5,"volume":1626.301},{"time":"2026-08-10","open":53.9,"high":55.3,"low":52.5,"close":52.8,"volume":1241.562},{"time":"2026-08-17","open":53.6,"high":54.0,"low":51.7,"close":53.8,"volume":1028.047},{"time":"2026-08-24","open":53.8,"high":54.4,"low"