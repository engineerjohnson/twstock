醫藥跌超10%，榮昌生物跌7.60%，信達生物與藥明生物大跌超6%；主因美聯儲加息預期抬升壓制長久期資產估值。 新能源及汽車鏈方面，理想汽車與寧德時代相關消息持續發酵，帶動鋰電池股走弱，寧德時代跌超4%。","sentiment":-1,"tags":{"topics":["EPS/獲利","AI/半導體","生技","盤後"],"bull":[],"bear":["大跌"],"score":-2,"highlights":[],"keywords":["恒生指數","恒生科技指數","科網股","半導體","生物科技","創新藥","港股盤後"]},"time":"11/20 16:39"}],"fund":{"code":"4128","rev_month":"11510","rev":169558.0,"rev_mom":12.717796672139976,"rev_yoy":-3.113036124475732,"rev_cum_yoy":3.1469395271954688,"eps_q":0.61,"eps_year":"115","eps_season":"3","net_income":163208.0,"pe":21.27,"pb":0.75,"yield":0.0,"updated":"2026-11-27 02:23"},"tdcc":{"latest":{"date":"2026-11-20","big1000":39.58,"big400":43.37,"retail":15.64,"holders":100746},"prev":{"date":"2026-11-13","big1000":39.79,"big400":43.55,"retail":15.64,"holders":100724},"d_big1000":-0.21,"d_big400":-0.18,"d_retail":0.0,"d_holders":22},"weekly":{"bars":[{"time":"2026-07-27","open":14.9,"high":15.15,"low":13.6,"close":13.85,"volume":7647.35},{"time":"2026-08-03","open":14.5,"high":15.1,"low":14.05,"close":14.7,"volume":7150.719},{"time":"2026-08-10","open":14.8,"high":15.15,"low":14.45,"close":14.8,"volume":6475.039},{"time":"2026-08-17","open":15.2,"high":15.8,"low":14.75,"close":15.6,"volume":7531.575000000001},{"time":"2026-08-24","open":15.7,"high":15.75,"low":14.85,"close":15.3,"volume":4695.142},{"time":"2026-08-31","open":15.15,"high":15.3,"low":14.4,"close":14.65,"volume":4357.048},{"time":"2026-09-07","open":14.65,"high":15.1,"low":14.45,"close":14.5,"volume":2894.8110000000006},{"time":"2026-09-14","open":14.5,"high":14.75,"low":14.1,"close":14.6,"volume":7105.73},{"time":"2026-09-21","open":14.65,"high":14.95,"low":14.5,"close":14.85,"volume":2816.0599999999995},{"time":"2026-09-29","open":14.65,"high":15.45,"low":14.65,"close":15.3,"volume":4917.592000000001},{"time":"2026-10-05","open":15.4,"high":16.0,"low":15.25,"close":15.55,"volume":6493.805},{"time":"2026-10-12","open":15.7,"high":15.95,"low":15.0,"close":15.5,"volume":6616.558},{"time":"2026-10-19","open