aler":-90.454},{"date":"2026-10-01","foreign":-16910.296,"trust":0.0,"dealer":-39.023},{"date":"2026-09-30","foreign":-962.29,"trust":0.0,"dealer":-116.0},{"date":"2026-09-29","foreign":-8188.275,"trust":9.0,"dealer":-4.759}],"news":[{"id":"4e8000b4df318e4f","source":"富聯網","category":"台股","title":"《台北股市》外資30日買超股：陽明、台泥、臺企銀","link":"https://news.google.com/rss/articles/CBMiiAFBVV95cUxQTGJjc0pTeC1HT3JrNGlSVWxzelpwOWQwQ3Rnb0JGVXJNQ3pfMmhoSmZndmdyM1RGazJIMHlCS3lFakRGR1RUODlHaVdlNXZyLXJfMExWX2VJeWVDYmhlSGo5V2xFZW9jUUJmRGRMV1hHR24wS3dZTFVEWUhuUVB0cE94dW1pVkND?oc=5","published":1793410080,"summary":"《台北股市》外資30日買超股：陽明、台泥、臺企銀 富聯網","sentiment":1,"tags":{"topics":["法人動向"],"bull":["買超"],"bear":[],"score":2,"highlights":[],"keywords":[]},"time":"10/31 09:28"},{"id":"cnyes6641939","source":"鉅亨網","category":"台股","title":"外資單日重砍台股1124億元創史上第七大賣超 反手布局防禦型傳產股","link":"https://news.cnyes.com/news/id/6641939","published":1793353493,"summary":"台北股市今(30)日大盤開低震盪，尾盤集中市場守住45000點大關，以45211.83點作收，較昨日下跌1156.5點，市場成交值8777.3億元。集中市場三大法人合計賣超1398.44億元，其中外資下重手賣超1124.67億元，創下史上第七大賣超紀錄，同時，外資在期貨市場並加空1780口空單。 外資今天在集中市場酌量買超的個股多屬傳產、航運及電信族群龍頭股，包括台泥(1101-TW)、中華電(2412-TW)、長榮(2603-TW)、寶成(9904-TW)、統一(1216-TW)。 今天在現貨市場中，外資賣超1124.67億元，投信買超239.93億元，自營商合計賣超513.7億元，三大法人合計賣超1398.44億元，在期貨市場，外資30日交易口數淨額爲空單1780口，未平倉口數爲空單94241口。 新台幣兌美元匯率今天以32.478元作收、升值1.4分，台北外匯市場成交金額24.4億美元。 今天集中市場外資買超較多的個股爲，陽明、台泥、臺企銀、中華電、合庫金、長榮、寶成、統一、華航、彰銀；今天集中市場外資賣超較多的個股爲，友達、力積電、國巨*、南亞、仁寶、台新新光金、宏碁、緯創、群創。","sentiment":0,"tags":{"topics":["法人動向","匯率","航運/傳產"],"bull":["買超","布局"],"bear":["賣超"],"score":1,"highlights":[],"keywords":["寶成","中華電","長榮","外資","期貨"]},"time":"10/30 17:44"},{"id":"cnyes6640736","source":"鉅亨網","category":"台股","title":"9銀行挺半導體通路龍頭 彰銀兆豐銀統籌大聯大旗下世平集團逾363億元聯貸案簽約","link":"https://news.cnyes.com/news/id/6640736","published":1793272562,"summary":"彰銀 (2801-TW) 及兆豐銀行統籌主辦的大聯大 (3702-TW) 旗下世平集團聯貸案，今 (29) 日舉行簽約儀式，本次聯貸金額包含等值新台幣 196.6 億元與 5.122 億美元（1:32.55等值新台幣166.72億元），共約新台幣363.32億元，由彰銀董事長胡光華代表銀行團與世平集團董事長張蓉崗共同簽訂合約。本案資金將用於充實世平集團中期營運周轉金，獲得多家金融機構熱烈響應，凸顯市場對世平集團經營體質與發展前景的高度肯定，也為企業因應全球半導體供應鏈重組及人工智慧技術升級，提供穩健的財務後盾。 本次聯貸案由世平興業股份有限公司、世平363國際 (香港) 有限公司及 WPI Technology Pte. Ltd. 共同擔任借款人，並由彰銀與兆豐銀行擔任額度管理銀行。參貸銀行陣容龐大，包含華南銀行、台北富邦銀行、第一銀行、合作金庫、臺企銀 (2834-TW)、中國銀行及農業金庫等金融機構。金融圈人士指出，在當前全球總體經濟環境多變之際，銀行團踴躍參與本次聯貸，展現出金融業對半導體通路龍頭企業強勁營運實力與風險控管能力的高度信任。 世平興業創立於 1980 年，為全球第一大半導體零組件通路商大聯大控股旗下的核心成員。","sentiment":0,"tags":{"topics":["AI/半導體","匯率","金融"],"bull":[],"bear":[],"score":0,"highlights":[],"keywords":["彰銀","聯貸","大聯大","世平","統籌","兆豐銀行","半導體","AI"]},"time":"10/29 19:16"},{"id":"b9e0da4cb3c3f3b4","source":"富聯網","category":"台股","title":"《一週投信買超15-3》科技創(2900)、金像電(2849)、臺企銀(2785)","link":"https://news.google.com/rss/articles/CBMiiAFBVV95cUxNZTNVc1RtVVRNT05nMFNxcnpvakFjWlljSXU2R0RTalpIY2NjQjU2Qi1vSVpVUjhCTDNIWG9VUWVrWWJaeEFJVFhfZy1UcVRMM0t4T0prOEJER2tzeTg4c3dQZmtZV2l1MzdVUFlfMUtrUWxETktqdHJoZmZSSTg1WGp4Q1pKY1BN?oc=5","published":1793058360,"summary":"《一週投信買超15-3》科技創(2900)、金像電(2849)、臺企銀(2785) 富聯網","sentiment":1,"tags":{"topics":["法人動向"],"bull":["買超"],"bear":[],"score":2,"highlights":[],"keywords":[]},"time":"10/27 07:46"},{"id":"60c55a6f0887c24c","source":"富聯網","category":"台股","title":"《一週外資買超38-19》技 嘉(547)、臺企銀(540)、高息中(524)","link":"https://news.google.com/rss/articles/CBMiiAFBVV95cUxOZ3k0djZ5LVFqNnNGeDVSTTZZOUQxV3dYeTYzdGdLSFNDUzlKSVBvWUVZd3o3QTRKYVF4M2FsaFl0UXF0TFNfRVd0ckdiQjVxdlZfRWxwQldPNDNCM0dxRjlDTjJEUVN6blFxdloxc29nMnEzN2FSdXpWRFJWNDQwQU9CanA4eHVz?oc=5","published":1793058360,"summary":"《一週外資買超38-19》技 嘉(547)、臺企銀(540)、高息中(524) 富聯網","sentiment":1,"tags":{"topics":["法人動向"],"bull":["買超"],"bear":[],"score":2,"highlights":[],"keywords":[]},"time":"10/27 07:46"},{"id":"06df8455ec7fc9d4","source":"富聯網","category":"台股","title":"《外資買超26-3》全球創(5422)、臺企銀(5072)、台中銀(4964)","link":"https://news.google.com/rss/articles/CBMiiAFBVV95cUxQbUFwSUYyN2NEdVZmTHZYOXA2Z1MwXzNFdWxQUlE2VWlXd2Z5ZS1wV2xjUzJ5SXRVb3VFVUg3amtNa0hLczBxZENzLURieDJpT2M5T1VGbVFjaF9RbnI4Nl9EOFFXdUxUSzdZTkx5NVdMRGlsaEJ4dDY2YzFqS3E3b0NIVG5yTG1B?oc=5","published":1792977840,"summary":"《外資買超26-3》全球創