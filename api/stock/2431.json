已於10月26日向美國證券交易委員會提交上市申請，規劃以ANT為代號在那斯達克掛牌，重新點燃市場對AI產業的關注；但AI資本支出能否轉化為持續獲利，仍是後續評價關鍵。 退休基金資金挹注： 新制勞退委外資金與既有未撥款金額合計約1,550億元，若資金陸續進場，可望提供市場一定支撐，惟實際進場時程與配置仍須追蹤。 先進封裝需求強勁： 市場傳出台積電CoWoS報價醞釀調漲1～2成，部分設備交期延長至8個月，反映AI晶片需求與先進封裝產能仍然吃緊。相關消息仍待公司或供應鏈進一步確認。","sentiment":-1,"tags":{"topics":["EPS/獲利","擴產/資本支出","法人動向","AI/半導體","美股/國際","金融"],"bull":["買超","反彈"],"bear":["賣超","利空","縮減"],"score":-3,"highlights":[],"keywords":["倫元投顧","陳學進","台股","趨勢分析"]},"time":"10/27 17:40"}],"fund":{"code":"2431","rev_month":"11509","rev":29796.0,"rev_mom":96.25872744038993,"rev_yoy":27.040163724737784,"rev_cum_yoy":-41.90211603161834,"eps_q":-0.32,"eps_year":"115","eps_season":"2","net_income":-35645.0,"pe":null,"pb":1.12,"yield":null,"updated":"2026-10-30 16:33"},"tdcc":{"latest":{"date":"2026-10-22","big1000":36.1,"big400":42.51,"retail":22.94,"holders":51362},"prev":{"date":"2026-10-08","big1000":36.0,"big400":42.04,"retail":23.0,"holders":51365},"d_big1000":0.1,"d_big400":0.47,"d_retail":-0.06,"d_holders":-3},"weekly":{"bars":[{"time":"2026-07-27","open":10.7,"high":10.8,"low":9.65,"close":10.05,"volume":1525.384},{"time":"2026-08-03","open":10.1,"high":10.6,"low":9.85,"close":10.5,"volume":652.1690000000001},{"time":"2026-08-10","open":10.5,"high":10.5,"low":10.0,"close":10.25,"volume":1230.1059999999998},{"time":"2026-08-17","open":10.15,"high":10.45,"low":10.1,"close":10.3,"volume":850.0760000000001},{"time":"2026-08-24","open":10.4,"high":10.7,"low":10.2,"close":10.35,"volume":544.577},{"time":"2026-08-31","open":10.35,"high":10.45,"low":9.9,"close":10.1,"volume":893.989},{"time":"2026-09-07","open":10.1,"high":10.1,"low":9.93,"close":9.98,"volume":641.823},{"time":"2026-09-14","open":9.94,"high":10.15,"low":9.7,"close":10.15,"volume":503.50699999999995},{"time":"2026-09-21","open":10.1,"high":10.4,"low":10.05,"close":10.05,"volume":355.177},{"time":"2026-09-29","open":10.05,"high":10.25,"low":9.99,"close":10.15,"volume":345.58799999999997},{"time":"2026-10-05","open":10.15,"high":10.15,"low":9.98