，豪宅社區「松濤苑」完工13年以來的最新成交價格站穩250萬元之上。 台北市中正區植物園景觀豪宅「松濤苑」只興建12樓，總戶數僅20 戶，目前屋齡13年多，依實價登錄交易14筆的資料顯示， 2015年8月，「松濤苑」6樓戶曾創下每坪270.6萬元的社區每坪最高成交單價。","sentiment":0,"tags":{"topics":[],"bull":[],"bear":[],"score":0,"highlights":[],"keywords":["松濤苑","潤泰新","豪宅","中正區"]},"time":"10/25 17:49"},{"id":"a531a27590e31aa9","source":"富聯網","category":"台股","title":"《外資買超26-5》潤泰新(2613)、佳世達(2582)、遠東銀(2425)","link":"https://news.google.com/rss/articles/CBMiiAFBVV95cUxNR0R0WXNINnVmcWl5QWdCQkd2YnVvc1BzS3BPQnFMZnh3ekZjZkFVSkMwOG5RbjRidE5uN2c0NVdhMHNTOHd1ajVxUWJVSzNuYXU1S2xRbzJ2Ymt2aHRmNkFXckRuRERHbkVPZkxlTTV4TzdaUjVxMUx0cGR6Rk41TzZMUF9Ibll4?oc=5","published":1792890240,"summary":"《外資買超26-5》潤泰新(2613)、佳世達(2582)、遠東銀(2425) 富聯網","sentiment":1,"tags":{"topics":["法人動向"],"bull":["買超"],"bear":[],"score":2,"highlights":[],"keywords":[]},"time":"10/25 09:04"}],"fund":{"code":"9945","rev_month":"11509","rev":3108067.0,"rev_mom":-10.261627336236774,"rev_yoy":-6.6736229551514565,"rev_cum_yoy":28.96225294994541,"eps_q":3.7,"eps_year":"115","eps_season":"2","net_income":11234382.0,"pe":5.09,"pb":0.51,"yield":3.78,"updated":"2026-10-30 16:33"},"tdcc":{"latest":{"date":"2026-10-22","big1000":62.17,"big400":66.5,"retail":8.03,"holders":100748},"prev":{"date":"2026-10-16","big1000":62.11,"big400":66.37,"retail":8.06,"holders":101048},"d_big1000":0.06,"d_big400":0.13,"d_retail":-0.03,"d_holders":-300},"weekly":{"bars":[{"time":"2026-07-27","open":26.35,"high":27.5,"low":25.55,"close":27.05,"volume":41509.888},{"time":"2026-08-03","open":26.95,"high":27.2,"low":26.2,"close":26.75,"volume":28141.778},{"time":"2026-08-10","open":26.9,"high":29.8,"low":26.75,"close":29.8,"volume":57010.284},{"time":"2026-08-17","open":30.1,"high":30.85,"low":29.3,"close":29.4,"volume":52472.189000000006},{"time":"2026-08-24","open":29.3,"high":29.55,"low":27.8,"close":28.0,"volume":37002.353},{"time":"2026-08-31","open":27.9,"high":28.5,"low":27.6,"close":28.45,"volume":19940.233},{"time":"2026-09-07","open":28.7,"high":28.7,"low":27.6,"cl