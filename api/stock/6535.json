亞市場，持續與多國經銷商洽談代理，進一步擴大國際版圖。 轉投資事業上，永昕(4726-TW)引進日本AFH以溢價24%策略入股，可望強化日本業務擴展；順藥(6535-TW)展開「2.0戰略轉型」，除推進核心資產LT3001臨床試驗，也積極切入基因編輯與細胞治療領域。","sentiment":1,"tags":{"topics":["訂單/接單","EPS/獲利","營收","法說/展望","總經/聯準會","生技"],"bull":["訂單","年增","受惠"],"bear":[],"score":5,"highlights":["EPS 0.02元","年增75%","年增33.95%"],"keywords":["晟德","豐華生技","財報","生技"]},"time":"11/13 08:01"}],"fund":{"code":"6535","rev_month":"11510","rev":78.0,"rev_mom":-63.03317535545024,"rev_yoy":-54.91329479768786,"rev_cum_yoy":-17.065307367228684,"eps_q":-2.04,"eps_year":"115","eps_season":"3","net_income":-342488.0,"pe":null,"pb":10.93,"yield":0.0,"updated":"2026-11-13 17:58"},"tdcc":{"latest":{"date":"2026-11-06","big1000":56.14,"big400":63.87,"retail":9.75,"holders":10786},"prev":{"date":"2026-10-30","big1000":56.1,"big400":63.85,"retail":9.77,"holders":10831},"d_big1000":0.04,"d_big400":0.02,"d_retail":-0.02,"d_holders":-45},"weekly":{"bars":[{"time":"2026-07-27","open":91.1,"high":95.9,"low":86.1,"close":87.0,"volume":848.77},{"time":"2026-08-03","open":86.9,"high":92.4,"low":85.9,"close":91.1,"volume":692.151},{"time":"2026-08-10","open":92.0,"high":93.0,"low":86.0,"close":86.1,"volume":818.86},{"time":"2026-08-17","open":86.9,"high":87.6,"low":80.4,"close":80.9,"volume":1226.786},{"time":"2026-08-24","open":81.0,"high":84.6,"low":73.8,"close":78.6,"volume":2058.277},{"time":"2026-08-31","open":78.0,"high":86.0,"low":73.7,"close":79.7,"volume":4444.857000000001},{"time":"2026-09-07","open":78.4,"high":83.5,"low":74.5,"close":75.4,"volume":1318.71},{"time":"2026-09-14","open":75.5,"high":78.9,"low":74.4,"close":78.9,"volume":984.366},{"time":"2026-09-21","open":79.5,"high":82.8,"low":76.7,"close":80.5,"volume":899.0310000000001},{"time":"2026-09-29","open":80.4,"high":85.2,"low":78.9,"close":85.0,"volume":932.358},{"time":"2026-10-05","open":87.0,"high":89.3,"low":80.3,"close":81.3,"volume":864.229},{"time":"2026-10-12","open":81.0,"high":81.0,"low":75.3,"close":75.9,"volume":882.6769999999999},{"time":"202