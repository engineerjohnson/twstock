。 〈防護架構走向平台化整合，四大細分領域分點擊破風險〉 面對複雜且跨系統的AI攻擊風險，企業的資安採購正從購買單點工具，轉向全方位的平台化整合與分層防禦，針對不同環節的風險，Securing AI已發展出四大核心防線：首先是涵蓋上線前測試與執行時的即時防護的AI應用安全、防範員工使用第三方工具導致資料外洩的AI使用控管、確保法規遵循與可解釋性的集中式AI治理平台，以及作為應用端與模型服務之間統一安全管制關卡的AI Gateway，作為應用端與模型服務之間的統一安全管制關卡。","sentiment":0,"tags":{"topics":["AI/半導體"],"bull":["成長"],"bear":[],"score":1,"highlights":[],"keywords":["中華資安","零壹","精誠技嘉","AI資安","Securing AI","AI Agent","提示詞注入","AI Gateway"]},"time":"11/15 09:10"}],"fund":{"code":"1326","rev_month":"11510","rev":35831843.0,"rev_mom":7.282107339763641,"rev_yoy":61.79229277055931,"rev_cum_yoy":22.844253687340956,"eps_q":3.03,"eps_year":"115","eps_season":"3","net_income":18585190.0,"pe":19.83,"pb":0.57,"yield":1.02,"updated":"2026-11-27 02:23"},"tdcc":{"latest":{"date":"2026-11-20","big1000":81.17,"big400":83.75,"retail":5.69,"holders":179923},"prev":{"date":"2026-11-13","big1000":81.22,"big400":83.76,"retail":5.68,"holders":180279},"d_big1000":-0.05,"d_big400":-0.01,"d_retail":0.01,"d_holders":-356},"weekly":{"bars":[{"time":"2026-07-27","open":65.9,"high":67.4,"low":55.8,"close":57.4,"volume":232792.41199999998},{"time":"2026-08-03","open":56.6,"high":61.0,"low":55.5,"close":58.9,"volume":122019.98800000001},{"time":"2026-08-10","open":59.7,"high":61.5,"low":56.8,"close":60.5,"volume":107013.253},{"time":"2026-08-17","open":60.4,"high":61.7,"low":56.6,"close":60.1,"volume":114377.793},{"time":"2026-08-24","open":59.9,"high":64.2,"low":56.1,"close":62.1,"volume":134078.38999999998},{"time":"2026-08-31","open":62.0,"high":78.2,"low":61.9,"close":69.8,"volume":376924.83400000003},{"time":"2026-09-07","open":70.2,"high":75.1,"low":69.8,"close":70.2,"volume":160177.15800000002},{"time":"2026-09-14","open":70.5,"high":70.5,"low":64.9,"close":68.1,"volume":116031.82199999999},{"time":"2026-09-21","open":68.3,"high":69.2,"low":63.8,"close":67.0,"volume":64536.611999999994},{"time":"2026-09-29","open":67.1,"high":72.6,"low":67.1,"close":71.7,"volume":133949.75199999998},{"time":"2026-10-05","open":71.