走高，聯想集團勁升6%，嗶哩嗶哩與百度漲超2%，騰訊控股與阿里巴巴-W分別微升1.11%及1.05%。","sentiment":1,"tags":{"topics":["訂單/接單","AI/半導體","關稅/地緣","匯率","盤後"],"bull":["大漲","放量","反彈","強勢","擴大"],"bear":[],"score":6,"highlights":[],"keywords":["恒生指數","恒生科技指數","科網股","黃金股","光通信","生物醫藥","港股盤後"]},"time":"11/04 16:40"}],"fund":{"code":"2038","rev_month":"11510","rev":693483.0,"rev_mom":29.85114032131221,"rev_yoy":20.556677804163176,"rev_cum_yoy":-14.742696084168822,"eps_q":null,"eps_year":null,"eps_season":null,"net_income":null,"pe":null,"pb":0.55,"yield":null,"updated":"2026-11-13 17:58"},"tdcc":{"latest":{"date":"2026-11-06","big1000":49.56,"big400":53.59,"retail":17.09,"holders":26694},"prev":{"date":"2026-10-30","big1000":49.57,"big400":53.6,"retail":17.09,"holders":26538},"d_big1000":-0.01,"d_big400":-0.01,"d_retail":0.0,"d_holders":156},"weekly":{"bars":[{"time":"2026-07-27","open":12.75,"high":12.85,"low":11.9,"close":12.2,"volume":1402.528},{"time":"2026-08-03","open":12.15,"high":12.95,"low":12.0,"close":12.8,"volume":2324.989},{"time":"2026-08-10","open":12.9,"high":13.3,"low":12.6,"close":12.7,"volume":1817.025},{"time":"2026-08-17","open":12.7,"high":13.1,"low":12.45,"close":12.75,"volume":1208.38},{"time":"2026-08-24","open":12.75,"high":13.15,"low":12.65,"close":12.8,"volume":833.3059999999999},{"time":"2026-08-31","open":12.8,"high":12.95,"low":12.5,"close":12.75,"volume":691.347},{"time":"2026-09-07","open":12.85,"high":12.85,"low":12.05,"close":12.1,"volume":762.579},{"time":"2026-09-14","open":12.0,"high":12.2,"low":11.75,"close":12.15,"volume":745.0089999999999},{"time":"2026-09-21","open":12.15,"high":12.9,"low":12.0,"close":12.55,"volume":1144.071},{"time":"2026-09-29","open":12.6,"high":13.3,"low":12.55,"close":12.95,"volume":2742.4539999999997},{"time":"2026-10-05","open":12.9,"high":13.0,"low":12.3,"close":12.5,"volume":931.3330000000001},{"time":"2026-10-12","open":12.5,"high":12.85,"low":12.3,"close":12.65,"volume":930.6779999999999},{"time":"2026-10-19","open":12.6,"high":12.8,"low":