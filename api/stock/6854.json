組的階段性研發成果，並規劃後續朝3.2T高速光收發模組目標邁進。","sentiment":1,"tags":{"topics":["AI/半導體"],"bull":["合作","供應鏈"],"bear":[],"score":2,"highlights":[],"keywords":["錼創","立碁","LED","MicroLED","光通訊"]},"time":"11/04 15:55"}],"fund":{"code":"6854","rev_month":"11510","rev":54296.0,"rev_mom":-28.358996688173747,"rev_yoy":-64.13312018601947,"rev_cum_yoy":-47.53837138875621,"eps_q":-6.37,"eps_year":"115","eps_season":"3","net_income":-745708.0,"pe":null,"pb":2.56,"yield":null,"updated":"2026-11-13 17:58"},"tdcc":{"latest":{"date":"2026-11-06","big1000":54.65,"big400":65.62,"retail":9.02,"holders":5964},"prev":{"date":"2026-10-30","big1000":54.65,"big400":65.11,"retail":9.11,"holders":6018},"d_big1000":0.0,"d_big400":0.51,"d_retail":-0.09,"d_holders":-54},"weekly":{"bars":[{"time":"2026-07-27","open":98.8,"high":99.1,"low":82.0,"close":91.1,"volume":2377.777},{"time":"2026-08-03","open":89.8,"high":100.5,"low":89.0,"close":96.8,"volume":1706.8229999999999},{"time":"2026-08-10","open":97.8,"high":97.9,"low":91.4,"close":92.4,"volume":652.181},{"time":"2026-08-17","open":92.4,"high":94.8,"low":87.9,"close":91.3,"volume":654.2180000000001},{"time":"2026-08-24","open":91.1,"high":95.8,"low":88.2,"close":90.7,"volume":804.509},{"time":"2026-08-31","open":89.8,"high":103.0,"low":87.5,"close":92.8,"volume":2253.5719999999997},{"time":"2026-09-07","open":93.3,"high":95.8,"low":88.0,"close":89.1,"volume":912.2860000000001},{"time":"2026-09-14","open":88.3,"high":94.6,"low":87.2,"close":93.6,"volume":879.6129999999999},{"time":"2026-09-21","open":94.7,"high":97.2,"low":90.6,"close":91.4,"volume":695.115},{"time":"2026-09-29","open":92.0,"high":97.1,"low":90.7,"close":94.9,"volume":715.807},{"time":"2026-10-05","open":94.9,"high":97.3,"low":90.3,"close":92.9,"volume":794.317},{"time":"2026-10-12","open":93.3,"high":98.0,"low":89.3,"close":90.3,"volume":1094.001},{"time":"2026-10-19","open":90.1,"high":93.0,"low":89.2,"close":90.8,"volume":450.40500000000003},{"time":"2026-10-27","open":91.5,"high":91.5,"