/rss/articles/CBMiUEFVX3lxTE9EXzA2OC0zRlZOOFNJNUE2SHhaMmIzWEF1Yk45S2JKY21zdVdna2RPbUdhTFN0Yi1UZTRaeXNheWNVMmlmTm8xY2pPU3dCN3JD?oc=5","published":1794207201,"summary":"尖點營收／10月續創新高 累計前十月年增80.9% UDN","sentiment":1,"tags":{"topics":["營收"],"bull":["創新高","新高","年增"],"bear":[],"score":4,"highlights":["年增80.9%"],"keywords":[]},"time":"11/09 14:53"},{"id":"cnyes6650240","source":"鉅亨網","category":"台股","title":"〈尖點法說〉看營運正向擴張 今、明年資本支出各達36億元 泰國廠將獲改善","link":"https://news.cnyes.com/news/id/6650240","published":1793956136,"summary":"PCB鑽針及代鑽服務廠尖點(8021-TW)今(6)日召開法說會，並公布最新財報，2026年前三季稅後純益達8.99億元，年增2.75倍，每股純益6.18元。尖點總經理林若萍指出，因應AI伺服器及高階PCB需求持續成長，尖點今年及明年資本支出均至少達36億元，將同步擴充PCB鑽針及代鑽孔服務產能，並看好泰國廠營運逐步改善，朝轉虧為盈目標邁進。 尖點2026年1至9月營收54.96億元，毛利率41.11%，較去年同期增加11.9個百分點，稅後純益8.99億元，年增2.75倍，每股純益達6.18元。 因應AI伺服器及高階PCB市場需求，尖點持續推進產能擴充計畫。林若萍指出，PCB鑽針產能預計今年底提升至每月4,500萬支，2027年進一步達到7,000萬支，並以2028年月產能9,000萬支為目標；代鑽孔設備數量也將逐年增加，以同步提升整體服務量能。尖點2026年上半年資本支出已達13.8億元，預估全年資本支出將達36億元。 為支應後續資本支出及產能擴充需求，尖點近期陸續完成可轉換公司債(CB)及現金增資兩項籌資案，合計募集資金22.04億元。其中，現金增資發行4,000張新股，每股以388元溢價發行，合計募集15.52億元，採原股東按持股比例認購，新股已於今日上市交易。","sentiment":1,"tags":{"topics":["EPS/獲利","營收","擴產/資本支出","法說/展望","AI/半導體","總經/聯準會"],"bull":["看好","成長","年增"],"bear":[],"score":3,"highlights":["年增2.75倍"],"keywords":["PCB","尖點","EPS","欣興","華通","定穎","泰國","中壢"]},"time":"11/06 17:08"},{"id":"cnyes6645191","source":"鉅亨網","category":"台股","title":"尖點現增募資15.52億元完成 每股388元發行新股11/6上市","link":"https://news.cnyes.com/news/id/6645191","published":1793695740,"summary":"PCB鑽針及代鑽服務廠尖點科技(8021-TW)積極擴充產能，以因應AI伺服器及高階PCB市場需求，近期也陸續完成可轉換公司債(CB)及現金增資兩項籌資案，合計募集資金逾22億元，為後續產能擴充及營運布局挹注資金。不過，台股今(3)日遭遇賣壓，高價股尖點也受到衝擊，股價終場跌停，收在382.5元，跌破每股388元的現金增資發行價格。 尖點今日公告，現金增資發行4,000張新股，每股以388元溢價發行，已完成募集，合計募得15.52億元。本次現增由原股東按持股比例認購，增資新股預計11月6日上市交易。 除了現金增資外，尖點自第三季起也完成發行4,800張無擔保可轉換公司債(CB)，以135.8元發行，募集資金約6.52億元。加計此次完成的現金增資案，兩項籌資合計募得22.04億元，兩案主辦券商均為福邦證券(6026-TW)。 在產能布局方面，尖點持續加快鑽針擴產腳步，預計今年底鑽針月產能將提升至4,500萬支，2027年底進一步擴大至7,000萬支，並以2028年底達到每月9,000萬支為目標。若依照規劃，2027年底產能將較今年底增加約55.6%，2028年底則可望較今年底倍增。此外，代鑽孔服務所需的設備數量也將逐年增加，以提升整體服務量能。 因應鑽針及代鑽孔業務擴張需求，尖點同步提高資本支出。","sentiment":-1,"tags":{"topics":["擴產/資本支出","AI/半導體","金融"],"bull":["布局"],"bear":["跌停","跌破","賣壓"],"score":-6,"highlights":[],"keywords":["CB","PCB","鑽針","營收","尖點","籌資"]},"time":"11/03 16:49"}],"fund":{"code":"8021","rev_month":"11510","rev":846767.0,"rev_mom":2.0624210516165737,"rev_yoy":93.51533808227693,"rev_cum_yoy":80.90379357962216,"eps_q":6.18,"eps_year":"115","eps_season":"3","net_income":1031970.0,"pe":54.21,"pb":8.4,"yield":0.51,"updated":"2026-11-13 17:58"},"tdcc":{"latest":{"date":"2026-11-06","big1000":33.02,"big400":44.24,"retail":34.63,"holders":91597},"prev":{"date":"2026-10-30","big1000":36.43,"big400":46.27,"retail":33.42,"holders":86561},"d_big1000":-3.41,"d_big400":-2.03,"d_retail":1.21,"d_holders":5036},"weekly":{"bars":[{"time":"2026-07-27","open":372.0,"high":390.5,"low":285.0,"close":323.0,"volume":21385.027000000002},{"time":"2026-08-03","open":331.5,"high":432.0,"low":330.0,"close":395.0,"volume":36594.303},{"time":"2026-08-10","open":408.5,"high":446.5,"low":408.5,"close":434.0,"volume":10634.216},{"time":"2026-08-17","open":423.5,"high":452.0,"low":391.0,"close":397.0,"volume":26040.485999999997},{"time":"2026-08-24","open":397.0,"high":463.5,"low":373.5,"close":454.0,"volume":36563.306},{"time":"2026-08-31","open":442.5,"high":465.0,"low":413.0,"close":420.0,"volume":45849.437000000005},{"time":"2026-09-07","open":445.0,"high":462.0,"low":418.0,"close":418.5,"volume":31605.437999999995},{"time":"2026-09-14","open":414.0,"high":481.0,"low":410.5,"close":460.0,"volume":28453.464999999997},{"time":"2026-09-21","open":461.5,"high":481.0,"low":457.0,"close":480.0,"volume":24647.913},{"time":"2026-09-29","open":475.5,"high":553.0,"low":470.0,"close":553.0,"volume":12289.078000000001},{"time":"2026-10-05","open":560.0,"high":584.0,"low":536.0,"close":557.0,"volume":37547.25},{"time":"2026-10-12","open":559.0,"high":560.0,"low":475.5,"close":494.0,"volume":6893.579},{"time":"2026-10-19","open":466.0,"high":541.0,"lo