司加大分紅回購力度，加力發揮國家隊穩市作用，進一步優化中央匯金公司的類平準基金功能，提供充足流動性保障。會議直接定調穩市機制與類平準基金功能，其權威性與信號強度高於單一監管部門表態。","sentiment":1,"tags":{"topics":["AI/半導體","金融","盤後"],"bull":["大漲","強勢"],"bear":[],"score":3,"highlights":[],"keywords":["國家隊","陸股盤後","滬深","半導體","國常會","李強","中國經濟","穩市"]},"time":"11/27 16:30"}],"fund":{"code":"2913","rev_month":"11510","rev":36161.0,"rev_mom":-37.20849467780305,"rev_yoy":-1.1184030626196335,"rev_cum_yoy":-6.214340325597265,"eps_q":-0.15,"eps_year":"115","eps_season":"3","net_income":-115887.0,"pe":null,"pb":0.57,"yield":null,"updated":"2026-11-27 02:23"},"tdcc":{"latest":{"date":"2026-11-20","big1000":49.82,"big400":56.97,"retail":13.8,"holders":112600},"prev":{"date":"2026-11-13","big1000":50.29,"big400":57.28,"retail":13.82,"holders":112608},"d_big1000":-0.47,"d_big400":-0.31,"d_retail":-0.02,"d_holders":-8},"weekly":{"bars":[{"time":"2026-07-27","open":11.15,"high":11.3,"low":10.75,"close":10.95,"volume":14134.081},{"time":"2026-08-03","open":10.85,"high":11.05,"low":10.7,"close":11.0,"volume":8899.164},{"time":"2026-08-10","open":11.0,"high":11.1,"low":10.8,"close":10.9,"volume":6309.196},{"time":"2026-08-17","open":10.9,"high":11.35,"low":10.85,"close":11.3,"volume":8545.244},{"time":"2026-08-24","open":11.3,"high":11.4,"low":11.1,"close":11.15,"volume":6599.821},{"time":"2026-08-31","open":11.15,"high":11.3,"low":10.95,"close":11.1,"volume":5582.674000000001},{"time":"2026-09-07","open":11.1,"high":11.1,"low":10.9,"close":10.9,"volume":3759.754},{"time":"2026-09-14","open":10.9,"high":11.15,"low":10.85,"close":10.9,"volume":6285.968},{"time":"2026-09-21","open":11.0,"high":11.2,"low":10.95,"close":11.05,"volume":5497.404},{"time":"2026-09-29","open":11.0,"high":11.15,"low":11.0,"close":11.0,"volume":2401.384},{"time":"2026-10-05","open":11.0,"high":11.15,"low":10.85,"close":10.95,"volume":5750.209},{"time":"2026-10-12","open":10.95,"high":11.8,"low":10.95,"close":11.7,"volume":13461.052000000001},{"time":"2026-10-19","open":11.6,"high":11.65,"low":11.25,"