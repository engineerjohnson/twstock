日賣超，也瞄準記憶體族群減碼，賣超力積電4.6萬張，旺宏1.3萬張，華邦電1.1萬張。另外，也賣超台玻2.9萬張，金寶1.5萬張，鴻海1.4萬張，台塑1.2萬張，華新9616張，南亞8895張。 外資今天也再度賣超0050台灣元大50共3.6萬張，連8賣，並同步減碼00919群益台灣精選高息2.4萬張，00981A主動統一台股增長2.4萬張，00403A主動統一升級50 2.2萬張，00631L元大台灣50正2 1.3萬張。 外資今天買超中鋼1萬張，友達8761張，泰金寶-DR 6718張，統一6665張，和碩6064張，寶成5744張，興富發4900張，統一超4194張，台表科3967張，和益3843張。","sentiment":-1,"tags":{"topics":["法人動向","AI/半導體"],"bull":[],"bear":["賣超","提款"],"score":-3,"highlights":[],"keywords":["三大法人","外資","台積電","記憶體"]},"time":"10/19 17:35"}],"fund":{"code":"9105","rev_month":"11509","rev":20237835.0,"rev_mom":71.43176252060113,"rev_yoy":21.071536703945014,"rev_cum_yoy":12.373575711487563,"eps_q":null,"eps_year":null,"eps_season":null,"net_income":null,"pe":null,"pb":null,"yield":null,"updated":"2026-10-30 16:33"},"tdcc":{"latest":{"date":"2026-10-22","big1000":17.98,"big400":28.84,"retail":16.77,"holders":104999},"prev":{"date":"2026-10-08","big1000":17.54,"big400":28.04,"retail":17.46,"holders":110308},"d_big1000":0.44,"d_big400":0.8,"d_retail":-0.69,"d_holders":-5309},"weekly":{"bars":[{"time":"2026-07-27","open":8.5,"high":8.5,"low":7.16,"close":8.12,"volume":138135.558},{"time":"2026-08-03","open":8.03,"high":8.56,"low":7.96,"close":8.08,"volume":77376.869},{"time":"2026-08-10","open":8.19,"high":8.7,"low":8.15,"close":8.61,"volume":89690.756},{"time":"2026-08-17","open":8.74,"high":9.09,"low":8.22,"close":8.42,"volume":98647.38100000001},{"time":"2026-08-24","open":8.46,"high":8.74,"low":8.22,"close":8.35,"volume":62422.56599999999},{"time":"2026-08-31","open":8.26,"high":9.05,"low":8.21,"close":8.65,"volume":103639.543},{"time":"2026-09-07","open":8.9,"high":8.93,"low":8.47,"close":8.59,"volume":114542.044},{"time":"2026-09-14","open":8.55,"high":8.61,"low":8.31,"close":8.37,"volume":61773.12},{"time":"2026-09-21","open":8.38,"high":8.47,"low":8.3,"close":8.43,"volume":46633.71800000001},{"time":"2026-09-29","open":8.42,"high":8.86,"low":8.38,"close":8.4,"volume":69421.58899999999},{"time":"2026-10-05","open":8.48,"high":9.04,"low