3.07,102.71,102.45,102.65,103.87,104.2,103.82,103.97,103.86,103.19,102.86,101.86,101.16,101.08,101.13,100.99,100.63,100.37,100.11,99.88,99.7,99.59,99.69,99.6,100.02,100.16,100.17,100.24,100.3,100.15,100.15,100.54,100.15,99.67,99.17,98.19,97.24,96.27,95.72,94.96,94.96,94.6,94.49,93.98,93.26,93.38,93.24,93.38,93.58,94.26]},"insti":[{"date":"2026-11-13","foreign":9.0,"trust":0.0,"dealer":0.193},{"date":"2026-11-12","foreign":-17.0,"trust":0.0,"dealer":0.118},{"date":"2026-11-11","foreign":-9.0,"trust":0.0,"dealer":0.15},{"date":"2026-11-10","foreign":-85.8,"trust":0.0,"dealer":0.289},{"date":"2026-11-09","foreign":12.0,"trust":0.0,"dealer":0.039},{"date":"2026-11-06","foreign":-11.0,"trust":0.0,"dealer":1.0},{"date":"2026-11-05","foreign":-38.0,"trust":0.0,"dealer":-1.03},{"date":"2026-11-04","foreign":-10.0,"trust":0.0,"dealer":-0.462},{"date":"2026-11-03","foreign":-26.0,"trust":0.0,"dealer":0.03},{"date":"2026-11-02","foreign":-4.0,"trust":0.0,"dealer":1.891},{"date":"2026-10-30","foreign":-18.0,"trust":0.0,"dealer":3.06},{"date":"2026-10-29","foreign":-13.0,"trust":0.0,"dealer":0.513},{"date":"2026-10-28","foreign":9.0,"trust":0.0,"dealer":0.0},{"date":"2026-10-27","foreign":13.0,"trust":0.0,"dealer":0.0},{"date":"2026-10-22","foreign":-32.0,"trust":0.0,"dealer":-0.827},{"date":"2026-10-21","foreign":-7.0,"trust":0.0,"dealer":0.0},{"date":"2026-10-20","foreign":-11.0,"trust":0.0,"dealer":0.0},{"date":"2026-10-19","foreign":8.0,"trust":0.0,"dealer":0.0},{"date":"2026-10-16","foreign":-5.0,"trust":0.0,"dealer":0.0},{"date":"2026-10-15","foreign":-14.924,"trust":0.0,"dealer":-2.0}],"news":[{"id":"cnyes6661100","source":"鉅亨網","category":"台股","title":"韋僑(6417) 毛利率連三季守 34%！2027 年 IC 漲價如何轉嫁？","link":"https://news.cnyes.com/news/id/6661100","published":1794510039,"summary":"2026年11月13日（優分析／產業數據中心報導）⸺ 韋僑(6417-TW) 前 3 季毛利率 34.55%、較去年同期增加 3.59 個百分點，第 3 季單季 34.38%，連三季維持在 34% 以上。公司將此水準歸因於台中新廠的規模攤提與產品組合；2027 年 IC 廠將漲價，毛利率能否維持，公司表示取決於客戶是否接受成本轉嫁。 新廠是支撐毛利率的首要因素。這座廠當初設計的年產能是 30 億元，公司目前的營業額規模是 18 億元至 20 億元。公司表示新廠自動化程度高，許多設備由公司自行開發，營業額擴大有助攤提固定成本，較有利於維持毛利率。 產品組合是第二個變數，硬式標籤（tag）指卡片、hard tag 與 keyfob 這類產品，前 3 季占 68%；軟性標籤（label）貼在包裝與醫療耗材上，占 31%，其他 1%。第 3 季毛利率比第 2 季的 34.71% 減少 0.33 個百分點，公司歸因於組合差異。 毛利率從 2025 年第 3 季的 29.35% 起回升，2026 年第 1 季到第 3 季都在 34% 以上；營業額則從 2025 年第 3 季的 4.05 億元升到 2026 年第 3 季的 5.10 億元，規模效益反映在毛利率水準上。 漲價與轉嫁 2027 年將面臨成本壓力。","sentiment":1,"tags":{"topics":["EPS/獲利","擴產/資本支出","總經/聯準會"],"bull":["漲價"],"bear":[],"score":2,"highlights":[],"keywords":["RFID","優分析"]},"time":"11/13 03:00"},{"id":"cnyes6661098","source":"鉅亨網","category":"台股","title":"韋僑(6417) 無電池藍牙標籤已放量！靠門市讀取器供電，2027 年服飾客戶續增出貨","link":"https://news.cnyes.com/news/id/6661098","published":1794510038,"summary":"2026年11月13日（優分析／產業數據中心報導）⸺ 韋僑(6417-TW) 與一家以色列的 IC 公司合作，開發出不需要電池的藍牙標籤，貼在服飾上，2026 年已在一家大型服飾公司開始放量。標籤的能量來自門市既有的讀取器（reader），公司將此產品線歸入環境物聯網（ambient IoT）。 這項產品解決了原有 RFID 的限制。公司指出，RAIN RFID 須由讀取器啟動標籤才能取得資料，屬於批次讀取，系統無法掌握消費者在店內的移動與商品位置；加上低功耗藍牙之後，標籤可以主動傳送資料，讓門市取得即時資訊。 製造是主要難點，公司表示這種標籤須在捲對捲產線上整合感測器，「你有沒有能力做捲對捲的技術」是關鍵；天線原本用 PI 材料、成本高，韋僑改用鋁天線，降低成本，客戶才願意為新增功能付費。 客戶已經在放量 這家客戶從 2026 年開始放量，考量在於投資報酬，公司指出效益包括門市決策、顧客互動、陳列與銷售的優化，額外投入具有投資效益，所以「它其實已經開始在放量」。 2027 年會繼續放量，公司表示「明年這個會繼續放量」。這條產品線對韋僑的意義，是把原本做標籤的客戶關係延伸到藍牙通訊層，客戶若更換供應商，等同須一併更換捲對捲產線與測試。 公司將今年的成長歸因於工業應用客戶穩定成長、以及消費應用客戶放量出貨。","sentiment":1,"tags":{"topics":["AI/半導體"],"bull":["合作","出貨","放量"],"bear":[],"score":3,"highlights":[],"keywords":["RFID","優分析"]},"time":"11/13 03:00"},{"id":"cnyes6661099","source":"鉅亨網","category":"台股","title":"韋僑(6417) 醫療應用占營收升至 33%！吸血海綿客戶全數改用 RFID，搶進同業市場","link":"https://news.cnyes.com/news/id/6661099","published":1794510038,"summary":"2026年11月13日（優分析／產業數據中心報導）⸺ 韋僑(6417-TW) 前 3 季醫療應用占營收 33%，較 2025 年的 30% 增加 3 個百分點。推升占比的因素之一是一家吸血海綿客戶：到 2026 年底，該客戶將所有以 barcode 管理的海綿改用 RFID。 轉換的理由明確：手術用的海綿留在病人體內，是醫療糾紛與保險理賠的來源，貼上 RFID 後，術前術後可以掃描確認數量，可降低海綿遺留體內的風險。公司表示，醫院與保險公司願意支付相關費用，「醫生不會因為開刀忘了把海綿放在裡面被抓去關」。 對客戶而言還有商業考量，這家公司在全美吸血海綿市場的份額大約 6%，另外 94% 由同業掌握，其中較大的是嬌生（Johnson & Johnson），導入 RFID 是這家客戶搶進該市場的方法，公司指出「他就是用他要去攻那個 94 %」；韋僑供應的正是這些海綿上的 RFID 標籤。 認證到手生意才成立 醫療應用的門檻在於認證，公司指出侵入式醫材大約要 5 年、非侵入式大約 3 年，才能跟客戶一起拿到認證，「一旦拿到這個認證，這個生意就是你的生意」。吸血海綿的轉換歷經多年，2026 年底全數換完，相當於完成該應用情境的驗證。","sentiment":1,"tags":{"topics":["營收","金融"],"bull":["搶進"],"bear":[],"score":2,"highlights":[],"keywords":["RFID","優分析"]},"time":"11/13 03:00"},{"id":"cnyes6661072","source":"鉅亨網","category":"台股","title":"韋僑(6417) 日本米澤設廠先租舊廠！醫療客戶為何要求海外基地，2028 年第 2 季量產？","link":"https://news.cnyes.com/news/id/6661072","published":1794508211,"summary":"2026年11月13日（優分析／產業數據中心報導）⸺ 韋僑(6417-TW) 將在日本米澤設立第二個生產基地，2027 年動工，2028 年第 2 季、也就是 4 月開始量產，主要產品是智慧標籤（smart label），卡片與射出成型仍留在台灣。 這座廠的設立源於客戶要求。公司表示，醫療客戶洽談後續訂單時，開始要求韋僑在台灣以外設立生產基地，「他們希望韋僑不是只有台灣這樣的一個生產基地」。醫療產品進入供應鏈要通過認證，更換供應商的成本高，客戶對斷料的容忍度也低，設廠因此有助降低客戶對供應中斷的疑慮，也是取得更大份額的前提。 韋僑將承租母公司希華（2484-TW）在米澤的既有廠房，進行改建。公司指出，日本產線對作業規範的要求較高，將自動化程度較高的醫療產品線設於當地，較能讓客戶放心。 產能與投資 台中新廠當初設計的年產能是 30 億元。公司指出，醫療客戶提供的預測期間比消費性電子長，較能掌握客戶計畫，「我們現在大概就已經是 20 億的生意了」。公司目前的營業額規模是 18 億元至 20 億元，公司認為下一階段將達到這座廠當初設計的 30 億元。 這座廠的投資分多年投入。資本支出在 2022 年 3.82 億元、2023 年 3.61 億元，之後逐年下降，2025 年降至 4,466 萬元；日本廠 2027 年動工，設備將隨營業額成長逐步導入。","sentiment":1,"tags":{"topics":["訂單/接單","擴產/資本支出"],"bull":["訂單"],"bear":[],"score":2,"highlights":[],"keywords":["RFID","優分析"]},"time":"11/13 02:30"},{"id":"cnyes6660676","source":"鉅亨網","category":"台股","title":"〈韋僑展望〉備妥明年營運雙位數成長需求 並啟動對日本投資億元方案","link":"https://news.cnyes.com/news/id/6660676","published":1794478109,"summary":"RFID解決方案業者韋僑 (6417-TW) 在2026年1-3前三季獲利創新高並賺回超過半個股本，稅後純益2.4億元已超越2025年全年，每股純益達5.68元。韋僑總經理江鴻佑今(12)日指出，對韋僑的成長動能來自各項新專案的開發及原有專案量能的放大，預估2027年還有雙位數業績成長。 同時，對於擴充產能因應2027市場需求成長的設備購置，韋僑在今年年底已全數備妥。 同時，對於韋僑海外市場開發鎖定在日本市場，江鴻佑指出，預韋僑計將進一步在大股東希華 (2484-TW) 的全力協助開拓日本市場，在日本八澤設立生產線以在地法人型態搶攻境內醫、藥品界對 RFID 解決方案需求，並將在2027年啟動，在2028年第二季正式投產，預估在投產後的一整個年度可明顯增進營收。 江鴻佑指出，韋僑在2026年全年資本支出約6000萬元，2027年將再增加1億元，規劃擴增到1.6億元，主要 在日本米澤租用希華原有廠房一座進行遷入設備並營運，主要生產智慧標籤爲主，以在地法人的地位利於切入日本醫療的物流市場；同時，這也是因應全球醫療產業客戶對供應鏈要求在兩岸之外另設立供應據點的需求。 韋僑遷入台中市大里新廠的設計量能達30億元的營收，對對於擴充產能因應2027市場需求成長的設備購置，韋僑在今年年底已全數備妥，且醫療應用需求回升挹注，韋僑營收已連續4個季度改寫新高。","sentiment":1,"tags":{"topics":["EPS/獲利","營收",