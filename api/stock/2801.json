2lpcWNNbWJneDIwMFJzckhLMFdWbmhoZ2dmTTZQNWo1VTBhMksxazNTQlJ1S2ljaVdj?oc=5","published":1795827840,"summary":"《外資買超19-10》彰銀(456)、緯創(435)、中鼎(434) 富聯網","sentiment":1,"tags":{"topics":["法人動向"],"bull":["買超"],"bear":[],"score":2,"highlights":[],"keywords":[]},"time":"11/28 09:04"},{"id":"cnyes6671694","source":"鉅亨網","category":"台股","title":"〈彰銀法說〉估房市「價穩量微升」房貸餘額年增3.74% 續攻自住與新青安","link":"https://news.cnyes.com/news/id/6671694","published":1795597705,"summary":"彰銀 (2801-TW) 今 (25) 日召開法人說明會，針對房市景氣與房貸業務釋出最新風向。彰銀指出，在總體經濟穩健支撐下，預期房市交易量有望小幅回升，房價則將維持高檔震盪格局。前 3 季彰銀房貸平均餘額達 6080 億元，年增 3.74%，佔總放款比重為 27.84%，承作策略持續以自用住宅及新青安政策性貸款為核心方向，且房貸逾放比僅 0.12%，授信品質極為穩健。 觀察總體經濟與產業趨勢，彰銀分析，美國形成分立政府後政策不確定性增加，加上地緣政治、國際貿易摩擦及 AI 投資推升通膨風險，全球高利率格局仍將延續。台灣方面，AI 需求穩健增長持續帶動半導體與伺服器供應鏈走揚，傳統產業隨美國關稅議題明朗可望逐步復甦，加上軍公教人員明年調薪 4%，有助挹注民間消費並支撐內需與房市剛性需求。 受惠於 AI 及相關科技供應鏈的資本支出與周轉需求，彰銀企業金融維持穩定成長，前 3 季大型企業放款平均餘額達 4290 億元，年增 12.17%；中小企業放款達 7030 億元，年增 6.07%，佔總放款比重 32.19% 居冠。透過積極調整放款結構與精準定價，彰銀前 3 季營業費用率由去年同期的 46.05% 下降至 43.51%，營運效率顯著提升。","sentiment":1,"tags":{"topics":["擴產/資本支出","法說/展望","AI/半導體","總經/聯準會","關稅/地緣"],"bull":["回升","年增"],"bear":[],"score":2,"highlights":["年增3.74%","年增 3.74%","年增 12.17%"],"keywords":["彰銀","法說","房貸","房市","放款","逾放比","授信","房價"]},"time":"11/25 17:08"},{"id":"cnyes6670838","source":"鉅亨網","category":"台股","title":"彰銀蟬聯金管會公平待客前25%殊榮 反詐守護星行動全面落實金融平權","link":"https://news.cnyes.com/news/id/6670838","published":1795493064,"summary":"金管會日前頒發2026年度「公平待客原則評核」績優業者獎項，彰化銀行 (2801-TW) 再度榮獲銀行業排名前25%最高肯定，由金管會副主任委員陳彥良頒獎，彰銀董事長胡光華代表領獎，展現長期推動公平待客、阻詐防線與消費者保護的豐碩成果。 面對快速變遷的金融環境，彰銀持續與時俱進，將公平待客理念化為具體行動，不僅執行全方位的「反詐守護星行動」（Guardian Star）、持續精進申訴機制，更積極提升高齡與身心障礙者的金融服務，全面落實金融平權。 在守護客戶資產方面，彰銀積極推動「可疑帳戶預警中心」制度，結合檢、警、金三方資源，針對可疑帳戶即時通報司法警察單位以阻斷詐欺金流，並同步新增系統註記提醒畫面來強化聯行間訊息共享，以利在客戶臨櫃交易時加強關懷提問。 為遏止不動產詐騙並向下扎根防詐教育，彰銀於客戶申辦房貸或設定抵押權等業務時，主動推廣內政部的「地籍異動即時通」服務。同時，彰銀開發國內首款專為金融教育設計的互動式信託桌遊，讓兒少在累積資產的過程中建立金融知識及辨識詐騙風險能力。 在重視客戶回饋方面，彰銀持續取得ISO 10002客訴管理國際標準認證，每季針對客訴數據與現行機制進行監控與優化，定期分析客訴案件執行根因，並同步建置電子表單管理系統，提升案件追蹤及管理品質。","sentiment":0,"tags":{"topics":["金融"],"bull":[],"bear":[],"score":0,"highlights":[],"keywords":["ESG共同推動","CSR","防詐","打詐","彰銀","視障","友善金融","普惠金融"]},"time":"11/24 12:04"},{"id":"cnyes6668093","source":"鉅亨網","category":"台股","title":"〈ESG狂潮〉95%學童消費態度翻轉！彰銀深耕金融教育「彰」顯校園ESG成果亮眼","link":"https://news.cnyes.com/news/id/6668093","published":1795134004,"summary":"彰化銀行（2801-TW）為落實企業社會責任、推動金融教育向下扎根，於昨（19）日舉辦「CSR金融共好公益計畫－成果發表會」，表揚投入校園金融教育之志工講師，並分享計畫推動成果。該計畫同時榮獲「台灣永續行動獎－銅獎」肯定，展現彰銀長期深耕校園金融教育的具體成效。 彰銀為提升學童金融素養，自113年4月起與台灣金融研訓院攜手推動「CSR金融共好公益計畫」，並自114年起續辦為期三年之「金融共好公益計畫」，以彰銀發跡地彰化為推動核心，每年宣導120班，三年共360班，預計觸及9,000名學童。 該計畫培訓126名行員擔任「CoCo老師」，以簡單易懂的語言、生活化實例及有趣互動的遊戲方式，幫助彰化縣國小四年級學童了解「金錢的用途」、「聰明的消費」、「認識風險支出」、「體驗家庭財務負擔」與「預防詐騙」等金融概念，引導學童理解金錢得來不易，逐步建立正確金錢觀念與理財行為。 彰銀表示，目前該計畫已覆蓋彰化縣26個行政區、76所小學、199個班級，累計觸及近4,663名學童，實現全縣行政區100%金融教育普及率，顯示彰銀金融教育已深入彰化縣多數城鄉地區，包含多所偏遠學校，充分展現教育資源均衡與公益關懷精神。彰銀指出，金融教育的核心價值不僅在於知識傳授，更在於培養孩子做出負責任選擇及面對風險的能力。","sentiment":1,"tags":{"topics":["金融"],"bull":["亮眼"],"bear":[],"score":2,"highlights":[],"keywords":["ESG","CSR","普惠金融","ESG共同推動","彰銀","永續力","校園","金融研訓院"]},"time":"11/20 08:20"}],"fund":{"code":"2801","rev_month":"11510","rev":4101214.0,"rev_mom":-0.9814421719303192,"rev_yoy":10.257409793121544,"rev_cum_yoy":13.786928030350332,"eps_q":1.44,"eps_year":"115","eps_season":"3","net_income":17370040.0,"pe":14.54,"pb":1.32,"yield":4.15,"updated":"2026-11-27 02:23"},"tdcc":{"latest":{"date":"2026-11-20","big1000":74.86,"big400":78.26,"retail":3.83,"holders":281147},"prev":{"date":"2026-11-13","big1000":74.82,"big400":78.27,"retail":3.81,"holders":280484},"d_big1000":0.04,"d_big400":-0.01,"d_retail":0.02,"d_holders":663},"weekly":{"bars":[{"time":"2026-07-27","open":24.55,"high":25.7,"low":24.0,"close":25.2,"volume":220630.25},{"time":"2026-08-03","open":25.25,"high":25.75,"low":23.0,"close":23.15,"volume":240766.31799999997},{"time":"2026-08-10","open":23.2,"high":23.8,"low":23.0,"close":23.55,"volume":87326.95500000002},{"time":"2026-08-17","open":23.5,"high":24.15,"low":23.45,"close":24.1,"volume":56619.776},{"time":"2026-08-24","op