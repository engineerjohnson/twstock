0,"dealer":-177.272},{"date":"2026-11-06","foreign":3240.71,"trust":43.0,"dealer":-93.219},{"date":"2026-11-05","foreign":-4939.628,"trust":-100.321,"dealer":-160.719},{"date":"2026-11-04","foreign":3275.113,"trust":-8.0,"dealer":33.168},{"date":"2026-11-03","foreign":122.856,"trust":92.0,"dealer":103.0},{"date":"2026-11-02","foreign":1702.664,"trust":4074.0,"dealer":104.999},{"date":"2026-10-30","foreign":6407.158,"trust":1014.0,"dealer":33.001},{"date":"2026-10-29","foreign":10427.686,"trust":-493.0,"dealer":56.0},{"date":"2026-10-28","foreign":2716.067,"trust":-1583.0,"dealer":260.092},{"date":"2026-10-22","foreign":10912.116,"trust":-191.0,"dealer":-28.2},{"date":"2026-10-21","foreign":10781.76,"trust":-118.0,"dealer":-106.023}],"news":[{"id":"cnyes6668093","source":"鉅亨網","category":"台股","title":"〈ESG狂潮〉95%學童消費態度翻轉！彰銀深耕金融教育「彰」顯校園ESG成果亮眼","link":"https://news.cnyes.com/news/id/6668093","published":1795134004,"summary":"彰化銀行（2801-TW）為落實企業社會責任、推動金融教育向下扎根，於昨（19）日舉辦「CSR金融共好公益計畫－成果發表會」，表揚投入校園金融教育之志工講師，並分享計畫推動成果。該計畫同時榮獲「台灣永續行動獎－銅獎」肯定，展現彰銀長期深耕校園金融教育的具體成效。 彰銀為提升學童金融素養，自113年4月起與台灣金融研訓院攜手推動「CSR金融共好公益計畫」，並自114年起續辦為期三年之「金融共好公益計畫」，以彰銀發跡地彰化為推動核心，每年宣導120班，三年共360班，預計觸及9,000名學童。 該計畫培訓126名行員擔任「CoCo老師」，以簡單易懂的語言、生活化實例及有趣互動的遊戲方式，幫助彰化縣國小四年級學童了解「金錢的用途」、「聰明的消費」、「認識風險支出」、「體驗家庭財務負擔」與「預防詐騙」等金融概念，引導學童理解金錢得來不易，逐步建立正確金錢觀念與理財行為。 彰銀表示，目前該計畫已覆蓋彰化縣26個行政區、76所小學、199個班級，累計觸及近4,663名學童，實現全縣行政區100%金融教育普及率，顯示彰銀金融教育已深入彰化縣多數城鄉地區，包含多所偏遠學校，充分展現教育資源均衡與公益關懷精神。彰銀指出，金融教育的核心價值不僅在於知識傳授，更在於培養孩子做出負責任選擇及面對風險的能力。","sentiment":1,"tags":{"topics":["金融"],"bull":["亮眼"],"bear":[],"score":2,"highlights":[],"keywords":["ESG","CSR","普惠金融","ESG共同推動","彰銀","永續力","校園","金融研訓院"]},"time":"11/20 08:20"},{"id":"cnyes6661811","source":"鉅亨網","category":"台股","title":"存股族嗨翻！公股4金2銀前10月狂賺1440億年增2成 全數超車去年全年","link":"https://news.cnyes.com/news/id/6661811","published":1794567219,"summary":"公股四金二銀10月自結盈餘今（13）日全數出爐，累計前10月合賺1440.69億元，年增19.49%，續創歷年同期新高且全數賺贏去年全年，其中以華南金年增26.85%表現最佳，獲利金額仍以兆豐金居冠。惟10月受資本市場波動拖累證券與壽險表現，單月合計獲利95.57億元、月減27.51%，其中兆豐金（2886-TW）受證券虧損影響，單月獲利月減59.13%降幅最大。 兆豐金控（2886-TW）10月自結稅後淨利14.83億元，月減59.13%、年減28.5%，主因台股回檔致兆豐證券單月虧損6.66億元。但兆豐金前10月稅後淨利仍達343.31億元，年增13.08%並續創同期新高，累計EPS為2.31元，穩居公股獲利王，其中兆豐銀行前10月獲利268.53億元、年增6.61%，存放款雙位數成長推升利息與手續費收益。 華南金控（2880-TW）與第一金控（2892-TW）前10月獲利雙創同期新高，兩者累計獲利僅差4.55億元，華南金以EPS 2.02元領先第一金的1.95元。華南金前10月賺284.56億元、年增26.85%，受惠華南銀行獲利230.77億元年增11.21%，及華南永昌證券複委託大增帶動非銀子公司獲利年增131%，貢獻比重推升至22%。","sentiment":0,"tags":{"topics":["EPS/獲利","金融"],"bull":["新高","獲利","年增"],"bear":["虧損"],"score":1,"highlights":["年增2成","年增19.49%","年增26.85%"],"keywords":["公股","華南金","第一金","兆豐金","稅後盈餘","合庫金","臺企銀","彰銀"]},"time":"11/13 18:53"},{"id":"6473bd7857f87046","source":"經濟日報-證券","category":"台股","title":"外資逆勢買超股有潛力 有望在大盤起伏之際突圍而上","link":"https://money.udn.com/money/story/5607/9865603","published":1794157678,"summary":"新台幣匯率持續走貶，外資殺紅眼，至今已連七賣，累計賣超7,056億元，但外資並非全面撤出，部分資金轉往華航、友達、彰銀等十檔個股另闢生機，而隨國安基金宣布進場，相關個股有機會在台股波瀾起伏之際，逆流而上。","sentiment":0,"tags":{"topics":["法人動向","匯率"],"bull":["買超"],"bear":["賣超"],"score":0,"highlights":[],"keywords":[]},"time":"11/09 01:07"}],"fund":{"code":"2801","rev_month":"11510","rev":4101214.0,"rev_mom":-0.9814421719303192,"rev_yoy":10.257409793121544,"rev_cum_yoy":13.786928030350332,"eps_q":1.44,"eps_year":"115","eps_season":"3","net_income":17370040.0,"pe":15.46,"pb":1.4,"yield":3.9,"updated":"2026-11-20 19:27"},"tdcc":{"latest":{"date":"2026-11-13","big1000":74.82,"big400":78.27,"retail":3.81,"holders":280484},"prev":{"date":"2026-11-06","big1000":74.87,"big400":78.33,"retail":3.8,"holders":279411},"d_big1000":-0.05,"d_big400":-0.06,"d_retail":0.01,"d_holders":1073},"weekly":{"bars":[{"time":"2026-07-27","open":24.55,"high":25.7,"low":24.0,"close":25.2,"volume":220630.25},{"time":"2026-08-03","open":25.25,"high":25.75,"low":23.0,"close":23.15,"volume":240766.31799999997},{"time":"2026-08-10","open":23.2,"high":23.8,"low":23.0,"close":23.55,"volume":87326.95500000002},{"time":"2026-08-17","open":23.5,"high":24.15,"low":23.45,"close":24.1,"volume":56619.776},{"time":"2026-08-24","open":24.1