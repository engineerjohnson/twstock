行車業務將重返健康的成長軌道。 反觀占營收比重逾四成的IT周邊事業，則面臨較大的市場逆風。由於記憶體、中央處理器與印刷電路板等零組件價格走揚，推升終端筆電官方建議售價大漲30%至50%，加上AI與伺服器排擠訂單效應，導致品牌客戶自8月與9月起大幅下修需求。","sentiment":0,"tags":{"topics":["訂單/接單","營收","擴產/資本支出","法說/展望","AI/半導體"],"bull":["成長","亮眼"],"bear":["不如預期"],"score":0,"highlights":[],"keywords":["達方","PC","MLCC","自行車","AI"]},"time":"11/03 17:52"}],"fund":{"code":"1475","rev_month":"11510","rev":89288.0,"rev_mom":-23.22745954497773,"rev_yoy":-13.668007425742575,"rev_cum_yoy":-1.9999603330044278,"eps_q":null,"eps_year":null,"eps_season":null,"net_income":null,"pe":6.31,"pb":1.06,"yield":6.11,"updated":"2026-11-13 17:58"},"tdcc":{"latest":{"date":"2026-11-06","big1000":68.97,"big400":76.26,"retail":4.19,"holders":2262},"prev":{"date":"2026-10-30","big1000":68.98,"big400":76.27,"retail":4.19,"holders":2263},"d_big1000":-0.01,"d_big400":-0.01,"d_retail":0.0,"d_holders":-1},"weekly":{"bars":[{"time":"2026-07-27","open":26.65,"high":27.45,"low":26.0,"close":27.2,"volume":104.951},{"time":"2026-08-03","open":26.55,"high":27.4,"low":26.55,"close":27.3,"volume":108.22},{"time":"2026-08-10","open":27.2,"high":27.55,"low":25.0,"close":25.2,"volume":405.82399999999996},{"time":"2026-08-17","open":25.45,"high":26.8,"low":24.9,"close":26.5,"volume":120.28399999999999},{"time":"2026-08-24","open":26.5,"high":26.8,"low":25.3,"close":26.6,"volume":45.683},{"time":"2026-08-31","open":26.25,"high":27.0,"low":25.7,"close":26.4,"volume":76.202},{"time":"2026-09-07","open":26.8,"high":27.4,"low":25.7,"close":26.05,"volume":187.10999999999999},{"time":"2026-09-14","open":26.05,"high":26.5,"low":25.8,"close":26.25,"volume":96.24000000000001},{"time":"2026-09-21","open":26.3,"high":26.7,"low":25.9,"close":26.35,"volume":27.048},{"time":"2026-09-29","open":25.85,"high":26.45,"low":25.8,"close":26.1,"volume":56.359},{"time":"2026-10-05","open":26.15,"high":26.35,"low":25.5,"close":26.0,"volume":147.482},{"time":"2026-10-12","open":26.15,"high":26.15,"low":25.5,"close":25.5,"volume":92.976},{"time":"2026-10-19","op