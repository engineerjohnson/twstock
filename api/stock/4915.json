的同時，協助客戶掌握產品碳排資訊，回應低碳產品設計與供應鏈管理需求。 在氣候行動方面，致伸持續推動再生能源使用與科學基礎減碳目標。","sentiment":0,"tags":{"topics":["AI/半導體","美股/國際"],"bull":[],"bear":[],"score":0,"highlights":[],"keywords":["致伸","ESG","車用","PC"]},"time":"11/26 16:10"}],"fund":{"code":"4915","rev_month":"11510","rev":6147886.0,"rev_mom":-1.5921148019376532,"rev_yoy":11.116340495843271,"rev_cum_yoy":13.270198663679102,"eps_q":3.38,"eps_year":"115","eps_season":"3","net_income":1566522.0,"pe":10.14,"pb":0.97,"yield":10.58,"updated":"2026-11-27 02:23"},"tdcc":{"latest":{"date":"2026-11-20","big1000":49.68,"big400":58.24,"retail":16.14,"holders":34460},"prev":{"date":"2026-11-13","big1000":50.75,"big400":58.57,"retail":15.94,"holders":34356},"d_big1000":-1.07,"d_big400":-0.33,"d_retail":0.2,"d_holders":104},"weekly":{"bars":[{"time":"2026-07-27","open":65.7,"high":66.5,"low":61.8,"close":65.4,"volume":19499.613},{"time":"2026-08-03","open":64.7,"high":65.3,"low":59.5,"close":59.5,"volume":23942.11},{"time":"2026-08-10","open":60.2,"high":61.1,"low":59.2,"close":60.9,"volume":13940.347000000002},{"time":"2026-08-17","open":60.5,"high":61.1,"low":58.8,"close":60.6,"volume":11243.455},{"time":"2026-08-24","open":60.9,"high":61.0,"low":59.3,"close":59.6,"volume":8533.389},{"time":"2026-08-31","open":59.5,"high":61.0,"low":59.0,"close":60.8,"volume":9235.400000000001},{"time":"2026-09-07","open":61.0,"high":63.2,"low":60.0,"close":62.8,"volume":17232.564},{"time":"2026-09-14","open":63.7,"high":66.5,"low":62.9,"close":65.5,"volume":41763.310999999994},{"time":"2026-09-21","open":65.2,"high":65.3,"low":63.7,"close":64.1,"volume":8275.667000000001},{"time":"2026-09-29","open":64.1,"high":65.8,"low":63.1,"close":64.4,"volume":8942.281},{"time":"2026-10-05","open":65.0,"high":65.0,"low":62.9,"close":63.3,"volume":8320.598999999998},{"time":"2026-10-12","open":63.3,"high":64.7,"low":62.7,"close":62.7,"volume":12746.321},{"time":"2026-10-19","open":62.1,"high":62.9,"low":61.3,"close":62.0,"volume":12350.331000000002},{"time":"202