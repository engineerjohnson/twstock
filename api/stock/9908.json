29","foreign":-138.0,"trust":0.0,"dealer":0.0},{"date":"2026-10-28","foreign":31.0,"trust":0.0,"dealer":0.0},{"date":"2026-10-22","foreign":-138.0,"trust":0.0,"dealer":0.0},{"date":"2026-10-21","foreign":-100.0,"trust":0.0,"dealer":0.0}],"news":[{"id":"cnyes6664132","source":"鉅亨網","category":"總經","title":"連3年發文「種電」惹議？水利署澄清：僅「盤點」潛力 絕無強制設置光電","link":"https://news.cnyes.com/news/id/6664132","published":1794826724,"summary":"對媒體報導推動翡翠水庫太陽光電引發爭議，經濟部水利署今(16)日重申，過往相關函文僅是為了調查光電設置潛力，並未規劃或要求翡翠水庫設置，更無強制推動情形。台北市長蔣萬安今表態堅決反對，強調守護用水安全，水利署則強調全國盤點作業已於113年全數結束，目前均以水庫水域外場址為推動目標，呼籲民眾多方查證，切勿誤信虛假訊息。 翡翠水庫肩負大台北地區民生與產業用水重任，近期水庫是否設置太陽光電板成為政壇與網路熱議焦點。台北市長蔣萬安今日受訪時明確指出，中央連續3年發文給台北市政府，要求盤點設置光電板的潛力，他表示，北市府對於翡翠水庫設置光電始終抱持堅決反對立場，全力守護市民的用水安全與水質純淨。 面對地方政府的強硬表態與外界質疑，經濟部水利署今日再度發出聲明還原公文始末。水利署表示，為了配合國家能源轉型及2050淨零排放政策，確實在111年至113年期間，持續請各相關單位協助盤點可設置太陽光電的屋頂、地面及水域場域。此舉旨在兼顧能源發展與水資源永續的前提下，尋求多元推動再生能源的可行方式。 水利署進一步澄清，當時發函進行全國盤點調查，主要目的僅是為了充分了解各場域的設置潛力，作為政策評估參考，自始至終並非要求水庫必須設置光電，更不存在任何強制推動的行政命令。水利署指出，這項全國性的光電潛力盤點調查作業，早已經在113年全部辦理結束，相關單位先前也已正式對外說明清楚，希望外界不要過度解讀。","sentiment":0,"tags":{"topics":[],"bull":[],"bear":["調查"],"score":-1,"highlights":[],"keywords":["水利署","光電","翡翠水庫","盤點","經濟部","太陽光電","水質","台北市"]},"time":"11/16 18:58"}],"fund":{"code":"9908","rev_month":"11510","rev":253463.0,"rev_mom":-4.316394674156371,"rev_yoy":-0.5941689086901615,"rev_cum_yoy":1.2165826370454829,"eps_q":2.05,"eps_year":"115","eps_season":"3","net_income":1113924.0,"pe":12.83,"pb":0.91,"yield":4.17,"updated":"2026-11-20 19:27"},"tdcc":{"latest":{"date":"2026-11-13","big1000":74.72,"big400":80.41,"retail":5.44,"holders":16279},"prev":{"date":"2026-11-06","big1000":74.76,"big400":80.7,"retail":5.42,"holders":16265},"d_big1000":-0.04,"d_big400":-0.29,"d_retail":0.02,"d_holders":14},"weekly":{"bars":[{"time":"2026-07-27","open":29.45,"high":29.45,"low":28.95,"close":29.15,"volume":1261.8259999999998},{"time":"2026-08-03","open":29.05,"high":29.2,"low":28.85,"close":29.15,"volume":782.954},{"time":"2026-08-10","open":29.25,"high":29.25,"low":29.0