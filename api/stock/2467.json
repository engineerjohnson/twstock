，並推動彈性工時、育嬰留停復職協助及員工子女照顧空間，減輕家庭照顧負擔。 在人才培育方面，志聖設有新人輔導員制度，協助年輕員工適應職場；並結合大學資源辦理機器人營、升學輔導及暑期實習，讓員工子女從探索興趣到接觸職場，都有企業陪伴。對中高齡員工則提供健康照護與技術傳承機會，讓經驗成為下一代人才成長的養分。 志聖與牧德同獲勞動部「2026年工作生活平衡獎－友善家庭獎」。(圖：志聖提供) 牧德科技秉持「牧德愛家應援」理念，透過免費幼兒園、育兒津貼、友善家庭講座及長者臨時照顧空間等多元措施，打造涵蓋育兒、家庭與長輩照護的全齡支持體系，成為員工安心打拚的堅實後盾。","sentiment":0,"tags":{"topics":["AI/半導體"],"bull":["年增"],"bear":[],"score":1,"highlights":[],"keywords":["志聖","設備","勞動部"]},"time":"11/02 18:03"}],"fund":{"code":"2467","rev_month":"11510","rev":1013344.0,"rev_mom":7.2148107237664165,"rev_yoy":80.67875061959084,"rev_cum_yoy":83.80094521811333,"eps_q":10.67,"eps_year":"115","eps_season":"3","net_income":1736703.0,"pe":25.08,"pb":3.18,"yield":1.81,"updated":"2026-11-13 17:58"},"tdcc":{"latest":{"date":"2026-11-06","big1000":58.25,"big400":67.36,"retail":14.53,"holders":50247},"prev":{"date":"2026-10-30","big1000":57.04,"big400":67.82,"retail":14.06,"holders":49839},"d_big1000":1.21,"d_big400":-0.46,"d_retail":0.47,"d_holders":408},"weekly":{"bars":[{"time":"2026-07-27","open":526.0,"high":546.0,"low":430.0,"close":478.5,"volume":9682.295999999998},{"time":"2026-08-03","open":461.0,"high":530.0,"low":461.0,"close":500.0,"volume":5615.716},{"time":"2026-08-10","open":521.0,"high":572.0,"low":521.0,"close":535.0,"volume":6831.682999999999},{"time":"2026-08-17","open":552.0,"high":616.0,"low":538.0,"close":560.0,"volume":8267.743},{"time":"2026-08-24","open":554.0,"high":624.0,"low":505.0,"close":610.0,"volume":6714.474},{"time":"2026-08-31","open":595.0,"high":643.0,"low":570.0,"close":603.0,"volume":6371.1630000000005},{"time":"2026-09-07","open":616.0,"high":637.0,"low":546.0,"close":552.0,"volume":6125.85},{"time":"2026-09-14","open":537.0,"high":545.0,"low":515.0,"close":528.0,"volume":4063.3529999999996},{"time":"2026-09-21","open":535.0,"high":537.0,"low":519.0,"close":529.0,"volume":2761.149},{"time":"2026-09-29","open":534.0,"high":566.0,"low":529.0,"close":552.0,"volume":3393.943},{"time":"2026-10-05","open":561.0,"high":590.0,"low":547.