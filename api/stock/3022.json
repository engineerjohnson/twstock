品質與開發過程的可追溯性。 此外，威強電持續投入醫療影像技術研發，涵蓋影像演算法、自動曝光及影像雜訊抑制，並布局高光譜影像感測與臨床手術導引等技術，相關自動曝光及影像雜訊抑制技術已申請多項專利。","sentiment":0,"tags":{"topics":["AI/半導體"],"bull":[],"bear":[],"score":0,"highlights":[],"keywords":["威強電","工業電腦","醫療"]},"time":"11/16 18:15"}],"fund":{"code":"3022","rev_month":"11510","rev":549232.0,"rev_mom":-38.15533007613027,"rev_yoy":11.852360228334959,"rev_cum_yoy":34.58298942583151,"eps_q":5.72,"eps_year":"115","eps_season":"3","net_income":1017804.0,"pe":8.37,"pb":0.97,"yield":5.34,"updated":"2026-11-27 02:23"},"tdcc":{"latest":{"date":"2026-11-20","big1000":59.11,"big400":64.34,"retail":14.38,"holders":17027},"prev":{"date":"2026-11-13","big1000":58.45,"big400":64.51,"retail":14.41,"holders":17053},"d_big1000":0.66,"d_big400":-0.17,"d_retail":-0.03,"d_holders":-26},"weekly":{"bars":[{"time":"2026-07-27","open":95.1,"high":95.6,"low":82.0,"close":85.0,"volume":15927.412000000002},{"time":"2026-08-03","open":85.0,"high":106.0,"low":84.1,"close":103.0,"volume":26719.636000000002},{"time":"2026-08-10","open":105.0,"high":116.5,"low":93.6,"close":94.2,"volume":30342.034000000007},{"time":"2026-08-17","open":94.4,"high":97.0,"low":89.2,"close":90.2,"volume":10679.462},{"time":"2026-08-24","open":90.5,"high":95.0,"low":90.0,"close":90.3,"volume":6670.686000000001},{"time":"2026-08-31","open":90.1,"high":95.9,"low":87.1,"close":95.9,"volume":9630.491},{"time":"2026-09-07","open":97.0,"high":98.6,"low":82.1,"close":83.2,"volume":12420.548999999999},{"time":"2026-09-14","open":82.7,"high":91.4,"low":82.7,"close":91.0,"volume":6426.853},{"time":"2026-09-21","open":91.1,"high":94.6,"low":90.1,"close":93.1,"volume":5411.75},{"time":"2026-09-29","open":93.1,"high":95.4,"low":91.5,"close":91.5,"volume":4389.246},{"time":"2026-10-05","open":92.0,"high":92.6,"low":89.4,"close":90.3,"volume":2858.9680000000003},{"time":"2026-10-12","open":89.5,"high":91.5,"low":87.7,"close":90.5,"volume":3458.6810000000005},{"time":"2026-10-19","open":88.8,"high":91.8,"low":87.5,"close":89.1,"v