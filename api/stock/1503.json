rust":4.0,"dealer":5.386},{"date":"2026-09-29","foreign":-284.671,"trust":-1.0,"dealer":-22.074}],"news":[{"id":"b6c975a166917a88","source":"富聯網","category":"台股","title":"《外資買超26-19》一詮(254)、士電(252)、華票(248)","link":"https://news.google.com/rss/articles/CBMiiAFBVV95cUxNQ2VRVlFKa3NGQ3ZaVkNZbGIzaHVrOWVtNk9FN0lCZW11UExjSUs3WnNUbVVGNnBoN19WTjdsU2dFSGlfeGVrd2F6OW1iRzVNdFNuekIwM1NBTjVGM3JXTF9WX2pNOGk2NWYzQzdaTkVmZzZEaWgzaGgxbTNKQVNKZlhUSDlSdjl0?oc=5","published":1792977840,"summary":"《外資買超26-19》一詮(254)、士電(252)、華票(248) 富聯網","sentiment":1,"tags":{"topics":["法人動向"],"bull":["買超"],"bear":[],"score":2,"highlights":[],"keywords":[]},"time":"10/26 09:24"},{"id":"cnyes6637130","source":"鉅亨網","category":"台股","title":"AI基建商機、台電強韌電網計畫雙重助攻 重電四雄營運可期","link":"https://news.cnyes.com/news/id/6637130","published":1792977249,"summary":"重電四雄華城(1519-TW)、亞力(1514-TW)、士電(1503-TW)以及中興電(1513-TW)受惠AI帶動基礎建設需求，加上台電強韌電網計劃，下半年營運可期，且訂單能見度直指2029至2031年。 華城上半年因外銷美國的交貨小部分延遲，使得營收稍微下滑，不過下半年起陸續追上，第三季營收近60億元，季對季、年對年都成長，預期下半年營運將優於上半年。此外，今年持續受惠AIDC、美國基礎建設、台電強韌電網計畫與科技業擴廠，其中，AIDC累計在手訂單達220億元，整體訂單能見度看至2029年。 華城9月營收20.29億元，月增5.58%，年增7.19%；第三季營收59.95億元，季增9.88%，年增2.79%；累計今年前三季營收163.26億元，年減0.73%。 亞力在手訂單約130億元，半導體占比35%，台電占30%，軌道交通占15至20%，AIDC占5至10%。亞力指出，公司業務重心已從台電轉至半導體產業。同時，公司積極布局海外，半導體客戶的美國第三期訂單於本季接單、明年出貨，日本也於本季接單，預計今年底至明年第一季出貨。 亞力9月營收9.81億元，月增26.8%，年增10.4%；第三季營收26.5億元，季減6%，年減5.76%；累計今年前三季營收80.25億元，年增8.24%。","sentiment":1,"tags":{"topics":["訂單/接單","營收","AI/半導體"],"bull":["訂單","成長","受惠"],"bear":["下滑"],"score":4,"highlights":["年增7.19%","年增2.79%","年增10.4%"],"keywords":["重電","變壓器","華城","亞力","士電","中興電"]},"time":"10/26 09:14"},{"id":"b1feb7a6fd5d4c6d","source":"富聯網","category":"台股","title":"《外資買超26-19》一詮(254)、士電(252)、華票(248)","link":"https://news.google.com/rss/articles/CBMiiAFBVV95cUxNOU1SN1VwcTlCRnlHdFpQQ0NpMURmcW1pWEYzVUtfWmlCOTItbTIwMVFBQ3MyZFJNSEEtMGdPMTM4YlJxVzdnQmlTRG94Q1E0ekhQZTZrcHRFa242cjJsMjVfZUJqVlJiT195X0NQaXpocy1sTk9uM2FFaWhmN3RGODZseV9CS044?oc=5","published":1792890240,"summary":"《外資買超26-19》一詮(254)、士電(252)、華票(248)