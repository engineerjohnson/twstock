ealer":-37.104},{"date":"2026-10-16","foreign":531.778,"trust":-2.0,"dealer":-27.786},{"date":"2026-10-15","foreign":346.153,"trust":8.509,"dealer":3.167},{"date":"2026-10-14","foreign":101.572,"trust":-0.582,"dealer":-20.279}],"news":[{"id":"cnyes6658581","source":"鉅亨網","category":"台股","title":"敦陽科(2480) 營收季增 4.1%，營業利益反減 2.1%，費用一季多花 14.9%","link":"https://news.cnyes.com/news/id/6658581","published":1794384011,"summary":"2026年11月11日（優分析／產業數據中心報導）⸺ 敦陽科(2480-TW) 第 3 季合併營收 25.6 億元，季增 4.1%、年增 30.9%。營業利益 2.85 億元，比第 2 季少了 2.1%，走勢和營收分開。 費用季增 14.9% 營業利益下滑的原因在費用。第 3 季營業費用 2.98 億元，季增 14.9%、年增 20.3%，其中管理費用 2.72 億元，占了九成以上。全公司約 710 人，人力是這門生意最大的成本。營收的季增幅不到費用季增幅的三分之一。 公司表示，費用增加主要來自「營運規模的擴大，還有人員相關費用的增加」。系統整合的費用是先投入、後回收：接到案子之後，工程師與顧問先到位，費用先認列，營收要等驗收之後才認列，人事與管理費用因此會先反映在單季損益上。多出來的費用幾乎把毛利增加的部分抵掉，營業利益才會只小幅下滑。 毛利率持平在 22.7% 毛利率 22.7%，比第 2 季多 0.4 個百分點，去年同期是 24.8%，少了 2.1 個百分點。公司表示，毛利率跟著當季驗收案子的產品組合走，硬體設備的比重高，毛利就低一點。 毛利率持平，營業利益率則連兩季往下，從第 1 季的 12.4% 掉到第 3 季的 11.1%。 如下圖，根據優分析產業資料庫，實際營業利益率連兩季往下，第 3 季低於法人共識，法人對第 4 季的預估又高於第 3 季實際。","sentiment":0,"tags":{"topics":["EPS/獲利","營收","總經/聯準會"],"bull":["年增"],"bear":["下滑"],"score":0,"highlights":["年增 30.9%","年增 20.3%"],"keywords":["毛利率","營業費用","營業利益率","系統整合","優分析"]},"time":"11/11 16:00"},{"id":"cnyes6658582","source":"鉅亨網","category":"台股","title":"敦陽科(2480) 在手訂單 134.88 億創 9 季新高，8 成要等到 2027 年起才進營收","link":"https://news.cnyes.com/news/id/6658582","published":1794384011,"summary":"2026年11月11日（優分析／產業數據中心報導）⸺ 敦陽科(2480-TW) 9 月底在手訂單 134.88 億元，比 6 月底的 122.4 億元多 10.2%，比去年同期的 77.5 億元多 74%，是 9 季以來最高。這筆訂單的結構和上一季不一樣：今年要完成的比例只剩兩成，八成排到 2027 年以後。 在手訂單在財報上是尚未履行的履約義務，指的是已經簽約、還沒認列成營收的金額；它與營收的差別在認列時點。 6 月底時，在手訂單裡有 43% 排在當年，其餘 57%、69.7 億元排在 2027 年以後。一季之後，2027 年以後的部位變成 107.9 億元。 今年的部位減 25.6 億 6 月底與 9 月底兩次公告可以互相對照：6 月底說今年要完成的 52.6 億元，到 9 月底剩 27 億元，中間少了 25.6 億元，跟第 3 季認列的營收 25.6 億元幾乎相同。 反過來，2027 年以後的部位從 69.7 億元增加到 107.9 億元，一季多了 38.2 億元，比訂單總額增加的 12.5 億元還多。多出來的部分，正好是今年部位少掉的金額。 2027 年以後排了 107 億 公司表示，會排到 2027 年以後，主要是多年期的維護合約，以及執行時間較長的專案。","sentiment":1,"tags":{"topics":["訂單/接單","營收","法說/展望"],"bull":["新高","訂單"],"bear":[],"score":3,"highlights":[],"keywords":["在手訂單","訂單能見度","履約義務","系統整合","優分析"]},"time":"11/11 16:00"},{"id":"cnyes6658583","source":"鉅亨網","category":"台股","title":"敦陽科(2480) 百億門檻只剩 27 億：前 3 季 74.47 億，在手訂單今年還要認列","link":"https://news.cnyes.com/news/id/6658583","published":1794384011,"summary":"2026年11月11日（優分析／產業數據中心報導）⸺ 敦陽科(2480-TW) 前 3 季合併營收 74.47 億元，年增 20.0%。9 月底在手訂單裡，預計 2026 年完成的還有 26.98 億元。若第 4 季只認列這批訂單，加上前 3 季就是 101.45 億元，全年跨過百億。這批訂單只反映 9 月底的狀況：第 4 季若還有新簽、當季完成的案子，全年會比這個數字高；沒驗收完的部分則會留到 2027 年。 10 月合併營收 11.93 億元，年增 69.84%，是 2010 年以來金額最高的單月；前 10 月累計 86.39 億元，距離百億還差 13.61 億元。9 月底那筆待完成訂單扣掉 10 月已認列的 11.93 億元，11 月與 12 月剩 15.05 億元，比這個缺口略多。營收認列跟著驗收時點走，驗收落在哪一個月，營收就認在那一個月，單月跳動因此比季度明顯。 訂單先變成存貨 9 月底在手訂單 134.88 億元，年增 74%，是 9 季以來最高。其中今年要完成的比例只有兩成，其餘八成排在 2027 年以後，公司表示主要是多年期維護合約，以及執行時間較長的專案。 訂單還沒變成營收，中間隔著備貨與驗收。9 月底存貨 49.1 億元，比去年底多 16.4 億元，公司表示增加的部分來自大型客戶的備貨，以及已經出貨但還沒驗收的專案。","sentiment":1,"tags":{"topics":["訂單/接單","營收"],"bull":["訂單","年增"],"bear":[],"score":3,"highlights":["年增 20.0%","年增 69.84%","年增 74%"],"keywords":["系統整合","營收成長","在手訂單","資訊服務","優分析"]},"time":"11/11 16:00"},{"id":"cnyes6658579","source":"鉅亨網","category":"台股","title":"敦陽科(2480) 政府案子占營收 15%，公部門標案先看兩張資安認證","link":"https://news.cnyes.com/news/id/6658579","published":1794384010,"summary":"2026年11月11日（優分析／產業數據中心報導）⸺ 敦陽科(2480-TW) 前 3 季營收裡，政府單位占 15%，占比與去年同期持平，是僅次於電子相關與半導體的客戶群。 公部門生意的門檻寫在認證上，公司表示很多公部門的採購標案都綁 ISO 27001 與 ISO 27701，「大概都綁這兩個，就是你必須要取得」。 ISO 27001 是資訊安全管理系統的國際標準，ISO 27701 管的是個人資料保護，兩張都要第三方驗證。 敦陽科本身就持有這兩張認證，ISO 27001 是 2022 年版、ISO 27701 是 2019 年版，並將它們納入內部控制；公司表示除了財務與營運的內稽內控，IT 系統也依 27001 與 27701 管理。 法規也把認證寫進去 外部的法規也對得上：資通安全管理法第 10 條要求受託者辦理受託業務的程序及環境，具備完善的資通安全管理措施，或通過公正第三方驗證；政府資訊服務採購常把 ISO 27001 列為資格或評選條件。 對投標的廠商來說，這道門檻同時是保護：沒有認證的廠商在資格標就被刷掉，有認證的廠商競爭者就少。 AI 讓攻擊變多 資安需求的另一頭是攻擊變多。公司表示，各行各業都在用人工智慧，攻擊的一方「比好人用得更努力」；「新的挑戰自然就帶來新的商機」。 敦陽科在資安的做法分三塊：網路安全、內容安全與專業服務。","sentiment":0,"tags":{"topics":["營收","AI/半導體"],"bull":[],"bear":[],"score":0,"highlights":[],"keywords":["資訊安全","ISO 27001","公部門標案","資安認證","優分析"]},"time":"11/11 16:00"},{"id":"cnyes6658580","source":"鉅亨網","category":"台股","title":"敦陽科(2480) 「有錢也買不到」：算力設備缺貨，客戶先把運算搬上雲","link":"https://news.cnyes.com/news/id/6658580","published":1794384010,"summary":"2026年11月11日（優分析／產業數據中心報導）⸺ 敦陽科(2480-TW) 9 月底在手訂單 134.88 億元，其中兩成今年要交；公司表示，現在的問題是買不到貨，客戶簽了約也得等。 公司表示，現在上游算力設備的供應「有錢也買不到，缺貨」。 已經跟客戶簽好的訂單，交期都比較長，公司表示必須先跟客戶溝通；公司清楚會延後多久，給客戶的交期是明確的。法說會上分析師問到，交期拉長是否影響營收，公司回答沒有改變，目前對公司並不構成問題。 存貨先堆高 貨還沒到，帳上先看到備貨：9 月底存貨 49.1 億元，比去年底多 16.4 億元，公司表示增加的部分來自大型客戶的備貨，以及還沒驗收的專案。 如下圖，根據優分析產業資料庫，存貨是季底數字，9 月底 49.1 億元；7 到 9 月三根柱子同高，是季底值攤到整季的畫法。 （資料來源：優分析產業資料庫） 存銷比是存貨除以近三個月合計營收，1.92 倍代表手上的存貨金額接近三個月營收的兩倍，比 6 月的 1.41 倍高。 敦陽科賣的產品裡，儲存設備占前 3 季營收 21%，是第二大產品線，僅次於資訊維護服務的 26%。","sentiment":1,"tags":{"topics":["訂單/接單","營收","法說/展望"],"bull":["訂單","缺貨"],"bear":["延後"],"score":3,"highlights":[],"keywords":["伺服器缺貨","記憶體","存貨","雲端服務","系統整合","優分析"]},"time":"11/11 16:00"},{"id":"32ccd70e30e76a6b","source":"富果直送","category":"台股","title":"【敦陽科法說會重點內容備忘錄】未來展望趨勢 20261110","link":"https://news.google.com/rss/articles/CBMiZ0FVX3lxTFBCTEsxNXRTdWRXUnotSDR1NmlPYmk3cUJObDVhMldYbWVhYl9YUEF4dVFVR2Ntd3VOZ3dab1FjN1RsYndFZ1N1c3VnYzZZSEdDS3IyTUN6ZzloQ1dPWjRKQUFRb1psQ1k?oc=5","published":1794268800,"summary":"【敦陽科法說會重點內容備忘錄】未來展望趨勢 20261110 富果直送","sentiment":0,"tags":{"topics":["法說/展望"],"bull":[],"bear":[],"score":0,"highlights":[],"keywords":[]},"time":"11/10 08:00"},{"id":"82c98c1743aa2b4d","source":"富聯網","category":"台股","title":"《一週外資買超54-50》晶圓製(125)、台 火(125)、敦陽科(124)","link":"https://news.google.com/rss/articles/CBMiiAFBVV95cUxNbTRyV1hJVkNzVmVzSmo5MjdGY3lBZEhXdmxJdVJFNGxXYm11X1B6YVl2ZzBWWjRBS2N5UWxKX2pjM3ZGMV9uWTdZTzdUdEtPUVFyYndpVnYzNktEcFhnRTBPNUQ1QVMzajNBYTlkVHI4MmRZOG5PNFRvclFiM0ZQWDhGYl9TbHpV?oc=5","published":1794099660,"summary":"《一週外資買超54-50》晶圓製(125)、台 火(125)、敦陽科(124) 富聯網","sentiment":1,"tags":{"topics":["法人動向"],"bull":["買超"],"bear":[],"score":2,"highlights":[],"keywords":[]},"time":"11/08 09:01"}],"fund":{"code":"2480","rev_month":"11510","rev":1192539.0,"rev_mom"