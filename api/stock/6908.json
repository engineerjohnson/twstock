-6.0,"trust":0.0,"dealer":-1.0},{"date":"2026-11-19","foreign":-25.0,"trust":0.0,"dealer":6.0},{"date":"2026-11-18","foreign":-5.177,"trust":0.0,"dealer":2.0},{"date":"2026-11-17","foreign":36.497,"trust":0.0,"dealer":-2.0},{"date":"2026-11-16","foreign":-5.336,"trust":0.0,"dealer":0.0},{"date":"2026-11-13","foreign":-4.0,"trust":0.0,"dealer":2.0},{"date":"2026-11-12","foreign":15.0,"trust":0.0,"dealer":-1.0},{"date":"2026-11-11","foreign":-1.0,"trust":0.0,"dealer":3.0},{"date":"2026-11-10","foreign":5.0,"trust":0.0,"dealer":-3.0},{"date":"2026-11-09","foreign":4.0,"trust":0.0,"dealer":-23.0},{"date":"2026-11-06","foreign":6.0,"trust":0.0,"dealer":17.0},{"date":"2026-11-05","foreign":5.0,"trust":0.0,"dealer":3.0},{"date":"2026-11-04","foreign":5.0,"trust":0.0,"dealer":3.0},{"date":"2026-11-03","foreign":3.0,"trust":0.0,"dealer":10.0},{"date":"2026-11-02","foreign":1.0,"trust":0.0,"dealer":-4.0}],"news":[{"id":"cnyes6673560","source":"鉅亨網","category":"台股","title":"〈焦點股〉GTA6熱賣帶旺PS5買氣 宏碁遊戲明年拚雙位數成長今盤中亮燈漲停","link":"https://news.cnyes.com/news/id/6673560","published":1795746757,"summary":"受惠全球遊戲大作《俠盜獵車手6》帶動PlayStation 5主機買氣增溫，宏碁遊戲-創(6908-TW)昨日法說會釋出樂觀展望並看好明年營運挑戰雙位數成長，激勵今(27)日股價跳空開高並於盤中攻上漲停價25.2元，成交量較前一日放大。 宏碁遊戲總經理徐挺洋表示，俠盜獵車手6於11月19日正式上市後首日全球零售額達37.9億美元，目前遊戲軟體與相關主題手把在各地通路均呈現供不應求，公司正積極向原廠爭取12月及明年第一季貨源。隨著主機硬體、遊戲軟體、周邊配件及數位點數卡四大業務同步受惠，加上明年PS5平台仍有多款大作接力推出，公司目標2027年整體營收維持雙位數增長。 在區域代理布局方面，宏碁遊戲目前握有台灣、香港、新加坡及菲律賓四地的PlayStation獨家代理權，其中香港子公司更於今年11月取得當地全通路總代理權，擴大亞洲市場營運規模。公司也已在上述四地導入PlayStation Network數位業務，透過數位點數卡與限量版主題控制器等周邊商品，有效提升既有玩家重複消費並拓展硬體以外的營收來源。 展望中長期產業趨勢，宏碁遊戲參考前一代俠盜獵車手5橫跨三個主機世代並創下近2.35億套累計出貨的經驗，看好大型遊戲IP具備長達數年的長尾銷售效益。","sentiment":1,"tags":{"topics":["營收","法說/展望","匯率"],"bull":["漲停","看好","成長","受惠","供不應求"],"bear":[],"score":10,"highlights":[],"keywords":["宏碁","宏碁遊戲","遊戲"]},"time":"11/27 10:32"},{"id":"cnyes6663864","source":"鉅亨網","category":"台股","title":"宏碁遊戲取得PlayStation香港總代理 同時入選「臺灣璞玉指數」成分股","link":"https://news.cnyes.com/news/id/6663864","published":1794815425,"summary":"宏碁旗下子公司宏碁遊戲-創(6908-TW)宣布，旗下海外香港子公司 Dropzone 亦取得 PlayStation® *1香港地區全通路總代理權*2；日前亦獲納入臺灣指數公司「臺灣璞玉指數」成分股。兩項進展有助強化公司資本市場的關注度，並進一步深化​國際品牌代​理與在地區​域通路經營​。 宏碁遊戲旗下香港子公司 Dropzone取得 PlayStation® *1香港地區全通路總代理權*2，深化與索尼互動娛樂（Sony Interactive Entertainment，SIE）的合作關係，並強化在亞洲遊戲市場的代理地位。 透過 Dropzone 在地營運基礎與集團跨區資源整合，宏碁遊戲將進一步集中需求預測與採購規劃，提升產品供應與通路協調效率​，同時加強​零售陳列、​通路行銷及​消費者互動​，擴大品牌​曝光與產品​體驗機會，​深化著香港​市場經營。 臺灣璞玉指數以企業獲利與配息表現為篩選基礎，並結合市場交易指標，選取具潛藏價值的上市公司，呈現優質非​熱門股組合​的投資績效​。宏碁遊戲​日前獲納入​成分股，彰​顯市場對公​司治理與長​期營運穩健​性的肯定，​並有助提升​投資人對公​司營運表現​與代理業務​布局及未來​發展的關注​。","sentiment":0,"tags":{"topics":["EPS/獲利","AI/半導體"],"bull":[],"bear":[],"score":0,"highlights":[],"keywords":["宏碁","宏碁遊戲","PS"]},"time":"11/16 15:50"}],"fund":{"code":"6908","rev_month":"11510","rev":548038.0,"rev_mom":10.351812624338539,"rev_yoy":-2.945609036058165,"rev_cum_yoy":-2.9113409718247243,"eps_q":-0.35,"eps_year":"115","eps_season":"3","net_income":-80557.0,"pe":711.67,"pb":0.62,"yield":5.81,"updated":"2026-11-27 02:23"},"tdcc":{"latest":{"date":"2026-11-20","big1000":76.45,"big400":77.82,"retail":10.45,"holders":2023},"prev":{"date":"2026-11-13","big1000":76.45,"big400":77.82,"retail":10.48,"holders":2026},"d_big1000":0.0,"d_big400":0.0,"d_retail":-0.03,"d_holders":-3},"weekly":{"bars":[{"time":"2026-07-27","open":35.0,"high":35.5,"low":32.1,"close":33.85,"volume":70.471},{"time":"2026-08-03","open":33.6,"high":34.0,"low":31.1,"close":32.3,"volume":88.497},{"time":"2026-08-10","open":32.4,"high":34.4,"low":31.65,"close":32.8,"volume":61.967000000000006},{"time":"2026-08-17","open":32.8,"high":32.95,"low":30.0,"close":30.35,"volume":112.803},{"time":"2026-08-24","open":30.35,"high":31.0,"low":30.0,"close":30.0,"volume":74.321},{"time":"2026-08-31","open":30.5,"high":31.2,"low":30.0,"close":30.1,"volume":75.886},{"time":"2026-09-07","open":30.1,"high":32.1,"low":29.9,"close":29.95,"volume":71.07},{"time":"2026-09-14","open":30.2,"high":30.85,"low":29.9,"close":30.0,"volume":46.339999999999996},{"time":"2026-09-21","open":30.25,"high":30.25,"low":2