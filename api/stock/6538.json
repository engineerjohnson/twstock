UXYtWnZELXRod0Rwek9oLTJ5RmI4VlV2TGJMazlwdDdJczFIeUVLTldfVkFXbjFiSU5keEdqa2FkQklEM04yY2tKLWtUVXFyYWd3a2M?oc=5","published":1795010488,"summary":"(6538)倉和法說會 2026/11、倉和財報、倉和展望、倉和財報投資亮點｜理柴知道:法說最速報! - 方格子 vocus","sentiment":0,"tags":{"topics":["法說/展望"],"bull":[],"bear":[],"score":0,"highlights":[],"keywords":[]},"time":"11/18 22:01"},{"id":"32e44a962b5f355c","source":"經濟日報-證券","category":"台股","title":"旺矽、倉和爆違約交割","link":"https://money.udn.com/money/story/5607/9885138","published":1794941187,"summary":"櫃買指數昨（17）日下跌3.92%，收306.61點，千金股旺矽、倉和驚爆違約交割。櫃買中心昨接獲台銀金山、德信、新光等券商據點通報，旺矽爆出5,406萬元違約交割，是旺矽今年第二次違約交割。","sentiment":-1,"tags":{"topics":[],"bull":[],"bear":["違約"],"score":-2,"highlights":[],"keywords":[]},"time":"11/18 02:46"},{"id":"95b7314030950076","source":"Yahoo股市-台股","category":"台股","title":"台股雪崩，韭菜翻車！旺矽、倉和爆違約交割逾6500萬，千金股旺矽今年第2起","link":"https://tw.news.yahoo.com/%E5%8F%B0%E8%82%A1%E9%9B%AA%E5%B4%A9-%E9%9F%AD%E8%8F%9C%E7%BF%BB%E8%BB%8A-%E6%97%BA%E7%9F%BD-%E5%80%89%E5%92%8C%E7%88%86%E9%81%95%E7%B4%84%E4%BA%A4%E5%89%B2%E9%80%BE6500%E8%90%AC-%E5%8D%83%E9%87%91%E8%82%A1%E6%97%BA%E7%9F%BD%E4%BB%8A%E5%B9%B4%E7%AC%AC2%E8%B5%B7-173347964.html","published":1794936827,"summary":"台股上周才反彈3979.48點，本周短短2個交易日就崩跌3583.01點，大盤再度陷入4萬點保衛戰，違約交割事件也接連浮現。櫃買中心今（17）日盤後公告，上櫃股旺矽（6223）、倉和（6538）發生違","sentiment":-1,"tags":{"topics":[],"bull":["反彈"],"bear":["崩跌","違約","崩"],"score":-6,"highlights":[],"keywords":[]},"time":"11/18 01:33"},{"id":"cnyes6665470","source":"鉅亨網","category":"台股","title":"櫃買爆2檔違約交割逾6500萬元 千金股旺矽今年二度上榜","link":"https://news.cnyes.com/news/id/6665470","published":1794923350,"summary":"櫃買中心今(17)日公告，上櫃新增 2 起個股違約交割通報，分別為測試介面千金股旺矽(6223-TW)及太陽能網版廠倉和(6538-TW)，合計違約金額達6,502.1萬元；這也是今年以來櫃買市場累計的第17及第18起違約交割案件。 根據櫃買中心公布資料，旺矽此次違約交割金額高達5,406萬元，由臺銀金山、德信、新光等三家券商分點通報；倉和違約交割金額則為1,096.1萬元，通報券商分點包括華南台南、永豐潮州及永豐桃園。 值得留意的是，高價股旺矽今年已非首度發生違約交割。回顧今年6月12日，旺矽便曾由永豐金證券萬盛分公司通報違約交割1,207萬元；加計今日通報的5,406萬元後，旺矽今年以來累計違約交割金額已達6,613萬元。 依據台股「T+2」交割制度回推，17日通報的違約交割，其交易發生日為13日。觀察上周五兩檔個股盤面表現，走勢皆出現劇烈震盪，成為引爆違約的關鍵。 其中，旺矽13日以4,910元開高後，盤中一度衝上5,100元高點，但隨後賣壓湧現、股價大幅拉回，盤中最低下探至4,630元，高低點震幅逾一成，終場僅小漲15元、收在4,670元，漲幅0.32%；倉和13日同樣開高走低，早盤以337元開出，最高觸及338元後反轉急殺，盤中直接打入跌停價293.5元並鎖死至終場，重挫32.5元、跌幅達9.97%。","sentiment":-1,"tags":{"topics":["金融"],"bull":[],"bear":["違約"],"score":-2,"highlights":[],"keywords":["旺矽","倉和","違約交割","櫃買中心"]},"time":"11/17 21:49"},{"id":"79ea3c383c476d31","source":"經濟日報-證券","category":"台股","title":"旺矽今年第二度爆違約交割、金額5,406萬元 倉和也爆違約1,096萬元","link":"https://money.udn.com/money/story/5607/9884911","published":1794918726,"summary":"櫃買指數17日下跌3.92%，收306.61點，櫃買中心接獲證券商臺銀金山、德信、新光（1409）通報，千金股旺矽（6223）爆出5,406萬元違約交割，是旺矽今年第二次違約交割；華南台南、永豐潮州、永豐（6790）桃園則通報倉和（6538）爆出違約交割1,096.1萬元。是今年來櫃買市場第17、18起違約交割案。","sentiment":-1,"tags":{"topics":["金融"],"bull":[],"bear":["違約"],"score":-2,"highlights":[],"keywords":[]},"time":"11/17 20:32"},{"id":"7f2b05aca0ed3cdf","source":"富果直送","category":"台股","title":"【倉和法說會重點內容備忘錄】未來展望趨勢 20261117","link":"https://news.google.com/rss/articles/CBMiZ0FVX3lxTE9LYWJTQXd5OWVOMGJLTFVNRlI5YWJmT0M0a2tubFNvTDNpNWNvSU05VXh3Mnp4Q2hVdEVpTW03MjhUSXBheU5hLXVsd01WemVpLUpvYlQwRlJSVEJ4SGk0VFBjOFFPbVE?oc=5","published":1794873600,"summary":"【倉和法說會重點內容備忘錄】未來展望趨勢 20261117 富果直送","sentiment":0,"tags":{"topics":["法說/展望"],"bull":[],"bear":[],"score":0,"highlights":[],"keywords":[]},"time":"11/17 08:00"}],"fund":{"code":"6538","rev_month":"11510","rev":167602.0,"rev_mom":-4.227975840138057,"rev_yoy":57.3550398077212,"rev_cum_yoy":9.151982599029992,"eps_q":4.56,"eps_year":"115","eps_season":"3","net_income":169853.0,"pe":45.86,"pb":3.24,"yield":0.84,"updated":"2026-11-20 19:27"},"tdcc":{"latest":{"date":"2026-11-13","big1000":26.75,"big400":53.6,"retail":16.14,"holders":38111},"prev":{"date":"2026-11-06","big1000":25.73,"big400":52.36,"retail":18.08,"holders":38294},"d_big1000":1.02,"d_big400":1.24,"d_retail":-1.94,"d_holders":-183},"weekly":{"bars":[{"time":"2026-07-27","open":132.0,"high":140.5,"low":108.5,"close":138.0,"volume":11170.133},{"time":"2026-08-03","open":136.0,"high":163.0,"low":132.0,"close":145.0,