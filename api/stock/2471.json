ealer":0.0},{"date":"2026-10-30","foreign":1.526,"trust":0.0,"dealer":0.0},{"date":"2026-10-29","foreign":15.988,"trust":0.0,"dealer":0.0},{"date":"2026-10-28","foreign":-27.012,"trust":0.0,"dealer":0.0},{"date":"2026-10-22","foreign":25.001,"trust":0.0,"dealer":-1.0},{"date":"2026-10-21","foreign":-14.95,"trust":0.0,"dealer":0.0}],"news":[{"id":"cnyes6669585","source":"鉅亨網","category":"台股","title":"〈熱門股〉資安股接棒成大盤中流砥柱 中華資安周漲逾9% 創1年來新高價","link":"https://news.cnyes.com/news/id/6669585","published":1795227003,"summary":"台股加權指數本周坐大怒神，重挫多達17%，少見個股有漲勢，中華資安(7765-TW)逆勢周漲9%，並創2025年11月以來高，合計二周來漲幅超過20%，成大盤中最是中流砥柱的資安股。 法人認為，11月中旬國內發生上櫃電商雲端服務商的客戶資料外洩事件，再次喚起市場對企業資安防護的重視，加上第四季本為政府與大型企業的資安預算核銷與採購傳統旺季，預估中華資安有約4-5億元的在手專案待驗收認列，單季營收有望改寫新高。 據中華民國資通安全發展協會彙整，今年上半年公開揭露資安事件共56起，而下半年截至11月15日已達117起，月平均事件數約為上半年的2.8倍，顯示企業資安風險持續升溫。 目前中華資安以既有客戶為主，惟近期重大資安事件多集中於下半年，相關需求轉化為訂單和營收仍需時間，成長效益尚未完全反映，法人預期將逐步挹注2027年營運表現。 其中，公司目前已掌握約半數年度訂閱型合約，9成以上既有訂閱合約預期將持續續約，提供穩定的經常性收入基礎。 展望2027年，隨著企業資安預算增加、金融監理及資安法規要求趨嚴，加上中華資安持續推出AISOC、雲端資安監控和半導體設備資安檢測等新服務，法人樂觀看待整體營運穩健成長應無虞。","sentiment":0,"tags":{"topics":["訂單/接單","營收","法說/展望","AI/半導體"],"bull":["新高","旺季"],"bear":["重挫"],"score":-1,"highlights":[],"keywords":["資安","中華資安","資訊服務","熱門股"]},"time":"11/21 10:10"},{"id":"5a67ab904f8437c3","source":"經濟日報","category":"台股","title":"今日最夯股／資通量增漲停 外資、自營商連兩日買超有何題材？ | 市場焦點 | 證券","link":"https://news.google.com/rss/articles/CBMiWkFVX3lxTE9hbjFKdnM1NFhaLWpVSGdZY051NzBGRkI4Vlk2MnRINWstU1loQVlvT2R5OFdvaUVCRlFkM05TQmtOOGhqTWpDY2toYmlVVnVrNDkySVZZeE5EUQ?oc=5","published":1795169864,"summary":"今日最夯股／資通量增漲停 外資、自營商連兩日買超有何題材？ | 市場焦點 | 證券 經濟日報","sentiment":1,"tags":{"topics":["法人動向","金融"],"bull":["漲停","買超","題材"],"bear":[],"score":6,"highlights":[],"keywords":[]},"time":"11/20 18:17"},{"id":"e9b397a47a728267","source":"經濟日報-證券","category":"台股","title":"今日最夯股／資通量增漲停 外資、自營商連兩日買超有何題材？","link":"https://money.udn.com/money/story/5607/9891938","published":1795169864,"summary":"股市瞬息萬變，標的五花八門，哪一檔個股是每天市場最關注的人氣指標及話題，請看經濟日報每日精選的今日最夯股。","sentiment":1,"tags":{"topics":["法人動向"],"bull":["漲停","買超","題材"],"bear":[],"score":6,"highlights":[],"keywords":[]},"time":"11/20 18:17"},{"id":"7222c41c9f703cf1","source":"富聯網","category":"台股","title":"《外資買超28-5》陽明(2178)、資通(2042)、滬深2X(2022)","link":"https://news.google.com/rss/articles/CBMiiAFBVV95cUxQVnRoZmh0WWFSNXpmMF9Iam1sU3ZmaDBsN1dZUW5RaHkyM2F3N2VKaXBzSWRSNTJtWE1TTEo0V2ZWVEdnazNzNEJXSmh5bXFoeDcwSGpxanVyLTFReXlKRjYzVUY0SUxTZldtVU1OQkRzRkJBakZiYUp5a2VpYTZmTFlqZktUQ01H?oc=5","published":1795131180,"summary":"《外資買超28-5》陽明(2178)、資通(2042)、滬深2X(2022) 富聯網","sentiment":1,"tags":{"topics":["法人動向"],"bull":["買超"],"bear":[],"score":2,"highlights":[],"keywords":[]},"time":"11/20 07:33"},{"id":"cnyes6666496","source":"鉅亨網","category":"台股","title":"三三會攜手工研院簽MOU 力促產業與研發機構開創新契機","link":"https://news.cnyes.com/news/id/6666496","published":1794999843,"summary":"三三會今(18)日與工研院簽署合作備忘錄(MOU)，三三會理事長林伯豐表示，這次合作象徵產業界與科技研發機構攜手邁入新階段，期盼透過產業需求與研發技術對接，也期待雙方未來攜手並進，讓合作成果真正落實於產業，為台灣經濟注入新動能。 三三企業交流會今日下午舉辦11月例會，除了與工研院簽MOU，也邀請工研院產科國際所所長紀昭吟以「台灣未來科技發展願景」為題發表專題演講。 林伯豐致詞時表示，工研院長期深耕科技研發，是台灣產業創新與技術升級的重要推手，三三會則匯聚各產業企業領袖，擁有豐富的產業資源及實務經驗，雙方各具優勢，此次簽署合作備忘錄，不僅象徵合作關係邁入新的里程碑，也代表產業界與科技研發機構共同推動產業升級的承諾。 工研院副院長李宗銘則強調，工研院長期投入半導體、材料、機械、資通訊、生醫及能源等領域研發，近年也成立無人化創新科技研究單位，投入無人機、無人載具船、機器狗等技術，期望透過攜手產業界，加速技術應用與產業發展。 林伯豐強調，此次簽約象徵雙方合作關係邁入新的里程碑，更代表產業界與科技研發機構攜手合作、共創未來的重要承諾，期待透過此次合作，促進產業需求與研發能量的有效對接，深化技術交流、創新應用及跨領域合作，協助企業掌握新興科技趨勢，開創更多產業發展的新契機。 林伯豐也感謝工研院的支持與促成，也期待雙方未來攜手並進，讓合作成果真正落實於產業，為台灣經濟注入新動能。","sentiment":0,"tags":{"topics":["AI/半導體"],"bull":["合作"],"bear":[],"score":1,"highlights":[],"keywords":["工研院","mou","三三企業交流會","半導體","無人機"]},"time":"11/18 19:04"},{"id":"cnyes6666224","source":"鉅亨網","category":"國際","title":"晶片出口與觀光強勁復甦 馬來西亞第3季GDP年增5.5%優於預期","link":"https://news.cnyes.com/news/id/6666224","published":1794993003,"summary":"馬來西亞央行與統計局公布最新經濟數據，馬來西亞 2026 年第三季GDP年增率達 5.5%，超越政府先前預估的 5.3% 初估值與市場預期的 5.3%。 這一數據雖然較第二季的 6.0% 有所放緩，但在半導體與電子產品出口、投資擴增以及觀光業復甦等因素支撐下，前九個月平均經濟成長率已達 5.6%，全年 GDP 成長率確定可突破 5% 的目標。 馬來西亞作為全球人工智慧(AI)供應鏈建置的顯著受益者，半導體與電子零組件出口大幅成長，並吸引數十億美元的資料中心投資。 針對市場擔憂經濟是否過度依賴 AI 景氣周期，馬來西亞央行(Bank Negara Malaysia)總裁阿布杜拉席德(Datuk Seri Abdul Rasheed Ghaffour)在記者會上澄清：「我們並不依賴單一特定產業。」 他強調，馬來西亞的經濟基礎相當廣泛，涵蓋服務業、製造業、採礦業與農業，且產品與出口目的地均呈現多元化。 阿布杜拉席德表示，晶片製造商在過去8個月的訂單持續穩健，全球 AI 與科技投資周期預期將延續至明年，儘管增速可能適度放緩。他指出，馬來西亞將以穩健的基本面與積極的經濟展望邁入 2027 年。 針對出口前景，他特別補充：「出口成長將由全球對科技相關產品與關鍵商品的持續需求帶動，同時獲得旅遊與資通訊(ICT)服務的支撐。","sentiment":1,"tags":{"topics":["訂單/接單","法說/展望","AI/半導體","總經/聯準會","匯率"],"bull":["突破","成長","供應鏈","優於預期","年增"],"bear":[],"score":7,"highlights":["年增5.5%"],"keywords":["馬來西亞","GDP","AI","供應鏈","出口","觀光業","投資","電子零組件"]},"time":"11/18 17:10"},{"id":"cnyes6665892","source":"鉅亨網","category":"台股","title":"盤中速報 - 櫃買市場加權指數下跌-6.16點至300.45點，跌幅2.01%","link":"https://news.cnyes.com/news/id/6665892","published":1794966641,"summary":"截至台北時間18日09:50，櫃買市場加權指數下跌6.16點（或2.01%），暫報300.45點。 歷史漲跌幅 近 1 週：-7.92% 近 1 月：-23.4% 近 3 月：-23.02% 近 6 月：-25.43% 今年以來：+10.99% 焦點個股 系統整合 (SI)概念領跌-3.57%。其中 資通(2471-TW) 下跌 9.94% ; 晉泰(6221-TW) 下跌 9.66% ; 邁達特(6112-TW) 下跌 6.98% 。 資訊安全概念領跌-3.35%。其中 安碁資訊(6690-TW) 下跌 10% ; 全景軟體(8272-TW) 下跌 9.95% ; 邁達特(6112-TW) 下跌 6.98% 。","sentiment":0,"tags":{"topics":[],"bull":[],"bear":[],"score":0,"highlights":[],"keywords":["台股指數","台股盤中","指數走勢","櫃買市場加權指數","系統整合 (SI)","資訊安全"]},"time":"11/18 09:50"},{"id":"4e3f55870f79b9a0","source":"富果直送","category":"台股","title":"【資通法說會重點內容備忘錄】未來展望趨勢 20261118","link":"https://news.google.com/rss/articles/CBMiZ0FVX3lxTE5aYlZtQWRwdkNGM3U1azhkVlU4TUF5TlZfeGotT0R6a3VWS0JIVE5SanhVY0FYTjZoTmJCNHk0VldwN1ZrblB2Z1Y0YWEtSmZHOWdHRFFSN1NyTm9GVkRwOHF1OXRzMzQ?oc=5","published":1794960000,"summary":"【資通法說會重點內容備忘錄】未來展望趨勢 20261118 富果直送","sentiment":0,"tags":{"topics":["法說/展望"],"bull":[],"bear":[],"score":0,"highlights":[],"keywords":[]},"time":"11/18 08:00"},{"id":"cnyes6665271","source":"鉅亨網","category":"台股","title":"鴻海擬斥14.5億元收購Sony半導體車載相機模組事業 強化車用電子系統整合","link":"https://news.cnyes.com/news/id/6665271","published":1794912179,"summary":"鴻海(2317-TW)今(17)日宣布，與索尼半導體解決方案公司(SSS)簽署協議，擬以72.4億日元（約新台幣14.5億元）現金收購SSS旗下車載相機模組事業，交易範圍涵蓋相關業務、技術、客戶關係及營運資源，預計在取得相關主管機關核准並完成先決條件後，於2027年4月底前完成交割。 鴻海表示，長期深耕資通訊領域相機模組設計、製造及整合，SSS旗下車載相機模組事業則為日本車載相機模組市場的重要供應商之一，長期與日系車廠合作，透過此次收購，未來將結合SSS既有技術、客戶基礎及直接服務汽車製造商的經驗，進一步強化車載整合服務能力，並向SSS原有全球車廠客戶提供更高附加價值的服務。 隨著先進駕駛輔助系統(ADAS)與智慧車輛持續發展，車載相機已成為汽車感知系統的重要產品。根據統計，2026年至2036年車載相機模組市場年複合成長率預估達6.9%。鴻海也將結合既有精密製造能力、全球供應鏈網絡，以及此次承接的車載相機模組技術與客戶服務能力，持續深化汽車電子及智慧移動領域布局。 鴻海指出，此次交易金額不包括SSS車載相機模組事業位於海外的生產設備及存貨，未來若有相關資產收購，將依規定對外公告。交易初期，雙方將以確保客戶服務不中斷及團隊穩定為首要原則，推動業務、客戶及相關營運資源移轉，並透過職涯發展規劃與整合支援機制，協助移轉員工順利融入新組織。","sentiment":0,"tags":{"topics":["AI/半導體","匯率"],"bull":[],"bear":[],"score":0,"highlights":[],"keywords":["鴻海","Sony","相機","模組"]},"time":"11/17 18:42"},{"id":"cnyes6664870","source":"鉅亨網","category":"台股","title":"盤中速報 - 櫃買市場加權指數下跌-8.67點至310.45點，跌幅2.72%","link":"https://news.cnyes.com/news/id/6664870","published":1794887334,"summary":"截至台北時間17日11:43，櫃買市場加權指數下跌8.67點（或2.72%），暫報310.45點。 歷史漲跌幅 近 1 週：-0.89% 近 1 月：-20.27% 近 3 月：-20.41% 近 6 月：-22.39% 今年以來：+15.52% 焦點個股 系統整合 (SI)概念領跌-5.23%。其中 資通(2471-TW) 下跌 9.97% ; 晉泰(6221-TW) 下跌 9.91% ; 大綜(3147-TW) 下跌 6.89% 。 MLCC電容概念領跌-4.93%。其中 信昌電(6173-TW) 下跌 9.9% ; 禾伸堂(3026-TW) 下跌 9.33% ; 華新科(2492-TW) 下跌 6.99% 。","sentiment":0,"tags":{"topics":[],"bull":[],"bear":[],"score":0,"highlights":[],"keywords":["台股指數","台股盤中","指數走勢","櫃買市場加權指數","系統整合 (SI)","MLCC電容"]},"time":"11/17 11:48"},{"id":"cnyes6664868","source":"鉅亨網","category":"台股","title":"盤中速報 - 櫃買市場加權指數下跌-8.57點至310.55點，跌幅2.69%","link":"https://news.cnyes.com/news/id/6664868","published":1794887143,"summary":"截至台北時間17日11:43，櫃買市場加權指數下跌8.57點（或2.69%），暫報310.55點。 歷史漲跌幅 近 1 週：-0.89% 近 1 月：-20.27% 近 3 月：-20.41% 近 6 月：-22.39% 今年以來：+15.52% 焦點個股 系統整合 (SI)概念領跌-5.23%。其中 資通(2471-TW) 下跌 9.97% ; 晉泰(6221-TW) 下跌 9.91% ; 大綜(3147-TW) 下跌 6.89% 。 MLCC電容概念領跌-4.93%。其中 信昌電(6173-TW) 下跌 9.9% ; 禾伸堂(3026-TW) 下跌 9.33% ; 華新科(2492-TW) 下跌 6.99% 。","sentiment":0,"tags":{"topics":[],"bull":[],"bear":[],"score":0,"highlights":[],"keywords":["台股指數","台股盤中","指數走勢","櫃買市場加權指數","系統整合 (SI)","MLCC電容"]},"time":"11/17 11:45"},{"id":"cnyes6664863","source":"鉅亨網","ca