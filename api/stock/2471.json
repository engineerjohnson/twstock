ate":"2026-10-13","foreign":-33.058,"trust":0.0,"dealer":2.0},{"date":"2026-10-12","foreign":-1.782,"trust":0.0,"dealer":0.0},{"date":"2026-10-08","foreign":0.213,"trust":0.0,"dealer":0.0},{"date":"2026-10-07","foreign":7.219,"trust":0.0,"dealer":2.0},{"date":"2026-10-06","foreign":46.183,"trust":0.0,"dealer":0.0},{"date":"2026-10-05","foreign":-69.002,"trust":0.0,"dealer":0.0},{"date":"2026-10-02","foreign":-36.012,"trust":0.0,"dealer":0.0},{"date":"2026-10-01","foreign":-10.0,"trust":0.005,"dealer":11.0},{"date":"2026-09-30","foreign":29.251,"trust":0.0,"dealer":-3.0},{"date":"2026-09-29","foreign":28.001,"trust":0.0,"dealer":1.0},{"date":"2026-09-24","foreign":109.0,"trust":0.0,"dealer":-1.0},{"date":"2026-09-23","foreign":76.566,"trust":0.0,"dealer":-28.0},{"date":"2026-09-22","foreign":99.92,"trust":0.0,"dealer":0.0}],"news":[{"id":"cnyes6635025","source":"鉅亨網","category":"總經","title":"借鏡英國資安認證與AI政策 台英攜手助攻中小企數位及淨零轉型","link":"https://news.cnyes.com/news/id/6635025","published":1792571730,"summary":"經濟部中小及新創企業署與英國在台辦事處於今（21）日共同舉辦台英中小企業AI論壇，聚焦數位韌性、淨零轉型及女性企業領導力。台灣憑藉完整的資通訊供應鏈與半導體製造實力，結合英國在數位科技、資安與淨零轉型領域的深厚研發能量，雙方展現強大的優勢互補效益。本次論壇吸引近100位業界專家參與，透過深度政策解析與實務經驗分享，全面助攻台灣中小企業運用AI加速雙軸轉型，深化國際經貿鏈結並搶占全球市場商機。 為推動中小企業運用人工智慧加速轉型，並深化台英提升貿易夥伴關係合作，經濟部中小及新創企業署與英國在台辦事處於今（21）日上午合作舉辦台英中小企業AI論壇，廣邀兩國產官學專家、中小企業及女性創業家共襄盛舉。本次論壇緊扣數位韌性、節能減碳及女性企業領導力等核心議題，期盼透過雙邊產業對話與具體案例分享，協助中小企業精準掌握AI應用趨勢，汲取創新轉型經驗，進一步提升布局國際市場的競爭實力。 中企署副署長戴婉蓉在會中表示，台英雙方於2025年簽署提升貿易夥伴關係三大支柱協議，強化投資、數位貿易、能源及淨零排放等關鍵領域合作，為雙方持續深化經貿交流奠定穩固基礎。台灣擁有全球完整的資通訊供應鏈、深厚的半導體及電子製造實力，而英國則在數位科技、資安及淨零轉型等領域具備豐富的研發能量與實務經驗。透過雙方的優勢互補與經驗交流，能有效促進兩國中小企業在AI及數位科技的創新應用，攜手開拓市場新商機。","sentiment":0,"tags":{"topics":["AI/半導體"],"bull":["供應鏈"],"bear":[],"score":1,"highlights":[],"keywords":["資安","中小企業","經濟部","淨零","AI","雙軸轉型","英國在台","英國"]},"time":"10/21 16:35"},{"id":"cnyes6634945","source":"鉅亨網","category":"總經","title":"桃機招募新進人員開跑 釋出64名職缺、起薪最高65K","link":"https://news.cnyes.com/news/id/6634945","published":1792564662,"summary":"隨著第三航廈、第三跑道等重大建設陸續推進，桃園國際機場公司今(21)日宣布，2026年新進從業人員甄試即日起開放網路報名，至11月2日下午5時截止，預計招募正取64名、備取63名，涵蓋工程、運輸管理及行政管理3大類別。 桃機表示，錄取人員通過試用後，月薪自4萬3,150元起，最高達6萬5,290元，歡迎有志投入航空產業的人才踴躍報考。 本次招募職缺涵蓋土木、建築、機械、環工、資通、航務、營運安全控制、運輸管理、行銷、護理、政風、稽核、會計及一般行政等領域，並依《身心障礙者權益保障法》第38條規定設置保障名額。多數職缺須具備相關學歷及工作經驗。 此外，本次有17名職缺不限工作經驗，只要具備符合職缺需求的學歷及英語檢定證明即可報考，提供社會新鮮人投入機場工作的機會。有意報考者應詳閱甄試簡章所列各類組的學經歷、專業證照及英語檢定等資格條件，並於期限內完成線上報名及繳費。 桃機表示，隨著第三航廈及第三跑道等重大建設陸續推進，桃園機場在工程建設、營運安全、智慧科技及旅客服務等面向，都需要更多不同專業的人才投入。歡迎認同安全、正直、專業、創新及熱情等核心價值的人才加入，共同守護國家門戶。完整甄試資訊可至甄試報名網站或桃園機場公司官網查詢。","sentiment":0,"tags":{"topics":[],"bull":[],"bear":[],"score":0,"highlights":[],"keywords":["桃園機場公司","第三航廈","航空產業"]},"time":"10/21 14:37"}],"fund":{"code":"2471","rev_month":"11509","rev":88266.0,"rev_mom":3.53782991202346,"rev_yoy":1.0868444861825304,"rev_cum_yoy":7.046827882839711,"eps_q":1.6,"eps_year":"115","eps_season":"2","net_income":75591.0,"pe":10.41,"pb":2.75,"yield":6.57,"updated":"2026-10-25 00:33"},"tdcc":{"latest":{"date":"2026-10-22","big1000":6.74,"big400":24.61,"retail":40.79,"holders":36662},"prev":{"date":"2026-10-08","big1000":6.74,"big400":24.75,"retail":41.05,"holders":36678},"d_big1000":0.0,"d_big400":-0.14,"d_retail":-0.26,"d_holders":-16},"weekly":{"bars":[{"time":"2026-07-27","open":48.7,"high":49.0,"low":46.45,"close":48.1,"volume":992.9699999999999},{"time":"2026-08-03","open":48.0,"high":49.25,"low":48.0,"close":48.4,"volume":459.019},{"time":"2026-08-10","open":48.7,"high":50.4,"low":48.7,"close":50.1,"volume":755.873},{"time":"2026-08-17","open":50.1,"high":50.1,"low":48.35,"close":48.9,"volume":506.64},{"time":"2026-08-24","open":49.0,"high":50.1,"low":48.75,"close":49.85,"volume":380.61899999999997},{"time":"2026-08-31","open":49.8,"high":50.9,"low":49.8,"close":50.2,"volume":542.701},{"time":"2026-09-07","open":49.9,"high":50.4,"low":49.05,"close":49.8,"volume":340.142},{"time":"2026-09-14","open":51.0,"high":54.0,"low":50.8,"close":53.1,"volume":4841.534},{"time":"2026-09-21","open":53.6,"high":54.0,"low":51.3,"close":51.4,"volume":1582.312},{"time":"2026-09-2