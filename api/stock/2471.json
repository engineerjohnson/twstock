rust":0.0,"dealer":0.0},{"date":"2026-10-13","foreign":-33.058,"trust":0.0,"dealer":2.0},{"date":"2026-10-12","foreign":-1.782,"trust":0.0,"dealer":0.0},{"date":"2026-10-08","foreign":0.213,"trust":0.0,"dealer":0.0},{"date":"2026-10-07","foreign":7.219,"trust":0.0,"dealer":2.0},{"date":"2026-10-06","foreign":46.183,"trust":0.0,"dealer":0.0}],"news":[{"id":"94a2cb1169175774","source":"經濟日報-證券","category":"台股","title":"遠傳全年財測可望達標","link":"https://money.udn.com/money/story/5710/9860353","published":1793894916,"summary":"遠傳電信（4904）昨（5）日舉行線上法說，前三季營收、獲利財測達成率全面超標，總經理井琪表示，電信本業、數位生活服務及企業智慧資通訊業務成推升成長動能，第4季企業智慧資通訊專案持續交付認列，成為推升營運成長動能，全年財測達標可期。","sentiment":1,"tags":{"topics":["EPS/獲利","營收","法說/展望"],"bull":["獲利","成長"],"bear":[],"score":2,"highlights":[],"keywords":[]},"time":"11/06 00:08"},{"id":"476850a7f2c8bc02","source":"經濟日報-證券","category":"台股","title":"中華電全年財測將達標 董座簡志誠喊話有信心達成","link":"https://money.udn.com/money/story/5710/9858056","published":1793808734,"summary":"中華電信（2412）昨（4）日舉行法說會，董事長簡志誠表示，有信心達成全年財測目標。其中，智慧資通訊（ICT）解決方案第3季接單金額年增84%，累計前三季資通訊簽約金額已達2025年全年1.4倍，看好IDC、雲端及資安服務成未來三大成長重心。","sentiment":1,"tags":{"topics":["訂單/接單","法說/展望"],"bull":["接單","看好","成長","年增"],"bear":[],"score":5,"highlights":["年增84%"],"keywords":[]},"time":"11/05 00:12"},{"id":"cnyes6645009","source":"鉅亨網","category":"國際","title":"花旗：台日韓企業赴美投資將續增 供應鏈重組帶動跨境商機","link":"https://news.cnyes.com/news/id/6645009","published":1793685615,"summary":"2026年11月03日（優分析／產業數據中心報導）⸺ 全球供應鏈重整之際，台灣、日本及南韓企業赴美投資可望持續增加，且隨購地、建廠到投產等階段推進，投資規模將逐步擴大。 花旗國際業務主管坎圖（Ernesto Torres Cantu）在香港受訪時表示：「這些企業有很強的投資能力。我認為南韓、台灣及日本企業的投資很可能持續下去。」他掌管花旗北美以外、涵蓋逾180個國家及地區的業務。 坎圖指出，全球企業正大舉投資美國，花旗承作的北美資金流入相關業務呈現雙位數成長。 花旗與摩根大通正為日本對美投資承諾所涉及的計畫提供融資，日本承諾的投資總額達5,500億美元；白宮近期也公布南韓3,500億美元戰略投資方案的首批項目。 坎圖表示，企業赴美投資通常會隨時間累積。他以製造業的分階段擴產為例，企業從購地、興建工廠，到投入日常營運，各階段都會產生資金需求，因此投資「只會持續往上堆疊」。 他指出，大型跨國企業面對地緣政治衝擊仍展現韌性，調整速度「非常快」。關稅雖仍是影響因素，波灣戰爭的衝擊可能更大，迫使許多企業重新安排貿易流向與供應鏈。 他表示，這也要求銀行在市場環境變動之際，持續為客戶辦理支付、貿易融資及交易清算。 花旗今年第3季整體營收成長8%，旗下服務業務表現更為突出，營收增加15%。該業務主要為企業、金融機構及政府提供現金管理、支付、貿易融資與流動性服務。","sentiment":1,"tags":{"topics":["營收","擴產/資本支出","關稅/地緣","匯率","金融"],"bull":["供應鏈","擴大"],"bear":[],"score":2,"highlights":["成長8%"],"keywords":["美國概念股","總經","優分析"]},"time":"11/03 14:00"},{"id":"cnyes6642371","source":"鉅亨網","category":"總經","title":"賴清德：三大方向協助產業布局全球 續推榮邦計畫助企業組「聯合艦隊」","link":"https://news.cnyes.com/news/id/6642371","published":1793365495,"summary":"賴清德總統今(30)日出席由民間產業基金會、電電公會舉辦的「榮邦啟航 鏈動全球 經濟外交高峰論壇」時表示，面對全球經貿新局，台灣產業須更深入參與供應鏈整合，完善海外布局，政府持續推動榮邦計畫，協助企業組成「聯合艦隊」，打造海外聚落、深化與當地產業合作，並透過經濟外交降低投資障礙，協助中小微企業轉型升級。 賴清德表示，政府將在既有合作基礎上持續推動榮邦計畫，將台灣在基礎建設、人才培育及科技發展等方面的經驗，帶往友邦與更多理念相近國家，並從3個方向協助產業布局全球，包括單打獨鬥走向整體出擊、設廠走向扎根、由政府擔任企業後盾， 賴清德指出，當前地緣政治、科技發展及經濟安全考量，正全面改變全球經貿秩序，企業布局海外，不僅要考量市場、成本與生產效率，更必須兼顧供應鏈韌性、人才資源、能源條件，及與當地產業長期合作的能力，台灣具備資通訊產業實力、精密製造技術及科學園區等產業聚落發展經驗，在全球供應鏈中持續占有不可或缺的關鍵地位。 賴清德表示，台灣產業若要走得更遠，必須從個別產品出口模式升級，更深入參與供應鏈整合，建構完整海外布局，這不僅是企業經營模式的轉變，更是台灣面對全球經貿新局必須掌握的戰略方向。 賴清德強調，政府將在既有合作基礎上持續推動榮邦計畫，將台灣在基礎建設、人才培育及科技發展等方面的經驗，帶往友邦與更多理念相近國家，並從以下3個方向協助產業布局全球。 首先是從單打獨鬥走向整體出擊。","sentiment":1,"tags":{"topics":["關稅/地緣"],"bull":["合作","供應鏈","布局"],"bear":[],"score":3,"highlights":[],"keywords":["總統府","賴清德","電電公會","AI新十大建設"]},"time":"10/30 21:04"},{"id":"cnyes6641849","source":"鉅亨網","category":"總經","title":"物價持穩有底氣！國發會葉俊顯：全年CPI維持約2% 經濟成長率可望再上調","link":"https://news.cnyes.com/news/id/6641849","published":1793365463,"summary":"國發會主委葉俊顯今(30)日出席「經濟外交高峰論壇」致詞時強調，政府正積極推動AI新十大建設，打造全民智慧生活圈，發揮台灣在半導體與資通訊產業的優勢，作為帶動出口、投資與消費三強鼎立的重要引擎。隨全球供應鏈重組與雲端服務需求擴增，今年台灣經濟成長率展現極佳韌性，全年CPI將維持在2%左右，下月主計總處發布最新預測時，今年經濟成長率有相當高的機會再向上調升。 全球經濟今年呈現溫和趨勢，受地緣政治衝突、美中關稅變數及極端氣候等風險干擾，國際機構預估全球經濟成長率落在2.4%至3.1%之間。儘管面臨全球通膨與利率高企等不確定性，台灣經濟依然乘風破浪。葉俊顯指出，受惠於全球雲端服務業者擴大資本支出，半導體與資通訊產品出口表現極佳；國內業者亦同步擴增先進製程與產能，帶動投資大幅成長。加上股市屢創新高的財富效果與民生消費復甦，出口、投資與消費三強，成為撐起台灣經濟高成長的三大支柱。 物價方面，受颱風及蔬果價格影響，今年1月至9月CPI平均為1.94%，全年預估將維持在2%左右。葉俊顯分析，在經濟強勁成長與總需求推升下，物價維持在2%左右屬健康且正常的溫和現象，政府亦會透過相關穩定措施密切控管。 在產業布局上，國發會統籌的「AI新十大建設」，涵蓋智慧應用、關鍵技術與數位基盤三大區塊。葉俊顯表示，AI發展正從生成式晶片轉向代理式晶片，未來機器與電腦間將能自主對話，深度融入食衣住行育樂及醫療等領域。","sentiment":1,"tags":{"topics":["擴產/資本支出","AI/半導體","總經/聯準會","關稅/地緣"],"bull":["調升","成長","供應鏈","上調"],"bear":[],"score":6,"highlights":[],"keywords":["國發會","經濟成長率","CPI","矽光子","算力","AI新十大建設","半導體","AI"]},"time":"10/30 21:04"},{"id":"cnyes6641783","source":"鉅亨網","category":"總經","title":"AI、半導體需求強勁 國科會：全國研發經費連2年突破兆元","link":"https://news.cnyes.com/news/id/6641783","published":1793341610,"summary":"國科會今(30)日公布「2025年全國科技動態調查」，結果顯示，去(2025)年全國研發經費及研發人力仍維持雙成長，全國研發經費繼2024年突破兆元後持續成長，達1兆1,380億元、年增8.5%，連續2年突破兆元，GDP占比為3.96%，推測因全球市場對於人工智慧、資料中心及半導體先進製程之高度需求，帶動半導體、資通訊、電子零組件等高科技產業出口大幅成長。 據國科會調查結果，全國科技動態調查中，幾項特點如下； 一、企業主導技術發展動能：政府持續增加基礎研究之投入2025年全國研發經費中，以經費來源面進行觀察時，來自民間部門研發經費為9,810億元、年增9%，來自政府部門研發經費為1,570億元，年增5.4%，2025年來自民間部門研發經費占整體研發經費之86.2%，較前年略增0.4個百分點。 二、企業部門為我國研發主力，科學園區驅動企業研發量能：近年來企業部門所執行之研發經費占全國研發經費的比率皆在8成以上，2025年占比達85.9%，年增率為8.8%。我國由大型企業帶動整體研發量能，去年由規模500人以上的企業所執行之研發經費占全體企業研發經費之83.2%，較上年增加0.9個百分點。而科學園區廠商所執行之研發經費占全體企業研發經費比率由2021年之45.4%提升至114年47.8%。","sentiment":1,"tags":{"topics":["法人動向","AI/半導體","總經/聯準會"],"bull":["需求強勁","突破","成長","年增"],"bear":["調查"],"score":4,"highlights":["年增8.5%","年增9%","年增5.4%"],"keywords":["國科會","全國研發經費","AI","半導體"]},"time":"10/30 14:26"}],"fund":{"code":"2471","rev_month":"11509","rev":88266.0,"rev_mom":3.53782991202346,"rev_yoy":1.0868444861825304,"rev_cum_yoy":7.046827882839711,"eps_q":null,"eps_year":null,"eps_season":null,"net_income":null,"pe":11.28,"pb":2.98,"yield":6.06,"updated":"2026-11-06 17:49"},"tdcc":{"latest":{"date":"2026-10-30","big1000":6.74,"big400":24.64,"retail":40.78,"holders":36666},"prev":{"date":"2026-10-22","big1000":6.74,"big400":24.61,"retail":40.79,"holders":36662},"d_big1000":0.0,"d_big400":0.03,"d_retail":-0.01,"d_holders":4},"weekly":{"bars":[{"time":"2026-07-27","open":48.7,"high":49.0,"low":46.45,"close":48.1,"volume":992.9699999999999},{"time":"2026-08-03","open":48.0,"high":49.25,"low":48.0,"close":48.4,"volume":459.019},{"time":"2026-08-10","open":48.7,"high":50.4,"low":48.7,"close":50.1,"volume":755.873},{"time":"2026-08-17","open":50.1,"high":50.1,"low":48.35,"close":48.9,"volume":506.64},{"time":