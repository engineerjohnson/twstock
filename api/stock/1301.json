:-668.857},{"date":"2026-11-04","foreign":-2123.737,"trust":275.0,"dealer":-59.908},{"date":"2026-11-03","foreign":-12250.562,"trust":18.0,"dealer":-1152.521},{"date":"2026-11-02","foreign":1422.977,"trust":878.0,"dealer":385.793},{"date":"2026-10-30","foreign":-383.736,"trust":0.0,"dealer":-146.135},{"date":"2026-10-29","foreign":524.94,"trust":0.0,"dealer":-150.264},{"date":"2026-10-28","foreign":-2047.266,"trust":3.0,"dealer":774.53},{"date":"2026-10-22","foreign":-16065.504,"trust":1.0,"dealer":-196.99},{"date":"2026-10-21","foreign":5007.997,"trust":0.0,"dealer":312.221}],"news":[{"id":"4f059eba674d84e1","source":"經濟日報-證券","category":"台股","title":"中工攜手信紘科拿下台塑大樓都更案","link":"https://money.udn.com/money/story/5607/9892107","published":1795189493,"summary":"中工（2515）昨（20）日宣布攜手信紘科，取得「台塑大樓都更案」建築與機電案。信紘科承攬約49億元全案機電工程，從半導體擴大布局大型商辦、住宅及都市更新市場，中工累積大型複合式建築工程實績，預計2029年完工。","sentiment":1,"tags":{"topics":["AI/半導體"],"bull":["擴大","布局"],"bear":[],"score":2,"highlights":[],"keywords":[]},"time":"11/20 23:44"},{"id":"cnyes6669132","source":"鉅亨網","category":"台股","title":"信紘科攜手中工搶攻台塑大樓都更 統包訂單營收占比已達50%","link":"https://news.cnyes.com/news/id/6669132","published":1795164604,"summary":"信紘科(6667-TW)今20日在台北宣布，與營造廠中工(2515-TW)攜手合作，共同投入總工程造價約新台幣220億元的台塑大樓都市更新新建工程，其中信紘科承攬全案機電統包工程，合約金額約49億元，預計2029年完工。受惠於近年積極轉型總承包商並拓展跨產業應用，信紘科目前在手統包形態案件占整體營收比重已達50%。 信紘科共同執行長林欣德指出，公司自2021年至2022年間便開始布局機電領域，目前已建立近百人的專業團隊，涵蓋設計規劃、現場監造與建築資訊模型等職能。面對外界關注高科技廠務與商辦都更的毛利率及人力配置差異。 林欣德他表示機電團隊與原本的半導體團隊各自獨立運作且可跨區調度，公司看重的是透過擴大承攬規模帶來整體營收與每股純益的實質成長。 信紘科過去在晶圓代工龍頭廠區的氣體與化學等高門檻二次配項目擁有八至九成市占率，如今正將高科技廠房的高效率管理經驗延伸至民間建築及半導體上下游供應鏈。 林欣德說明，隨著半導體大廠持續擴產，周邊化學品與原物料供應商普遍採取統包模式發包建廠，信紘科憑藉熟悉精密製程與無塵室整合的優勢，已順利切入美系記憶體廠的二次配統包與辦公室機電工程，未來海外如新加坡等據點也將以統包模式接單。","sentiment":1,"tags":{"topics":["訂單/接單","EPS/獲利","營收","擴產/資本支出","AI/半導體","總經/聯準會","匯率"],"bull":["訂單","合作","受惠","布局"],"bear":[],"score":6,"highlights":[],"keywords":["中工","信紘科","廠務"]},"time":"11/20 16:50"},{"id":"cnyes6669013","source":"鉅亨網","category":"台股","title":"中工進軍科技廠辦 搶攻高科技建廠商機並結盟信紘科發揮綜效","link":"https://news.cnyes.com/news/id/6669013","published":1795159942,"summary":"中華工程(2515-TW)今(20)日與信紘科技(6667-TW)攜手合作，共同投入台北市重大都市更新指標工程「台塑大樓都市更新新建工程」，全案由台塑建設擔任實施者，整體工程造價約220億元，此次合作結合中工大型營造統籌能力與信紘科高科技廠務及機電工程整合經驗，集結專業工程團隊共同執行大型複合式建築工程，也為雙方跨領域合作開啟新的篇章。 信紘科此次承攬「台塑大樓都市更新新建工程」案約49億元的機電工程。 中工並指出，未來，中工與信紘科將以此次合作為重要基礎， 建立台塑建設、中工與信紘科三方合作基礎，持續拓展後續大型營建及相關工程合作機會，開創更廣泛的工程合作空間。 台北市都更重大工程的「台塑大樓都市更新新建工程」，基地位於台北市松山區敦化北路，面積約6,328坪，規劃興建兩棟地上22層辦公大樓及一棟地上22層住宅大樓，預計2029年完工。全案由中工承攬興建，主要負責主體營造工程，信紘科則負責全案機電工程。 台塑大樓於1976年落成，長年作為台塑企業總部及敦化北路重要企業地標，隨台塑集團總部於2023年遷往內湖，原址正式啟動都市更新計畫。 「台塑大樓都市更新新建工程」案基地涵蓋松山區民生段6筆土地，座落於敦北金融商圈與民生住宅生活圈交會地帶，也是敦化南北路都市綠廊的重要節點，屬台北市中心少見的大規模完整街廓都市更新案。","sentiment":0,"tags":{"topics":["擴產/資本支出"],"bull":["合作"],"bear":[],"score":1,"highlights":[],"keywords":["中工","信紘科","台塑大樓","都更"]},"time":"11/20 15:32"},{"id":"2c3b2c3c401f54ef","source":"Yahoo股市-台股","category":"台股","title":"台股狂殺2000點！009816、0050同步重挫 台塑四寶全到齊後「這檔持股」竟差17個百分點","link":"https://tw.stock.yahoo.com/news/%E5%8F%B0%E8%82%A1%E7%8B%82%E6%AE%BA2000%E9%BB%9E-009816-0050%E5%90%8C%E6%AD%A5%E9%87%8D%E6%8C%AB-%E5%8F%B0%E5%A1%91%E5%9B%9B%E5%AF%B6%E5%85%A8%E5%88%B0%E9%BD%8A%E5%BE%8C-%E9%80%99%E6%AA%94%E6%8C%81%E8%82%A1-022600299.html","published":1795141560,"summary":"[FTNN新聞網]記者陳雅婷／綜合報導台股今（20）日賣壓持續擴大，早盤開低走低，開盤報37,646.13點，盤中最低下探36,162.96點，大跌2263.93點。大型ETF同步承...","sentiment":-1,"tags":{"topics":[],"bull":["擴大"],"bear":["重挫","大跌","賣壓"],"score":-6,"highlights":[],"keywords":[]},"time":"11/20 10:26"},{"id":"6eb1e755dea7a0e7","source":"CMoney","category":"台股","title":"6505 台塑化 - 【台塑化(6505)盤後解析】投信主力低接，價跌籌碼戰 台塑... - 股市爆料同學會","link":"https://news.google.com/rss/articles/CBMiWEFVX3lxTE5VSzd2V2VHRkJvWVA3bU92ZEN2TWRkMkVGV0N0QlhmZGttNzVRUklYQWFsN0ZQRVVPTm9aR0JvOXk3UUF5empzZ0dDYVhsMi1FaW4xT0M2d1Y?oc=5","published":1795108468,"summary":"6505 台塑化 - 【台塑化(6505)盤後解析】投信主力低接，價跌籌碼戰 台塑... - 股市爆料同學會 CMoney","sentiment":0,"tags":{"topics":["法人動向","航運/傳產","盤後"],"bull":[],"bear":[],"score":0,"highlights":[],"keywords":[]},"time":"11/20 01:14"},{"id":"cnyes6665044","source":"鉅亨網","category":"台股","title":"大戶搶短遭雙巴？台化、世界、萬泰科違約交割共1.29億元都在這分點","link":"https://news.cnyes.com/news/id/6665044","published":1795087933,"summary":"台股近期震盪加劇，違約交割頻傳，繼昨(18)日上市櫃爆出 9 檔後，證交所與櫃買中心今(19)日再度公告 3 檔，包括上市股台化(1326-TW)及上櫃股世界(5347-TW)、萬泰科(6190-TW)，違約交割金額合計達1億2,892萬6,300元。值得注意的是，3 筆違約申報全數出自同一家券商分點「元大和平」，市場揣測可能為同一名大戶或關聯戶資金調度失靈所致。 根據證交所及櫃買中心公告數據，今日揭露的 3 檔違約交割個股中，以半導體晶圓代工廠世界違約金額最高，達4,925萬3,000元；其次為台塑集團股之一的台化，申報違約金額為4,172萬8,000元；銅纜線材廠萬泰科則以3,794萬5,300元居第三，這3檔皆由元大證券和平分公司通報。 依據台股「T+2」交割制度推算，今日公告的違約交割案件，實際交易日落在本周二(17日)。回顧當天盤勢，大盤重挫近千點，三檔個股當日盤中均出現劇烈洗盤，成為引爆違約的主因。","sentiment":-1,"tags":{"topics":["法人動向","AI/半導體","金融"],"bull":[],"bear":["違約"],"score":-2,"highlights":[],"keywords":["違約交割","證交所","台股","台化","萬泰科","世界","櫃買"]},"time":"11/19 19:32"},{"id":"01b66e0f2c8a4f42","source":"富聯網","category":"台股","title":"《投信買超9-2》台塑(4141)、上海銀(3991)、日月光(3973)","link":"https://news.google.com/rss/articles/CBMiiAFBVV95cUxPRTFPRjBQakFBcjE3ai0yV3pKZmVzR3hDMVhpZUc2LWhPMFZjXzI3OEpHT1RTYm41aG43aXZWcFpWV2xncWc5aXZXZHhjWGJ0Mnh0SnQ1MEJObmxUMld3LWY3bDZqcnpESXphbXR5RGpHaXJ4YXdVd2VIM2MxcTFkX0JXMFRTYTdM?oc=5","published":1795044900,"summary":"《投信買超9-2》台塑(4141)、上海銀(3991)、日月光(3973) 富聯網","sentiment":1,"tags":{"topics":["法人動向"],"bull":["買超"],"bear":[],"score":2,"highlights":[],"keywords":[]},"time":"11/19 07:35"},{"id":"ecde3bf24128d515","source":"CMoney","category":"台股","title":"6505 台塑化 - 【台塑化(6505)盤後解析】投信逆勢大買，土洋對作 台塑... - 股市爆料同學會","link":"https://news.google.com/rss/articles/CBMiWEFVX3lxTFBjemM0eGY1ZXNCLUZNejFyTzd4YkNOMWdmbjBGWExJWmlUeU1PTW83NnRReGhLQU9la0ZYdWtiVEJYbXZvTDF0X1JmRjcyOG9kWWNzaDZRb3Y?oc=5","published":1795007945,"summary":"6505 台塑化 - 【台塑化(6505)盤後解析】投信逆勢大買，土洋對作 台塑... - 股市爆料同學會 CMoney","sentiment":1,"tags":{"topics":["法人動向","航運/傳產","盤後"],"bull":["大買"],"bear":[],"score":3,"highlights":[],"keywords":[]},"time":"11/18 21:19"},{"id":"6093f0f63fa63c39","source":"富聯網","category":"台股","title":"《投信買超9-2》台塑(4141)、日月光(4027)、上海銀(3991)","link":"https://news.google.com/rss/articles/CBMiiAFBVV95c