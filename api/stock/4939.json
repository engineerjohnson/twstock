下，有望超越今年獲利水準。 外資則指出，台股今年從歷史高點迄今回檔幅度逼近3成，之前備受關注的電子AI全淪為重災區，目前包括大摩觀察，不少千金股財務遭下修，南亞成為外資看好的股票之一。","sentiment":1,"tags":{"topics":["EPS/獲利","營收","法人動向","AI/半導體","航運/傳產"],"bull":["大漲","調高","目標價","成長","放量","受惠"],"bear":["縮減"],"score":8,"highlights":[],"keywords":["南亞","南亞科","塑化股","AI"]},"time":"11/26 20:55"}],"fund":{"code":"4939","rev_month":"11510","rev":160030.0,"rev_mom":2.6346506586626646,"rev_yoy":42.32099819464084,"rev_cum_yoy":19.527141863386536,"eps_q":0.76,"eps_year":"115","eps_season":"3","net_income":74855.0,"pe":53.49,"pb":2.86,"yield":0.54,"updated":"2026-11-27 02:23"},"tdcc":{"latest":{"date":"2026-11-20","big1000":23.61,"big400":31.44,"retail":41.01,"holders":67200},"prev":{"date":"2026-11-13","big1000":23.7,"big400":31.58,"retail":41.22,"holders":67431},"d_big1000":-0.09,"d_big400":-0.14,"d_retail":-0.21,"d_holders":-231},"weekly":{"bars":[{"time":"2026-07-27","open":62.4,"high":63.9,"low":45.9,"close":50.8,"volume":45857.674},{"time":"2026-08-03","open":49.3,"high":67.2,"low":49.3,"close":60.8,"volume":76735.734},{"time":"2026-08-10","open":60.8,"high":65.5,"low":59.1,"close":61.4,"volume":56736.44200000001},{"time":"2026-08-17","open":61.0,"high":68.5,"low":59.1,"close":66.5,"volume":70102.957},{"time":"2026-08-24","open":67.0,"high":95.2,"low":63.5,"close":92.8,"volume":189586.61200000002},{"time":"2026-08-31","open":89.0,"high":93.2,"low":80.2,"close":87.9,"volume":49281.179000000004},{"time":"2026-09-07","open":88.5,"high":94.5,"low":80.1,"close":82.4,"volume":55264.941999999995},{"time":"2026-09-14","open":82.4,"high":83.8,"low":75.3,"close":78.3,"volume":37796.772},{"time":"2026-09-21","open":78.8,"high":81.4,"low":71.3,"close":73.7,"volume":19009.010000000002},{"time":"2026-09-29","open":73.2,"high":84.0,"low":73.1,"close":79.2,"volume":34633.981},{"time":"2026-10-05","open":79.7,"high":80.7,"low":76.2,"close":78.3,"volume":24957.428},{"time":"2026-10-12","open":76.3,"high":83.3,"low":70.0,"close":83.3,"volume":84537.79400000001},{"time":"2026-10-1