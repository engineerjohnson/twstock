流程。 展望未來，光鼎指出，將深化與日本大塚集團及所有國際夥伴的合作，並透過開放式 CDMO 將開發需求轉化為長期穩定的耗材與試劑供應。 光鼎生技10月營收1940.1萬元，月增8.97%，年減15.19%；累計今年前10月營收1.72億元，年減2.09%。","sentiment":1,"tags":{"topics":["營收","法說/展望","生技"],"bull":["受惠"],"bear":[],"score":2,"highlights":[],"keywords":["光鼎生技","法說會","檢測","生技"]},"time":"11/24 19:16"},{"id":"349f442822f16e09","source":"生技投資第一站-Genet觀點","category":"台股","title":"11月24日 Genet新聞: 【生合、杏昌、醫影、上亞科技、太醫、光鼎生技、聯合法說】、【岱宇】115/11/24~116/01/22買回庫藏股220萬股價格16.00~25.00元、【加捷生醫】115/11/24~116/01/23買回庫藏股300萬股價格5.64~15.80元、《11/23日法人買超》外資買超前三名：晟","link":"https://news.google.com/rss/articles/CBMibkFVX3lxTE10OTZsSTJZeTV1Y2stRk1FSWxMNWROdEM2VGRiaVlmOFdiY2N3Q252VDRoMlJmeFc3Y0ZtT2dWbHhMSzI4N1hzWUx0WW1DVjcyTDV6WElqYy0tTEJUSHJ6dFhkV2s0cWtCdDhuZWx3?oc=5","published":1795479153,"summary":"11月24日 Genet新聞: 【生合、杏昌、醫影、上亞科技、太醫、光鼎生技、聯合法說】、【岱宇】115/11/24~116/01/22買回庫藏股220萬股價格16.00~25.00元、【加捷生醫】115/11/24~116/01/23買回庫藏股300萬股價格5.64~15.80元、《11/23日法人買超》外資買超前三名：晟 生技投資第一站-Genet觀點","sentiment":1,"tags":{"topics":["法說/展望","法人動向","生技"],"bull":["買超","庫藏股","法人買"],"bear":[],"score":6,"highlights":[],"keywords":[]},"time":"11/24 08:12"}],"fund":{"code":"6226","rev_month":"11510","rev":58870.0,"rev_mom":-11.733837111670864,"rev_yoy":35.3613391276356,"rev_cum_yoy":11.342442242665438,"eps_q":0.06,"eps_year":"115","eps_season":"3","net_income":6940.0,"pe":null,"pb":2.18,"yield":null,"updated":"2026-11-27 02:23"},"tdcc":{"latest":{"date":"2026-11-20","big1000":13.47,"big400":19.11,"retail":45.41,"holders":57768},"prev":{"date":"2026-11-13","big1000":12.34,"big400":18.37,"retail":45.95,"holders":58130},"d_big1000":1.13,"d_big400":0.74,"d_retail":-0.54,"d_holders":-362},"weekly":{"bars":[{"time":"2026-07-27","open":18.1,"high":24.5,"low":17.5,"close":19.6,"volume":120901.72099999999},{"time":"2026-08-03","open":19.2,"high":23.8,"low":18.95,"close":22.05,"volume":96760.30500000001},{"time":"2026-08-10","open":22.05,"high":22.3,"low":19.05,"close":19.05,"volume":44639.797},{"time":"2026-08-17","open":19.05,"high":23.2,"low":