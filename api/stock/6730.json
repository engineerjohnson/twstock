r":0.0},{"date":"2026-10-20","foreign":-1.0,"trust":0.0,"dealer":0.0},{"date":"2026-10-19","foreign":-2.0,"trust":0.0,"dealer":0.0},{"date":"2026-10-15","foreign":-1.0,"trust":0.0,"dealer":0.0},{"date":"2026-10-13","foreign":12.0,"trust":0.0,"dealer":0.0},{"date":"2026-09-29","foreign":-1.0,"trust":0.0,"dealer":0.0},{"date":"2026-09-18","foreign":0.0,"trust":0.0,"dealer":0.0}],"news":[{"id":"cnyes6663822","source":"鉅亨網","category":"台股","title":"常廣持續拓展海外客戶 看好明年營收年增雙位數","link":"https://news.cnyes.com/news/id/6663822","published":1794814668,"summary":"常廣(6730-TW)今(16)日召開法說會，董事長陳政宏指出，常廣持續拓展海外市場，包括東南亞、南美洲等地，各國多個產品客戶皆成長，預期今明兩年客戶數都將成長雙位數，並同步看好明年營收年增雙位數。 總經理陳正雄表示，常廣於東南亞市場深耕多年，客戶持續成長，包含印尼、越南、菲律賓及新加坡等，南美洲市場則已經營5年，今年開始顯著升溫，客戶涵蓋瓜地馬拉、巴西及秘魯等，而阿根廷也在洽談中。 陳正雄進一步提到，日本既有客戶在穿刺套管產品推廣效益佳，認為明年將有較大幅度的成長；中國市場方面，這兩年客戶也有新增；台灣市場部分，目前產品已導入全台23家醫學中心、45家區域/地方醫院。 至於常廣各區域營收比重，亞洲地區(包括台灣)營收比重約75%，歐洲地區占25%，其他地區則約占5%。整體而言，陳正雄預期，營收金額仍以亞洲成長速度最快，不過以百分比來看，因南美洲基數較低，因此成長幅度將最高，明年百分比有機會倍增。 另外，陳政宏指出，未來達文西將走向單孔手術，因此常廣將跟隨此趨勢，開發與達文西手術相關的產品。 常廣第三季營收1.33億元，季增4.16%，年增5.04%；毛利率47.11%，季增4.46個百分點，年減0.37個百分點；營益率18.78%，季增3.87個百分點，年減0.53個百分點；稅後純益1999.7萬元，季增22.39%，年減1.93%，每股純益0.55元。","sentiment":1,"tags":{"topics":["EPS/獲利","營收","法說/展望","總經/聯準會"],"bull":["看好","成長","年增"],"bear":[],"score":3,"highlights":["年增5.04%"],"keywords":["常廣","醫材","生技","法說會"]},"time":"11/16 15:37"}],"fund":{"code":"6730","rev_month":"11510","rev":41170.0,"rev_mom":-5.980954120897942,"rev_yoy":-3.2591583053316726,"rev_cum_yoy":2.3828394210889043,"eps_q":1.44,"eps_year":"115","eps_season":"3","net_income":52131.0,"pe":16.33,"pb":1.47,"yield":4.89,"updated":"2026-11-20 19:27"},"tdcc":{"latest":{"date":"2026-11-13","big1000":60.56,"big400":74.47,"retail":4.27,"holders":975},"prev":{"date":"2026-11-06","big1000":60.56,"big400":74.45,"retail":4.29,"holders":977},"d_big1000":0.0,"d_big400":0.02,"d_retail":-0.02,"d_holders":-2},"weekly":{"bars":[{"time":"2026-07-27","open":34.5,"high":34.95,"low":32.1,"close":34.45,"volume":133.756},{"time":"2026-08-03","open"