UWVGVzJwbV9yM3htVTluT2ZjOEpLM2hPcVhIdHNhX1MwUm1KUVlkSFo0ZmhwaUpRUHM0aFMxMnM0VXh4VnJwSHB2OUkyR056emF0Y2tFR05KbnloYmM1T2owd3J0d0V0ZEM0Sl9keEhnbWdnX3JjV1lOZTZ1U3NjQV9OUU1BbHF1Q1c?oc=5","published":1794349773,"summary":"【即時新聞】裕民10月營收21.77億創新高，前三季EPS達5.8元展現強勁動能 CMoney投資網誌","sentiment":1,"tags":{"topics":["EPS/獲利","營收"],"bull":["創新高","新高"],"bear":[],"score":3,"highlights":["EPS達5.8元"],"keywords":[]},"time":"11/11 06:29"},{"id":"856436ade273d6c7","source":"經濟日報-證券","category":"台股","title":"裕民財報／第3季稅後純益19.35億元、年增33% EPS 2.29元","link":"https://money.udn.com/money/story/5710/9869935","published":1794306356,"summary":"裕民（2606）航運第 3 季合併營收 52.78 億元，毛利率為 36.7%，稅後純益 19.35 億元、年增 33%，第 3 季每股盈餘（EPS）為 2.29 元，整體本業營運表現穩健。","sentiment":0,"tags":{"topics":["EPS/獲利","營收","法說/展望","總經/聯準會","航運/傳產"],"bull":["年增"],"bear":[],"score":1,"highlights":["年增33%","EPS 2.29元","年增 33%"],"keywords":[]},"time":"11/10 18:25"},{"id":"2d95be65e85dcc58","source":"富聯網","category":"台股","title":"《外資買超21-15》裕民(173)、大立光(172)、泰山(170)","link":"https://news.google.com/rss/articles/CBMiiAFBVV95cUxNTTAzRzhXZ0g1OC1Ea1cxRk9BazhEN1ZfZUptYm5yVnZXT2l2WEFsbTM4cEZkVzlXX0xzeElPY1U0Z09aRW90T2FvNktzRi04R2xpblVsNnRRSkI5T2dvakYycTdvR2NOTEo1NXVQY2YtaGdRLXhDYUluWThqR1AyQ2lGNGpCZE4t?oc=5","published":1793921580,"summary":"《外資買超21-15》裕民(173)、大立光(172)、泰山(170) 富聯網","sentiment":1,"tags":{"topics":["法人動向"],"bull":["買超"],"bear":[],"score":2,"highlights":[],"keywords":[]},"time":"11/06 07:33"},{"id":"cnyes6647555","source":"鉅亨網","category":"台股","title":"〈焦點股〉散裝航商處Q4傳統旺季 多檔揚帆上漲成資金避風港","link":"https://news.cnyes.com/news/id/6647555","published":1793845025,"summary":"散裝航商裕民(2606-TW)近日有新船下水，隨著第四季傳統旺季到來，又有新船挹注營運新動能，裕民今(5)日盤中股價維持紅盤上，一度漲逾3%，同時，中航(2612-TW)、慧洋-KY(2637-TW)均漲2%上下，顯示業績穩健成長的散裝航運，成為大盤資金移動的另一避風港。 裕民近日迎來一艘64000載重噸極限靈便型(Ultramax)散裝新船，是旗下首艘採用海虹Hempaguard NB高性能矽基防污塗層的船舶，並取得法國驗船協會(Bureau Veritas, BV)「BIOFUEL-READY」附加船級符號。 裕民表示，此Ultramax船型具備貨種多元、港口適應性高和航線部署靈活等特性，可承運穀物、煤炭、鋼材、肥料及鋁土礦等主要乾散裝貨載，並可依船舶配置承運甲板貨，是推動船隊汰舊換新與低碳轉型的重要里程碑。 裕民樂觀看待，隨著未來4-5年的船隊擴充計畫逐步落實，將進一步提升營運表現。 慧洋則指出，下半月巴拿馬型船運價指數略有回檔，主要受到中國和印度煤炭採購需求以及印尼出口配額政策不確定性影響，此為短期市場波動，後續冬季供電仍有回補空間。 而目前北美穀物正值傳統出口旺季，慧洋預期可為市場提供一定支撐。 展望後市，慧洋認為，目前地緣政治和區域衝突持續影響散裝市場，貿易結構和航線改變預期將增加船舶周轉率，使明年運價可望有撐。","sentiment":1,"tags":{"topics":["法說/展望","關稅/地緣","航運/傳產"],"bull":["旺季","成長"],"bear":[],"score":2,"highlights":[],"keywords":["焦點股","散裝","裕民","慧洋","海運","BDI","原物料"]},"time":"11/05 10:17"}],"fund":{"code":"2606","rev_month":"11510","rev":2176702.0,"rev_mom":21.022622708553527,"rev_yoy":56.87026559170239,"rev_cum_yoy":28.495221839357793,"eps_q":5.8,"eps_year":"115","eps_season":"3","net_income":4898709.0,"pe":9.58,"pb":1.4,"yield":3.98,"updated":"2026-11-13 17:58"},"tdcc":{"latest":{"date":"2026-11-06","big1000":74.56,"big400":78.3,"retail":9.19,"holders":44570},"prev":{"date":"2026-10-30","big1000":74.6,"big400":78.31,"retail":9.26,"holders":44788},"d_big1000":-0.04,"d_big400":-0.01,"d_retail":-0.07,"d_holders":-218},"weekly":{"bars":[{"time":"2026-07-27","open":64.3,"high":64.5,"low":59.9,"close":62.6,"volume":19073.962},{"time":"2026-08-03","open":61.8,"high":67.5,"low":61.5,"close":67.5,"volume":19922.052},{"time":"2026-08-10","open":66.7,"high":68.4,"low":64.6,"close":66.3,"volume":16741.353000000003},{"time":"2026-08-17","open":66.7,"high":73.0,"low":66.3,"close":72.6,"volume":40078.312},{"time":"2026-08-24","open":73.5,"high":79.5,"low":70.0,"close":72.2,"volume":112485.117},{"time":"2026-08-31","open":72.9,"high":80.0,"low":71.9,"close":78.2,"volume":42195.077000000005},{"time":"2026-09-07","open":79.0,"high":81.7,"low":76.3,"close":76.5,"volume":24067.745000000003},{"time":"2026-09-14","open":76.5,"high":77.5,"low":73.9,"close":77.4,"volume":19379.35},{"time":"2026-09-21","open":78.0,"high":78.3,"low":75.2,"close":76.7,"volume":9267.432999999999},{"time":"2026-09-29","open":75.8,"high":75.9,"low":73.1,"close":75.9,"volume":12430.989},{"time":"2026-10-05","open":75.9,"high":76.8,"low":74.0,"close":74.9,"volume":8392.021},{"time":"2026-10-12","open":75.9,"high":79.3,"low":74.8