主力藥物正於台灣、美國等地進行臨床1b、2a試驗，研究涵蓋胃癌、胃食道交界部癌及大腸直腸癌等實體腫瘤。現階段臨床研究數據仍屬初步，藥物療效及安全性尚待後續進行確認，相關研究結果作為後續臨床開發策略的評估依據。 董事長劉世高指出，此次與高醫合作，將結合雙方優勢，在符合台灣法規及研究倫理的前提下，共同探索癌症新藥臨床研究的合作機會，持續累積臨床研究經驗，為後續新藥開發提供更多研究依據。","sentiment":0,"tags":{"topics":["法人動向","生技"],"bull":["合作"],"bear":[],"score":1,"highlights":[],"keywords":["漢康","高醫","生技","癌症","新藥開發"]},"time":"11/05 16:58"}],"fund":{"code":"7827","rev_month":"11510","rev":0.0,"rev_mom":null,"rev_yoy":null,"rev_cum_yoy":-91.14030676791909,"eps_q":null,"eps_year":null,"eps_season":null,"net_income":null,"pe":null,"pb":12.51,"yield":null,"updated":"2026-11-13 17:58"},"tdcc":{"latest":{"date":"2026-11-06","big1000":74.79,"big400":79.68,"retail":3.28,"holders":2586},"prev":{"date":"2026-10-30","big1000":74.67,"big400":79.56,"retail":3.29,"holders":2615},"d_big1000":0.12,"d_big400":0.12,"d_retail":-0.01,"d_holders":-29},"weekly":{"bars":[{"time":"2026-07-27","open":136.0,"high":144.0,"low":132.0,"close":142.5,"volume":1572.7999999999997},{"time":"2026-08-03","open":144.5,"high":157.5,"low":144.5,"close":156.0,"volume":1421.297},{"time":"2026-08-10","open":156.0,"high":164.5,"low":153.5,"close":161.0,"volume":1269.247},{"time":"2026-08-17","open":161.0,"high":165.5,"low":151.5,"close":161.0,"volume":1151.946},{"time":"2026-08-24","open":161.5,"high":164.5,"low":152.5,"close":159.5,"volume":1763.3059999999998},{"time":"2026-08-31","open":157.0,"high":157.0,"low":145.0,"close":151.0,"volume":680.4289999999999},{"time":"2026-09-07","open":152.5,"high":154.5,"low":149.5,"close":152.5,"volume":644.365},{"time":"2026-09-14","open":150.5,"high":162.5,"low":147.0,"close":162.0,"volume":898.883},{"time":"2026-09-21","open":162.0,"high":167.5,"low":155.0,"close":162.5,"volume":1170.795},{"time":"2026-09-29","open":161.0,"high":170.5,"low":158.0,"close":167.0,"volume":1384.1660000000002},{"time":"2026-10-05","open":166.5,"high":170.5,"low":163.0,"close":169.0,"volume":1372.497},{"time":"2026-10-12","open":169.0,"high":172.0,"low":163.0,"close":164.0,"volume"