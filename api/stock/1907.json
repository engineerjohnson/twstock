轉讓的現金增資認股權利，合計約1,187萬股、金額約4.17億元，其餘額度約3.03億元，擬視實際配售情形參與特定人認購。 而永豐餘建設開發的總投資金額以10.1億元為上限，其中，依原持股比例認購，以及受讓永豐餘投控轉讓的現金增資認股權利，合計約1,408萬股、金額約4.95億元，其餘額度約5.15億元，擬視實際配售情形參與特定人認購。 永豐餘說明，2家子公司合計總投資金額不超過17.3億元，其中，原股東認購及認股權利受讓金額為9.12億元，特定人認購額度合計不超過8.18億元，實際認購股數及金額將依最終獲配結果辦理。","sentiment":0,"tags":{"topics":["金融"],"bull":["認購"],"bear":[],"score":1,"highlights":[],"keywords":["永豐餘","永豐金控","現金增資"]},"time":"10/28 19:54"}],"fund":{"code":"1907","rev_month":"11509","rev":6652784.0,"rev_mom":3.1073308856235538,"rev_yoy":3.947606080624587,"rev_cum_yoy":4.873221098838152,"eps_q":0.47,"eps_year":"115","eps_season":"2","net_income":828200.0,"pe":16.79,"pb":0.52,"yield":3.5,"updated":"2026-10-30 16:33"},"tdcc":{"latest":{"date":"2026-10-22","big1000":82.16,"big400":85.65,"retail":5.02,"holders":81469},"prev":{"date":"2026-10-08","big1000":82.13,"big400":85.59,"retail":5.06,"holders":81588},"d_big1000":0.03,"d_big400":0.06,"d_retail":-0.04,"d_holders":-119},"weekly":{"bars":[{"time":"2026-07-27","open":28.1,"high":29.65,"low":27.9,"close":29.05,"volume":12876.220000000001},{"time":"2026-08-03","open":29.05,"high":31.15,"low":28.5,"close":30.85,"volume":11384.48},{"time":"2026-08-10","open":31.3,"high":31.3,"low":28.25,"close":28.95,"volume":9901.228},{"time":"2026-08-17","open":28.8,"high":31.2,"low":28.6,"close":31.2,"volume":6244.8099999999995},{"time":"2026-08-24","open":31.2,"high":31.7,"low":29.85,"close":29.9,"volume":5094.316000000001},{"time":"2026-08-31","open":29.9,"high":30.75,"low":29.65,"close":29.85,"volume":4766.654},{"time":"2026-09-07","open":30.2,"high":30.2,"low":28.65,"close":29.05,"volume":4364.515},{"time":"2026-09-14","open":28.7,"high":29.55,"low":28.6,"close":29.25,"volume":3875.0150000000003},{"time":"2026-09-21","open":29.25,"high":29.35,"low":28.2,"close":28.25,"volume":2502.062},{"time":"2026-09-29","open":28.25,"high":28.45,"low":27.65,"close":27.9,"volume":4494.654},{"time":"2026-10-05","open":27.75,"high":28.55,"low":27.55,"close":28.45,"volume":21668.78800000