電及建構智慧能源系統三方面著手，強化能源韌性。公司運用固態資源循環燃料、液態木質素與氣態沼氣發展「三態綠電」，逐步降低對燃煤的依賴。2025年三事業群(工紙、林漿紙、消費品)總自發自用電比例達67%，並結合智慧能源系統提升能源使用效率，深化低碳布局。","sentiment":0,"tags":{"topics":[],"bull":[],"bear":[],"score":0,"highlights":[],"keywords":["永豐餘","永豐實","循環經濟","淨零轉型","造紙","永續","CSR"]},"time":"11/24 20:00"},{"id":"2649d489910f2151","source":"經濟日報-證券","category":"台股","title":"11月16日重要財經行事曆","link":"https://money.udn.com/money/story/5607/9880782","published":1794783313,"summary":"台灣 央行赴立院備詢股息紅利繳庫 除權息：台新永續高息中小、台新日本半導體、台新AI優息動能、玉山嚴選非投債、台德宏 法人說明會：亞泥、大宇、華紙、永豐餘、敦吉、王道銀行、健和興、聯陽、三星、新鼎、達興材料、華懋、光聚晶電、茂達、旺矽、漢測、網家、中鼎、好樂迪 新股掛牌：騏億鑫 國際 日本第3季 GDP 13F文件呈交截止日 中國大陸 國家統計局公布10月社會消費品零售及房地產開發投資","sentiment":0,"tags":{"topics":["AI/半導體","總經/聯準會","金融"],"bull":[],"bear":[],"score":0,"highlights":[],"keywords":[]},"time":"11/16 06:55"}],"fund":{"code":"1907","rev_month":"11510","rev":6206468.0,"rev_mom":-6.708710218158293,"rev_yoy":-0.6773943848712,"rev_cum_yoy":4.304583391485981,"eps_q":1.33,"eps_year":"115","eps_season":"3","net_income":2229760.0,"pe":15.27,"pb":0.43,"yield":3.97,"updated":"2026-11-27 02:23"},"tdcc":{"latest":{"date":"2026-11-20","big1000":82.05,"big400":85.75,"retail":4.96,"holders":81080},"prev":{"date":"2026-11-13","big1000":82.05,"big400":85.74,"retail":4.96,"holders":81206},"d_big1000":0.0,"d_big400":0.01,"d_retail":0.0,"d_holders":-126},"weekly":{"bars":[{"time":"2026-07-27","open":28.1,"high":29.65,"low":27.9,"close":29.05,"volume":12876.220000000001},{"time":"2026-08-03","open":29.05,"high":31.15,"low":28.5,"close":30.85,"volume":11384.48},{"time":"2026-08-10","open":31.3,"high":31.3,"low":28.25,"close":28.95,"volume":9901.228},{"time":"2026-08-17","open":28.8,"high":31.2,"low":28.6,"close":31.2,"volume":6244.8099999999995},{"time":"2026-08-24","open":31.2,"high":31.7,"low":29.85,"close":29.9,"volume":5094.316000000001},{"time":"2026-08-31","open":29.9,"high":30.75,"low":29.65,"close":29.85,"volume":4766.654},{"time":"2026-09-07","open":30.2,"high":30.2,"low":28.65,"close":29.05,"volume":4364