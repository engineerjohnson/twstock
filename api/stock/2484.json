4,61.79,60.97,61.13,60.74,60.35,60.11,60.89,61.79,63.32,64.89,65.93,67.3,68.82,70.09,71.32,72.24,72.77,71.39,69.95,66.48,63.5,59.45,55.2,52.87,51.81,51.41,50.53,50.77]},"insti":[{"date":"2026-11-13","foreign":-321.284,"trust":0.0,"dealer":21.652},{"date":"2026-11-12","foreign":172.844,"trust":0.0,"dealer":-35.057},{"date":"2026-11-11","foreign":260.858,"trust":0.0,"dealer":18.678},{"date":"2026-11-10","foreign":-93.716,"trust":0.0,"dealer":42.202},{"date":"2026-11-09","foreign":170.864,"trust":0.0,"dealer":1.832},{"date":"2026-11-06","foreign":635.839,"trust":0.0,"dealer":-23.502},{"date":"2026-11-05","foreign":110.55,"trust":0.0,"dealer":-10.732},{"date":"2026-11-04","foreign":252.641,"trust":0.0,"dealer":-33.056},{"date":"2026-11-03","foreign":1662.373,"trust":0.0,"dealer":-126.792},{"date":"2026-11-02","foreign":49.714,"trust":0.0,"dealer":-0.577},{"date":"2026-10-30","foreign":562.646,"trust":0.0,"dealer":-21.282},{"date":"2026-10-29","foreign":-670.379,"trust":0.0,"dealer":-22.596},{"date":"2026-10-28","foreign":529.973,"trust":0.0,"dealer":-1.073},{"date":"2026-10-22","foreign":-1300.928,"trust":-76.0,"dealer":-65.103},{"date":"2026-10-21","foreign":-2320.112,"trust":-72.0,"dealer":-98.049},{"date":"2026-10-20","foreign":996.296,"trust":-75.0,"dealer":65.398},{"date":"2026-10-19","foreign":-519.215,"trust":-75.0,"dealer":-26.659},{"date":"2026-10-16","foreign":-1834.995,"trust":-9.0,"dealer":-72.01},{"date":"2026-10-15","foreign":-2402.686,"trust":0.0,"dealer":-75.981},{"date":"2026-10-14","foreign":2355.295,"trust":-5.0,"dealer":134.286}],"news":[{"id":"cnyes6661072","source":"鉅亨網","category":"台股","title":"韋僑(6417) 日本米澤設廠先租舊廠！醫療客戶為何要求海外基地，2028 年第 2 季量產？","link":"https://news.cnyes.com/news/id/6661072","published":1794508211,"summary":"2026年11月13日（優分析／產業數據中心報導）⸺ 韋僑(6417-TW) 將在日本米澤設立第二個生產基地，2027 年動工，2028 年第 2 季、也就是 4 月開始量產，主要產品是智慧標籤（smart label），卡片與射出成型仍留在台灣。 這座廠的設立源於客戶要求。公司表示，醫療客戶洽談後續訂單時，開始要求韋僑在台灣以外設立生產基地，「他們希望韋僑不是只有台灣這樣的一個生產基地」。醫療產品進入供應鏈要通過認證，更換供應商的成本高，客戶對斷料的容忍度也低，設廠因此有助降低客戶對供應中斷的疑慮，也是取得更大份額的前提。 韋僑將承租母公司希華（2484-TW）在米澤的既有廠房，進行改建。公司指出，日本產線對作業規範的要求較高，將自動化程度較高的醫療產品線設於當地，較能讓客戶放心。 產能與投資 台中新廠當初設計的年產能是 30 億元。公司指出，醫療客戶提供的預測期間比消費性電子長，較能掌握客戶計畫，「我們現在大概就已經是 20 億的生意了」。公司目前的營業額規模是 18 億元至 20 億元，公司認為下一階段將達到這座廠當初設計的 30 億元。 這座廠的投資分多年投入。資本支出在 2022 年 3.82 億元、2023 年 3.61 億元，之後逐年下降，2025 年降至 4,466 萬元；日本廠 2027 年動工，設備將隨營業額成長逐步導入。","sentiment":1,"tags":{"topics":["訂單/接單","擴產/資本支出"],"bull":["訂單"],"bear":[],"score":2,"highlights":[],"keywords":["RFID","優分析"]},"time":"11/13 02:30"},{"id":"cnyes6660676","source":"鉅亨網","category":"台股","title":"〈韋僑展望〉備妥明年營運雙位數成長需求 並啟動對日本投資億元方案","link":"https://news.cnyes.com/news/id/6660676","published":1794478109,"summary":"RFID解決方案業者韋僑 (6417-TW) 在2026年1-3前三季獲利創新高並賺回超過半個股本，稅後純益2.4億元已超越2025年全年，每股純益達5.68元。韋僑總經理江鴻佑今(12)日指出，對韋僑的成長動能來自各項新專案的開發及原有專案量能的放大，預估2027年還有雙位數業績成長。 同時，對於擴充產能因應2027市場需求成長的設備購置，韋僑在今年年底已全數備妥。 同時，對於韋僑海外市場開發鎖定在日本市場，江鴻佑指出，預韋僑計將進一步在大股東希華 (2484-TW) 的全力協助開拓日本市場，在日本八澤設立生產線以在地法人型態搶攻境內醫、藥品界對 RFID 解決方案需求，並將在2027年啟動，在2028年第二季正式投產，預估在投產後的一整個年度可明顯增進營收。 江鴻佑指出，韋僑在2026年全年資本支出約6000萬元，2027年將再增加1億元，規劃擴增到1.6億元，主要 在日本米澤租用希華原有廠房一座進行遷入設備並營運，主要生產智慧標籤爲主，以在地法人的地位利於切入日本醫療的物流市場；同時，這也是因應全球醫療產業客戶對供應鏈要求在兩岸之外另設立供應據點的需求。 韋僑遷入台中市大里新廠的設計量能達30億元的營收，對對於擴充產能因應2027市場需求成長的設備購置，韋僑在今年年底已全數備妥，且醫療應用需求回升挹注，韋僑營收已連續4個季度改寫新高。","sentiment":1,"tags":{"topics":["EPS/獲利","營收","擴產/資本支出","法說/展望"],"bull":["創新高","新高","獲利","成長"],"bear":[],"score":5,"highlights":[],"keywords":["希華","韋僑","日本","RFID"]},"time":"11/12 18:08"},{"id":"cnyes6643635","source":"鉅亨網","category":"台股","title":"〈焦點股〉韋僑業績連4季創新高 量能激增重返百元價位區","link":"https://news.cnyes.com/news/id/6643635","published":1793584695,"summary":"RFID 解決方案供應商韋僑 (6417-TW) 及永道-KY(6863-TW)在新產能及市場需求強勁之下，2026年第三季營收同步改寫歷史新高，其中，韋僑第三季營收5.1億元，年增25.85%，爲韋僑連續4個季度營收創新紀錄，韋僑今(2)日盤中量能充沛股價重返100元價位，漲幅3.95%。 韋僑遷入台中大里新廠的綜效正在高度發揮，且醫療應用需求回升挹注，單季營收已在 2025 年第四季起連續3季創新高，韋僑2026年9月營收1.72億元改寫歷史次高，月增0.67%，年增18.26%，第三季營收5.1億元連4創新高，年增25.85%。 韋僑2026年前三季營收14.44億元，年增22.08%，再創同期新高，全年營收將改寫新高。第四季營運也有再向上突破的契機，法人估韋僑2026年下半年的單月平均營收將在1.7億元之上。韋僑 2026 年上半年營收 9.34 億元，毛利率 34.65%，年增 2.85 個百分點，稅後純益 1.53 億元，年增 89.13%，每股純益 3.62 元。 在韋僑推出於 Ambient IoT 的 BLE TAG 新產品，預計在下半年出貨將呈現倍數成長同時，下半年估單月業績也平均達 1.7 億元。同時以韋僑的訂單及出貨而言，2026 年第三季可望續創新高。全年營收將突破 2025 年營收歷史新高的 16.07 億元水準。","sentiment":1,"tags":{"topics":["訂單/接單","EPS/獲利","營收","擴產/資本支出","總經/聯準會"],"bull":["創新高","新高","需求強勁","營收創","回升","年增"],"bear":[],"score":9,"highlights":["年增25.85%","年增18.26%","年增22.08%"],"keywords":["希華","韋僑","RFID"]},"time":"11/02 09:58"}],"fund":{"code":"2484","rev_month":"11510","rev":271407.0,"rev_mom":9.373476205636175,"rev_yoy":37.0777039824238,"rev_cum_yoy":7.236586494438576,"eps_q":1.37,"eps_year":"115","eps_season":"3","net_income":219097.0,"pe":35.0,"pb":2.34,"yield":1.14,"updated":"2026-11-13 17:58"},"tdcc":{"latest":{"date":"2026-11-06","big1000":16.19,"big400":26.53,"retail":46.31,"holders":87205},"prev":{"date":"2026-10-30","big1000":18.52,"big400":27.75,"retail":45.18,"holders":86793},"d_big1000":-2.33,"d_big400":-1.22,"d_retail":1.13,"d_holders":412},"weekly":{"bars":[{"time":"2026-07-27","open":71.2,"high":76.0,"low":56.7,"close":61.1,"volume":122080.73000000001},{"time":"2026-08-03","open":61.2,"high":74.5,"low":60.7,"close":71.7,"volume":121561.86400000002},{"time":"2026-08-10","open":75.8,"high":80.7,"low":71.8,"close":72.8,"volume":95277.815},{"time":"2026-08-17","open":74.2,"high":78.2,"low":68.6,"close":76.5,"volume":71648.942},{"time":"2026-08-24","open":75.0,"high":81.0,"low":70.1,"close":76.1,"volume":100825.81699999998},{"time":"2026-08-31","open":75.5,"high":79.2,"low":69.3,"close":70.4,"volume":42964.098},{"time":"2026-09-07","open":71.6,"high":73.1,"low":66.2,"close":66.7,"volume":26717.291},{"time":"2026-09-14","open":65.4,"high":73.7,"low":64.7,"close":70.4,"volume":28020.489},{"time":"2026-09-21","open":71.0,"high":75.0,"low":68.6,"close":72.8,"volume":37189.785},{"time":"2026-09-29","open":75.0,"high":89.0,"low":74.2,"close":86.5,"volume":140327.825},{"time":"2026-10-05","open":87.5,"high":94.8,"low":80.0,"close":90.6,"volume":118205