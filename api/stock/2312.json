碩則於開盤觸及漲停，不過未鎖住。另外，緯穎(6669-TW)、金寶(2312-TW)也都雙雙亮燈漲停。 截至午盤，緯創成交量超過7000張，排隊委買單約7000張；仁寶成交量超過1.7萬張，排隊委買單約4000張；廣達成交量超過2.2萬張，排隊委買單約3000張；英業達成交量超過2.4萬張，和碩成交量則超過1萬張。 電子五哥持續看好AI伺服器展望，廣達預期明年AI伺服器營收年增雙位數；緯創第四季AI伺服器業務持續向上，將在11、12月迎高峰；英業達預估明年GPU及ASIC營收與出貨皆高位數年增；和碩預期明年伺服器業務倍數成長；仁寶預期今年全年伺服器營收占比將上看1成，且動能將延續至明年。","sentiment":1,"tags":{"topics":["營收","法說/展望","AI/半導體"],"bull":["漲停","回神"],"bear":[],"score":4,"highlights":[],"keywords":["輝達","黃仁勳","AI伺服器","廣達","緯創","英業達","仁寶","和碩"]},"time":"11/24 12:50"},{"id":"fef0089275cbc822","source":"富聯網","category":"台股","title":"《外資買超41-6》泰金寶(3103)、騰輝電(2978)、美國增(2942)","link":"https://news.google.com/rss/articles/CBMiiAFBVV95cUxNZ3ZZR0hGbVVUTlBBREF4ZmwwZ2E2T2VHenhMUmJneHNBTkVsR3R4M25UNWRfSUpLaU5sQ2NaWGlMQzV4UnRLUHhqUkJoZFFZY2gwYTNaWlluNGpKVHRueXp4cHJnNnFaSXdPc3ZKVHZDWkxvcTZ2d3ZHUU94eEV3Wm96N1R5ODM5?oc=5","published":1795390320,"summary":"《外資買超41-6》泰金寶(3103)、騰輝電(2978)、美國增(2942) 富聯網","sentiment":1,"tags":{"topics":["法人動向"],"bull":["買超"],"bear":[],"score":2,"highlights":[],"keywords":[]},"time":"11/23 07:32"}],"fund":{"code":"2312","rev_month":"11510","rev":16937909.0,"rev_mom":-23.643489184009226,"rev_yoy":8.282588516281473,"rev_cum_yoy":5.492900231358412,"eps_q":1.0,"eps_year":"115","eps_season":"3","net_income":2139470.0,"pe":17.71,"pb":1.28,"yield":2.82,"updated":"2026-11-27 02:23"},"tdcc":{"latest":{"date":"2026-11-20","big1000":42.52,"big400":47.31,"retail":24.06,"holders":198457},"prev":{"date":"2026-11-13","big1000":42.86,"big400":47.69,"retail":24.01,"holders":198475},"d_big1000":-0.34,"d_big400":-0.38,"d_retail":0.05,"d_holders":-18},"weekly":{"bars":[{"time":"2026-07-27","open":31.85,"high":32.0,"low":27.3,"close":30.0,"volume":90144.978},{"time":"2026-08-03","open":29.75,"high":33.6,"low":29.35,"close":31.3,"volume":71125.41200000001},{"time":"2026-08-10","open":32.0,"high":34.5,"low":31.8,"close":33.75,"volume":91778.509},{"time":"2026-08-17","open":33.4,"high":33.4,"low":30.85,"close":31.05,"volume":57690.768000000004},{"time":"2026-08