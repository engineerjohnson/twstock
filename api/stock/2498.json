FZwbFc1V0NpM056U0kzNGtKUGVRMndjYzc3emdqb1phZDFIVDc3cnBob1hLN01KcF8ySzlkbzJQbXZBa1FSNFViY3M2amJEeUtxLXlUdmlMTmx1ZXVPSUpCQzl5cHFHYmE5?oc=5","published":1793230320,"summary":"《外資買超30-14》宏達電(610)、晶技(606)、大成鋼(605) 富聯網","sentiment":1,"tags":{"topics":["法人動向"],"bull":["買超"],"bear":[],"score":2,"highlights":[],"keywords":[]},"time":"10/29 07:32"},{"id":"b95bb5af594f80c9","source":"富聯網","category":"台股","title":"《外資買超29-25》吉祥全(143)、凌華(142)、宏達電(141)","link":"https://news.google.com/rss/articles/CBMiiAFBVV95cUxNUUhaenpXY3hmOU9NWTM0cW9WSGg2SUgwR0xIdzBmWks4cUFHenNhUHB6M1RLVGswNzhBTDFnNmQ2SnBBdC1tckgtdjdlWGY4Y2hscXRRWEFMb2hZbWVSQzBGZHFXN3QxWFlYS0RnZ2d2Z2tQamN5QzE4c0xReDRvU2NkQXJ0QnRS?oc=5","published":1793143920,"summary":"《外資買超29-25》吉祥全(143)、凌華(142)、宏達電(141) 富聯網","sentiment":1,"tags":{"topics":["法人動向"],"bull":["買超"],"bear":[],"score":2,"highlights":[],"keywords":[]},"time":"10/28 07:32"},{"id":"cnyes6638230","source":"鉅亨網","category":"台股","title":"宏達電正式揭曉VIVEE擴大個人AI產品布局 AI帶進穿搭、陪伴與互動打造新世代日常","link":"https://news.cnyes.com/news/id/6638230","published":1793074751,"summary":"VR軟硬體整合商宏達電(2498-TW)今（27）日正式揭曉全新個人AI產品 VIVEE。VIVEE創新結合AI對話、長期記憶、個性養成與實體互動，將AI體驗延伸至可隨身攜帶、持續互動的個人陪伴裝置。隨著日常對話與共同經歷的累積，VIVEE能逐步形塑出獨特的個性回應方式，拓展個人AI產品在日常陪伴與個人化互動上的新應用。 VIVEE全球市場布局同步展開，目前已於美國開放預購，後續亦規劃拓展至台灣、日本及歐洲等市場；台灣及日本市場亦預計於今年底前陸續上市，各地區相關銷售資訊將於後續公布。 VIVEE採小巧圓潤設計，大小約如雞蛋，可放置於桌面，也能掛在包包上隨身攜帶。透過生動的螢幕表情、語音對話，以及觸碰、搖晃與轉動等實體互動，VIVEE自然加入不同生活片刻，成為能陪伴聊天、互動，也能展現個人風格的日常AI玩伴。 HTC董事長暨執行長王雪紅表示：「VIVEE 的誕生結合了想像力、科技與一點科幻色彩，也代表我們對個人AI產品更多可能性的探索。我們看到消費者愈來愈重視科技是否能展現個人風格、回應生活情境，甚至成為人與人之間新的互動媒介。我們希望透過VIVEE，讓AI 以更自然、富有表現力的方式融入生活，為日常科技帶來兼具獨特個性與新鮮感的互動體驗。」 VIVEE的角色故事從一群由純粹能量構成、對人類生活充滿好奇的小生命開始，因為想了解『成為人類是什麼感覺』而來到地球。","sentiment":1,"tags":{"topics":["AI/半導體"],"bull":["擴大","布局"],"bear":[],"score":2,"highlights":[],"keywords":["宏達電","VR","AI"]},"time":"10/27 12:19"},{"id":"6a16733bb5de6648","source":"經濟日報-證券","category":"台股","title":"宏達電 AI 夥伴搶商機 掌上型互動數位精靈 VIVEE 美國首發","link":"https://money.udn.com/money/story/5710/9838080","published":1793029485,"summary":"宏達電（2498）AI布局進擊，在官網宣布推出首款個人AI產品VIVEE，定價119美元（約新台幣3,800元），首發海外市場為美國，即日起開放預購，早鳥價99.99美元（約新台幣3,200元），預計12月初開始出貨，助攻營運。","sentiment":1,"tags":{"topics":["AI/半導體","匯率"],"bull":["出貨","布局"],"bear":[],"score":2,"highlights":[],"keywords":[]},"time":"10/26 23:44"}],"fund":{"code":"2498","rev_month":"11509","rev":338824.0,"rev_mom":37.68128309216434,"rev_yoy":12.095757667991121,"rev_cum_yoy":-4.210039651931056,"eps_q":-0.62,"eps_year":"115","eps_season":"2","net_income":-521137.0,"pe":15.39,"pb":1.27,"yield":1.25,"updated":"2026-10-30 16:33"},"tdcc":{"latest":{"date":"2026-10-22","big1000":33.69,"big400":39.23,"retail":26.7,"holders":164414},"prev":{"date":"2026-10-08","big1000":33.27,"big400":38.82,"retail":26.78,"holders":164979},"d_big1000":0.42,"d_big400":0.41,"d_retail":-0.08,"d_holders":-565},"weekly":{"bars":[{"time":"2026-07-27","open":42.2,"high":42.3,"low":37.7,"close":39.95,"volume":25943.718},{"time":"2026-08-03","open":39.95,"high":41.0,"low":39.65,"close":39.9,"volume":19069.337},{"time":"2026-08-10","open":40.2,"high":41.4,"low":40.0,"close":40.5,"volume":15738.776000000002},{"time":"2026-08-17","open":40.75,"high":42.5,"low":38.85,"close":40.95,"volume":23101.652000000002},{"time":"2026-08-24","open":41.15,"high":41.35,"low":40.0,"close":40.55,"volume":11465.130000000001},{"time":"2026-08-31","open":40.65,"high":43.3,"low":40.15,"close":41.6,"volume":35776.416},{"time":"2026-09-07","open":41.7,"high":41.9,"low":39.8,"close":39.95,"volume":13965.167000000001},{"time":"2026-09-14","open":39.9,"high":40.5,"low":39.2,"close":39.55,"volume":22517.915999999997},{"time":"2026-09-21","open":40.0,"high":44.0,"low":39.65,"close":41.8,"volume":39964.47},{"time":"2026-09-29","open":41.8,"high":46.85,"low":41.75,"close":42.9,"volume":53112.136000000006},{"time":"2026-10-05","open":42.9,"high":43.2,"low":41.8,"close":42.0,"volume":17550.310999999998},{"time":"2026-10-12","open":41.6,"high":42.15,"low":39.8,"close":40.3,"volume":19491.584},{"time":"2026-10-19","open":