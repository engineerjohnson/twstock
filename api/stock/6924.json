收","金融"],"bull":[],"bear":[],"score":0,"highlights":[],"keywords":["德宏","穎漢","榮惠-KY"]},"time":"11/27 15:32"},{"id":"6c2c06ca1cad0f2b","source":"經濟日報-證券","category":"台股","title":"11月19日重要財經行事曆","link":"https://money.udn.com/money/story/5607/9887917","published":1795042669,"summary":"台灣 行政院會 除權息：兆豐國泰R2、榮惠-KY創 法人說明會：江申、長興、長榮鋼、廣宇、偉詮電、鉅祥、瓦城、玉晶光、矽瑪、世禾、達航科技、鈺創、GIS-KY、資拓宏宇、威力德生醫、萊德光電-KY、光速火箭 國際 美國上周初領失業金人數 Anthropic掛牌上市 財報：沃爾瑪 中國大陸 APEC、川習三會、中美俄三方會談 Swift公布10月人民幣在全球支付占比","sentiment":0,"tags":{"topics":["法說/展望","關稅/地緣"],"bull":[],"bear":[],"score":0,"highlights":[],"keywords":[]},"time":"11/19 06:57"}],"fund":{"code":"6924","rev_month":"11510","rev":304352.0,"rev_mom":4.1366992629900565,"rev_yoy":116.36039212619696,"rev_cum_yoy":42.9195289917889,"eps_q":8.93,"eps_year":"115","eps_season":"3","net_income":184181.0,"pe":10.53,"pb":4.26,"yield":4.17,"updated":"2026-11-27 02:23"},"tdcc":{"latest":{"date":"2026-11-20","big1000":73.08,"big400":82.21,"retail":4.39,"holders":626},"prev":{"date":"2026-11-13","big1000":73.08,"big400":82.21,"retail":3.8,"holders":599},"d_big1000":0.0,"d_big400":0.0,"d_retail":0.59,"d_holders":27},"weekly":{"bars":[{"time":"2026-07-27","open":103.5,"high":104.0,"low":90.8,"close":103.0,"volume":185.922},{"time":"2026-08-03","open":103.0,"high":114.0,"low":99.8,"close":110.0,"volume":242.26100000000002},{"time":"2026-08-10","open":109.0,"high":119.5,"low":108.5,"close":115.5,"volume":203.37899999999996},{"time":"2026-08-17","open":113.0,"high":121.5,"low":109.5,"close":117.0,"volume":177.34},{"time":"2026-08-24","open":114.0,"high":121.5,"low":108.0,"close":117.5,"volume":191.21999999999997},{"time":"2026-08-31","open":115.5,"high":123.0,"low":111.0,"close":123.0,"volume":133.512},{"time":"2026-09-07","open":123.5,"high":141.5,"low":119.0,"close":141.5,"volume":390.19199999999995},{"time":"2026-09-14","open":142.0,"high":144.0,"low":128.0,"close":134.5,"volume":322.445},{"time":"2026-09-21","open":135.5,"high":139.0,"low":130.0,"close":134.0,"volume":86.