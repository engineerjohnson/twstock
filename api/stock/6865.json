ar":["跌停","重挫","下滑","賣壓","拋售","提款"],"score":-12,"highlights":[],"keywords":[]},"time":"11/06 08:37"},{"id":"cnyes6643711","source":"鉅亨網","category":"台股","title":"〈焦點股〉資安議題熱！資服業多頭氣勢高漲 多檔漲逾半根停板","link":"https://news.cnyes.com/news/id/6643711","published":1793590807,"summary":"AI快速發展引發近期多個大型資安事件，使多家具備資安題材的資訊軟體服務商今(2)日股價再度大漲，東捷資訊(6697-TW)、偉康科技(6865-TW)、普鴻(6590-TW)漲停，智聯服務(6751-TW)也一度漲停，華電網(6163-TW)、驊宏資(6148-TW)漲超過半根停板，奧義賽博-KY創(7823-TW)也漲逾4%。 普鴻指出，量子電腦密碼造成破解資安威脅，隨著AI飛速發展、攻克多種多年數學難題越發緊迫，金融與政府單位已紛紛將後量子密碼(PQC)解決方案的盤點與提升排上日程表。 而普鴻自主研發的13項PQC演算法程式，成功通過美國國家標準暨技術研究院(NIST)認證。 偉康科技則是目標，隨著客戶群逐步擴張至高科技製造業，透過自研產品邁向國際市場。 法人分析，國內市場多數軟硬體品牌仍以外商原廠為主，若本土廠商要在台灣市場與國際原廠競爭，須先具備資格與認證。 而偉康積極取得國際認證與聯盟證照，也強調產品要走向雲端 SaaS 化平台，並著個資保護，擴張規模化與訂閱收入成長。","sentiment":1,"tags":{"topics":["AI/半導體"],"bull":["漲停","大漲","題材"],"bear":[],"score":6,"highlights":[],"keywords":["資安","偉康","普鴻","資訊服務","資訊軟體"]},"time":"11/02 11:40"}],"fund":{"code":"6865","rev_month":"11509","rev":32825.0,"rev_mom":142.57315991723323,"rev_yoy":-14.73361560641089,"rev_cum_yoy":-45.8944587991894,"eps_q":null,"eps_year":null,"eps_season":null,"net_income":null,"pe":null,"pb":1.65,"yield":3.86,"updated":"2026-11-06 17:49"},"tdcc":{"latest":{"date":"2026-10-30","big1000":36.45,"big400":50.87,"retail":12.22,"holders":1361},"prev":{"date":"2026-10-22","big1000":36.45,"big400":50.87,"retail":12.25,"holders":1363},"d_big1000":0.0,"d_big400":0.0,"d_retail":-0.03,"d_holders":-2},"weekly":{"bars":[{"time":"2026-07-27","open":25.05,"high":25.4,"low":23.85,"close":25.05,"volume":33.202999999999996},{"time":"2026-08-03","open":24.9,"high":25.35,"low":24.45,"close":24.7,"volume":68.41599999999998},{"time":"2026-08-10","open":24.7,"high":27.6,"low":24.7,"close":26.95,"volume":65.976},{"time":"2026-08-20","open":24.6,"high":26.6,"low":24.3,"close":25.5,"volume":41.423},{"time":"2026-08-24","open":24.85,"high":26.0,"low":24.6,"close":26.0,"volume":46.733},{"time":"2026-08-31","open":25.0,"high":26.7,"low":24.5,"close":25.55,"volume":52.161},{"time":"2026-09