":-39.196,"trust":0.0,"dealer":-4.831},{"date":"2026-11-05","foreign":-32.347,"trust":0.0,"dealer":-7.329},{"date":"2026-11-04","foreign":-2.0,"trust":0.0,"dealer":-7.064},{"date":"2026-11-03","foreign":-24.149,"trust":0.0,"dealer":-15.153},{"date":"2026-11-02","foreign":-34.381,"trust":0.0,"dealer":-4.122},{"date":"2026-10-30","foreign":-20.0,"trust":0.0,"dealer":-8.142},{"date":"2026-10-29","foreign":8.649,"trust":0.0,"dealer":-1.1},{"date":"2026-10-28","foreign":-5.279,"trust":0.0,"dealer":4.084},{"date":"2026-10-27","foreign":20.086,"trust":0.0,"dealer":-4.138},{"date":"2026-10-22","foreign":-15.0,"trust":0.0,"dealer":-4.139}],"news":[{"id":"4f059eba674d84e1","source":"經濟日報-證券","category":"台股","title":"中工攜手信紘科拿下台塑大樓都更案","link":"https://money.udn.com/money/story/5607/9892107","published":1795189493,"summary":"中工（2515）昨（20）日宣布攜手信紘科，取得「台塑大樓都更案」建築與機電案。信紘科承攬約49億元全案機電工程，從半導體擴大布局大型商辦、住宅及都市更新市場，中工累積大型複合式建築工程實績，預計2029年完工。","sentiment":1,"tags":{"topics":["AI/半導體"],"bull":["擴大","布局"],"bear":[],"score":2,"highlights":[],"keywords":[]},"time":"11/20 23:44"},{"id":"cnyes6669132","source":"鉅亨網","category":"台股","title":"信紘科攜手中工搶攻台塑大樓都更 統包訂單營收占比已達50%","link":"https://news.cnyes.com/news/id/6669132","published":1795164604,"summary":"信紘科(6667-TW)今20日在台北宣布，與營造廠中工(2515-TW)攜手合作，共同投入總工程造價約新台幣220億元的台塑大樓都市更新新建工程，其中信紘科承攬全案機電統包工程，合約金額約49億元，預計2029年完工。受惠於近年積極轉型總承包商並拓展跨產業應用，信紘科目前在手統包形態案件占整體營收比重已達50%。 信紘科共同執行長林欣德指出，公司自2021年至2022年間便開始布局機電領域，目前已建立近百人的專業團隊，涵蓋設計規劃、現場監造與建築資訊模型等職能。面對外界關注高科技廠務與商辦都更的毛利率及人力配置差異。 林欣德他表示機電團隊與原本的半導體團隊各自獨立運作且可跨區調度，公司看重的是透過擴大承攬規模帶來整體營收與每股純益的實質成長。 信紘科過去在晶圓代工龍頭廠區的氣體與化學等高門檻二次配項目擁有八至九成市占率，如今正將高科技廠房的高效率管理經驗延伸至民間建築及半導體上下游供應鏈。 林欣德說明，隨著半導體大廠持續擴產，周邊化學品與原物料供應商普遍採取統包模式發包建廠，信紘科憑藉熟悉精密製程與無塵室整合的優勢，已順利切入美系記憶體廠的二次配統包與辦公室機電工程，未來海外如新加坡等據點也將以統包模式接單。","sentiment":1,"tags":{"topics":["訂單/接單","EPS/獲利","營收","擴產/資本支出","AI/半導體","總經/聯準會","匯率"],"bull":["訂單","合作","受惠","布局"],"bear":[],"score":6,"highlights":[],"keywords":["中工","信紘科","廠務"]},"time":"11/20 16:50"},{"id":"cnyes6669013","source":"鉅亨網","category":"台股","title":"中工進軍科技廠辦 搶攻高科技建廠商機並結盟信紘科發揮綜效","link":"https://news.cnyes.com/news/id/6669013","published":1795159942,"summary":"中華工程(2515-TW)今(20)日與信紘科技(6667-TW)攜手合作，共同投入台北市重大都市更新指標工程「台塑大樓都市更新新建工程」，全案由台塑建設擔任實施者，整體工程造價約220億元，此次合作結合中工大型營造統籌能力與信紘科高科技廠務及機電工程整合經驗，集結專業工程團隊共同執行大型複合式建築工程，也為雙方跨領域合作開啟新的篇章。 信紘科此次承攬「台塑大樓都市更新新建工程」案約49億元的機電工程。 中工並指出，未來，中工與信紘科將以此次合作為重要基礎， 建立台塑建設、中工與信紘科三方合作基礎，持續拓展後續大型營建及相關工程合作機會，開創更廣泛的工程合作空間。 台北市都更重大工程的「台塑大樓都市更新新建工程」，基地位於台北市松山區敦化北路，面積約6,328坪，規劃興建兩棟地上22層辦公大樓及一棟地上22層住宅大樓，預計2029年完工。全案由中工承攬興建，主要負責主體營造工程，信紘科則負責全案機電工程。 台塑大樓於1976年落成，長年作為台塑企業總部及敦化北路重要企業地標，隨台塑集團總部於2023年遷往內湖，原址正式啟動都市更新計畫。 「台塑大樓都市更新新建工程」案基地涵蓋松山區民生段6筆土地，座落於敦北金融商圈與民生住宅生活圈交會地帶，也是敦化南北路都市綠廊的重要節點，屬台北市中心少見的大規模完整街廓都市更新案。","sentiment":0,"tags":{"topics":["擴產/資本支出"],"bull":["合作"],"bear":[],"score":1,"highlights":[],"keywords":["中工","信紘科","台塑大樓","都更"]},"time":"11/20 15:32"},{"id":"cnyes6666836","source":"鉅亨網","category":"台股","title":"營收速報 - 2026年11月19日台股中小型公司10月營收一覽（新增56家）","link":"https://news.cnyes.com/news/id/6666836","published":1795046139,"summary":"本次公布10月營收一覽 截至台北時間2026年11月19日07:55，彙整前一日公布10月營收的中小型公司(資本額 本次公布營收年增率前3名成長排行 公司名稱 月營收 YoY 青雲 -電腦及週邊設備業 24.76億 201.8% 信紘科 -其他電子業 12.96億 172.8% 勝悅-KY -塑膠工業 861萬 137.5% 本次公布營收月增率前3名成長排行 公司名稱 月營收 MoM 寬魚國際 -文化創意業 8,483萬 334.3% 眾智 -半導體業 3,173萬 140.3% 拉法醫 -生技醫療業 1,998萬 93.7% 10月已公布營收一覽 截至目前，已公布10月營收報告（資本額 10月營收年增分布表現 資本額規模 YoY 表現 家數 介於10～50億 >= +25% 291家 介於10～50億 >= 0% 259家 介於10～50億 125家 介於10～50億 190家 資本額規模 YoY 表現 家數 小於10億 >= +25% 515家 小於10億 >= 0% 373家 小於10億 237家 小於10億 190家 10月營收年增率前5名成長排行 公司名稱 月營收 YoY 欣巴巴 -建材營造業 3.33億 2381850.0% 聯上 -建材營造業 7.22億 1362458.5% 國揚 -建材營造業 5.77億 110081.1% 富旺 -建材營造業 2.82億 1091","sentiment":1,"tags":{"topics":["營收","AI/半導體","生技"],"bull":["成長","年增"],"bear":[],"score":2,"highlights":[],"keywords":["台股","營收速報","台股營收","10月營收","建材營造業","欣巴巴","電腦及週邊設備業","青雲"]},"time":"11/19 07:55"},{"id":"a9391a049fac7140","source":"鏡報","category":"台股","title":"半導體建廠潮停不下來！信紘科在手訂單破230億 前三季EPS超越去年全年","link":"https://news.google.com/rss/articles/CBMiUkFVX3lxT