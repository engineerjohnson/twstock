:"2026-11-09","foreign":-1019.934,"trust":0.0,"dealer":-96.789},{"date":"2026-11-06","foreign":-642.44,"trust":0.0,"dealer":-128.981},{"date":"2026-11-05","foreign":-2727.942,"trust":1.0,"dealer":50.132},{"date":"2026-11-04","foreign":-979.539,"trust":12.0,"dealer":-325.018},{"date":"2026-11-03","foreign":-3986.504,"trust":0.0,"dealer":-61.216},{"date":"2026-11-02","foreign":-962.178,"trust":1.0,"dealer":39.296}],"news":[{"id":"a709b3bd4ec6f0ef","source":"Yahoo股市-台股","category":"台股","title":"中環10/2~11/26取得台積電140張，計約3.34億元","link":"https://tw.stock.yahoo.com/news/%E4%B8%AD%E7%92%B010-2-11-26%E5%8F%96%E5%BE%97%E5%8F%B0%E7%A9%8D%E9%9B%BB140%E5%BC%B5-%E8%A8%88%E7%B4%843-011000143.html","published":1795741800,"summary":"公開資訊觀測站重大訊息公告(2323)中環-公告本公司取得有價證券1.證券名稱:台積電 普通股2.交易日期:115/10/2~115/11/263.董事會通過日期: 不適用4.其他核決日期:核決層級:","sentiment":0,"tags":{"topics":["AI/半導體","金融"],"bull":[],"bear":[],"score":0,"highlights":[],"keywords":[]},"time":"11/27 09:10"},{"id":"1aefdf461b0d6884","source":"經濟日報-證券","category":"台股","title":"中環躋身資安概念股","link":"https://money.udn.com/money/story/5710/9897011","published":1795454059,"summary":"近期資安攻擊事件頻傳，「儲存安全」成為重要議題，伴隨AI應用快速普及，離線儲存需求升溫，日本富士軟片傳出投入百億日圓擴大磁帶產能至原有的五倍，光碟片產業亦受惠，中環（2323）看好，資安需求升溫將帶動高階光碟需求，有望為營運帶來正面效益。","sentiment":1,"tags":{"topics":["擴產/資本支出","AI/半導體","匯率"],"bull":["看好","擴大","受惠"],"bear":[],"score":4,"highlights":[],"keywords":[]},"time":"11/24 01:14"},{"id":"cnyes6670115","source":"鉅亨網","category":"台股","title":"資安需求帶旺離線存儲商機爆發 中環看好正面效益","link":"https://news.cnyes.com/news/id/6670115","published":1795411380,"summary":"近期資安攻擊事件頻傳，加上AI應用快速普及，離線儲存需求升溫，日本富士軟片傳出投入百億日圓擴大磁帶產能至原有的5倍；光碟片廠中環(2323-TW)也看好，資安需求升溫將帶動高階光碟需求，可望帶來正面助益。 企業資料儲存方式包括雲端、磁帶及光碟等，相較於連網儲存設備，光碟屬於離線儲存媒介，不會直接暴露於網路攻擊風險，也能降低資料遭人為誤刪的可能性，因此企業可透過光碟建立額外備份機制。 中環在目前光學媒體市佔逾 6 成，尤其在 SONY 退出光碟市場後，中環現在是全球唯一能供應全品項、高品質利基光碟的製造商，目前廣泛應用於國防、醫療、銀行等利基型領域。 中環指出，隨著AI應用快速普及，資料量持續攀升，主權AI所涉及的數據安全與保密性也日益重要，各國及企業發展主權AI，帶動資料庫規模擴大，進一步推升資料儲存需求，如何兼顧資料安全及長期保存成為企業重要課題。 中環認為，AI時代不僅需要更高速的資料儲存，也更加重視資料安全與長期保存能力，隨著企業資安意識提升，離線備份及高階光碟的應用價值可望逐步受到重視，為光碟儲存市場帶來新的成長機會。 富士軟片指出，隨著生成式AI及雲端服務快速發展，全球資料量大幅增加，磁帶具備大容量、低成本及可實體隔離網路等優勢，近年在大型雲端服務商及資料中心的應用持續擴大，也成為重要備份媒介。","sentiment":1,"tags":{"topics":["擴產/資本支出","AI/半導體","匯率","金融"],"bull":["看好","擴大"],"bear":[],"score":2,"highlights":[],"keywords":["AI","資安","冷儲存","中環"]},"time":"11/23 13:23"},{"id":"18350196edfe8c0d","source":"CMoney投資網誌","category":"台股","title":"【09:56 即時新聞】中環(2323) 盤中續揚，主力與法人同步加溫","link":"https://news.google.com/rss/articles/CBMijgFBVV95cUxPa0Q4RDdLeG9UcnJnbWV6emxKdGhHanRRVk9pX2s1UlcwemVZSXFFLTZsS1VSUGF6XzdxcjhjUnRFN0MtdUdGdGZIWHROaDVNOVU4TWtMajk0cFZCa1lEUWt2QXNBdkE3UXZENkstOXBMMmkwRWtLeEhSNy1XRDB0RWxVRW1ydzlQS2ZURUVn?oc=5","published":1794880620,"summary":"【09:56 即時新聞】中環(2323) 盤中續揚，主力與法人同步加溫 CMoney投資網誌","sentiment":0,"tags":{"topics":["法人動向"],"bull":[],"bear":[],"score":0,"highlights":[],"keywords":[]},"time":"11/17 09:57"}],"fund":{"code":"2323","rev_month":"11510","rev":842701.0,"rev_mom":-2.051488287919698,"rev_yoy":32.391288295945316,"rev_cum_yoy":18.81275036193743,"eps_q":2.17,"eps_year":"115","eps_season":"3","net_income":2338841.0,"pe":2.95,"pb":0.53,"yield":1.83,"updated":"2026-11-27 02:23"},"tdcc":{"latest":{"date":"2026-11-20","big1000":39.93,"big400":47.04,"retail":18.17,"holders":105623},"prev":{"date":"2026-11-13","big1000":39.27,"big400":46.32,"retail":18.22,"holders":105153},"d_big1000":0.66,"d_big400":0.72,"d_retail":-0.05,"d_holders":470},"weekly":{"bars":[{"time":"2026-07-27","open":10.4,"high":10.4,"low":9.26,"close":9.94,"volume":36385.006},{"time":"2026-08-03","open":9.97,"high":10.5,"low":9.72,"close":10.25,"volume":21946.227000000003},{"time":"2026-08-10","open":10.35,"high":11.3,"low":10.1,"close":11.3,"volume":34466.038},{"time":"2026-08-17","open":10.95,"high":11.95,"low":10.6,"close":10.85,"volume":71868.74599999998},{"time":"2026-08-24","open":10.95,"high":11.1,"low":10.55,"close":10.9,"volume":21753.283},{"time":"2026-08-31","open":10.95,"high":11.15,"low":10.65,"close":10.8,"volume":22265.519},{"time":"2