ign":1265.318,"trust":-405.182,"dealer":442.393},{"date":"2026-11-10","foreign":-1199.143,"trust":-76.6,"dealer":-402.074},{"date":"2026-11-09","foreign":-1207.289,"trust":-656.0,"dealer":166.651},{"date":"2026-11-06","foreign":1054.87,"trust":-1789.43,"dealer":-32.285},{"date":"2026-11-05","foreign":1544.525,"trust":-2126.81,"dealer":89.497},{"date":"2026-11-04","foreign":-3016.686,"trust":-1279.149,"dealer":-252.785},{"date":"2026-11-03","foreign":-1312.963,"trust":-9.964,"dealer":-225.527},{"date":"2026-11-02","foreign":-90.304,"trust":-1202.788,"dealer":197.605}],"news":[{"id":"7da3d16367e2f16d","source":"Yahoo股市-國際","category":"國際","title":"環球晶：MEMC Electronic Materials董事會決議取得廠務設施，上限4000萬歐元","link":"https://tw.stock.yahoo.com/news/%E7%92%B0%E7%90%83%E6%99%B6-memc-electronic-materials%E8%91%A3%E4%BA%8B%E6%9C%83%E6%B1%BA%E8%AD%B0%E5%8F%96%E5%BE%97%E5%BB%A0%E5%8B%99%E8%A8%AD%E6%96%BD-%E4%B8%8A%E9%99%904000%E8%90%AC%E6%AD%90%E5%85%83-011000738.html","published":1795741800,"summary":"公開資訊觀測站重大訊息公告(6488)環球晶-代子公司MEMC Electronic Materials S.p.A.公告董事會決議取得廠務設施1.標的物之名稱及性質（如坐落台中市北區ＸＸ段ＸＸ小段土","sentiment":0,"tags":{"topics":[],"bull":[],"bear":[],"score":0,"highlights":[],"keywords":[]},"time":"11/27 09:10"},{"id":"7c30166704e11b7d","source":"經濟日報-證券","category":"台股","title":"12檔台積擴產概念股點火 法人：操作量力而為","link":"https://money.udn.com/money/story/5607/9904322","published":1795709881,"summary":"台股昨（26）日避險情緒降溫，站穩5日線，隨台積電（2330）傳出向美國德州政府申請設廠，激勵中砂（1560）、環球晶等相關概念股點火轉強，法人預期盤勢仍處於震盪築底階段，建議短多操作量力而為，善設停利停損。","sentiment":1,"tags":{"topics":["擴產/資本支出","AI/半導體"],"bull":["擴產"],"bear":[],"score":2,"highlights":[],"keywords":[]},"time":"11/27 00:18"},{"id":"cnyes6670152","source":"鉅亨網","category":"台股","title":"AI股跌到不合理？一場錯殺，可能正在醞釀暴利行情！","link":"https://news.cnyes.com/news/id/6670152","published":1795421583,"summary":"台股歷經連續重挫後，終於迎來強勁反彈。儘管上週五美股與費城半導體指數大跌，台積電ADR同步承壓，但台股週一開低後迅速湧現承接買盤，呈現明顯的開低走高格局。觀察這波修正，大盤自高點回落近28%，融資餘額減幅超過三成，上週五上市櫃融資更單日大減逾600億元，顯示市場已出現大規模的槓桿清洗。另一方面，CNN恐懼與貪婪指數逼近個位數，反映投資情緒高度悲觀。歷史經驗顯示，極端恐慌往往也是行情醞釀反轉的重要階段。隨著政策護盤力量介入，市場能否逐步止穩，應觀察AI企業獲利預期、權值股表現、外資賣壓及融資清洗等四大訊號。 這波修正最值得關注的，並非股價究竟跌了多少，而是企業的基本面是否同步惡化。根據高盛報告對台灣經濟的樂觀預估，明年GDP成長率有望達8.7%，企業EPS成長幅度上看32%，反映AI產業仍具成長動能。若企業獲利持續擴張，股價卻因恐慌大幅下跌，便可能創造難得的價值投資機會。從本益比河流圖觀察，台積電、世芯-KY、台達電、環球晶及嘉澤等企業，部分已回落至相對歷史低估值區間。尤其台積電與世芯，具備AI供應鏈的競爭優勢，若未來訂單與獲利展望不變，當前市場的非理性修正，反而可能成為長期投資人重新布局的契機。 值得借鏡的是1990年代網際網路發展初期的思科（Cisco）。當年網路基礎建設需求快速成長，思科卻曾因營收成長率由83%放緩至57%，引發投資人對成長動能的疑慮，造成股價大幅修正。","sentiment":-1,"tags":{"topics":["訂單/接單","EPS/獲利","營收","法說/展望","法人動向","AI/半導體","總經/聯準會","美股/國際"],"bull":["反彈"],"bear":["重挫","大跌","恐慌"],"score":-6,"highlights":[],"keywords":["趨勢分析","摩爾投顧","謝晨彥","台股","AI"]},"time":"11/23 16:13"},{"id":"b9b3482c7746829a","source":"Yahoo股市-台股","category":"台股","title":"台股一度跌破4萬點還能抱嗎？哲哲急喊「別殺低」點名這幾檔正二次打底","link":"https://tw.news.yahoo.com/%E5%8F%B0%E8%82%A1-%E5%BA%A6%E8%B7%8C%E7%A0%B44%E8%90%AC%E9%BB%9E%E9%82%84%E8%83%BD%E6%8A%B1%E5%97%8E-%E5%93%B2%E5%93%B2%E6%80%A5%E5%96%8A-%E5%88%A5%E6%AE%BA%E4%BD%8E-%E9%BB%9E%E5%90%8D%E9%80%99%E5%B9%BE%E6%AA%94%E6%AD%A3%E4%BA%8C%E6%AC%A1%E6%89%93%E5%BA%95-151400644.html","published":1794928440,"summary":"台股17日盤中高低震盪1747點、一度失守4萬點大關。摩爾投顧投資長郭哲榮急喊別殺低，點名國巨、環球晶、聯電等個股正處二次打底階段，並揭露1121轉折關鍵。（記者唐家興）","sentiment":-1,"tags":{"topics":[],"bull":[],"bear":["失守","跌破"],"score":-4,"highlights":[],"keywords":[]},"time":"11/17 23:14"},{"id":"cnyes6663974","source":"鉅亨網","category":"總經","title":"台鏈聚光！前10月僑外資、對外投資雙創新高 外資投資衝破208億美元","link":"https://news.cnyes.com/news/id/6663974","published":1794821161,"summary":"經濟部投審司今(16)日發布最新統計，今年前10月外資來台投資金額首度突破200億美元，創下歷史新高；同時，對外投資金額也創下歷年同期之最，主要受惠於台積電 (TSM-US)(2330-TW) 等科技大廠積極進行全球布局。 經濟部投審司公布最新統計，今年1月到10月核准僑外投資件數為1,878件，投增資金額達208億9,926萬2,000美元，較去年同期大幅增加127.50%。 投審司指出，核准僑外投資金額首度突破200億美元大關，創下歷年同期新高紀錄，主要受惠於新加坡商美光、丹麥沃旭能源、荷蘭玉山能源及美商酷澎等大型外商持續加碼投資台灣。 在陸資來台投資方面，今年1月到10月核准投增資件數為17件，金額計856萬4,000美元，較去年同期減少91.63%，顯示陸資來台動能持續走低。 對外投資部分，今年1月到10月核准備對外投資件數達612件，投增資金額高達699億1,687萬2,000美元，較去年同期大增105.14%，創下歷史新高。 對外投資金額暴增的主因，在於台積電分別以300億美元及200億美元增資海外子公司，加上南亞科技與環球晶圓等企業積極佈局全球，推升整體對外投資規模。 至於對中國大陸投資方面，今年1月到10月核准對中國大陸投資件數為210件，核准投增資金額計7億8,694萬3,000美元，較去年同期減少20.04%。","sentiment":1,"tags":{"topics":["法人動向","AI/半導體","匯率"],"bull":["創新高","新高","突破","受惠","布局"],"bear":[],"score":7,"highlights":[],"keywords":["經濟部","對外","來台","外資","投資","沃旭能源","美光","酷澎"]},"time":"11/16 17:26"}],"fund":{"code":"6488","rev_month":"11510","rev":4764123.0,"rev_mom":-7.1073338855273684,"rev_yoy":11.190897518901265,"rev_cum_yoy":-3.0696698736548838,"eps_q":15.0,"eps_year":"115","eps_season":"3","net_income":7179871.0,"pe":29.17,"pb":1.88,"yield":1.49,"updated":"2026-11-27 02:23"},"tdcc":{"latest":{"date":"2026-11-20","big1000":65.59,"big400":71.2,"retail":15.99,"holders":179231},"prev":{"date":"2026-11-13","big1000":66.07,"big400":71.83,"retail":15.69,"holders":178737},"d_big1000":-0.48,"d_big400":-0.63,"d_retail":0.3,"d_holders":494},"weekly":{"bars":[{"time":"2026-07-27","open":1030.0,"high":1065.0,"low":778.0,"close":855.0,"volume":46175.134999999995},{"time":"2026-08-03","open":870.0,"high":996.0,"low":828.0,"close":872.0,"volume":70482.478},{"time":"2026-08-10","open":880.0,"high":1045.0,"low":823.0,"close":1010.0,"volume":52467.132},{"time":"2026-08-17","open":1000.0,"high":1120.0,"low":931.0,"close":941.0,"volume":53280.412000000004},{"time":"2026-08-24","open":970.0,"high":1035.0,"low":925.0,"close":972.0,"volume":51056.443999999996},{"time":"2026-08-31","open":951.0,"high":998.0,"low":875.0,"close":981.0,"volume":49328.97099999999},{"time":"2026-09-07","open":990.0,"high":1015.0,"low":882.0,"close":902.0,"volume":35796.11},{"time":"2026-09-14","open":880.0,"high":977.0,"low":872.0,"close":944.0,"volume":45630.821},{"time":"2026-09-21","open":951.0,"high":1010.0,"low":922.0,"close":948.0,"volume":65072.767},{"time":"2026-09-29","open":940.0,"high":1190.0,"low":930.0,"close":1190.0,"volume":68571.58},{"time":"2026-10-05","open":1220.0,"high":1260.0,"low":1095.0,"close":1130.0,"volume":67827.573},{"time":"2026-10-12","open":1110.0,"high":1145.0,"low":890.0,"close":902.0,"volume":72041.69},{"time