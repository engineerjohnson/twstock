":"2026-10-02","foreign":56.33,"trust":-35.58,"dealer":108.592},{"date":"2026-10-01","foreign":572.48,"trust":-9.0,"dealer":53.666},{"date":"2026-09-30","foreign":44.815,"trust":10.922,"dealer":46.94},{"date":"2026-09-29","foreign":403.659,"trust":-95.5,"dealer":81.408}],"news":[{"id":"cnyes6642889","source":"鉅亨網","category":"國際","title":"商用PC換機需求仍在 漲價考驗明年採購量 華碩逆勢增加市占","link":"https://news.cnyes.com/news/id/6642889","published":1793419206,"summary":"2026年10月31日（優分析／產業數據中心報導）⸺ 戴爾Dell(DELL-US)、惠普HP(HPQ-US)及華碩ASUS(2357-TW)積極搶攻商用PC換機潮，但記憶體等零組件漲價，也讓企業採購面臨預算壓力。三家業者各有布局，戴爾鎖定高階商用機種爭取市占，惠普靠調價與產品組合支撐營收，華碩則維持出貨成長，在漲價壓力下逆勢擴大商用PC市占。 戴爾認為，既有設備老舊及Windows 11升級需求，仍是支撐商用換機的主要動能。公司截至2025年10月底的2026會計年度第三季，商用業務營收年增5%，商用需求連續七季成長。面對後續市場出貨壓力，戴爾將著重高階商用產品，並運用供應鏈優勢爭取市占。 惠普則出現營收增加、出貨減少的情況。2026會計年度第三季商用PC營收年增22%，出貨量卻減少14%，主要靠調整售價及提高高階產品比重支撐。即使如此，個人系統事業營益率仍較去年同期下降0.8個百分點至4.6%，零組件成本增加持續侵蝕獲利。 相比之下，華碩在這波漲價壓力下，商用PC市占反而持續擴大，出貨已連續六季年增逾50%。相較惠普透過漲價與產品組合維持營收成長，華碩有實際出貨量增加作為支撐，商用業務基期較低，也提供較大的擴張空間。 不過，華碩同樣面對客戶預算限制。華碩表示，今年下半年國內PC價格已上漲約10%，部分機構原先編列的預算已買不齊所需設備，必須重新安排採購。","sentiment":1,"tags":{"topics":["EPS/獲利","營收","AI/半導體"],"bull":["漲價","成長","出貨","擴大","布局"],"bear":[],"score":6,"highlights":["年增5%","年增22%"],"keywords":["PC","優分析"]},"time":"10/31 12:00"},{"id":"c8760d779298d90e","source":"富聯網","category":"台股","title":"《投信買超5-5》瑞昱(148)、華碩(141)、聯詠(138)","link":"https://news.google.com/rss/articles/CBMiiAFBVV95cUxNa2lvYmVsSUtfS0V3YUJjLThTQWw1aGlmTzd3cWtkLUIzM011SkVjSzNxaGJGeE1jT0ljVjFhWGlBMXpzVkRxc20ySGRHY3VRWHFOY0NscC1jTWozbmo1V1ZORlJES0FJM2Q3eHl2d0RwREphWUYtalM0Nm1EU0c5ZTZrdnlrUTZt?oc=5","published":1793261100,"summary":"《投信買超5-5》瑞昱(148)、華碩(141)、聯詠(138) 富聯網","sentiment":1,"tags":{"topics":["法人動向"],"bull":["買超"],"bear":[],"score":2,"highlights":[],"keywords":[]},"time":"10/29 16:05"},{"id":"cnyes6640220","source":"鉅亨網","category":"台股","title":"東南亞不香了？惠普、華碩、宏碁想將產線搬回中國 專家：AI推高記憶體等成本","link":"https://news.cnyes.com/news/id/6640220","published":1793256603,"summary":"市場研究機構Omdia最新數據顯示，今年第三季聯想到貨量佔全球PC總量四分之一，其餘市佔率由惠普、戴爾、蘋果、華碩、三星和宏碁等非中國廠商分食，而在持續攀升的供應鏈成本壓力下，越來越多海外PC大廠正把核心零組件採購、整機生產訂單交給中國代工廠承接，更有產業主管預期成本環境若未改善，回流趨勢恐進一步擴大。 多位知情人士透露，惠普、華碩、宏碁等全球主要PC製造商正透過將部分生產從泰國、越南遷回中國，並啟用新一代代工製造商的方式，應對持續飆升的零組件成本。 主打遊戲PC品項的廠商高層坦言，過去一年DRAM價格漲幅至少達8倍，CPU、PCB及各類被動元件採購成本同步大幅攀升，加上美國先前暫停對PC類產品徵收額外關稅，權衡之下，廠商自然將更多生產訂單轉回中國製造體系。 中國憑藉著經驗豐富的產業技術工人、更低的綜合生產成本，以及全球最完整的電子全產業鏈集群，仍是PC製造的最優選擇之一，零組件就近供應的優勢幾乎無可取代。 隨著物料清單成本上升，AI需求激增導致記憶體等零件嚴重短缺，PC廠商利潤空間大幅壓縮。一家為所有主要PC製造商供貨的晶片企業高層表示，不僅記憶體晶片，其他零件價格也迅猛上漲，廠商已難以消化漲幅。 此外，PC廠商的訂單正轉向新興中國代工企業。由於廣達、仁寶等傳統代工巨頭將產能重心轉向利潤率更高的AI資料中心伺服器業務，為立訊精密等技術新勢力創造關鍵窗口期。","sentiment":1,"tags":{"topics":["訂單/接單","擴產/資本支出","AI/半導體","關稅/地緣"],"bull":["訂單","供應鏈","擴大"],"bear":[],"score":4,"highlights":[],"keywords":["Omdia","PC","生產線","惠普","華碩","宏碁","AI","記憶體"]},"time":"10/29 14:50"},{"id":"cnyes6639857","source":"鉅亨網","category":"國際","title":"1.5萬→6萬！AI算力需求助推RTX 5090價格 陸網嘆：一日一價 漲得比黃金還離譜","link":"https://news.cnyes.com/news/id/6639857","published":1793228409,"summary":"AI算力需求狂飆，消費級顯卡市場正迎來一場罕見漲價潮。自9月起，深圳華強北RTX 50系列高端顯卡價格持續跳漲，通路報價「一日一價」，日內、隔日價差可達數百元，有商家直言「不敢輕易出書面報價單」。 綜合《中國經濟網》、《每日經濟新聞》等陸媒報導，根據深圳華強北從業16年的經銷商介紹，RTX 5090官方初始零售價約1.5萬至1.6萬元，當前通路報價已飆升至5.5萬至6萬元；RTX 5080從首發約8000元漲至1.7萬元，半個月內就上漲4000至5000元。連走貨量最大的入門款RTX 5060，也從約2300元漲到3600元以上。 線上平台同樣漲勢驚人。得物App數據顯示，華碩RTX 5060成交均價由去年同期2459元漲至4296元，漲幅約74%；RTX 5070由4899元漲至9498元，漲幅約94%；旗艦RTX 5090更從24099元漲至59929元，漲幅約149%。 業內分析指出，漲價核心在於「需求吞噬、供給收縮」的極端剪刀差。輝達晶片產能優先傾斜AI算力卡，消費級顯卡配額被壓縮；OpenAI、谷歌、微軟等科技巨頭以高溢價鎖定長期產能，進一步加劇緊張氛圍。 此前，市場流傳的「RTX 5090停產」雖被英偉達否認，但官方承認供應鏈產能受限，渠道恐慌性鎖貨讓價格「未證先漲」。","sentiment":1,"tags":{"topics":["擴產/資本支出","AI/半導體","美股/國際"],"bull":["漲價"],"bear":[],"score":2,"highlights":[],"keywords":["顯卡","記憶體通膨","輝達","RTX 5090","通路","記憶體","AI算力"]},"time":"10/29 07:00"},{"id":"90a2d6ec75434155","source":"Yahoo股市-國際","category":"國際","title":"華碩AI商戰1》員工3天燒掉300美元Token 輝達AI PC首批賣光","link":"https://tw.news.yahoo.com/%E8%8F%AF%E7%A2%A9ai%E5%95%86%E6%88%B01-%E5%93%A1%E5%B7%A53%E5%A4%A9%E7%87%92%E6%8E%89300%E7%BE%8E%E5%85%83token-%E8%BC%9D%E9%81%94ai-pc%E9%A6%96%E6%89%B9%E8%B3%A3%E5%85%89-223000445.html","published":1793140200,"summary":"華碩員工開發產品，短短3天就耗掉300美元AI使用費，連公司都開始管制預算！華碩聯合科技系統事業總經理廖逸翔27日透露，華碩9月底已檢討內部AI Token支出，鼓勵員工減少依賴昂貴的雲端運算；另一方","sentiment":0,"tags":{"topics":["AI/半導體","匯率"],"bull":[],"bear":["減少"],"score":-1,"highlights":[],"keywords":[]},"time":"10/28 06:30"},{"id":"cnyes6638733","source":"鉅亨網","category":"台股","title":"研調：全球PC出貨量Q3年減21% 估Q4跌幅擴大至27% 華碩、蘋果市占提升","link":"https://news.cnyes.com/news/id/6638733","published":1793104068,"summary":"研調機構Counterpoint Research統計，2026年第三季全球PC出貨量年減21%至5,700萬台，季減13.8%。記憶體及其他零組件成本持續攀升，推高PC售價並影響消費者購買意願，其中聯想維持全球PC市場市佔第一，華碩與蘋果出貨跌幅低於整體市場，市占率均有所提升。 消費性市場需求仍顯疲弱，較高的產品售價使消費者傾向延後設備汰換。相較之下，企業市場受惠於設備更新及Windows系統遷移需求，表現相對穩定，但仍不足以抵銷整體市場下滑。此外，2025年第三季受到Windows 10終止支援前的換機需求，以及關稅相關庫存調整帶動，形成較高的比較基期，進一步擴大2026年第三季的年減幅度。 2026年第三季，全球前五大PC品牌合計占整體出貨量的76.7%，各品牌表現如下，聯想出貨1,500萬台，年減23%，市占率26.3%，維持全球第一；惠普(HPE-US)出貨1,030萬台，年減31%，市占率18.1%，排名第二，為前六大品牌中跌幅最大者。 戴爾(DELL-US)出貨760萬台，年減25%，市占率13.3%，排名第三，顯示企業需求仍不足以完全抵銷市場下滑；蘋果(AAPL-US)出貨560萬台，年減11%，市占率由去年同期的8.7%提升至9.8%。","sentiment":0,"tags":{"topics":["AI/半導體","關稅/地緣"],"bull":["出貨","擴大","受惠"],"bear":["年減","延後","疲弱"],"score":0,"highlights":[],"keywords":["研調","PC","蘋果","華碩","戴爾","惠普","聯想"]},"time":"10/27 20:27"},{"id":"64dd98ec900d619c","source":"科技島","category":"台股","title":"電腦及週邊設備產業鏈／華碩Q3營收2763億元創新高！AI伺服器全年成長目標上修至150%","link":"https://news.google.com/rss/articles/CBMiakFVX3lxTE9KU1RNVEYydVNJUnluRUJEUk1oa19YSFlNTENuX3FLNWtQcnUtOXVjdkNyVnNmLWh0VDJPbFNBOGdKMHAyVkw5UU9udFJKZ0VXcW56RzFHYmxidWpVUWFCMzV5M1RWcDRBaUE?oc=5","published":1793089834,"summary":"電腦及週邊設備產業鏈／華碩Q3營收2763億元創新高！AI伺服器全年成長目標上修至150% 科技島","sentiment":1,"tags":{"topics":["營收","AI/半導體"],"bull":["創新高","新高","上修","成長"],"bear":[],"score":7,"highlights":[],"keywords":[]},"time":"10/27 16:30"},{"id":"cnyes6638317","source":"鉅亨網","category":"台股","title":"華碩看旺2027年台灣商用PC市場 迎量價齊揚與標案預算回溫","link":"https://news.cnyes.com/news/id/6638317","published":1793086290,"summary":"PC品牌華碩今(27)日發表全新商用筆電ASUS ExpertBook A7，華碩聯合科技系統事業總經理廖逸翔受訪時，對台灣商用市場釋出正向營運展望，他提到，受惠於企業與政府預算回升及硬需求浮現，看好2027年商用市場在出貨量與價格上皆能維持成長動能，整體表現將優於今年。 他指出，台灣商用PC市場歷經上半年報價上漲近三成後，下半年因應零組件成本呈現逐季微幅調升約5%的緩漲格局，全年價格漲幅估計落在10%左右。展望2027年，由於DRAM與SSD等關鍵原料供應仍偏緊，預期明年上半年價格仍有至少5%的上揚空間，在採購動能未見縮減且大型企業願意拉高預算下，明年商用出貨量可望持平，並力拚優於今年。 回顧今年市場表現，廖逸翔表示，上半年台灣商用業務在量價齊揚帶動下繳出亮眼成績，出貨量成長近兩成達到22%，產品平均售價也同步拉升三成。下半年隨著政府採購標案陸續開出，大中型專案接單狀況維持穩健，且受惠於四年一次的生生用平板延續採購潮，華碩在教育領域的Chromebook出貨更繳出大幅度成長的佳績。 除了傳統PC產品線，華碩在地端AI設備的供貨同樣備受關注。廖逸翔透露，市場對RTX Spark等邊緣運算產品反應熱烈，目前供貨仍處於配貨階段，月底第二批貨將陸續到位，但由於全球市場同步爭奪配額，預計要到明年下半年整體供應量才有機會顯著放大，電競機種則受限於入門晶片缺料而面臨供給受限的挑戰。","sentiment":1,"tags":{"topics":["訂單/接單","法說/展望","AI/半導體"],"bull":["調升","看好","回升","回溫","成長","出貨"],"bear":[],"score":9,"highlights":[],"keywords":["華碩","PC","商用"]},"time":"10/27 15:31"},{"id":"41a95a89f0600569","source":"Yahoo股市-國際","category":"國際","title":"華碩說白話！新款商用筆電明年買只會更貴 輝達RTX Spark 供不應求","link":"https://tw.news.yahoo.com/%E8%8F%AF%E7%A2%A9%E8%AA%AA%E7%99%BD%E8%A9%B1-%E6%96%B0%E6%AC%BE%E5%95%86%E7%94%A8%E7%AD%86%E9%9B%BB%E6%98%8E%E5%B9%B4%E8%B2%B7%E5%8F%AA%E6%9C%83%E6%9B%B4%E8%B2%B4-%E8%BC%9D%E9%81%94rtx-spark-%E4%BE%9B%E4%B8%8D%E6%87%89%E6%B1%82-051700168.html","published":1793078220,"summary":"連假一結束，華碩於今（27）日上午舉辦 ASUS ExpertBook A7 新品發表會，看著這一款目前建議售價4.49萬元的新款筆電，華碩旗下華碩聯合科技系統事業總經理廖逸翔透露，「現在不買，怕是過","sentiment":1,"tags":{"topics":["AI/半導體"],"bull":["供不應求"],"bear":[],"score":3,"highlights":[],"keywords":[]},"time":"10/27 13:17"},{"id":"e917b3b7bb935afe","source":"Yahoo股市-國際","category":"國際","title":"華碩推商用新筆電下半年價格再漲一成 輝達RTX Spark創配貨制月底才到貨","link":"https://tw.news.yahoo.com/%E8%8F%AF%E7%A2%A9%E6%8E%A8%E5%95%86%E7%94%A8%E6%96%B0%E7%AD%86%E9%9B%BB%E4%B8%8B%E5%8D%8A%E5%B9%B4%E5%83%B9%E6%A0%BC%E5%86%8D%E6%BC%B2-%E6%88%90-%E8%BC%9D%E9%81%94rtx-spark%E5%89%B5%E9%85%8D%E8%B2%A8%E5%88%B6%E6%9C%88%E5%BA%95%E6%89%8D%E5%88%B0%E8%B2%A8-041754487.html","published":1793074674,"summary":"華碩宣布推出搭載Intel Core系列3 處理器全新商用筆電 ASUS ExpertBook A7，售價4.49萬起。面對記憶體等零組件飆漲，華碩系統事業總經理廖逸翔表示，今年上半年商用產品價格漲幅","sentiment":0,"tags":{"topics":["AI/半導體"],"bull":[],"bear":[],"score":0,"highlights":[],"keywords":[]},"time":"10/27 12:17"},{"id":"cnyes6638047","source":"鉅亨網","category":"美股","title":"高階顯卡漲價瘋狂 在中國有商家稱一周漲了上千元","link":"https://news.cnyes.com/news/id/6638047","published":1793063458,"summary":"人工智慧（AI）資料中心持續渴求算力，在中國大眾消費市場，近期出現了高階消費級獨立顯卡瘋狂漲價，多款輝達( NVDA-US ) 高階消費級顯卡近期價格變動頗大。 這些高階消費級顯卡面向遊戲玩家等用戶，多名華強北商家表示，目前輝達RTX5060顯卡售價人民幣（下同）4,000元左右；RTX5070顯卡售價8,000元左右，部分已達到9,000元以上；RTX5090D售價3萬元左右；RTX5090價格已經漲至5萬元以上。 「RTX5060這兩天價格都在漲。兩個星期前還賣3,000元左右，這兩天就站上4,000元了，兩個多月前才賣2,000多元。」一名商家說，近兩個星期漲價尤其迅猛。還有商家形容，這張顯卡近期幾乎漲了「一張卡的價格」。 據《第一財經》26日（周一）報導，RTX5060並不是個例。一名商家稱，RTX5070上個星期漲了3次價，一星期內漲價近千元，今天（周一）又漲了價。RTX5080近期漲價幅度則達到6,000～7,000元。 一些商家表示，近期高階消費級顯卡的價格每天實時變動，報價只對當下有效。「上周向一個客戶就一款高階顯卡報了價，隔了三天客戶再問，價格漲了800元，今天再問，漲了1,000多元。太誇張了。」一名商家形容。 在慢慢買比價平台，多款熱賣輝達高階消費級顯卡在電商平台上漲價也十分迅猛。","sentiment":1,"tags":{"topics":["AI/半導體"],"bull":["漲價"],"bear":[],"score":2,"highlights":[],"keywords":["輝達","中國","顯卡"]},"time":"10/27 09:10"}],"fund":{"code":"2357","rev_month":"11509","rev":97243019.0,"rev_mom":2.4085535489433343,"rev_yoy":17.734896679273135,"rev_cum_yoy":38.518371864576615,"eps_q":38.83,"eps_year":"115","eps_season":"2","net_income":31494261.0,"pe":13.89,"pb":2.34,"yield":4.42,"updated":"2026-10-30 16:33"},"tdcc":{"latest":{"date":"2026-10-22","big1000":64.85,"big400":74.79,"retail":9.89,"holders":109168},"prev":{"date":"2026-10-08","big1000":65.01,"big400":74.53,"retail":10.03,"holders":110371},"d_big1000":-0.16,"d_big400":0.26,"d_retail":-0.14,"d_holders":-1203},"weekly":{"bars":[{"time":"2026-07-27","open":778.0,"high":810.0,"low":722.0,"close":810.0,"volume":29263.28},{"time":"2026-08-03","open":790.0,"high":859.0,"low":781.0,"close":817.0,"volume":21986.863},{"time":"2026-08-10","open":820.0,"high":1025.0,"low":808.0,"close":996.0,"volume":28905.428},{"time":"2026-08-17","open":985.0,"high":986.0,"low":891.0,"close":921.0,"volume":18371.958},{"time":"2026-08-24","open":919.0,"high":981.0,"low":901.0,"close":965.0,"volume":10626.187999999998},{"time":"2026-08-31","open":962.0,"high":1030.