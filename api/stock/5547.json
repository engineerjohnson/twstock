收規模擴大。另一方面，公司近年持續優化工程組合，提高高毛利案件比重，並透過BIM建築資訊模型、智慧工地及工料精準管理，有效降低施工成本。 在都更危老全案管理業務方面，久舜旗下久聯建經目前共有7個案件持續推進，其中2案已進入施工階段，其餘5案則處於規劃整合等不同階段，未來亦有機會轉化為集團營造工程承攬案源。","sentiment":1,"tags":{"topics":["EPS/獲利","營收","法說/展望","總經/聯準會"],"bull":["創新高","新高","獲利","年增"],"bear":[],"score":5,"highlights":["年增2.37倍","年增11.9%"],"keywords":["久舜","財報","營收"]},"time":"11/04 15:55"}],"fund":{"code":"5547","rev_month":"11509","rev":242202.0,"rev_mom":-21.850154878678367,"rev_yoy":54.87843869499047,"rev_cum_yoy":24.18425971741162,"eps_q":null,"eps_year":null,"eps_season":null,"net_income":null,"pe":10.36,"pb":1.24,"yield":9.61,"updated":"2026-11-06 17:49"},"tdcc":{"latest":{"date":"2026-10-30","big1000":58.82,"big400":68.63,"retail":4.19,"holders":1380},"prev":{"date":"2026-10-22","big1000":58.82,"big400":68.57,"retail":4.21,"holders":1387},"d_big1000":0.0,"d_big400":0.06,"d_retail":-0.02,"d_holders":-7},"weekly":{"bars":[{"time":"2026-07-27","open":19.95,"high":20.4,"low":19.0,"close":20.4,"volume":124.66499999999999},{"time":"2026-08-03","open":20.0,"high":20.5,"low":19.5,"close":19.5,"volume":115.64699999999999},{"time":"2026-08-10","open":19.55,"high":20.25,"low":19.5,"close":19.85,"volume":135.38600000000002},{"time":"2026-08-17","open":20.05,"high":20.1,"low":19.8,"close":19.9,"volume":67.849},{"time":"2026-08-24","open":19.85,"high":20.1,"low":19.75,"close":19.85,"volume":58.983000000000004},{"time":"2026-08-31","open":19.85,"high":20.1,"low":19.6,"close":19.65,"volume":106.39999999999999},{"time":"2026-09-07","open":19.7,"high":20.4,"low":19.55,"close":19.95,"volume":232.824},{"time":"2026-09-14","open":20.0,"high":20.15,"low":19.85,"close":19.95,"volume":105.28200000000001},{"time":"2026-09-21","open":20.0,"high":20.2,"low":19.9,"close":19.9,"volume":111.888},{"time":"2026-09-29","open":20.0,"high":20.25,"low":20.0,"close":20.2,"volume":74.87400000000001},{"time":"2026-10-05","open":20.1,"high":20.35,"low":20.0,"close":20.15,"volume":102.95599999999999},{"time":"2026-10-12","open":20.1,"hi