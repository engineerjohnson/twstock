reign":-170.25,"trust":0.0,"dealer":0.0},{"date":"2026-10-14","foreign":157.88,"trust":0.0,"dealer":0.0},{"date":"2026-10-13","foreign":-56.508,"trust":0.0,"dealer":-7.0},{"date":"2026-10-12","foreign":-143.498,"trust":0.0,"dealer":3.0},{"date":"2026-10-08","foreign":263.962,"trust":0.0,"dealer":0.0},{"date":"2026-10-07","foreign":22.237,"trust":0.0,"dealer":0.0},{"date":"2026-10-06","foreign":243.251,"trust":0.0,"dealer":0.0},{"date":"2026-10-05","foreign":-406.682,"trust":0.0,"dealer":-1.0},{"date":"2026-10-02","foreign":575.86,"trust":0.0,"dealer":0.0},{"date":"2026-10-01","foreign":111.929,"trust":0.0,"dealer":3.845},{"date":"2026-09-30","foreign":1070.447,"trust":0.0,"dealer":3.155},{"date":"2026-09-29","foreign":-124.073,"trust":0.0,"dealer":-3.0},{"date":"2026-09-24","foreign":217.099,"trust":0.0,"dealer":-1.0},{"date":"2026-09-23","foreign":86.975,"trust":0.0,"dealer":0.0},{"date":"2026-09-22","foreign":178.411,"trust":0.0,"dealer":0.0}],"news":[{"id":"cnyes6632368","source":"鉅亨網","category":"總經","title":"賴清德：台美關稅力保15％不疊加 301調查秉持台美貿易互惠","link":"https://news.cnyes.com/news/id/6632368","published":1792155180,"summary":"總統賴清德今(16)日接受網紅節目專訪，針對外界關切的台美對等關稅議題，賴清德回應，目前對等關稅雖對台灣有挑戰，但對也對台灣經濟增進跟美國產業結構，增加更進一步結合的機會，目前台灣與美國對等關稅15%不疊加，與日韓條件拉平。至於美方正進行的301調查，政府也會極力爭取原來雙方同意的談判條件，秉持台美貿易互惠關係。 游庭皓今日將與賴清德對談台灣經濟等專訪影片上傳，針對台美貿易、美國對等關稅政策部分。 賴清德說，台灣對美國的關稅談判，確實是因為台灣對美國的順差數字太大，以今(2026)年台灣的外銷金額估計達9,000億美元，其中最大外銷標的國為美國，預期台灣今(2026)年對美國的貿易順差，將會比去(2025)年美國提出對等關稅政策時還要高。 賴清德強調，美國對等關稅，固然對台灣是一個挑戰，但也是台灣增進跟美國，產業結構更進一步結合的機會，有望促進台灣產業的發展，包括台灣去美國投資，美方也會來台投資，包括科技產業、國防工業及其他產業也是如此，所以在雙方互惠的狀況之下，也能讓美國也看到台灣產業的實力。 賴清德說，目前貿易談判結果為對等關稅15%不疊加，雖然目前美國對等關稅的法源已經失效，但對台灣的關稅並未因此增加，目前政府會持續關注美方在301條款調查結果與最終稅率，極力爭取原來雙方同意的談判條件，未來仍視美國政治的局勢變化而定，但仍以台灣利益為出發點，不採取拖延的策略因應。","sentiment":-1,"tags":{"topics":["關稅/地緣","匯率"],"bull":[],"bear":["關稅","調查"],"score":-3,"highlights":[],"keywords":["總統府","台股","台美對等關稅","301調查"]},"time":"10/16 20:53"},{"id":"cnyes6631178","source":"鉅亨網","category":"總經","title":"美光新廠啟用典禮 賴清德：期盼與台廠合力打造下一世代AI產品","link":"https://news.cnyes.com/news/id/6631178","published":1792052573,"summary":"總統賴清德今(15)日出席「台灣美光台中先進封裝測試二廠啟用典禮」時表示，政府支持先進技術在台研發、先進產品製造，推動科技與傳產雙引擎發展，除了恭喜新廠啟用外，也期盼美光(MU-US)能與台灣產業夥伴攜手合作，結合高階記憶體與先進製程的優勢，共同打造下一世代的AI產品，讓台灣持續引領科技突破，為全球產業開創新的發展機會。 賴清德致詞時表示，台灣美光在台中的「先進封裝測試二廠」正式啟用，他很高興與大家一起見證這個重要時刻，這座廠房去(2025)年9月動土，1年多就順利完工、啟用，展現建廠團隊的效率，也看到美光持續深耕台灣的決心。 賴清德指出，這座新廠的啟用除了壯大美光公司版圖、厚植全球競爭力外，對台灣整體的半導體產業更如虎添翼，對台灣在未來人工智慧化的時代，促進全球經濟發展所扮演的關鍵角色，更厥功甚偉，他要恭喜美光，也向所有投入建廠的團隊及一路支持美光在台發展的供應鏈夥伴致上最深的感謝。 賴清德提到，美光深耕台灣超過30年，累計投資突破新台幣1.6兆元，這份長期投入代表美光對台灣的信心，也讓雙方建立了緊密的合作關係，今(2026)年1月他在總統府與美光總裁梅羅特拉(Sanjay Mehrotra)見面交流，也感謝美光將台灣置於全球擴產計畫中的關鍵環節。","sentiment":1,"tags":{"topics":["擴產/資本支出","AI/半導體","匯率"],"bull":["突破","合作"],"bear":[],"score":2,"highlights":[],"keywords":["總統府","記憶體","台灣美光新廠","台積電","半導體","AI"]},"time":"10/15 16:22"}],"fund":{"code":"2025","rev_month":"11509","rev":159354.0,"rev_mom":-25.0381033022862,"rev_yoy":163.02984286280207,"rev_cum_yoy":139.012352909764,"eps_q":0.76,"eps_year":"115","eps_season":"2","net_income":130422.0,"pe":10.39,"pb":1.11,"yield":null,"updated":"2026-10-25 00:33"},"tdcc":{"latest":{"date":"2026-10-22","big1000":59.73,"big400":63.68,"retail":11.1,"holders":30201},"prev":{"date":"2026-10-08","big1000":60.3,"big400":63.4,"retail":11.23,"holders":30231},"d_big1000":-0.57,"d_big400":0.28,"d_retail":-0.13,"d_holders":-30},"weekly":{"bars":[{"time":"2026-07-27","open":11.7,"high":12.8,"low":11.5,"close":12.15,"volume":2766.91},{"time":"2026-08-03","open":12.15,"high":12.3,"low":11.75,"close":12.15,"volume":1350.029},{"time":"2026-08-10","open":12.45,"high":12.95,"low":12.15,"close":12.6,"volume":4940.3730000000005},{"time":"2026-08-17","open":12.6,"high":12.9,"low":12.3,"close":12.9,"volume":1955.0390000000002},{"time":"2026-08-24","open":13.1,"high":13.6,"low":12.7,"close":13.25,"volume":3533.178},{"time":"2026-08-31","open":13.05,"high":13.05,"low":12.55,"close":12.7,"volume":2041.8160000000003},{"time":"2026-09-07","open":12.6,"high":12.7,"low":12.2,"close":12.3,"volume