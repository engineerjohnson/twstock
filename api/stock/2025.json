2026-10-16","foreign":61.686,"trust":0.0,"dealer":0.0},{"date":"2026-10-15","foreign":-170.25,"trust":0.0,"dealer":0.0},{"date":"2026-10-14","foreign":157.88,"trust":0.0,"dealer":0.0},{"date":"2026-10-13","foreign":-56.508,"trust":0.0,"dealer":-7.0},{"date":"2026-10-12","foreign":-143.498,"trust":0.0,"dealer":3.0},{"date":"2026-10-08","foreign":263.962,"trust":0.0,"dealer":0.0},{"date":"2026-10-07","foreign":22.237,"trust":0.0,"dealer":0.0},{"date":"2026-10-06","foreign":243.251,"trust":0.0,"dealer":0.0}],"news":[{"id":"cnyes6651313","source":"鉅亨網","category":"台股","title":"和椿Q3 EPS 1.14元寫單季新高 前3季已賺贏去年","link":"https://news.cnyes.com/news/id/6651313","published":1793966566,"summary":"AI與機器人自動化整合廠和椿(6215-TW)今(6)日自結第3季財報，受惠於半導體、高階AI伺服器及電子製造客戶持續拉貨挹注，單季稅後純益為9,416萬元、季增81.79％、年增81.8％，每股稅後純益1.14元較去年同期年增81％，創單季獲利新高，今(2026)年前3季累計EPS為3.06元，已賺贏去(2025)年全年度水準。 和椿第3季營收為11.13億元、季增23.37％、年增57.9％；營業利益為1.17億元、年增134％，營益率10％、季增1.4個百分比、年增2.9個百分比；淨利率8％，均為季增、年增。前3季合併營收達27.88億元、55.4％，創歷年來單季營收、獲利新高佳績，稅後純益累計9,416萬元、年增140.6％。 和椿表示，隨AI基礎建設持續推進，也帶動半導體測試及高階伺服器相關設備及自動化次系統(Subsystem)的出貨比重提升，加上公司持續優化產品組合、供應鏈管理及生產效率，營運規模擴大效益逐步顯現，也挹注第3季單季營益率、淨利率均較上季及去年同期提升。 和椿也同步公布10月營收為3.47億元、月增5.9％、年增51.96％，達年月雙增，累計前10月合併營收31.35億元、年增55％。","sentiment":1,"tags":{"topics":["訂單/接單","EPS/獲利","營收","法說/展望","AI/半導體","總經/聯準會"],"bull":["新高","獲利","年增","受惠"],"bear":[],"score":5,"highlights":["EPS 1.14元","EPS為3.06元"],"keywords":["和椿","機器人","AI","半導體","高階伺服器","和椿財報","和椿營收"]},"time":"11/06 20:02"},{"id":"cnyes6648864","source":"鉅亨網","category":"台股","title":"上詮自結Q3每股虧0.06元 新增21.9億元資本支出擴充FAU產線","link":"https://news.cnyes.com/news/id/6648864","published":1793880130,"summary":"光通訊廠上詮(3363-TW)今(5)日自結今(2026)年第3季財報，稅後淨損約700萬元，虧損較前季收斂，較去(2025)年同期由盈轉虧，EPS為-0.06元，前3季合計稅後淨損為1.39億元，也去年同期由盈轉虧，EPS為-1.24元。 法人指出，上詮第2季主因FAU(光纖陣列單元)啟動試產，才導致獲利表現不如意，第3季隨著機台陸續進場，良率也大幅提升，虧損逐步收斂，第4季，3.2T FAU將持續放量，搭上Scale-Out、Scale-Up皆採用CPO的趨勢，將推升公司營收、獲利向上成長。 另為了強化CPO(矽光)產品量產布局，上詮也持續建置FAU高精密自動化生產線，今年至明(2027)年第2季，將規劃投入資本支出約15.38億元建置產線，FAU生產機台約占其中的10.8億元。 此外，上詮今日傍晚也發布重訊表示，經董事會決議通過，將新增資本支出預算約21.9億元，加計原尚待執行預算11.4億元後，資本支出預算總額為33.3億元。 上銓表示，新增資本支出主要係配合公司擴廠及擴充產能需求。法人指出，上詮有望利用資本支出新增產能，以擴產布局FAU的光通訊市場，迎接未來的AI基礎建設挑戰及搶先商機。 據了解，上詮將與國內半導體客戶持續密切合作，雙方合作應用在COUPE先進封裝上，包括2027年之後交付3.2T、6.4T的FAU產品，也為後續CPO產品出貨先做準備。","sentiment":0,"tags":{"topics":["EPS/獲利","營收","擴產/資本支出","法說/展望","AI/半導體"],"bull":["獲利"],"bear":["虧損"],"score":-1,"highlights":["EPS為-0.06元","EPS為-1.24元"],"keywords":["上詮","光通訊","CPO","AI"]},"time":"11/05 20:02"},{"id":"cnyes6648619","source":"鉅亨網","category":"總經","title":"賴清德重申三項使命 除了加強自主國防產業更要守護國安","link":"https://news.cnyes.com/news/id/6648619","published":1793879967,"summary":"總統賴清德今(5)日前往新北市淡水廟宇參香祈福，也重申他身為總統有三項重要使命，包括守護國家安全、發展經濟、照顧人民，政府將持續守護國家安全，支持中小微企業及傳統產業升級轉型，也透過各項社會福利政策照顧人民，期盼大家共同努力，未來持續提升地方醫療資源、推動交通及產業建設。 賴清德致詞時表示，他身為總統有三項重要使命，首先是守護國家安全，確保台灣維護民主制度，政府編列國防特別預算，對美軍事採購並與國際進行軍事合作，強化國軍戰力、發展國防自主產業，不僅提升國家安全，也能帶動產業進步及經濟發展。 第二項則是發展經濟。賴清德說，他就任總統後，去(2025)年經濟成長率8.76%，今(2026)年主計總處則預估將超過12%，高於日、韓、中、美國及歐洲各國，股市最高也來到4萬9千點，規模位居全球第四，台灣經濟表現亮眼，都要歸功於台灣人民及百工百業的共同努力。 賴清德也說，政府不僅要照顧大型企業，也要顧及中小微型企業的發展，除了支持科技公司，也要扶持傳統產業，目前政府提出8年加碼投入1,000億元預算，加速中小微企業升級轉型，希望企業不分大小，共同攜手打拚，經濟才能長遠發展。","sentiment":0,"tags":{"topics":[],"bull":[],"bear":[],"score":0,"highlights":[],"keywords":["總統府","賴清德","國防軍工","支持及壯大中小微企業方案","淡海科學城","AI","國防特別預算"]},"time":"11/05 19:59"},{"id":"cnyes6648331","source":"鉅亨網","category":"台股","title":"營收速報 - 千興(2025)10月營收1.29億元年增率高達129.55％","link":"https://news.cnyes.com/news/id/6648331","published":1793870471,"summary":"千興(2025-TW)今天公告2026年10月營收為新台幣1.29億元，年增率129.55%，月增率-19.16%。 今年1-10月累計營收為15.16億元，累計年增率138.18%。 最新價為11.05元，近5日股價下跌-16.55%，相關鋼鐵工業下跌-3.54%，短期股價無明顯表現。 近5日籌碼 三大法人合計買賣超：-237 張 外資買賣超：-250 張 投信買賣超：+6 張 自營商買賣超：+7 張 近6個月營收一覽 月份 月營收 年增率 月增率 26/10 1.29億 130% -19% 26/9 1.59億 163% -25% 26/8 2.13億 103% 89% 26/7 1.13億 201% 32% 26/6 8,549萬 58% -64% 26/5 2.38億 562% 18% 千興(2025-TW) 所屬產業為鋼鐵工業，主要業務為不銹鋼捲。 註：數據僅供參考，不作為投資建議。","sentiment":0,"tags":{"topics":["營收","法人動向","匯率","航運/傳產"],"bull":["年增"],"bear":["賣超"],"score":-1,"highlights":[],"keywords":["台股","台股營收","營收速報","10月營收","千興"]},"time":"11/05 17:21"},{"id":"cnyes6646924","source":"鉅亨網","category":"台股","title":"邁威爾收購Lumentum 法人：對光通訊台廠長線展望正向利多","link":"https://news.cnyes.com/news/id/6646924","published":1793794585,"summary":"因AI資料中心(AIDC)投資熱潮引發光通訊需求，美系晶片大廠邁威爾科技Marvell(MRVL-US)宣布，擬以含債務總值1,150億美元(約合新台幣3.75兆元)的全股票交易，收購光學元件大廠Lumentum(LITE-US)，將成為今(2026)年最大企業併購案之一。對此，法人表示，從產業面看，此為電晶片廠往光元件延伸的垂直整合，這樁收購顯示光模組產業正往美國主導靠攏，對長線來看對台灣光通訊產業長線觀察有望為一大利多。 目前全球光模組的製造重心近年已遷移至中國，根據調研機構LightCounting 在去(2025)年榜單中，前10大光模組廠中，中國就占7家，其中中際旭創與新易盛包辦前2名，但光模組最關鍵的兩樣東西，訊號處理器(DSP)與高階雷射，仍掌握在美國公司手上。 法人表示，無論審查結果如何，這樁收購都顯示光模組產業正往美國主導靠攏，對台灣的影響可以分三層面觀察，包括雷射與磊晶廠，獨立雷射供應商變少，客戶會積極尋找第2供應商，台灣的磷化銦(InP)磊晶與雷射晶片廠有機會承接分散出來的訂單，這是最直接的轉單紅利。 第二則光模組與次組件。若中國模組廠取得DSP與高功率雷射的難度升高，美系雲端業者更需要「非中國」製造夥伴，台廠角色會變重。 第三則是CPO的封裝、光纖耦合與測試。","sentiment":1,"tags":{"topics":["訂單/接單","法說/展望","AI/半導體","匯率"],"bull":["利多"],"bear":[],"score":3,"highlights":[],"keywords":["lumentum","marvell","台積電","光通訊"]},"time":"11/04 20:16"},{"id":"cnyes6646641","source":"鉅亨網","category":"總經","title":"英荷來台旅客雙雙創新高 觀光署赴倫敦旅展搶攻歐洲長程市場","link":"https://news.cnyes.com/news/id/6646641","published":1793788482,"summary":"英國、荷蘭旅客來台人數去年(2025)雙雙創下歷年新高，歐洲長程市場成為台灣觀光業者拓展海外客源的焦點。交通部觀光署統計，去年英國來台旅客達7萬7,958人次、荷蘭達2萬8,075人次，均超越疫情前水準。 為持續拓展歐洲主要客源市場，並配合國籍航空陸續於歐洲增班、擴點，交通部觀光署由署長陳玉秀偕同48位旅行社及航空業者代表，近期赴英國參加全球觀光指標展會WTM倫敦旅展，並串聯荷蘭市場，爭取歐洲長程旅遊商機。 本屆倫敦旅展台灣館以「台灣不打烊」為意象，向歐洲買家展現台灣從晨曦到夜幕、24小時安全便利的旅遊環境，以及多元旅遊路線與觀光資源。展期首日舉辦的交流會，也邀請英國BBC《The Travel Show》主持人Carmen Roberts分享台灣旅遊體驗，現場並提供以馬告、醃漬番茄等特色食材入菜的餐點，搭配獲得國際大獎的台灣「威石東」葡萄酒及經典台灣啤酒，深化台英觀光業者商務交流。 為讓歐洲業者深入體驗台灣生活美學，台灣館現場打造充滿茶香的慢旅茶館，設置茶席供歐洲買家品茗，並安排傳統歌仔戲演出，也邀請國寶級紙雕藝術家洪新富透過紙雕介紹台灣特有種生態。此外，參觀者還可透過數位互動，讓許願天燈在展館內緩緩升起，藉由五感體驗傳達台灣深度旅遊的多元魅力。","sentiment":1,"tags":{"topics":[],"bull":["創新高","新高"],"bear":[],"score":3,"highlights":[],"keywords":["觀光署","國際重遊客加碼方案","交通部"]},"time":"11/04 18:34"},{"id":"cnyes6645399","source":"鉅亨網","category":"總經","title":"賴清德：台股已躍升全球第四大市場 揭未來金融服務三大發展方向","link":"https://news.cnyes.com/news/id/6645399","published":1793704943,"summary":"總統賴清德今(3)日出席「2026台灣週」開幕式時表示，面對國際情勢變化及AI挑戰，政府將持續發揮產業優勢、強化金融發展，讓金融市場更加國際化、資本市場更具創新活力，讓台灣成為更值得長期信賴的投資市場，今(2026)年依照彭博統計，台股已躍升為全球第四大股市，資本市場將持續擴大。 賴清德表示，去年第一屆台灣週成功匯聚許多國內外金融機構與國際投資人；今年以「從科技島到資本島」為主題，擴大舉辦一系列國際金融交流活動，展現台灣金融市場的發展成果，向世界分享台灣下一階段的金融發展願景。 賴清德指出，近年面對國際變化及AI浪潮的挑戰，台灣經濟展現韌性，去(2025)年台灣經濟成長率達到8.76%，預估今年全年可超過11%，主計總處上周五公布，今年第3季經濟成長率為14.36%，比8月預測增加2.94個百分點，創48年來同季最高，並已連4季雙位數成長。 賴清德認為，產業發展需要金融服務，產業的全球布局更需要具有國際競爭力的金融市場做為後盾，政府會持續朝三個方向，發揮產業優勢，也強化金融發展。 第一，讓台灣的金融市場更加國際化。台灣正積極打造亞洲資產管理中心，讓臺灣成為全球資產配置的重要據點，過去2年多，金管會已經完成超過60項法規函令調適，截至9月底，台灣金融業的資產管理規模已達新台幣48.38兆元，相較於2024年6月增加超過15兆元。","sentiment":0,"tags":{"topics":["AI/半導體","匯率"],"bull":["擴大"],"bear":[],"score":1,"highlights":[],"keywords":["TISA","台灣週","AI","總統府"]},"time":"11/03 19:22"},{"id":"cnyes6644147","source":"鉅亨網","category":"台股","title":"高階玻纖布出貨強勁+產品組合優化 台玻前3季轉盈EPS達1.57元","link":"https://news.cnyes.com/news/id/6644147","published":1793620570,"summary":"台玻(1802-TW)今(2)日公布自結今(2026)年前3季稅後純益為45.64億元，較去(2025)同期淨損9.6億元由虧轉盈，累計每股純益(EPS)達1.57元，也較去年同期虧損0.33元，同樣轉為獲利。 台玻今年第3季受惠高階玻纖布需求出貨提升，稅後純益衝上 27.05 億元、季增 113.56%。 受惠於Low CTE今年度以來出貨量明顯增加，加上台玻在高階產品的組合持續優化，除了Low CTE營收貢獻提升，隨著國際高階玻纖布供需至今仍偏緊縮，預期產品毛利可望向上攀升，有機會反映對外報價上揚。法人對台玻維持「買進」投資建議，並提高目標價。 台玻因市場需求暢旺、價格持續上揚影響，在持續擴充產線布局產能下，高階產品 營收貢獻持續提升，也成為推升今年營運及獲利的重要動能，台玻近年積極轉型電子材料領域，旗下高階玻纖布與 T-glass 產品，也已陸續通過國內外大廠與供應鏈認證。 台玻今年參加TPCA Show 2026展出多款高階玻纖布產品，包括Low Dk1、Low Dk2玻纖布具備低介電損耗特性，可應用於電子產業、PCB、IC載板及先進封裝材料等領域。 在台玻Low CTE上，則具備低熱膨脹係數、高機械韌性及良好電性絕緣等特性，主要應用於5G、6G等網路應用、高頻高速電路板、光模組、高速交換器及資料傳輸等相關領域。","sentiment":1,"tags":{"topics":["EPS/獲利","營收","擴產/資本支出","AI/半導體"],"bull":["獲利","出貨","受惠"],"bear":["虧損"],"score":2,"highlights":["EPS達1.57元","EPS)達1.57元"],"keywords":["台玻","玻纖布","AI伺服器","T-glass","電子材料"]},"time":"11/02 19:56"},{"id":"cnyes6642259","source":"鉅亨網","category":"台股","title":"八貫前3季每股賺5.7元、賺贏去年全年 新訂單排到明年Q2後","link":"https://news.cnyes.com/news/id/6642259","published":1793365411,"summary":"TPU材料大廠八貫(1342-TW)自結今(2026)年第3季財報，受惠於戶外與醫療擴大應用領域，再加上航太航海與軍工客戶強勁拉貨及標案出貨貢獻雙重助攻下，單季EPS達1.6元，累計前3季EPS為 5.7元，已賺贏去(2025)年全年度獲利。八貫主管也表示，目前與客戶洽談的新訂單均已排到明(2027)年第2季後，展現營運成長動能及強勁的訂單能見度。 八貫今年第3季受惠於戶外與醫療擴大應用領域、軍工客戶強勁拉貨與標案出貨貢獻下，單季營收9.4億元、年增53.78％，因公司具備規模經濟加上產線調配優化，也帶動單季毛利率季增1個百分點為25.15％，單季營業利益為1.5億元、稅後純益1.2億元，年增分別為46.13％與17.68％，繳出第3季EPS 為1.6元，也優於去年1.34元。 統計八貫前3季營收28.6億元、年增36％，是公司四大產品線前3季營收較去年同期均雙位數成長，戶外前3季營收年增50.8％尤其亮眼，其次為醫療與軍工產品，前3季營收年增均超越二成，航太航海年增亦達14％；另於業外匯兌收益挹注1,154萬元，使稅後純益4.4億元、年增40.2％，繳出前3季EPS為5.7元，也已提前超越去年全年5.62元。","sentiment":1,"tags":{"topics":["訂單/接單","EPS/獲利","營收","法說/展望","總經/聯準會"],"bull":["訂單","獲利","成長","出貨","擴大","受惠"],"bear":[],"score":10,"highlights":["EPS達1.6元","EPS為 5.7元","EPS 為1.6元"],"keywords":["八貫","戶外產品","醫療產品","軍工國防"]},"time":"10/30 21:03"},{"id":"cnyes6641783","source":"鉅亨網","category":"總經","title":"AI、半導體需求強勁 國科會：全國研發經費連2年突破兆元","link":"https://news.cnyes.com/news/id/6641783","published":1793341610,"summary":"國科會今(30)日公布「2025年全國科技動態調查」，結果顯示，去(2025)年全國研發經費及研發人力仍維持雙成長，全國研發經費繼2024年突破兆元後持續成長，達1兆1,380億元、年增8.5%，連續2年突破兆元，GDP占比為3.96%，推測因全球市場對於人工智慧、資料中心及半導體先進製程之高度需求，帶動半導體、資通訊、電子零組件等高科技產業出口大幅成長。 據國科會調查結果，全國科技動態調查中，幾項特點如下； 一、企業主導技術發展動能：政府持續增加基礎研究之投入2025年全國研發經費中，以經費來源面進行觀察時，來自民間部門研發經費為9,810億元、年增9%，來自政府部門研發經費為1,570億元，年增5.4%，2025年來自民間部門研發經費占整體研發經費之86.2%，較前年略增0.4個百分點。 二、企業部門為我國研發主力，科學園區驅動企業研發量能：近年來企業部門所執行之研發經費占全國研發經費的比率皆在8成以上，2025年占比達85.9%，年增率為8.8%。我國由大型企業帶動整體研發量能，去年由規模500人以上的企業所執行之研發經費占全體企業研發經費之83.2%，較上年增加0.9個百分點。而科學園區廠商所執行之研發經費占全體企業研發經費比率由2021年之45.4%提升至114年47.8%。","sentiment":1,"tags":{"topics":["法人動向","AI/半導體","總經/聯準會"],"bull":["需求強勁","突破","成長","年增"],"bear":["調查"],"score":4,"highlights":["年增8.5%","年增9%","年增5.4%"],"keywords":["國科會","全國研發經費","AI","半導體"]},"time":"10/30 14:26"},{"id":"13ab6905b8d6e68d","source":"經濟日報-證券","category":"台股","title":"10月28日重要財經行事曆","link":"https://money.udn.com/money/story/5607/9841141","published":1793141061,"summary":"台灣 國發會發布9月景氣對策信號 央行發布9月消費者貸款及建築貸款餘額統計 股東臨時會：雄順 除權息：千興、世鎧、力達-KY 法人說明會：國慶科技、聯電、聯亞、尼克森、中光電投控、譜瑞-KY、訊連、精測、長科*、鴻勁 國際 紐西蘭、泰國、加拿大央行利率決策 蘋果新品發表會 Fed利率決策 財報：SK海力士；微軟、字母（美股盤後）","sentiment":0,"tags":{"topics":["法說/展望","總經/聯準會","美股/國際"],"bull":[],"bear":[],"score":0,"highlights":[],"keywords":[]},"time":"10/28 06:44"},{"id":"cnyes6638694","source":"鉅亨網","category":"總經","title":"〈ITF旅展〉港務公司續推動郵輪旅遊業務 首度進軍旅展拓寬台灣市場","link":"https://news.cnyes.com/news/id/6638694","published":1793103826,"summary":"台灣港務公司基隆港分公司今(27)日表示，台灣憑藉優越的地理位置、完善的港埠設施及豐富的觀光資源，經多年深耕，已成為亞洲郵輪航線的重要節點，根據國際郵輪協會(CLIA)統計，去(2025)年台灣已名列全球第13大、亞洲第4大郵輪客源市場，亞洲排名僅次於中國、新加坡及印度，也展現了台灣的郵輪發展實力。 基隆港公司主管指出，基隆港為北台灣重要郵輪母港，鄰近台北都會區，具備便利的聯外交通及完善的旅客服務，隨著國際郵輪品牌持續布局，郵輪產品與航線也日益多元，包括奢華型(Luxury)及探險型(Expedition)郵輪占基隆港郵輪靠泊艘次的比例，由疫情前的7%提升至今(2026)年度的16%，顯示基隆港除持續拓展大眾郵輪市場，也逐步吸引更多高端郵輪品牌及旅客造訪台灣。 另為了持續拓展郵輪經濟，台灣港務公司也宣布，將於下(11)月6日-9日首度參加「2026年台灣國際旅展」，並與基隆市文化觀光局、高雄市觀光局及台灣市占率第一的麗星郵輪合作，邀請民眾走訪各展攤，透過聯合集章互動活動，認識港群特色、郵輪航線及港口周邊觀光景點。","sentiment":0,"tags":{"topics":[],"bull":[],"bear":[],"score":0,"highlights":[],"keywords":["基隆港","港務公司","郵輪旅遊","台北國際旅展"]},"time":"10/27 20:23"}],"fund":{"code":"2025","rev_month":"11509","rev":159354.0,"rev_mom":-25.0381033022862,"rev_yoy":163.02984286280207,"rev_cum_yoy":139.012352909764,"eps_q":null,"eps_year":null,"eps_season":null,"net_income":null,"pe":8.57,"pb":0.91,"yield":null,"updated":"2026-11-06 17:49"},"tdcc":{"latest":{"date":"2026-10-30","big1000":58.64,"big400":62.92,"retail":11.13,"holders":30268},"prev":{"date":"2026-10-22","big1000":59.73,"big400":63.68,"retail":11.1,"holders":30201},"d_big1000":-1.09,"d_big400":-0.76,"d_retail":0.03,"d_holders":67},"weekly":{"bars":[{"time":"2026-07-27","open":11.7,"high":12.8,"low":11.5,"close":12.15,"volume":2766.91},{"time":"2026-08-03","open":12.15,"high":12.3,"low":11.75,"close":12.15,"volume":1350.029},{"time":"2026-08-10","open":12.45,"high":12.95,"low":12.15,"close":12.6,"volume":4940.3730000000005},{"time":"2026-08-17","open":12.6,"high":12.9,"low":12.3,"close":12.9,"volume":1955.0390000000002},{"time":"2026-08-24","open":13.1,"high":13.6,"low":12.7,"close":13.25,"volume":3533.178},{"time":"2026-08-31","open":13.05,"high":13.05,"low":12.55,"close":12.7,"volume":2041.8160000000003},{"time":"2026-09-07","open":12.6,"high":12.7,"lo