6,"trust":0.0,"dealer":4.0},{"date":"2026-10-22","foreign":208.079,"trust":0.0,"dealer":-0.43},{"date":"2026-10-21","foreign":225.783,"trust":0.0,"dealer":-7.0}],"news":[{"id":"cnyes6668632","source":"鉅亨網","category":"台股","title":"微型金融違約增加 裕融：增提備抵 資產品質穩健可控","link":"https://news.cnyes.com/news/id/6668632","published":1795142802,"summary":"裕融企業(9941-TW)最新指出，企金事業有看到企業融資和微型金融違約增加，使台灣延滯率回升至1.65%，惟已增提備抵反映風險，且部分大型違約個案擔保品充足，屬實質無損案件，整體資產品質保持穩健且在可控範圍，今(20)日盤中股價相對抗跌。 裕融表示，今年前三季業務動能增溫、資產品質穩定改善且有效成本管理，使獲利穩健成長，截至第三季合併總資產達2964.1億元，較去年同期成長4.7%，而預期信用減損損失大幅年減29%。台灣消金事業資產品質持續改善，已回穩至2022年優良時期水準。 而儘管企金事業雖受企業融資和微型金融違約增加影響，台灣延滯率回升至1.65%，但裕融表示，已增提備抵反映風險，且部分大型違約個案擔保品充足，是實質無損案件，整體資產品質仍保持穩健且在可控範圍。 在中國，裕融說明，延滯率由去年同期的3.15%降至2.25%，新承作案件資產品質已顯著改善，惟當地執行時程仍較緩，呆帳回收效益將遞延顯現。 裕融進一步提到，中國景氣復甦有限、租賃市場競爭加劇壓縮利差空間，所幸資金成本降低且費用控管良好，使前三季在中國的營業利益達1.58億元，較去年同期倍增，未來將聚焦優質客群，穩固資產品質。 而東南亞的投資也值得期待，裕融持續增資產、擴收益，對整體獲利的貢獻度正逐步放大。","sentiment":0,"tags":{"topics":["EPS/獲利"],"bull":["獲利","回升","成長"],"bear":["違約"],"score":1,"highlights":["成長4.7%"],"keywords":["違約","備抵","台股","裕融","融資","借貸","租賃"]},"time":"11/20 10:46"},{"id":"f807528c37c4f856","source":"富果直送","category":"台股","title":"【裕融法說會重點內容備忘錄】未來展望趨勢 20261119","link":"https://news.google.com/rss/articles/CBMiZ0FVX3lxTE9Zc0QtU0hjN1FiS3lnR3dOS1JFUmRNcjRpcWhZeFdzb3hCT251alR4ZmNXcDJtNkpMbFRBVGVBZzZ3NVowS09lWE1kbUxLZEIzd084Y3pGdzFXaUN1NUpralJQcEN2ZTA?oc=5","published":1795046400,"summary":"【裕融法說會重點內容備忘錄】未來展望趨勢 20261119 富果直送","sentiment":0,"tags":{"topics":["法說/展望"],"bull":[],"bear":[],"score":0,"highlights":[],"keywords":[]},"time":"11/19 08:00"}],"fund":{"code":"9941","rev_month":"11510","rev":3238595.0,"rev_mom":-5.100010549017769,"rev_yoy":2.413322796628634,"rev_cum_yoy":-0.31413311226089596,"eps_q":5.79,"eps_year":"115","eps_season":"3","net_income":3525276.0,"pe":10.31,"pb":1.16,"yield":6.48,"updated":"2026-11-20 19:27"},"tdcc":{"latest":{"date":"2026-11-13","big1000":66.14,"big400":69.83,"retail":12.42,"holders":43790},"prev":{"date":"2026-11-06","big1000":66.4,"big400":70.08