d":1793578704,"summary":"昨日盤勢 受到美股重量級科技股財報不如預期干擾，亞馬遜第三季財報表現失色，加上英特爾釋出疲弱的第四季財測，引發市場對科技產業獲利動能的疑慮。 台股今日早盤跳空開低於 46,139 點後，恐慌性停損賣壓傾巢而出，盤中一度狂瀉逾 1,600 點、下探 44,726 點。尾盤雖見低接買盤進場收斂跌幅，終場加權指數仍大跌 1,156 點，收在 45,211 點，成交量略增，呈現高檔放量長黑、劇烈震盪的洗盤格局。 權值股方面，台積電下跌1.86%、鴻海下跌1.00%、聯發科下跌3.21%、廣達持平盤，台達電下跌9.79%。 盤面強勢股，冠西電、明遠精密、強新、東捷資訊、科妍、旭品、科際精密、智晶、訊達等漲停；大世科、東台、高僑、普鴻等漲幅6%以上。 盤面弱勢股，台達電、華新科、友達、玉晶光、致茂、GIS-KY等跌停；國巨*、南亞、台光電、聯茂、大立光、台燿、臻鼎-KY、聯亞、金像電、智邦等跌幅5%以","sentiment":-1,"tags":{"topics":["EPS/獲利","法說/展望","法人動向","AI/半導體","美股/國際","盤前"],"bull":["獲利","放量"],"bear":["大跌","恐慌","不如預期","疲弱","賣壓","狂瀉"],"score":-12,"highlights":[],"keywords":[]},"time":"11/02 08:18"}],"fund":{"code":"4568","rev_month":"11510","rev":98941.0,"rev_mom":-13.183756558973728,"rev_yoy":-14.172572628145629,"rev_cum_yoy":3.6136211992669502,"eps_q":0.73,"eps_year":"115","eps_season":"3","net_income":23072.0,"pe":26.89,"pb":1.45,"yield":4.09,"updated":"2026-11-13 17:58"},"tdcc":{"latest":{"date":"2026-11-06","big1000":62.0,"big400":68.43,"retail":7.2,"holders":1674},"prev":{"date":"2026-10-30","big1000":62.0,"big400":68.43,"retail":7.3,"holders":1631},"d_big1000":0.0,"d_big400":0.0,"d_retail":-0.1,"d_holders":43},"weekly":{"bars":[{"time":"2026-07-27","open":39.6,"high":39.6,"low":38.4,"close":38.7,"volume":34.769},{"time":"2026-08-03","open":39.5,"high":39.65,"low":39.4,"close":39.4,"volume":19.267000000000003},{"time":"2026-08-10","open":40.35,"high":40.35,"low":39.25,"close":39.45,"volume":48.283},{"time":"2026-08-17","open":39.45,"high":39.5,"low":38.6,"close":39.5,"volume":33.521},{"time":"2026-08-24","open":39.55,"high":39.95,"low":39.35,"close":39.9,"volume":24.25},{"time":"2026-09-01","open":39.5,"high":40.1,"low":39.05,"close":39.3,"volume":20.344},{"time":"2026-09-07","open":39.3,"high":39.4,"low":38.5,"close":38.5,"volume":16.429000000000002},{"time":"2026-09-14","open":38.55,"high":39.95,"low":38.55,"close":39.6,"volume":16.287},{"time":"2026-09-21","open":39.5,"high":40.45,"low":38.8,"close":39.2,"volume":22.25},{"time":"20