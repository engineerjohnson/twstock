優勢。","sentiment":-1,"tags":{"topics":["訂單/接單","EPS/獲利","營收","法說/展望","AI/半導體","總經/聯準會"],"bull":["放量","布局"],"bear":["虧損","減少","年減"],"score":-2,"highlights":[],"keywords":["慧友","安控","機器人","半導體","視覺"]},"time":"11/05 16:51"},{"id":"5ac7b6d7dc8305e1","source":"富果直送","category":"台股","title":"【慧友法說會重點內容備忘錄】未來展望趨勢 20261105","link":"https://news.google.com/rss/articles/CBMiZ0FVX3lxTE4wS0tLbFk4amQtcUd3cE8xLTVxMjRUR195MF9OSHZDRUpDakF5cUdKc0l0eWJ3MHJ5MGR0YlRSQ1NrSzJ6RldPeGRaRGJWcHo5OWRMSEtiRUhobmFBNmZmWF9XMURhWGM?oc=5","published":1793836800,"summary":"【慧友法說會重點內容備忘錄】未來展望趨勢 20261105 富果直送","sentiment":0,"tags":{"topics":["法說/展望"],"bull":[],"bear":[],"score":0,"highlights":[],"keywords":[]},"time":"11/05 08:00"}],"fund":{"code":"5484","rev_month":"11510","rev":50143.0,"rev_mom":32.7096125344061,"rev_yoy":-19.189363416599516,"rev_cum_yoy":62.16957918217893,"eps_q":1.04,"eps_year":"115","eps_season":"3","net_income":69599.0,"pe":27.35,"pb":3.67,"yield":null,"updated":"2026-11-13 17:58"},"tdcc":{"latest":{"date":"2026-11-06","big1000":33.96,"big400":37.97,"retail":37.42,"holders":33751},"prev":{"date":"2026-10-30","big1000":33.96,"big400":37.95,"retail":37.54,"holders":33757},"d_big1000":0.0,"d_big400":0.02,"d_retail":-0.12,"d_holders":-6},"weekly":{"bars":[{"time":"2026-07-27","open":41.0,"high":41.0,"low":36.3,"close":37.7,"volume":1320.732},{"time":"2026-08-03","open":37.7,"high":45.0,"low":37.3,"close":44.8,"volume":2056.834},{"time":"2026-08-10","open":42.8,"high":46.9,"low":40.3,"close":40.6,"volume":2431.358},{"time":"2026-08-17","open":40.8,"high":41.9,"low":38.7,"close":40.0,"volume":1427.656},{"time":"2026-08-24","open":41.1,"high":41.25,"low":39.65,"close":40.2,"volume":859.828},{"time":"2026-08-31","open":40.5,"high":40.5,"low":39.0,"close":39.5,"volume":844.552},{"time":"2026-09-07","open":39.8,"high":43.5,"low":38.85,"close":39.85,"volume":2506.473},{"time":"2026-09-14","open":40.2,"high":40.2,"low":38.2,"close":39.35,"volume":586.4169999999999},{"time":"2026-09-21","ope