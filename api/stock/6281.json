-06","foreign":86.0,"trust":0.0,"dealer":14.0},{"date":"2026-11-05","foreign":4.0,"trust":0.0,"dealer":0.0},{"date":"2026-11-04","foreign":15.0,"trust":0.0,"dealer":0.0},{"date":"2026-11-03","foreign":10.0,"trust":0.0,"dealer":0.0},{"date":"2026-11-02","foreign":-2.0,"trust":0.0,"dealer":0.0},{"date":"2026-10-30","foreign":-5.0,"trust":0.0,"dealer":0.0},{"date":"2026-10-29","foreign":-2.0,"trust":0.0,"dealer":0.0},{"date":"2026-10-28","foreign":-2.0,"trust":0.0,"dealer":0.0},{"date":"2026-10-22","foreign":-23.0,"trust":0.0,"dealer":0.0},{"date":"2026-10-21","foreign":-7.0,"trust":0.0,"dealer":0.0},{"date":"2026-10-20","foreign":-3.0,"trust":0.0,"dealer":0.0},{"date":"2026-10-19","foreign":-2.0,"trust":0.0,"dealer":0.0},{"date":"2026-10-15","foreign":12.0,"trust":0.0,"dealer":0.0},{"date":"2026-10-14","foreign":1.0,"trust":0.0,"dealer":0.0},{"date":"2026-10-13","foreign":13.0,"trust":0.0,"dealer":0.0}],"news":[{"id":"cnyes6661814","source":"鉅亨網","category":"台股","title":"TEEMA產業鏈進軍波蘭 電電公會攜手逾50家台廠媒合布局中東歐市場","link":"https://news.cnyes.com/news/id/6661814","published":1794567118,"summary":"電電公會今(13)日表示，「2026 年TEEMA 科學園區產業日—波蘭」將於下周11月17 日在華沙登場，活動為期2天，電電公會將攜手台灣電機電子供應鏈及關聯產業業者，邀集ICT、工具機及電動車等領域具產業代表性的50家台廠，憑藉供應鏈整合與技術創新實力前進波蘭，搶攻中東歐市場商機。 電電公會表示，此次由經濟部指導，國貿署及電電公會(TEEMA)主辦，透過展示攤位呈現台灣科技及其關聯產業的創新成果，並藉由產業論壇及㇐對㇐商務媒合，協助業者發揮AI、智慧製造與電動車等領域的技術優勢，爭取採購訂單與在地合作機會，擴大歐洲市場布局。 此次波蘭方預計出席的代表有發展與科技部政務次⾧Michał Jaros、投資貿易局執行⾧Artur Osuchowski...等，另有波蘭台灣工商會及地方政府代表參與。雙方將就產業合作、投資環境及在地布局交換意見，協助台灣廠商掌握當地市場資源與合作機會，從中央與地方政府、投資貿易機構到經濟特區的高層參與，展現波蘭方對本次活動及深化台波產業合作的重視。 此外，活動除了集結台灣重要公協會夥伴參與，包含台灣電路板協會、工具機公會、機械公會等，並邀請波蘭全國電子電信商會、資料中心協會、自動化與機器人協會及電動交通發展商會等當地產業組織參與，涵蓋電子電信、資料中心、自動化及電動車等領域。","sentiment":1,"tags":{"topics":["訂單/接單","AI/半導體","關稅/地緣"],"bull":["供應鏈","布局"],"bear":[],"score":2,"highlights":[],"keywords":["電電公會","鴻海","teema","科學園區","中東歐","東元","亞崴","勤崴國際"]},"time":"11/13 18:51"},{"id":"cnyes6661017","source":"鉅亨網","category":"台股","title":"寵研所三支保健食品已有回購！鑫傳(6856) 寵物事業持股升至八成六","link":"https://news.cnyes.com/news/id/6661017","published":1794501009,"summary":"2026年11月13日（優分析／產業數據中心報導）⸺ 鑫傳(6856-TW) 對星品國際的持股在 2026 年提高到 86.3855%，寵物事業併入合併報表；星品自有品牌「寵研所」已推出皮毛修護、魚油與腸胃益生菌三支機能保健食品。 鑫傳分兩次取得股權，2025 年鑫傳先取得 48.19%，2026 年合計持有 86.3855%，星品成為子公司，寵物事業的營收與費用自此納入鑫傳的合併報表。 寵物業務聚焦兩個方向，一是繼續經營 PetSnowy 的台灣總代理，並以自有品牌 Jolly Pet 發展智慧飲水機、視訊飼料機等用品，公司表示新品結合智慧功能，飼主外出也能遠端操控餵食。 另一個方向為保健食品，寵研所與獸醫師合作開發，也由獸醫師推薦，三支產品針對皮毛修護、魚油補充與腸胃菌相。公司表示，這個方向的目標是協助消費者選擇優質保健食品，獲利不是第一順位。 通路已經布局完成 銷售通路涵蓋電商與實體，電商包括 momo、蝦皮、官網與 7-11 預購，旗艦通路是全國電子，實體有魚中魚、大樹寵物、寵物公園等連鎖寵物店，另外還有東森與誠品；據工商時報 2025 年 8 月的報導，星品也已在台中大遠百設立櫃點。公司指出，幾乎全台大型的寵物實體店面都有合作。 據工商時報 2025 年 8 月引述的市場調查，2024 年台灣寵物食品與用品市場規模已突破 650 億元。","sentiment":0,"tags":{"topics":["EPS/獲利","營收"],"bull":[],"bear":[],"score":0,"highlights":[],"keywords":["媒體","優分析"]},"time":"11/13 00:30"}],"fund":{"code":"6281","rev_month":"11510","rev":1341339.0,"rev_mom":-10.195671735322946,"rev_yoy":-4.1307694616812975,"rev_cum_yoy":0.35496664094733066,"eps_q":3.16,"eps_year":"115","eps_season":"3","net_income":313521.0,"pe":12.99,"pb":1.71,"yield":6.67,"updated":"2026-11-13 17:58"},"tdcc":{"latest":{"date":"2026-11-06","big1000":43.57,"big400":56.27,"retail":19.27,"holders":10235},"prev":{"date":"2026-10-30","big1000":43.57,"big400":56.27,"retail":19.26,"holders":10248},"d_big1000":0.0,"d_big400":0.0,"d_retail":0.01,"d_holders":-13},"weekly":{"bars":[{"time":"2026-07-27","open":51.9,"high":52.2,"low":51.4,"close":51.8,"volume":370.87200000000007},{"time":"2026-08-03","open":51.9,"high":51.9,"low":51.0,"close":51.3,"volume":297.224},{"time":"2026-08-10","open":51.3,"high":51.8,"low":51.2,"close":51.5,"volume":150.511},{"time":"2026-08-17","open":51.5,"high":51.8,"low":51.1,"close":51.8,"volume":180.891},{"time":"2026-08-24","open":51.8,"high":51.8,"low":51.1,"close":51.3,"volume":142.88899999999998},{"time":"2026-08-31","open":51.2,"high":51.5,"low":51.0,"close":51.4,"volume":184.71800000000002},{"time":"2026-09-07","open":51.7,"high":51.7,"low":51.2,"close":51.3,"volume":137.32600000000002},{"time":"2026-09-14"