情資解決方案(ASI)在日本與合作夥伴推廣順利，將持續拓展更多海外市場。 GOGOLOOK 強調，持續投入 AI 防詐技術創新，主要鎖定東南亞7億人口市場，並將同步布局歐美地區，與國際組織、各國政府和大型企業合作。 而在金融科技服務方面，GOGOLOOK旗下JUJI 招財麻吉在風險控管、營收規模等營運表現持續優於內部預期，占整體營收比重可望上看30%。 在消費者防詐端，隨著詐騙手法日新月異，GOGOLOOK因應消費者的需求，旗下Whoscall持續迭代產品功能，近日開啟「自訂來電者名稱」功能，讓陌生來電不再陌生。","sentiment":1,"tags":{"topics":["EPS/獲利","營收","AI/半導體"],"bull":["大漲","新高","需求強勁","年增","受惠","布局"],"bear":[],"score":9,"highlights":["年增25.7%","年增 26.9%"],"keywords":["詐騙","gogolook","熱門股","防詐"]},"time":"10/24 21:18"}],"fund":{"code":"6902","rev_month":"11509","rev":113873.0,"rev_mom":1.6868481211601658,"rev_yoy":17.86997070666294,"rev_cum_yoy":26.869003857863675,"eps_q":3.33,"eps_year":"115","eps_season":"2","net_income":117627.0,"pe":34.51,"pb":7.24,"yield":null,"updated":"2026-10-25 00:33"},"tdcc":{"latest":{"date":"2026-10-22","big1000":53.64,"big400":64.66,"retail":8.48,"holders":7660},"prev":{"date":"2026-10-16","big1000":54.96,"big400":67.35,"retail":8.15,"holders":7561},"d_big1000":-1.32,"d_big400":-2.69,"d_retail":0.33,"d_holders":99},"weekly":{"bars":[{"time":"2026-07-27","open":122.0,"high":123.5,"low":108.5,"close":121.0,"volume":652.0749999999999},{"time":"2026-08-03","open":121.0,"high":123.5,"low":118.5,"close":120.5,"volume":480.214},{"time":"2026-08-10","open":121.0,"high":135.5,"low":121.0,"close":132.0,"volume":609.086},{"time":"2026-08-17","open":130.0,"high":137.0,"low":125.0,"close":126.5,"volume":451.882},{"time":"2026-08-24","open":129.5,"high":129.5,"low":123.0,"close":129.5,"volume":296.603},{"time":"2026-08-31","open":127.0,"high":129.0,"low":122.5,"close":125.0,"volume":299.057},{"time":"2026-09-07","open":124.5,"high":128.0,"low":121.0,"close":121.0,"volume":349.504},{"time":"2026-09-14","open":120.5,"high":141.0,"low":120.5,"close":141.0,"volume":1188.749},{"time":"2026-09-21","open":155.0,"high":183.0,"low":155.0,"close":176.5,"volume":5791.3279999999995},{"time":"2026-09-29","open":173.0,"high":175.0,"low":149.0,"close":150.0,"volume":2160.247},{"time":"2026-10-05","open":151.0,"h