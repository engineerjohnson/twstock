5,"trust":1.0,"dealer":14.922}],"news":[{"id":"8520c4c5119fac91","source":"Yahoo股市-台股","category":"台股","title":"黃仁勳離職台股照噴！郭哲榮點名：這幾檔「低本益比、轉單股」必噴","link":"https://tw.news.yahoo.com/%E9%BB%83%E4%BB%81%E5%8B%B3%E9%9B%A2%E8%81%B7%E5%8F%B0%E8%82%A1%E7%85%A7%E5%99%B4-%E9%83%AD%E5%93%B2%E6%A6%AE%E9%BB%9E%E5%90%8D-%E9%80%99%E5%B9%BE%E6%AA%94-%E4%BD%8E%E6%9C%AC%E7%9B%8A%E6%AF%94-%E8%BD%89%E5%96%AE%E8%82%A1-200500001.html","published":1794600300,"summary":"黃仁勳辭去輝達執行長，郭哲榮認為AI需求不變，ASIC、TPU及半導體材料仍有機會，點名精材、聯發科、智原、帆宣、環球晶、國巨等個股，並看好台股年底挑戰5萬點。（記者唐家興）","sentiment":1,"tags":{"topics":["訂單/接單","EPS/獲利","AI/半導體"],"bull":["看好","轉單"],"bear":[],"score":3,"highlights":[],"keywords":[]},"time":"11/14 04:05"},{"id":"fb07ebee2fbff4f5","source":"Yahoo股市-台股","category":"台股","title":"台積電大單護體！「這大廠」在手訂單衝上1657億 目標價上看580元","link":"https://tw.news.yahoo.com/%E5%8F%B0%E7%A9%8D%E9%9B%BB%E5%A4%A7%E5%96%AE%E8%AD%B7%E9%AB%94-%E9%80%99%E5%A4%A7%E5%BB%A0-%E5%9C%A8%E6%89%8B%E8%A8%82%E5%96%AE%E8%A1%9D%E4%B8%8A1657%E5%84%84-%E7%9B%AE%E6%A8%99%E5%83%B9%E4%B8%8A%E7%9C%8B580%E5%85%83-170500274.html","published":1794503100,"summary":"帆宣（6196）公布10月營收達73.33億元創新高，但第3季財報不如預期，每股盈餘僅5.26元，遭本土投顧將目標價由830元下修至580元。不過，因手握台積電美國廠及亞灣資料中心等千億訂單，2027","sentiment":1,"tags":{"topics":["訂單/接單","EPS/獲利","營收","法說/展望","AI/半導體"],"bull":["創新高","新高","訂單","目標價","大單"],"bear":["下修","不如預期"],"score":2,"highlights":["目標價上看580元","目標價由830元"],"keywords":[]},"time":"11/13 01:05"},{"id":"cnyes6659653","source":"鉅亨網","category":"台股","title":"樺漢(6414) 智慧工廠單季成長 91%！營收佔比 45% 超越工業物聯網","link":"https://news.cnyes.com/news/id/6659653","published":1794409212,"summary":"2026年11月11日（優分析／產業數據中心報導）⸺ 半導體建廠需求改變了樺漢(6414-TW) 的事業排序。2026 年第 3 季，智慧工廠營收年增 91%、佔集團營收 45%，工業物聯網 44%，智慧軟體與方案 11%，智慧工廠成為集團營收最大的事業。 智慧工廠這一軌，公司也稱廠務，主體是子公司帆宣(6196-TW)，做的是晶圓廠的廠務工程、無塵室與設備整合。公司表示，成長動能來自先進製程與先進封裝的建廠需求；以廠務營收為分母，EUV 相關設備佔超過 40%，CoWoS（晶圓級先進封裝）與 CPO（共同封裝光學）合計超過 20%。集團也替 ASML 做客製化機器設備。 建廠的地點不只在台灣。公司指出，台灣從北到南都有案子在進行，美國、日本、德國也有建廠案；帆宣 9 月表示，已在美國亞利桑那、日本與德國布局工程與技術團隊，由台灣專案經理搭配當地施工夥伴執行。 工業物聯網 2026 年第 3 季營收年增 30%，貢獻集團毛利 48%，仍是最大獲利來源。智慧軟體與方案只佔第 3 季營收 11%，卻貢獻 23% 的毛利，公司表示這是毛利率最高的事業。 毛利率被建廠稀釋 智慧工廠的毛利率低於集團平均。2026 年第 3 季集團毛利率 19.5%，比 2025 年同期少 2.2 個百分點；公司表示，智慧工廠營收佔比拉高是主因。","sentiment":1,"tags":{"topics":["EPS/獲利","營收","擴產/資本支出","AI/半導體","總經/聯準會"],"bull":["成長","年增"],"bear":[],"score":2,"highlights":["成長 91%","年增 91%","年增 30%"],"keywords":["智慧工廠","先進封裝","廠務工程","毛利率","優分析"]},"time":"11/11 23:00"},{"id":"cnyes6659654","source":"鉅亨網","category":"台股","title":"樺漢(6414) 2027 年在手訂單逾 2,800 億！一半來自半導體建廠","link":"https://news.cnyes.com/news/id/6659654","published":1794409212,"summary":"2026年11月11日（優分析／產業數據中心報導）⸺ 樺漢(6414-TW) 2027 年的在手訂單已超過 2,800 億元。公司表示，目前的訂單出貨比（BB ratio，當期接單金額除以出貨金額）為 1.3 至 1.35，換算下來，接單比出貨多出三成到三成五。 這批訂單有一半來自半導體建廠。公司指出，2,800 億元拆成兩軌、各佔一半：一軌是半導體廠務與智慧工廠，以下稱廠務那一軌；另一軌是工業物聯網與 AI 設備服務，以下稱本業。兩軌的訂單都排在 2027 年交付完畢。 如下圖，根據優分析產業資料庫，除了在手訂單，客戶先付進來的錢也反映能見度：合約負債（客戶預收款）2026 年第 2 季達 277 億元、佔單季營收 57%，近三年大致走高。 （資料來源：優分析產業資料庫） 到了第 3 季，數字再往上走：合約負債 311 億元、佔單季營收 64%，金額是 2017 年有這個數字以來的新高。 廠務那一軌的訂單主要來自子公司帆宣(6196-TW)。帆宣做的是半導體廠務工程、無塵室與設備整合，營收跟著晶圓廠的建廠進度認列。帆宣 9 月表示在手訂單約 1,351 億元，能見度至少延伸到 2028 年；帆宣在集團合併報表內，這批訂單已算在集團的 2,800 億元裡。","sentiment":1,"tags":{"topics":["訂單/接單","營收","擴產/資本支出","AI/半導體"],"bull":["接單","訂單","出貨"],"bear":[],"score":5,"highlights":[],"keywords":["在手訂單","半導體建廠","廠務工程","合約負債","優分析"]},"time":"11/11 23:00"},{"id":"cnyes6659647","source":"鉅亨網","category":"台股","title":"樺漢(6414) 募 60 億元只是還銀行借款！3 年內只做小型軟體投資","link":"https://news.cnyes.com/news/id/6659647","published":1794409210,"summary":"2026年11月11日（優分析／產業數據中心報導）⸺ 樺漢(6414-TW) 11 月 11 日董事會決議發行兩檔國內無擔保轉換公司債（未來可換成股票的債），是公司發行的第 7 檔與第 8 檔，第 7 檔 40 億元、第 8 檔 20 億元，合計 60 億元，3 年期、票面利率 0%，用途是償還銀行借款。 這筆募資不是為新的併購準備。公司表示，未來 3 年沒有重大投資，像控創與帆宣那種規模的案子不會再有。 如下圖，根據優分析產業資料庫，資本支出佔營收比重十年來最高是 2025 年的 2.02%，金額 28.7 億元，這家公司的錢主要不是花在設備上。 （資料來源：優分析產業資料庫） 原本的做法是用併購取得營收與通路，投資德國工業電腦廠控創（Kontron）108 億元、投資帆宣(6196-TW) 49 億多元。公司表示，接下來只做 1 億至 2 億元的小型軟體投資。 資金需求來自在手訂單的交付。公司表示，營收往上走就需要資金，因此先把資金準備好，並以短債與中長期債持續優化債務結構。 票面零利率、三年到期 兩檔公司債的條件接近，都是 3 年期、票面利率 0%：第 7 檔依票面金額的 101% 到 102% 發行，採詢價圈購（先向法人詢價再配售）；第 8 檔以不低於票面金額 102% 為底標，採競價拍賣。票面不付息、發行價又高於面額，投資人看的是未來轉換成股票的價差。","sentiment":0,"tags":{"topics":["訂單/接單","營收","擴產/資本支出","總經/聯準會","金融"],"bull":[],"bear":[],"score":0,"highlights":[],"keywords":["可轉換公司債","資本支出","償債","財務結構","優分析"]},"time":"11/11 23:00"},{"id":"c8d8f933abb75e48","source":"Yahoo股市-台股","category":"台股","title":"台積電10月營收創新高！郭哲榮再喊「年底拚5萬點」：飆股名單曝光","link":"https://tw.news.yahoo.com/%E5%8F%B0%E7%A9%8D%E9%9B%BB10%E6%9C%88%E7%87%9F%E6%94%B6%E5%89%B5%E6%96%B0%E9%AB%98-%E9%83%AD%E5%93%B2%E6%A6%AE%E5%86%8D%E5%96%8A-%E5%B9%B4%E5%BA%95%E6%8B%9A5%E8%90%AC%E9%BB%9E-%E9%A3%86%E8%82%A1%E5%90%8D%E5%96%AE%E6%9B%9D%E5%85%89-105000283.html","published":1794307800,"summary":"台股連續反彈，10日大漲1050點收42711點，台積電10月營收5868.9億元創歷史新高。摩爾投顧投資長郭哲榮看好年底挑戰5萬點，點名環球晶、國巨、精材、帆宣等9檔個股。（記者唐家興）","sentiment":1,"tags":{"topics":["營收","AI/半導體"],"bull":["大漲","創新高","新高","看好","營收創","反彈"],"bear":[],"score":9,"highlights":[],"keywords":[]},"time":"11/10 18:50"},{"id":"bf2d75306b25cc55","source":"Yahoo股市-台股","category":"台股","title":"台積電強化整頓供應鏈 沒改善就掉單","link":"https://tw.news.yahoo.com/%E5%8F%B0%E7%A9%8D%E9%9B%BB%E5%BC%B7%E5%8C%96%E6%95%B4%E9%A0%93%E4%BE%9B%E6%87%89%E9%8F%88-%E6%B2%92%E6%94%B9%E5%96%84%E5%B0%B1%E6%8E%89%E5%96%AE-222746922.html","published":1794176866,"summary":"台積電海內外如火如荼趕工擴廠，但近期工安事件頻傳，台積電內部高度關注，業界盛傳公司已成立專案小組強化整頓供應鏈，若供應鏈問題未改善恐「掉單」，漢唐、帆宣、中鋼構與多家營造夥伴等協力廠商壓力大。","sentiment":0,"tags":{"topics":["AI/半導體"],"bull":["供應鏈"],"bear":[],"score":1,"highlights":[],"keywords":[]},"time":"11/09 06:27"},{"id":"738c94fa4ee029ce","source":"經濟日報-證券","category":"台股","title":"亞翔、帆宣前三季賺贏去年","link":"https://money.udn.com/money/story/5607/9865394","published":1794156761,"summary":"無塵室工程暨設備大廠亞翔（6139）、帆宣受惠半導體海內外大擴產熱潮，雙雙繳出前三季賺贏去年全年的漂亮成績單。亞翔獲利更是大爆發，法人看好，亞翔今年大賺逾五個股本應非難事。","sentiment":1,"tags":{"topics":["EPS/獲利","擴產/資本支出","AI/半導體"],"bull":["看好","擴產","獲利","受惠"],"bear":[],"score":6,"highlights":[],"keywords":[]},"time":"11/09 00:52"}],"fund":{"code":"6196","rev_month":"11510","rev":7333912.0,"rev_mom":2.2242900